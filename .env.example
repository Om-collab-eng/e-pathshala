# =============================================================================
# LIBRIKA PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================

# Server Environment
PORT=3000
NODE_ENV=production
SESSION_SECRET=your_long_random_session_secret_here

# Database Configuration (MySQL / MariaDB / PostgreSQL / SQLite)
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=librika_user
DB_PASSWORD=your_db_password
DB_NAME=librika_db

# =============================================================================
# JITSI AS A SERVICE (JaaS on 8x8.vc) CONFIGURATION
# Sign up and obtain credentials from https://jaas.8x8.vc
# =============================================================================
JAAS_APP_ID=vpaas-magic-cookie-xxxxxxxxxxxxxxxx
JAAS_API_KEY_ID=vpaas-magic-cookie-xxxxxxxxxxxxxxxx/xxxxxxxx
JAAS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC6...\n-----END PRIVATE KEY-----"
JAAS_DOMAIN=8x8.vc

# =============================================================================
# AI SERVICES (Optional AI Study Assistant & Chat)
# =============================================================================
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Storage & Uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
