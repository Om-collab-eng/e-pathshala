# =============================================================================
# LIBRIKA PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================

# Server Environment
PORT=3000
NODE_ENV=production
SESSION_SECRET=your_long_random_session_secret_here

# Database Configuration (MySQL / SQLite / PostgreSQL)
USE_MYSQL=1
MYSQL_HOST=10.169.7.44
MYSQL_PORT=3306
MYSQL_USER=librika_1_librika
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=librika_1_librika
MYSQL_SOCKET=/run/mysqld/mysqld.sock

# Leave USE_MYSQL=0 or unset to use local SQLite fallback:
# USE_SQLITE=1

# =============================================================================
# JITSI AS A SERVICE (JaaS on 8x8.vc) CONFIGURATION
# =============================================================================
JAAS_APP_ID=vpaas-magic-cookie-xxxxxxxxxxxxxxxx
JAAS_API_KEY_ID=vpaas-magic-cookie-xxxxxxxxxxxxxxxx/xxxxxxxx
JAAS_DOMAIN=8x8.vc
JAAS_PRIVATE_KEY=./jaas_private_key.pk

# =============================================================================
# AI & EXTERNAL SERVICES
# =============================================================================
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=
BREVO_API_KEY=

# Gmail SMTP Settings
SMTP_USER=librika.in@gmail.com
