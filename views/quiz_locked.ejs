<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Quiz Locked - Librika' %></title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      --primary: #0B5ED7;
      --indigo: #5B4BDB;
      --background: #F8FAFC;
      --surface: #FFFFFF;
      --text-primary: #111827;
      --text-secondary: #64748B;
      --border: #E2E8F0;
      --radius-xl: 24px;
      --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.05);
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: var(--background);
      color: var(--text-primary);
      font-family: 'Plus Jakarta Sans', sans-serif;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }
    .lock-card {
      background: var(--surface);
      border-radius: var(--radius-xl);
      border: 1px solid var(--border);
      padding: 48px 36px;
      max-width: 520px;
      width: 100%;
      text-align: center;
      box-shadow: var(--shadow-md);
    }
    .lock-icon {
      font-size: 3.5rem;
      margin-bottom: 16px;
      display: inline-block;
    }
    .lock-title {
      font-family: 'Outfit', sans-serif;
      font-size: 1.6rem;
      font-weight: 800;
      color: var(--text-primary);
      margin-bottom: 12px;
    }
    .lock-message {
      font-size: 0.95rem;
      color: var(--text-secondary);
      line-height: 1.5;
      margin-bottom: 28px;
    }
    .btn-back {
      background: linear-gradient(135deg, var(--primary), var(--indigo));
      color: white;
      text-decoration: none;
      padding: 12px 28px;
      border-radius: 12px;
      font-family: 'Outfit', sans-serif;
      font-weight: 700;
      font-size: 0.95rem;
      display: inline-block;
    }
  </style>
</head>
<body>
  <div class="lock-card">
    <div class="lock-icon">🔒</div>
    <h1 class="lock-title">Quiz Locked</h1>
    <p class="lock-message"><%= message || 'You are not yet eligible to take this quiz. Complete the required reading or return the physical book to unlock.' %></p>
    <a href="/student?module=learn" class="btn-back">&larr; Back to Learning Hub</a>
  </div>
</body>
</html>
