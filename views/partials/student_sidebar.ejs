<style>
/* Self-Contained Student Sidebar Mobile Drawer System */
.sp-sidebar {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    width: 280px !important;
    max-width: 82vw !important;
    height: 100vh !important;
    height: 100dvh !important;
    background: #080f22 !important;
    border-right: 1px solid rgba(99, 102, 241, 0.16) !important;
    z-index: 99999 !important;
    transform: translateX(-105%) !important;
    transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1) !important;
    box-shadow: 10px 0 40px rgba(0, 0, 0, 0.6) !important;
    display: flex !important;
    flex-direction: column !important;
    padding: 0 !important;
    margin: 0 !important;
    box-sizing: border-box !important;
}
.sp-sidebar.open {
    transform: translateX(0) !important;
}
@media (min-width: 901px) {
    .sp-sidebar {
        transform: translateX(0) !important;
        position: sticky !important;
    }
}
.sp-sidebar-brand {
    padding: 1.1rem 1rem !important;
    border-bottom: 1px solid rgba(99, 102, 241, 0.16) !important;
    display: flex !important;
    align-items: center !important;
    gap: 10px !important;
    background: #080f22 !important;
    flex-shrink: 0 !important;
}
.sp-brand-logo {
    width: 36px !important;
    height: 36px !important;
    border-radius: 50% !important;
    background: linear-gradient(135deg, #6366f1, #a855f7) !important;
    color: white !important;
    font-weight: 800 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    flex-shrink: 0 !important;
}
.sp-brand-text {
    min-width: 0 !important;
    flex: 1 !important;
}
.sp-brand-name {
    margin: 0 !important;
    font-size: 0.9rem !important;
    font-weight: 800 !important;
    color: #ffffff !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
}
.sp-brand-sub {
    margin: 0 !important;
    font-size: 0.72rem !important;
    color: #94a3b8 !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
}
.sp-sidebar-close {
    background: rgba(255, 255, 255, 0.08) !important;
    border: 1px solid rgba(255, 255, 255, 0.15) !important;
    color: #f1f5f9 !important;
    width: 30px !important;
    height: 30px !important;
    border-radius: 50% !important;
    cursor: pointer !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    flex-shrink: 0 !important;
}
.sp-nav {
    flex: 1 !important;
    overflow-y: auto !important;
    padding: 0.75rem !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 4px !important;
}
.sp-nav-group-label {
    font-size: 0.68rem !important;
    text-transform: uppercase !important;
    color: #818cf8 !important;
    font-weight: 800 !important;
    margin: 12px 0 4px 8px !important;
    letter-spacing: 0.05em !important;
}
.sp-nav-link {
    display: flex !important;
    align-items: center !important;
    height: 44px !important;
    padding: 0 12px !important;
    border-radius: 10px !important;
    color: #94a3b8 !important;
    font-size: 0.85rem !important;
    font-weight: 600 !important;
    text-decoration: none !important;
    transition: all 0.2s ease !important;
    white-space: nowrap !important;
}
.sp-nav-link:hover, .sp-nav-link.active {
    background: rgba(99, 102, 241, 0.18) !important;
    color: #ffffff !important;
}
.sp-nav-icon {
    font-size: 1.1rem !important;
    margin-right: 10px !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
}
.sp-sidebar-footer {
    padding: 0.75rem !important;
    border-top: 1px solid rgba(99, 102, 241, 0.16) !important;
    background: #080f22 !important;
    flex-shrink: 0 !important;
}
.sp-footer-link {
    display: flex !important;
    align-items: center !important;
    height: 40px !important;
    padding: 0 12px !important;
    border-radius: 8px !important;
    font-size: 0.82rem !important;
    font-weight: 700 !important;
    color: #f87171 !important;
    text-decoration: none !important;
    background: rgba(239, 68, 68, 0.12) !important;
    border: 1px solid rgba(239, 68, 68, 0.2) !important;
}
.sp-overlay {
    position: fixed !important;
    inset: 0 !important;
    background: rgba(3, 7, 18, 0.8) !important;
    backdrop-filter: blur(8px) !important;
    -webkit-backdrop-filter: blur(8px) !important;
    z-index: 99998 !important;
    opacity: 0 !important;
    pointer-events: none !important;
    transition: opacity 0.28s ease !important;
}
.sp-overlay.active {
    opacity: 1 !important;
    pointer-events: auto !important;
}

/* Strictly hide all bottom nav bars across the student portal */
.bottom-nav, .portal-bottom-nav, nav.bottom-nav, .sp-bottom-nav, .ld-bottom-nav {
    display: none !important;
    height: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
}
</style>
<%
  // Student sidebar partial — pass `active` (page key) when including.
  const spName = (session && (session.user_name || session.name)) ? (session.user_name || session.name) : 'Student';
  const spSchool = (session && session.school_name) ? session.school_name : 'E-Pathshala Network';
%>
<aside class="sp-sidebar" id="spSidebar">
  <div class="sp-sidebar-brand">
    <div class="sp-brand-logo">L</div>
    <div class="sp-brand-text">
      <p class="sp-brand-name">librika.in</p>
      <p class="sp-brand-sub"><%= spSchool %></p>
    </div>
    <button class="sp-sidebar-close" onclick="spCloseSidebar()" aria-label="Close sidebar">✕</button>
  </div>

  <nav class="sp-nav">
    <div class="sp-nav-group-label">Main</div>
    <a href="/student" class="sp-nav-link <%= active === 'dashboard' ? 'active' : '' %>">
      <span class="sp-nav-icon">🏠</span><span class="sp-nav-label">Dashboard</span>
    </a>
    <a href="/student/browse" class="sp-nav-link <%= active === 'browse' ? 'active' : '' %>">
      <span class="sp-nav-icon">📚</span><span class="sp-nav-label">Digital Library</span>
    </a>
    <a href="/student/my-library" class="sp-nav-link <%= active === 'library' ? 'active' : '' %>">
      <span class="sp-nav-icon">📦</span><span class="sp-nav-label">My Library</span>
    </a>
    <a href="/digital-library" class="sp-nav-link <%= active === 'community' ? 'active' : '' %>">
      <span class="sp-nav-icon">🌐</span><span class="sp-nav-label">Community</span>
    </a>
    <a href="/student/ai" class="sp-nav-link <%= active === 'ai' ? 'active' : '' %>">
      <span class="sp-nav-icon">🤖</span><span class="sp-nav-label">AI Assistant</span>
    </a>

    <div class="sp-nav-group-label">Create &amp; Track</div>
    <a href="/student/publish" class="sp-nav-link <%= active === 'publish' ? 'active' : '' %>">
      <span class="sp-nav-icon">✏️</span><span class="sp-nav-label">Publish Content</span>
    </a>
    <a href="/student/my-publications" class="sp-nav-link <%= active === 'publications' ? 'active' : '' %>">
      <span class="sp-nav-icon">📄</span><span class="sp-nav-label">My Publications</span>
    </a>
    <a href="/student/bookmarks" class="sp-nav-link <%= active === 'bookmarks' ? 'active' : '' %>">
      <span class="sp-nav-icon">🔖</span><span class="sp-nav-label">Saved Items</span>
    </a>
    <a href="/student/goals" class="sp-nav-link <%= active === 'goals' ? 'active' : '' %>">
      <span class="sp-nav-icon">🎯</span><span class="sp-nav-label">Reading Goals</span>
    </a>

    <div class="sp-nav-group-label">Account</div>
    <a href="/student/achievements" class="sp-nav-link <%= active === 'achievements' ? 'active' : '' %>">
      <span class="sp-nav-icon">🏆</span><span class="sp-nav-label">Achievements</span>
    </a>
    <a href="/student/analytics" class="sp-nav-link <%= active === 'analytics' ? 'active' : '' %>">
      <span class="sp-nav-icon">📈</span><span class="sp-nav-label">Analytics</span>
    </a>
    <a href="/student/assignments" class="sp-nav-link <%= active === 'assignments' ? 'active' : '' %>">
      <span class="sp-nav-icon">📝</span><span class="sp-nav-label">Assignments</span>
    </a>
    <a href="/student/requests" class="sp-nav-link <%= active === 'requests' ? 'active' : '' %>">
      <span class="sp-nav-icon">📬</span><span class="sp-nav-label">Book Requests</span>
    </a>
    <a href="/student/calendar" class="sp-nav-link <%= active === 'calendar' ? 'active' : '' %>">
      <span class="sp-nav-icon">📅</span><span class="sp-nav-label">Calendar</span>
    </a>
    <a href="/student/notifications" class="sp-nav-link <%= active === 'notifications' ? 'active' : '' %>">
      <span class="sp-nav-icon">🔔</span><span class="sp-nav-label">Notifications</span>
    </a>
    <a href="/student/settings" class="sp-nav-link <%= active === 'settings' ? 'active' : '' %>">
      <span class="sp-nav-icon">⚙️</span><span class="sp-nav-label">Settings</span>
    </a>
    <a href="/student/security" class="sp-nav-link <%= active === 'security' ? 'active' : '' %>">
      <span class="sp-nav-icon">🔐</span><span class="sp-nav-label">Security</span>
    </a>
    <a href="/student/support" class="sp-nav-link <%= active === 'support' ? 'active' : '' %>">
      <span class="sp-nav-icon">🛟</span><span class="sp-nav-label">Help &amp; Support</span>
    </a>
    <a href="/student/profile" class="sp-nav-link <%= active === 'profile' ? 'active' : '' %>">
      <span class="sp-nav-icon">👤</span><span class="sp-nav-label">My Profile</span>
    </a>
  </nav>

  <div class="sp-sidebar-footer">
    <button class="sp-footer-link" type="button" onclick="spToggleTheme()">
      <span class="sp-nav-icon">🌓</span><span id="spThemeLabel">Appearance</span>
    </button>
    <a href="/logout" class="sp-footer-link danger">
      <span class="sp-nav-icon">🚪</span><span>Logout</span>
    </a>
  </div>
</aside>

<div class="sp-overlay" id="spOverlay" onclick="spCloseSidebar()"></div>



<script>
  function spOpenSidebar() {
    const sb = document.getElementById('spSidebar');
    const ov = document.getElementById('spOverlay');
    if (sb) sb.classList.add('open');
    if (ov) ov.classList.add('active');
  }
  function spCloseSidebar() {
    const sb = document.getElementById('spSidebar');
    const ov = document.getElementById('spOverlay');
    if (sb) sb.classList.remove('open');
    if (ov) ov.classList.remove('active');
  }
  document.addEventListener('DOMContentLoaded', function () {
    const sb = document.getElementById('spSidebar');
    if (sb) sb.querySelectorAll('a').forEach(function (a) { a.addEventListener('click', spCloseSidebar); });
    var saved = localStorage.getItem('theme') || 'dark';
    document.documentElement.setAttribute('data-theme', saved);
    var lbl = document.getElementById('spThemeLabel');
    if (lbl) lbl.textContent = saved === 'light' ? '☀️ Appearance' : '🌙 Appearance';
  });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') spCloseSidebar(); });
  function spToggleTheme() {
    const html = document.documentElement;
    const next = html.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
    html.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
    const lbl = document.getElementById('spThemeLabel');
    if (lbl) lbl.textContent = next === 'light' ? '☀️ Appearance' : '🌙 Appearance';
    if (typeof updateAllThemeIcons === 'function') updateAllThemeIcons(next);
  }
</script>
