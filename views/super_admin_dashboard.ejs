async function loadCategories() {
  try {
    const d = await (await fetch('/super-admin/categories')).json();
    const renderList = (list, entity) => {
      const rows = list && list.length
        ? `<table class="sa-table"><thead><tr><th>Name</th><th>Count</th><th>Actions</th></tr></thead><tbody>${list.map(c => `<tr><td>${c.name}</td><td>${c.count}</td><td><div class="sa-table-actions"><button class="sa-btn sa-btn-ghost sa-btn-xs" onclick="renameCategory('${entity}','${(c.name||'').replace(/'/g,"\\'")}')">✏️ Rename</button><button class="sa-btn sa-btn-danger sa-btn-xs" onclick="deleteCategory('${entity}','${(c.name||'').replace(/'/g,"\\'")}')">🗑</button></div></td></tr>`).join('')}</tbody></table>`
        : '<p style="color:#475569;font-size:.86rem">None yet.</p>';
      return `${rows}
        <div style="display:flex;gap:.5rem;margin-top:.6rem;align-items:center">
          <input class="sa-input" style="max-width:220px;font-size:.8rem" id="newCat-${entity}" placeholder="New ${entity === 'subject' ? 'subject' : 'category'} name">
          <button class="sa-btn sa-btn-primary sa-btn-xs" onclick="createCategory('${entity}')">+ Add</button>
        </div>`;
    };
    document.getElementById('catWrap').innerHTML = `
      <div class="sa-card-body"><h4 style="color:#a5b4fc">Book Categories</h4>${renderList(d.book_categories, 'category')}</div>
      <div class="sa-card-body"><h4 style="color:#a5b4fc">Digital Content Categories</h4>${renderList(d.digital_categories, 'digital')}</div>
      <div class="sa-card-body"><h4 style="color:#a5b4fc">Subjects (Books)</h4>${renderList(d.subjects, 'subject')}</div>`;
