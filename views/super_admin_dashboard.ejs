async function selectAvatarOption(avatarId) {
  _selectedAvatarId = avatarId;
  document.querySelectorAll('.sa-avatar-option').forEach(el => el.classList.remove('selected'));
  const selectedEl = document.querySelector(`.sa-avatar-option[onclick*="'${avatarId}'"]`);
  if (selectedEl) selectedEl.classList.add('selected');

  document.getElementById('upAvatarCurrentImg').src = `/static/avatars/${avatarId}.svg`;
  document.getElementById('upAvatarCurrentName').textContent = `Character: ${avatarId.replace('_', ' ').toUpperCase()}`;

  const userId = document.getElementById('upId').value;
  if (userId) {
    await apiPost(`/super-admin/users/${userId}/avatar`, { avatar_id: avatarId, profile_picture: null });
    showToast('Avatar character updated!', 'success');
  }
}

async function uploadUserProfilePicture(input) {
  if (!input.files || !input.files[0]) return;
  const userId = document.getElementById('upId').value;
  if (!userId) return;

  const formData = new FormData();
  formData.append('picture', input.files[0]);

  try {
    const res = await fetch(`/super-admin/users/${userId}/upload-picture`, {
      method: 'POST',
      body: formData
    });
    const d = await res.json();
    if (d.success && d.profile_picture) {
      document.getElementById('upAvatarCurrentImg').src = d.profile_picture;
      document.getElementById('upAvatarCurrentName').textContent = 'Custom Profile Picture';
      showToast('Profile picture uploaded successfully!', 'success');
      loadUsers(_usersPage);
    } else {
      showToast(d.error || 'Upload failed', 'error');
    }
  } catch (err) {
    showToast('Upload error: ' + err.message, 'error');
  }
}

