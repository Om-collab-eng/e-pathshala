  const d = await apiPost(`/super-admin/users/${id}/status`, { action });
  if (d.success) {
    showToast(d.message || 'Status updated', 'success');
    loadUsers(_usersPage);
  } else {
    showToast(d.error || 'Action failed', 'error');
