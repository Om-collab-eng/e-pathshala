<%- layout("base") %>

<style>
/* ═══════════════════════════════════════════════
   SUPER ADMIN DASHBOARD — MASTER RESPONSIVE DESIGN
   Complete Theme Isolation & Zero Layout Shifts
═══════════════════════════════════════════════ */
html, body {
  background: #060d1f !important;
  background-color: #060d1f !important;
  color: #f1f5f9 !important;
  margin: 0 !important;
  padding: 0 !important;
  padding-top: 0 !important;
  overflow-x: hidden !important;
  width: 100% !important;
  max-width: 100vw !important;
  min-height: 100vh !important;
}

.sa-page-wrapper {
  background: #060d1f !important;
  min-height: 100vh;
  width: 100vw;
  max-width: 100vw;
  overflow-x: hidden;
  position: relative;
  font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  color: #f1f5f9;
}

.sa-layout {
  display: flex;
  min-height: 100vh;
  width: 100%;
  max-width: 100vw;
  overflow-x: hidden;
}

/* ── SIDEBAR ── */
.sa-sidebar {
  width: 260px;
  max-width: 85vw; /* 80-85% screen width max on mobile */
  background: #080f22;
  border-right: 1px solid rgba(99, 102, 241, 0.14);
  display: flex;
  flex-direction: column;
  position: fixed;
  top: 0;
  left: 0;
  height: 100vh;
  height: 100dvh;
  z-index: 9999;
  transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
  overflow: hidden;
  box-shadow: 4px 0 24px rgba(0, 0, 0, 0.4);
}

.sa-sidebar-brand {
  padding: 1.1rem 1.2rem 0.9rem;
  border-bottom: 1px solid rgba(99, 102, 241, 0.12);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sa-brand-logo {
  display: flex;
  align-items: center;
  gap: 10px;
}

.sa-brand-icon {
  width: 38px;
  height: 38px;
  background: linear-gradient(135deg, #6366f1, #a855f7);
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.15rem;
  flex-shrink: 0;
  box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
}

.sa-brand-text h2 {
  font-family: 'Outfit', sans-serif;
  font-size: 1rem;
  font-weight: 900;
  margin: 0;
  background: linear-gradient(135deg, #818cf8, #c084fc);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.sa-brand-text p {
  font-size: 0.67rem;
  color: #475569;
  margin: 1px 0 0;
  font-weight: 600;
}

.sa-sidebar-close-mob {
  display: none;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: #94a3b8;
  width: 36px;
  height: 36px;
  border-radius: 9px;
  align-items: center;
  justify-content: center;
  font-size: 1.1rem;
  cursor: pointer;
}
.sa-sidebar-close-mob:active { background: rgba(239, 68, 68, 0.2); color: #f87171; }

.sa-nav {
  flex: 1;
  overflow-y: auto;
  padding: 0.75rem 0.6rem;
  scrollbar-width: thin;
  scrollbar-color: rgba(99, 102, 241, 0.2) transparent;
  -webkit-overflow-scrolling: touch;
}
.sa-nav::-webkit-scrollbar { width: 4px; }
.sa-nav::-webkit-scrollbar-thumb { background: rgba(99, 102, 241, 0.2); border-radius: 4px; }

/* Collapsible / Group section headers */
.sa-nav-section-title {
  font-size: 0.64rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 1.2px;
  color: #475569;
  padding: 0.7rem 0.7rem 0.35rem;
  margin-top: 0.5rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;
  user-select: none;
  transition: color 0.15s ease;
}
.sa-nav-section-title:first-child { margin-top: 0; }
.sa-nav-section-title:hover { color: #818cf8; }
.sa-nav-group {
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.sa-nav-group.collapsed {
  display: none;
}

.sa-nav-link {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 12px;
  min-height: 44px; /* 44px touch target */
  border-radius: 10px;
  color: #94a3b8;
  font-size: 0.83rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  margin-bottom: 2px;
  border: 1px solid transparent;
  background: none;
  width: 100%;
  text-align: left;
  white-space: nowrap;
  text-decoration: none;
  box-sizing: border-box;
}
.sa-nav-link:hover {
  background: rgba(99, 102, 241, 0.1);
  color: #a5b4fc;
}
.sa-nav-link.active {
  background: linear-gradient(135deg, rgba(99, 102, 241, 0.24), rgba(168, 85, 247, 0.14));
  color: #a5b4fc;
  border-left: 3.5px solid #818cf8;
  border-color: rgba(99, 102, 241, 0.25);
  font-weight: 700;
}
.sa-nav-icon {
  font-size: 1.05rem;
  min-width: 20px;
  text-align: center;
}

.sa-sidebar-footer {
  padding: 0.85rem;
  border-top: 1px solid rgba(99, 102, 241, 0.12);
  flex-shrink: 0;
  background: #080f22;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.sa-user-chip {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 8px 10px;
  background: rgba(99, 102, 241, 0.08);
  border-radius: 11px;
  border: 1px solid rgba(99, 102, 241, 0.14);
}
.sa-avatar {
  width: 32px;
  height: 32px;
  background: linear-gradient(135deg, #6366f1, #a855f7);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.75rem;
  font-weight: 900;
  color: #fff;
  flex-shrink: 0;
}
.sa-user-name {
  font-size: 0.78rem;
  font-weight: 700;
  color: #e2e8f0;
  line-height: 1.2;
}
.sa-user-role {
  font-size: 0.65rem;
  color: #6366f1;
  font-weight: 700;
}

/* Semi-transparent dark overlay for mobile */
.sa-overlay-dim {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.35);
  
  
  z-index: 9998;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.28s cubic-bezier(0.4, 0, 0.2, 1);
}
.sa-overlay-dim.active {
  opacity: 1;
  pointer-events: auto;
}

/* ── MAIN CONTENT ── */
.sa-main {
  margin-left: 260px;
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  width: calc(100vw - 260px);
  max-width: 100vw;
  overflow-x: hidden;
}
.sa-topbar {
  background: rgba(8, 15, 34, 0.92);
  
  
  border-bottom: 1px solid rgba(99, 102, 241, 0.12);
  padding: 0.85rem 1.5rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: sticky;
  top: 0;
  z-index: 100;
  gap: 12px;
}
.sa-topbar-left {
  display: flex;
  align-items: center;
  gap: 12px;
}
.sa-mob-toggle {
  display: none;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: #e2e8f0;
  font-size: 1.2rem;
  cursor: pointer;
  padding: 8px 12px;
  border-radius: 10px;
  min-height: 44px;
  min-width: 44px;
  align-items: center;
  justify-content: center;
}
.sa-breadcrumbs {
  font-size: 0.72rem;
  color: #64748b;
  font-weight: 600;
  margin-bottom: 2px;
}
.sa-topbar-title {
  font-family: 'Outfit', sans-serif;
  font-size: 1.15rem;
  font-weight: 800;
  color: #fff;
  margin: 0;
}
.sa-topbar-right {
  display: flex;
  align-items: center;
  gap: 8px;
}
.sa-content {
  padding: 1.5rem;
  flex: 1;
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
  box-sizing: border-box;
}

/* ── TABS ── */
.sa-tab-pane { display: none; }
.sa-tab-pane.active { display: block; }

/* ── STAT CARDS ── */
.sa-stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(175px, 1fr));
  gap: 0.9rem;
  margin-bottom: 1.75rem;
}
.sa-stat-card {
  background: linear-gradient(145deg, #0d1630, #111c3a);
  border: 1px solid rgba(99, 102, 241, 0.14);
  border-radius: 16px;
  padding: 1.2rem 1.3rem;
  position: relative;
  overflow: hidden;
  cursor: default;
  transition: transform 0.2s, box-shadow 0.2s;
}
.sa-stat-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 28px rgba(99, 102, 241, 0.15);
}
.sa-stat-card::after {
  content: '';
  position: absolute;
  top: -24px;
  right: -24px;
  width: 72px;
  height: 72px;
  border-radius: 50%;
  background: var(--glow, rgba(99, 102, 241, 0.1));
  pointer-events: none;
}
.sa-stat-icon { font-size: 1.6rem; margin-bottom: 0.4rem; display: block; line-height: 1; }
.sa-stat-label { font-size: 0.67rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; color: #475569; }
.sa-stat-value { font-family: 'Outfit', sans-serif; font-size: 2rem; font-weight: 900; color: #fff; margin: 3px 0 0; line-height: 1; }
.sa-stat-sub { font-size: 0.72rem; color: #64748b; margin-top: 3px; }

/* ── CARDS ── */
.sa-card {
  background: linear-gradient(145deg, #0d1630, #111c3a);
  border: 1px solid rgba(99, 102, 241, 0.14);
  border-radius: 18px;
  margin-bottom: 1.2rem;
  overflow: hidden;
}
.sa-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1.1rem 1.4rem;
  border-bottom: 1px solid rgba(99, 102, 241, 0.08);
  flex-wrap: wrap;
  gap: 10px;
}
.sa-card-title { font-family: 'Outfit', sans-serif; font-size: 1rem; font-weight: 800; color: #fff; margin: 0; display: flex; align-items: center; gap: 8px; }
.sa-card-body { padding: 1.4rem; }
.sa-card-body-np { padding: 0; }

/* ── BUTTONS ── */
.sa-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 10px 16px;
  min-height: 44px; /* Accessible 44px touch target */
  border-radius: 10px;
  font-size: 0.82rem;
  font-weight: 700;
  cursor: pointer;
  border: none;
  transition: all 0.18s ease;
  text-decoration: none;
  white-space: nowrap;
  font-family: inherit;
  box-sizing: border-box;
}
.sa-btn:disabled { opacity: 0.5; cursor: not-allowed; }
.sa-btn-primary { background: linear-gradient(135deg, #6366f1, #4f46e5); color: #fff; box-shadow: 0 4px 14px rgba(99, 102, 241, 0.3); }
.sa-btn-primary:hover { box-shadow: 0 6px 20px rgba(99, 102, 241, 0.45); transform: translateY(-1px); }
.sa-btn-success { background: linear-gradient(135deg, #10b981, #059669); color: #fff; }
.sa-btn-success:hover { transform: translateY(-1px); }
.sa-btn-danger { background: linear-gradient(135deg, #ef4444, #dc2626); color: #fff; }
.sa-btn-danger:hover { transform: translateY(-1px); }
.sa-btn-warning { background: linear-gradient(135deg, #f59e0b, #d97706); color: #fff; }
.sa-btn-warning:hover { transform: translateY(-1px); }
.sa-btn-info { background: linear-gradient(135deg, #3b82f6, #2563eb); color: #fff; }
.sa-btn-ghost { background: rgba(255, 255, 255, 0.05); color: #94a3b8; border: 1px solid rgba(255, 255, 255, 0.08); }
.sa-btn-ghost:hover { background: rgba(255, 255, 255, 0.09); color: #e2e8f0; }
.sa-btn-sm { padding: 6px 12px; font-size: 0.78rem; min-height: 36px; border-radius: 8px; }
.sa-btn-xs { padding: 4px 10px; font-size: 0.72rem; min-height: 32px; border-radius: 6px; }

/* ── TABLE OVERFLOW & RESPONSIVENESS ── */
.sa-table-wrap {
  width: 100%;
  max-width: 100%;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  border-radius: 12px;
}
.sa-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.83rem;
  min-width: 600px;
}
.sa-table th {
  padding: 10px 13px;
  font-size: 0.65rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: #334155;
  border-bottom: 1px solid rgba(99, 102, 241, 0.1);
  white-space: nowrap;
  text-align: left;
  background: rgba(0, 0, 0, 0.2);
}
.sa-table td {
  padding: 10px 13px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.03);
  color: #94a3b8;
  vertical-align: middle;
}
.sa-table td:first-child { color: #e2e8f0; }
.sa-table tr:hover td { background: rgba(99, 102, 241, 0.04); }
.sa-table tr:last-child td { border-bottom: none; }
.sa-table-actions { display: flex; gap: 5px; flex-wrap: nowrap; }
.sa-col-check { width: 40px; }
input[type=checkbox].sa-check { width: 18px; height: 18px; accent-color: #6366f1; cursor: pointer; }

/* ── BADGES ── */
.badge { display: inline-block; padding: 3px 9px; border-radius: 20px; font-size: 0.68rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.3px; white-space: nowrap; }
.badge-indigo { background: rgba(99, 102, 241, 0.18); color: #a5b4fc; }
.badge-purple { background: rgba(168, 85, 247, 0.18); color: #d8b4fe; }
.badge-green { background: rgba(16, 185, 129, 0.18); color: #34d399; }
.badge-red { background: rgba(239, 68, 68, 0.18); color: #f87171; }
.badge-yellow { background: rgba(245, 158, 11, 0.18); color: #fbbf24; }
.badge-blue { background: rgba(59, 130, 246, 0.18); color: #93c5fd; }
.badge-gray { background: rgba(100, 116, 139, 0.18); color: #94a3b8; }

/* ── FILTERS / SEARCH ── */
.sa-toolbar { display: flex; align-items: center; gap: 8px; padding: 1rem 1.4rem; border-bottom: 1px solid rgba(99, 102, 241, 0.08); flex-wrap: wrap; }
.sa-search { display: flex; align-items: center; gap: 7px; background: rgba(255, 255, 255, 0.04); border: 1.5px solid rgba(99, 102, 241, 0.18); border-radius: 10px; padding: 8px 12px; flex: 1; min-width: 180px; min-height: 44px; }
.sa-search input { background: none; border: none; color: #e2e8f0; outline: none; font-size: 0.83rem; flex: 1; font-family: inherit; min-width: 80px; }
.sa-search input::placeholder { color: #334155; }
.sa-select { background: rgba(255, 255, 255, 0.04); border: 1.5px solid rgba(99, 102, 241, 0.18); border-radius: 10px; color: #e2e8f0; font-size: 0.83rem; padding: 8px 12px; min-height: 44px; font-family: inherit; outline: none; cursor: pointer; }
.sa-select option { background: #111c3a; }
.sa-input { width: 100%; padding: 10px 14px; min-height: 44px; background: rgba(255, 255, 255, 0.04); border: 1.5px solid rgba(99, 102, 241, 0.18); border-radius: 10px; color: #e2e8f0; font-size: 0.85rem; font-family: inherit; outline: none; transition: border-color 0.2s; box-sizing: border-box; }
.sa-input:focus, .sa-select:focus { border-color: #6366f1; background: rgba(99, 102, 241, 0.07); }
.sa-input::placeholder { color: #334155; }
.sa-textarea { width: 100%; padding: 10px 14px; background: rgba(255, 255, 255, 0.04); border: 1.5px solid rgba(99, 102, 241, 0.18); border-radius: 10px; color: #e2e8f0; font-size: 0.85rem; font-family: inherit; outline: none; resize: vertical; min-height: 90px; box-sizing: border-box; }
.sa-form-group { margin-bottom: 0.9rem; }
.sa-form-group label { display: block; font-size: 0.72rem; font-weight: 700; color: #64748b; margin-bottom: 5px; text-transform: uppercase; letter-spacing: 0.3px; }
.sa-form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.sa-form-row-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px; }

/* ── PAGINATION ── */
.sa-pagination { display: flex; align-items: center; gap: 6px; padding: 0.9rem 1.4rem; border-top: 1px solid rgba(99, 102, 241, 0.08); flex-wrap: wrap; }
.sa-page-info { font-size: 0.78rem; color: #475569; flex: 1; }
.sa-page-btn { background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(99, 102, 241, 0.15); color: #94a3b8; border-radius: 8px; padding: 6px 12px; min-height: 38px; font-size: 0.78rem; font-weight: 600; cursor: pointer; transition: all 0.15s; }
.sa-page-btn:hover, .sa-page-btn.active { background: rgba(99, 102, 241, 0.2); color: #a5b4fc; border-color: rgba(99, 102, 241, 0.3); }
.sa-page-btn:disabled { opacity: 0.35; cursor: not-allowed; }

/* ── BULK ACTION BAR ── */
.sa-bulk-bar { display: none; align-items: center; gap: 10px; background: rgba(99, 102, 241, 0.12); border: 1px solid rgba(99, 102, 241, 0.25); border-radius: 10px; padding: 10px 16px; margin-bottom: 12px; flex-wrap: wrap; }
.sa-bulk-bar.show { display: flex; }
.sa-bulk-count { font-size: 0.83rem; font-weight: 700; color: #a5b4fc; flex: 1; }

/* ── MODAL ── */
.sa-modal-overlay { position: fixed; inset: 0; background: rgba(15, 23, 42, 0.35);   z-index: 9999; display: none; align-items: center; justify-content: center; padding: 1.2rem; }
.sa-modal-overlay.open { display: flex; }
.sa-modal { background: #0d1630; border: 1px solid rgba(99, 102, 241, 0.22); border-radius: 20px; width: 100%; max-width: 540px; max-height: 92vh; overflow-y: auto; box-shadow: 0 30px 70px rgba(0, 0, 0, 0.6); }
.sa-modal-lg { max-width: 680px; }
.sa-modal-header { padding: 1.3rem 1.5rem 1rem; border-bottom: 1px solid rgba(99, 102, 241, 0.1); display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; background: #0d1630; z-index: 1; }
.sa-modal-header h3 { font-family: 'Outfit', sans-serif; font-size: 1.05rem; font-weight: 800; color: #fff; margin: 0; }
.sa-modal-body { padding: 1.2rem 1.5rem; }
.sa-modal-footer { padding: 0.9rem 1.5rem 1.4rem; display: flex; gap: 9px; justify-content: flex-end; border-top: 1px solid rgba(99, 102, 241, 0.08); }
.sa-close-btn { background: none; border: none; color: #475569; font-size: 1.3rem; cursor: pointer; padding: 4px; line-height: 1; transition: color 0.15s; min-width: 36px; min-height: 36px; display: inline-flex; align-items: center; justify-content: center; }
.sa-close-btn:hover { color: #fff; }

/* ── SKELETON ANIMATION ── */
.sa-skeleton {
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.03) 25%, rgba(255, 255, 255, 0.08) 50%, rgba(255, 255, 255, 0.03) 75%);
  background-size: 200% 100%;
  animation: skeletonPulse 1.5s infinite;
  border-radius: 6px;
  display: inline-block;
}
@keyframes skeletonPulse {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ── RESPONSIVE BREAKPOINTS ── */
@media (max-width: 600px) {
  .sa-sidebar {
    transform: translateX(-105%);
  }
  .sa-sidebar.open {
    transform: translateX(0);
    box-shadow: 20px 0 60px rgba(0, 0, 0, 0.8);
  }
  .sa-sidebar-close-mob {
    display: flex;
  }
  .sa-main {
    margin-left: 0 !important;
    width: 100vw !important;
    max-width: 100vw !important;
  }
  .sa-mob-toggle {
    display: flex;
  }
  .sa-content {
    padding: 1rem;
  }
  .sa-topbar {
    padding: 0.75rem 1rem;
  }
  .sa-toolbar {
    flex-direction: column;
    align-items: stretch;
    gap: 10px;
    padding: 0.8rem;
  }
  .sa-search, .sa-select {
    width: 100%;
    min-width: 100%;
  }
  .sa-form-row, .sa-form-row-3 {
    grid-template-columns: 1fr !important;
  }
  .sa-btn {
    min-height: 44px; /* Accessible touch target */
  }
}
@media (max-width: 480px) {
  .sa-stats-grid {
    grid-template-columns: 1fr !important;
  }
  .sa-quick-grid {
    grid-template-columns: repeat(2, 1fr) !important;
  }
}

/* ═══════════════════════════════════════════════
   PREVENT GLOBAL TABLE CARD BREAKAGE & WHITE SPACE
═══════════════════════════════════════════════ */
.sa-page-wrapper table,
.sa-page-wrapper thead,
.sa-page-wrapper tbody,
.sa-page-wrapper tfoot,
.sa-page-wrapper tr,
.sa-page-wrapper th,
.sa-page-wrapper td {
  display: table-cell !important;
}

.sa-page-wrapper table {
  display: table !important;
  width: 100% !important;
  border-collapse: collapse !important;
  border-spacing: 0 !important;
  margin: 0 !important;
  background: transparent !important;
}

.sa-page-wrapper thead {
  display: table-header-group !important;
  position: static !important;
  top: auto !important;
  left: auto !important;
}

.sa-page-wrapper tbody {
  display: table-row-group !important;
}

.sa-page-wrapper tr {
  display: table-row !important;
  margin-bottom: 0 !important;
  border: none !important;
  background: transparent !important;
  border-radius: 0 !important;
}

.sa-page-wrapper th {
  display: table-cell !important;
  padding: 10px 14px !important;
  font-size: 0.68rem !important;
  font-weight: 800 !important;
  text-transform: uppercase !important;
  letter-spacing: 0.5px !important;
  color: #64748b !important;
  border-bottom: 1px solid rgba(99, 102, 241, 0.12) !important;
  border-top: none !important;
  border-left: none !important;
  border-right: none !important;
  background: rgba(0, 0, 0, 0.3) !important;
  text-align: left !important;
  white-space: nowrap !important;
}

.sa-page-wrapper td {
  display: table-cell !important;
  padding: 10px 14px !important;
  position: static !important;
  padding-left: 14px !important;
  text-align: left !important;
  border-top: none !important;
  border-left: none !important;
  border-right: none !important;
  border-bottom: 1px solid rgba(255, 255, 255, 0.04) !important;
  border-radius: 0 !important;
  background: transparent !important;
  color: #94a3b8 !important;
  vertical-align: middle !important;
}

.sa-page-wrapper td:before {
  content: none !important;
  display: none !important;
}

.sa-page-wrapper tr:hover td {
  background: rgba(99, 102, 241, 0.06) !important;
}

.sa-table-wrap {
  width: 100% !important;
  max-width: 100% !important;
  overflow-x: auto !important;
  -webkit-overflow-scrolling: touch !important;
  border-radius: 12px;
  margin-bottom: 0.5rem;
}

</style>

