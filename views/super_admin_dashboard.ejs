  `;
}

function openCreateRoleModal() {
  document.getElementById('rbRoleId').value = '';
  document.getElementById('rbName').value = '';
  document.getElementById('rbSlug').value = '';
  document.getElementById('rbSlug').disabled = false;
  document.getElementById('rbDesc').value = '';
  document.getElementById('rbModalTitle').textContent = '🛡️ Create Custom Role & Permissions';
  document.getElementById('rbModalSubtitle').textContent = 'Define role key and select granular module permissions';

  fetchAndRenderPermissionsMatrix([]);
  openModal('roleBuilderModal');
}

async function openRoleModal(roleId) {
  try {
    const roleRes = await (await fetch(`/super-admin/api/roles/${roleId}`)).json();
    if (!roleRes.success || !roleRes.role) return showToast(roleRes.error || 'Failed to fetch role', 'error');

    const r = roleRes.role;
    document.getElementById('rbRoleId').value = r.id;
    document.getElementById('rbName').value = r.name;
    document.getElementById('rbSlug').value = r.slug;
    document.getElementById('rbSlug').disabled = !!r.is_system;
    document.getElementById('rbDesc').value = r.description || '';
    document.getElementById('rbModalTitle').textContent = `🛡️ Permissions Matrix: ${r.name}`;
    document.getElementById('rbModalSubtitle').textContent = `${r.is_system ? 'System Role (Slug locked)' : 'Custom Role'} • ${r.user_count || 0} assigned users`;

    const assignedIds = (r.permissions || []).map(p => p.id);
    await fetchAndRenderPermissionsMatrix(assignedIds);
    openModal('roleBuilderModal');
  } catch (err) {
    showToast('Error loading role: ' + err.message, 'error');
  }
}

async function fetchAndRenderPermissionsMatrix(assignedPermIds = []) {
  const container = document.getElementById('rbModulesWrap');
  container.innerHTML = '<div class="sa-loading"><span class="sa-spinner"></span>Loading permissions catalog...</div>';

  try {
    if (!Object.keys(_permissionsCatalog).length) {
      const permsRes = await (await fetch('/super-admin/api/permissions')).json();
      _permissionsCatalog = permsRes.modules || {};
    }

    const assignedSet = new Set(assignedPermIds);
    const moduleTitles = {
      users: '👥 Users Management',
      roles: '🛡️ Roles & Permissions Control',
      books: '📚 Books & Physical Library Catalog',
      digital: '🌐 Digital Content Vault',
      transactions: '📋 Transactions & Circulation',
      rfid: '🏷️ RFID & Inventory Management',
      categories: '📂 Categories & Subject Classifications',
      requests: '🙋 Book Requests & Acquisition',
      goals: '🎯 Reading Goals & Challenges',
      ads: '📢 Announcements & Display Ads',
      system: '⚙️ System, Backups & Maintenance'
    };

    let html = '';
    for (const [modKey, perms] of Object.entries(_permissionsCatalog)) {
      const modTitle = moduleTitles[modKey] || modKey.toUpperCase();
      const allSelected = perms.every(p => assignedSet.has(p.id));

      html += `
        <div class="sa-perm-module-card">
          <div class="sa-perm-module-header">
            <span>${modTitle}</span>
            <label style="font-size:.78rem;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;gap:4px">
              <input type="checkbox" onchange="toggleModulePerms('${modKey}', this.checked)" ${allSelected ? 'checked' : ''}> Select Module
            </label>
          </div>
          <div class="sa-perm-grid" data-module="${modKey}">
            ${perms.map(p => `
              <div class="sa-perm-item">
                <input type="checkbox" class="perm-cb perm-mod-${modKey}" value="${p.id}" id="perm_${p.id}" ${assignedSet.has(p.id) ? 'checked' : ''}>
                <label for="perm_${p.id}">
                  <strong>${p.name || p.code}</strong>
                  <small>${p.description || p.code}</small>
                </label>
              </div>
            `).join('')}
          </div>
        </div>
      `;
    }

    container.innerHTML = html;
  } catch (err) {
    container.innerHTML = `<p style="color:var(--danger)">Failed to load permissions catalog: ${err.message}</p>`;
  }
}

function toggleModulePerms(modKey, isChecked) {
  document.querySelectorAll(`.perm-mod-${modKey}`).forEach(cb => cb.checked = isChecked);
}

function toggleAllPerms(isChecked) {
  document.querySelectorAll('.perm-cb').forEach(cb => cb.checked = isChecked);
  document.querySelectorAll('.sa-perm-module-header input[type="checkbox"]').forEach(cb => cb.checked = isChecked);
}

async function saveRoleBuilder() {
  const roleId = document.getElementById('rbRoleId').value;
  const name = document.getElementById('rbName').value.trim();
  const slug = document.getElementById('rbSlug').value.trim();
  const description = document.getElementById('rbDesc').value.trim();

  if (!name) return showToast('Role display name is required', 'error');

  const selectedPermIds = [];
  document.querySelectorAll('.perm-cb:checked').forEach(cb => {
    selectedPermIds.push(parseInt(cb.value, 10));
  });

  const payload = { name, slug, description, permission_ids: selectedPermIds, status: 'active' };

  try {
    let res;
    if (roleId) {
      res = await apiPost(`/super-admin/api/roles/${roleId}/edit`, payload);
    } else {
      res = await apiPost('/super-admin/api/roles/create', payload);
    }

    if (res.success) {
      showToast(roleId ? 'Role permissions updated successfully!' : 'Custom role created successfully!', 'success');
      closeModal('roleBuilderModal');
      loadRolesCatalog();
    } else {
      showToast(res.error || 'Failed to save role', 'error');
    }
  } catch (err) {
    showToast('Error saving role: ' + err.message, 'error');
  }
}

function openCloneRoleModal(roleId, roleName) {
  document.getElementById('crSourceId').value = roleId;
  document.getElementById('crSourceName').textContent = roleName;
  document.getElementById('crNewName').value = `${roleName} (Copy)`;
  document.getElementById('crNewSlug').value = '';
  document.getElementById('crNewDesc').value = `Cloned from ${roleName}`;
  openModal('cloneRoleModal');
}

async function confirmCloneRole() {
  const sourceId = document.getElementById('crSourceId').value;
  const name = document.getElementById('crNewName').value.trim();
  const slug = document.getElementById('crNewSlug').value.trim();
  const description = document.getElementById('crNewDesc').value.trim();

  if (!name) return showToast('New role name is required', 'error');

  try {
    const res = await apiPost(`/super-admin/api/roles/${sourceId}/clone`, { name, slug, description });
    if (res.success) {
      closeModal('cloneRoleModal');
      showToast('Role cloned successfully!', 'success');
      loadRolesCatalog();
    } else {
      showToast(res.error || 'Clone failed', 'error');
    }
  } catch (err) {
    showToast('Error cloning role: ' + err.message, 'error');
  }
}

async function deleteRole(roleId, roleName) {
  if (!confirm(`Permanently delete custom role "${roleName}"? This cannot be undone.`)) return;
  try {
    const res = await apiPost(`/super-admin/api/roles/${roleId}/delete`, {});
    if (res.success) {
      showToast('Role deleted successfully', 'success');
      loadRolesCatalog();
    } else {
      showToast(res.error || 'Failed to delete role', 'error');
    }
  } catch (err) {
    showToast('Error deleting role: ' + err.message, 'error');
  }
}

