let _adsCache = [];
let _adSchoolsCache = [];
let _previewDevice = 'desktop';

async function loadAdsData() {
  const tbody = document.getElementById('adsTableBody');
  if (tbody) {
    tbody.innerHTML = `<tr><td colspan="9" style="text-align:center;padding:36px;color:#94a3b8"><span class="sa-spinner"></span> Loading advertisements...</td></tr>`;
  }

  try {
    const res = await apiGet('/super-admin/ads-data');
    if (!res.success) {
      if (tbody) tbody.innerHTML = `<tr><td colspan="9" style="text-align:center;padding:30px;color:#ef4444">Failed to load advertisements: ${res.error || 'Unknown error'}</td></tr>`;
      return;
    }

    _adsCache = res.advertisements || [];
    _adSchoolsCache = res.schools || [];

    // Populate school options in Create/Edit modal
    const schoolSelect = document.getElementById('adFormSchoolCode');
    if (schoolSelect) {
      schoolSelect.innerHTML = '<option value="">-- Choose School --</option>' +
        _adSchoolsCache.map(s => `<option value="${s.school_code}">${s.name} (${s.school_code})</option>`).join('');
    }

    // Populate KPI cards
    const stats = res.stats || {};
    const setVal = (id, val) => { const el = document.getElementById(id); if (el) el.textContent = val ?? 0; };
    setVal('adStatTotal', stats.total);
    setVal('adStatActive', stats.active);
    setVal('adStatScheduled', stats.scheduled);
    setVal('adStatExpired', (stats.expired || 0) + (stats.paused || 0));

    renderAdsTable(_adsCache);
  } catch (err) {
    console.error('loadAdsData error:', err);
    if (tbody) tbody.innerHTML = `<tr><td colspan="9" style="text-align:center;padding:30px;color:#ef4444">Error connecting to server</td></tr>`;
  }
}

function renderAdsTable(ads) {
  const tbody = document.getElementById('adsTableBody');
  if (!tbody) return;

  if (!ads || ads.length === 0) {
    tbody.innerHTML = `
      <tr>
        <td colspan="9" style="text-align:center;padding:48px 20px;color:#94a3b8">
          <div style="font-size:2rem;margin-bottom:8px;">📢</div>
          <div style="font-weight:700;font-size:1rem;color:#e2e8f0;">No Advertisements Found</div>
          <div style="font-size:0.8rem;margin-top:4px;margin-bottom:16px;">Create your first announcement or interesting fact to show in E-Library!</div>
          <button class="sa-btn sa-btn-primary sa-btn-sm" onclick="openCreateAdModal()">+ Create Advertisement</button>
        </td>
      </tr>`;
    return;
  }

  tbody.innerHTML = ads.map(ad => {
    const status = (ad.computed_status || ad.status || 'ACTIVE').toUpperCase();
    let badgeClass = 'badge-gray';
    if (status === 'ACTIVE') badgeClass = 'badge-green';
    else if (status === 'SCHEDULED') badgeClass = 'badge-yellow';
    else if (status === 'EXPIRED') badgeClass = 'badge-red';
    else if (status === 'PAUSED' || status === 'DRAFT') badgeClass = 'badge-gray';

    const type = (ad.type || 'BANNER').toUpperCase();
    let typeBadge = `<span class="badge badge-blue">🎨 Banner</span>`;
    let typeIcon = '📢';
    if (type === 'INTERESTING_FACT') {
      typeBadge = `<span class="badge badge-purple">💡 Fact</span>`;
      typeIcon = '💡';
    } else if (type === 'IMAGE') {
      typeBadge = `<span class="badge badge-blue">🖼️ Image</span>`;
      typeIcon = '🖼️';
    } else if (type === 'VIDEO') {
      typeBadge = `<span class="badge badge-indigo">🎥 Video</span>`;
      typeIcon = '🎥';
    } else if (type === 'TEXT') {
      typeBadge = `<span class="badge badge-gray">📝 Text</span>`;
      typeIcon = '📝';
    }

    const mediaSrc = ad.thumbnail_url || ad.media_url || ad.image_url;
    let thumbHtml = `
      <div style="width:48px;height:34px;border-radius:6px;background:${ad.bg_gradient || '#334155'};display:flex;align-items:center;justify-content:center;color:#fff;font-size:1.1rem;box-shadow:0 2px 5px rgba(0,0,0,0.2);">
        ${typeIcon}
      </div>`;
    if (mediaSrc) {
      thumbHtml = `
        <div style="width:48px;height:34px;border-radius:6px;overflow:hidden;background:#0f172a;border:1px solid rgba(255,255,255,0.1);display:flex;align-items:center;justify-content:center;">
          <img src="${mediaSrc}" alt="thumb" style="width:100%;height:100%;object-fit:cover;" onerror="this.onerror=null;this.parentElement.innerHTML='${typeIcon}';">
        </div>`;
    }

    const schoolLabel = (ad.target_type === 'SPECIFIC_SCHOOL' && ad.school_code) 
      ? `🏫 <span style="color:#60a5fa;font-weight:700;">${ad.school_code}</span>` 
      : `🌍 <span style="color:#94a3b8;">All Schools</span>`;

    const cleanDate = d => d ? String(d).slice(0, 16).replace('T', ' ') : '—';
    const scheduleStr = (ad.start_time || ad.end_time) 
      ? `<div style="font-size:0.75rem;line-height:1.3"><span>Start: ${cleanDate(ad.start_time)}</span><br><span style="opacity:0.75">End: ${cleanDate(ad.end_time)}</span></div>` 
      : `<span style="color:#64748b;font-size:0.75rem">Always Active</span>`;

    const titleText = ad.title || ad.content_text || 'Announcement';
    const subText = ad.content_text ? (ad.content_text.slice(0, 60) + (ad.content_text.length > 60 ? '...' : '')) : (ad.subtitle || '');

    const isCurrentlyPaused = status === 'PAUSED' || ad.is_active === 0;

    return `
      <tr>
        <td>${thumbHtml}</td>
        <td>
          <div style="font-weight:700;color:#f8fafc;font-size:0.88rem;max-width:280px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
            ${titleText}
          </div>
          <div style="font-size:0.74rem;color:#94a3b8;max-width:280px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:2px;">
            ${subText}
          </div>
          ${ad.category ? `<span style="font-size:0.68rem;background:rgba(124,58,237,0.15);color:#c084fc;padding:1px 6px;border-radius:4px;font-weight:700;margin-top:4px;display:inline-block;">${ad.category}</span>` : ''}
        </td>
        <td>${typeBadge}</td>
        <td><div style="font-size:0.8rem">${schoolLabel}</div></td>
        <td>${scheduleStr}</td>
        <td><span style="font-size:0.8rem;font-weight:700;color:#cbd5e1;">#${ad.display_order ?? 0}</span></td>
        <td><span class="badge ${badgeClass}">${status}</span></td>
        <td>
          <div style="font-size:0.75rem;color:#cbd5e1;line-height:1.4">
            <span>👁️ ${ad.impressions || 0}</span> · <span>👆 ${ad.clicks || 0}</span>
            <div style="font-weight:700;color:#38bdf8;">${ad.ctr || 0}% CTR</div>
          </div>
        </td>
        <td style="text-align:right">
          <div style="display:inline-flex;gap:4px">
            <button class="sa-btn sa-btn-ghost sa-btn-xs" title="Edit" onclick="openEditAdModal(${ad.id})">✏️</button>
            <button class="sa-btn sa-btn-ghost sa-btn-xs" title="${isCurrentlyPaused ? 'Resume' : 'Pause'}" onclick="toggleAdStatus(${ad.id})">${isCurrentlyPaused ? '▶' : '⏸'}</button>
            <button class="sa-btn sa-btn-danger sa-btn-xs" title="Delete" onclick="deleteAdItem(${ad.id})">🗑️</button>
          </div>
        </td>
      </tr>
    `;
  }).join('');
}

function filterAdsTable() {
  const q = (document.getElementById('adSearchInput')?.value || '').toLowerCase().trim();
  const typeF = document.getElementById('adTypeFilter')?.value || '';
  const statusF = document.getElementById('adStatusFilter')?.value || '';
  const schoolF = document.getElementById('adSchoolFilter')?.value || '';

  const filtered = _adsCache.filter(ad => {
    if (q) {
      const matchT = (ad.title || '').toLowerCase().includes(q);
      const matchC = (ad.content_text || '').toLowerCase().includes(q);
      const matchCat = (ad.category || '').toLowerCase().includes(q);
      const matchU = (ad.target_url || ad.destination_url || '').toLowerCase().includes(q);
      if (!matchT && !matchC && !matchCat && !matchU) return false;
    }
    if (typeF && (ad.type || 'BANNER').toUpperCase() !== typeF) return false;
    if (statusF && (ad.computed_status || ad.status || 'ACTIVE').toUpperCase() !== statusF) return false;
    if (schoolF && (ad.target_type || 'ALL_SCHOOLS').toUpperCase() !== schoolF) return false;
    return true;
  });

  renderAdsTable(filtered);
}

function onAdTypeChange() {
  const type = (document.getElementById('adFormType')?.value || 'BANNER').toUpperCase();
  const groupFactMeta = document.getElementById('groupFactMeta');
  const groupGradient = document.getElementById('groupAdGradient');
  const groupMedia = document.getElementById('groupAdMedia');
  const groupSubtitle = document.getElementById('groupAdSubtitle');
  const lblContentText = document.getElementById('lblAdContentText');
  const lblTitle = document.getElementById('lblAdTitle');
  const badge = document.getElementById('previewTypeBadge');

  if (badge) badge.textContent = type;

  if (type === 'INTERESTING_FACT') {
    if (groupFactMeta) groupFactMeta.style.display = 'flex';
    if (lblContentText) lblContentText.textContent = 'Educational Fact Body *';
    if (lblTitle) lblTitle.textContent = 'Catchy Header / Fact Title (e.g. "Did You Know?")';
    if (groupSubtitle) groupSubtitle.style.display = 'none';
  } else {
    if (groupFactMeta) groupFactMeta.style.display = 'none';
    if (lblContentText) lblContentText.textContent = 'Announcement / Description Body';
    if (lblTitle) lblTitle.textContent = 'Title / Headline *';
    if (groupSubtitle) groupSubtitle.style.display = 'block';
  }

  updateLiveAdPreview();
}

function onAdTargetTypeChange() {
