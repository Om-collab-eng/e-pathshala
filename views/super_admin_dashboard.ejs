// ═══════════════════════════════════════
//  PAGINATION HELPER
// ═══════════════════════════════════════
function renderPagination(containerId, page, total, limit, onPage) {
  const el = document.getElementById(containerId);
  if (!el) return;
  const totalPages = Math.ceil(total / limit);
  if (totalPages <= 1) { el.innerHTML = ''; return; }
  const start = (page-1)*limit+1, end = Math.min(page*limit, total);
  let html = `<div class="sa-page-info">Showing ${start}–${end} of ${total}</div>`;
  html += `<button class="sa-page-btn" onclick="${onPage}(${page-1})" ${page<=1?'disabled':''}>‹ Prev</button>`;
  const startP = Math.max(1, page-2), endP = Math.min(totalPages, page+2);
  for (let i=startP; i<=endP; i++) html += `<button class="sa-page-btn ${i===page?'active':''}" onclick="${onPage}(${i})">${i}</button>`;
  html += `<button class="sa-page-btn" onclick="${onPage}(${page+1})" ${page>=totalPages?'disabled':''}>Next ›</button>`;
  el.innerHTML = html;
}

