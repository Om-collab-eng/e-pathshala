                  <div style="font-size:.75rem;opacity:.85;margin-top:2px;"><%= ad.subtitle||'' %></div></div>
                  <span style="background:rgba(255,255,255,.2);padding:3px 10px;border-radius:7px;font-size:.72rem;font-weight:800;display:inline-block;margin-top:8px;"><%= ad.cta_text||'Learn More' %></span>
