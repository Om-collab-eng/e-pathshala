function openEditAdModal(id) {
  const ad = _adsCache.find(a => a.id === id);
  if (!ad) return showToast('Advertisement not found', 'error');

  const form = document.getElementById('adEditorForm');
  if (form) form.reset();

  document.getElementById('adEditId').value = ad.id;
  document.getElementById('adEditorModalTitle').textContent = `✏️ Edit Advertisement #${ad.id}`;
  document.getElementById('adFormType').value = (ad.type || 'BANNER').toUpperCase();
  document.getElementById('adFormSection').value = ad.target_section || 'all';
  document.getElementById('adFormTitle').value = ad.title || '';
  document.getElementById('adFormCategory').value = ad.category || '';
  document.getElementById('adFormSource').value = ad.source || '';
  document.getElementById('adFormContentText').value = ad.content_text || ad.description || '';
  document.getElementById('adFormSubtitle').value = ad.subtitle || '';
  document.getElementById('adFormMediaUrl').value = ad.media_url || ad.image_url || '';
  document.getElementById('adFormUrl').value = ad.destination_url || ad.target_url || '';
  document.getElementById('adFormCta').value = ad.cta_text || 'Explore Now';
  document.getElementById('adFormTargetType').value = (ad.target_type || 'ALL_SCHOOLS').toUpperCase();
  document.getElementById('adFormSchoolCode').value = ad.school_code || '';
  document.getElementById('adFormStart').value = (ad.start_time || '').toString().slice(0, 16);
  document.getElementById('adFormEnd').value = (ad.end_time || '').toString().slice(0, 16);
  document.getElementById('adFormOrder').value = ad.display_order ?? 0;
  document.getElementById('adFormStatus').value = (ad.status || 'ACTIVE').toUpperCase();
  document.getElementById('adFormGradient').value = ad.bg_gradient || 'linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%)';

  onAdTypeChange();
  onAdTargetTypeChange();
  setPreviewDevice('desktop');
  updateLiveAdPreview(ad.media_url || ad.image_url);

  openModal('adEditorModal');
}

async function handleAdFormSubmit(e) {
  e.preventDefault();
  const form = document.getElementById('adEditorForm');
  const formData = new FormData(form);
  const editId = document.getElementById('adEditId').value;
  const isEdit = Boolean(editId);

  const btn = document.getElementById('btnSaveAd');
  const origText = btn.textContent;
  btn.textContent = 'Saving...';
  btn.disabled = true;

  try {
    const url = isEdit ? `/super-admin/ads/edit/${editId}` : '/super-admin/ads/create';
    const res = await fetch(url, {
      method: 'POST',
      body: formData
    });
    const data = await res.json();

    if (data.success) {
      showToast(data.message || 'Saved successfully!', 'success');
      closeModal('adEditorModal');
      await loadAdsData();
    } else {
      showToast(data.error || 'Failed to save advertisement', 'error');
    }
  } catch (err) {
    console.error('Submit ad form error:', err);
    showToast('Network error saving advertisement', 'error');
  } finally {
    btn.textContent = origText;
    btn.disabled = false;
  }
}

async function toggleAdStatus(id) {
  try {
    const res = await apiPost(`/super-admin/ads/toggle/${id}`, {});
    if (res.success) {
      showToast(`Status updated to ${res.newStatus || 'new state'}`, 'success');
      await loadAdsData();
    } else {
      showToast(res.error || 'Failed to toggle status', 'error');
    }
  } catch (err) {
    showToast('Failed to toggle status', 'error');
  }
}

async function deleteAdItem(id) {
  if (!confirm('Are you sure you want to delete this advertisement?')) return;
  try {
    const res = await apiPost(`/super-admin/ads/delete/${id}`, {});
    if (res.success) {
      showToast('Advertisement deleted successfully', 'success');
      await loadAdsData();
    } else {
      showToast(res.error || 'Failed to delete advertisement', 'error');
    }
  } catch (err) {
    showToast('Failed to delete advertisement', 'error');
  }
}

