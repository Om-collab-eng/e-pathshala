<%- layout("base") %>

<style>
/* ═══════════════════════════════════════════════════════════════════
   LIBRIKA SUPER ADMIN PORTAL — ENTERPRISE DESIGN SYSTEM
   Modern SaaS + EdTech + Digital Library Control Center
   ═══════════════════════════════════════════════════════════════════ */
:root {
  --primary: #0B5ED7;
  --primary-dark: #084298;
  --primary-light: #EAF3FF;
  --indigo: #5B4BDB;
  --indigo-light: #EEF2FF;
  --success: #198754;
  --success-light: #E8F5E9;
  --warning: #F59E0B;
  --warning-light: #FEF3C7;
  --danger: #DC3545;
  --danger-light: #FFEBEE;
  --background: #F8FAFC;
  --surface: #FFFFFF;
  --surface-sub: #F1F5F9;
  --text-primary: #111827;
  --text-secondary: #667085;
  --text-muted: #9CA3AF;
  --border: #E5E7EB;
  --border-focus: #0B5ED7;
  --sidebar: #FFFFFF;
  --radius-sm: 8px;
  --radius-md: 14px;
  --radius-lg: 18px;
  --radius-xl: 24px;
  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.05);
  --shadow-md: 0 4px 18px rgba(16, 24, 40, 0.04), 0 1px 3px rgba(0, 0, 0, 0.02);
  --shadow-lg: 0 12px 32px rgba(16, 24, 40, 0.08);
}

*, *::before, *::after {
  box-sizing: border-box;
}

html, body {
  background: var(--background) !important;
  background-color: var(--background) !important;
  color: var(--text-primary) !important;
  margin: 0 !important;
  padding: 0 !important;
  padding-top: 0 !important;
  overflow-x: hidden !important;
  width: 100% !important;
  max-width: 100vw !important;
  min-height: 100vh !important;
  font-family: 'Inter', 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
  -webkit-font-smoothing: antialiased;
}

.sa-page-wrapper {
  background: var(--background) !important;
  min-height: 100vh;
  width: 100vw;
  max-width: 100vw;
  overflow-x: hidden;
  position: relative;
  font-family: 'Inter', 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  color: var(--text-primary);
}

.sa-layout {
  display: flex;
  min-height: 100vh;
  width: 100%;
  max-width: 100vw;
  overflow-x: hidden;
}

/* ── SIDEBAR (EXACTLY 9 PRIMARY MODULES) ── */
.sa-sidebar {
  width: 270px;
  max-width: 85vw;
  background: var(--sidebar);
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  position: fixed;
  top: 0;
  left: 0;
  height: 100vh;
  height: 100dvh;
  z-index: 1000;
  transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), margin-left 0.25s ease;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.sa-sidebar.collapsed {
  transform: translateX(-105%) !important;
}

.sa-sidebar-brand {
  padding: 1.25rem 1.4rem;
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sa-brand-logo {
  display: flex;
  align-items: center;
  gap: 12px;
}

.sa-brand-icon {
  width: 38px;
  height: 38px;
  background: linear-gradient(135deg, var(--primary), var(--indigo));
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.25rem;
  color: white;
  flex-shrink: 0;
  box-shadow: 0 4px 12px rgba(11, 94, 215, 0.25);
}

.sa-brand-text h2 {
  font-family: 'Outfit', 'Inter', sans-serif;
  font-size: 1.15rem;
  font-weight: 900;
  margin: 0;
  color: var(--text-primary);
  letter-spacing: -0.02em;
}

.sa-brand-text p {
  font-size: 0.68rem;
  color: var(--primary);
  margin: 2px 0 0;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.sa-sidebar-close-mob {
  display: none;
  background: var(--surface-sub);
  border: 1px solid var(--border);
  color: var(--text-secondary);
  width: 34px;
  height: 34px;
  border-radius: 8px;
  align-items: center;
  justify-content: center;
  font-size: 1rem;
  cursor: pointer;
}
.sa-sidebar-close-mob:active { background: var(--danger-light); color: var(--danger); }

.sa-nav {
  flex: 1;
  overflow-y: auto;
  padding: 1rem 0.75rem;
  scrollbar-width: thin;
  scrollbar-color: var(--border) transparent;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.sa-nav::-webkit-scrollbar { width: 4px; }
.sa-nav::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }

.sa-nav-item {
  display: flex;
  flex-direction: column;
}

.sa-nav-link {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 14px;
  min-height: 42px;
  border-radius: 10px;
  color: var(--text-secondary);
  font-size: 0.86rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.15s ease;
  border: 1px solid transparent;
  background: none;
  width: 100%;
  text-align: left;
  white-space: nowrap;
  text-decoration: none;
  box-sizing: border-box;
}
.sa-nav-link:hover {
  background: var(--surface-sub);
  color: var(--text-primary);
}
.sa-nav-link.active {
  background: var(--primary-light);
  color: var(--primary);
  font-weight: 700;
  border-color: rgba(11, 94, 215, 0.15);
}
.sa-nav-icon {
  font-size: 1.15rem;
  min-width: 22px;
  text-align: center;
  line-height: 1;
}
.sa-nav-label {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
}
.sa-nav-arrow {
  font-size: 0.95rem;
  color: var(--text-muted);
  transition: transform 0.2s ease;
}
.sa-nav-item.open .sa-nav-arrow {
  transform: rotate(90deg);
  color: var(--primary);
}

.sa-submenu {
  display: none;
  flex-direction: column;
  gap: 2px;
  margin-left: 32px;
  padding-left: 10px;
  border-left: 2px solid var(--border);
  margin-top: 4px;
  margin-bottom: 6px;
}
.sa-nav-item.open .sa-submenu {
  display: flex;
}
.sa-sub-link {
  display: flex;
  align-items: center;
  padding: 7px 12px;
  min-height: 34px;
  border-radius: 8px;
  color: var(--text-secondary);
  font-size: 0.82rem;
  font-weight: 600;
  text-align: left;
  background: none;
  border: none;
  cursor: pointer;
  transition: all 0.15s ease;
  text-decoration: none;
  width: 100%;
}
.sa-sub-link:hover {
  color: var(--primary);
  background: var(--surface-sub);
}
.sa-sub-link.active {
  color: var(--primary);
  background: var(--primary-light);
  font-weight: 700;
}

.sa-sidebar-footer {
  padding: 1rem 1.1rem;
  border-top: 1px solid var(--border);
  flex-shrink: 0;
  background: var(--sidebar);
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.sa-user-chip {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 10px;
  background: var(--surface-sub);
  border-radius: 12px;
  border: 1px solid var(--border);
}
.sa-avatar {
  width: 34px;
  height: 34px;
  background: linear-gradient(135deg, var(--primary), var(--indigo));
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.78rem;
  font-weight: 900;
  color: #fff;
  flex-shrink: 0;
}
.sa-avatar-sm {
  width: 28px;
  height: 28px;
  font-size: 0.7rem;
}
.sa-user-meta {
  flex: 1;
  min-width: 0;
}
.sa-user-name {
  font-size: 0.82rem;
  font-weight: 700;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.2;
}
.sa-user-role {
  font-size: 0.7rem;
  color: var(--primary);
  font-weight: 700;
}
.sa-logout-btn {
  color: var(--text-muted);
  text-decoration: none;
  font-size: 1.1rem;
  padding: 4px;
  border-radius: 6px;
  transition: all 0.15s ease;
}
.sa-logout-btn:hover {
  color: var(--danger);
  background: var(--danger-light);
}

.sa-overlay-dim {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.4);
  backdrop-filter: blur(2px);
  z-index: 999;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease;
}
.sa-overlay-dim.active {
  opacity: 1;
  pointer-events: auto;
}

/* ── MAIN CONTENT ── */
.sa-main {
  margin-left: 270px;
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  width: calc(100vw - 270px);
  max-width: 100vw;
  overflow-x: hidden;
  transition: margin-left 0.25s ease, width 0.25s ease;
}

.sa-main.expanded {
  margin-left: 0 !important;
  width: 100vw !important;
}

/* ── STICKY TOPBAR HEADER ── */
.sa-topbar {
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  padding: 0.9rem 1.8rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: sticky;
  top: 0;
  z-index: 100;
  gap: 16px;
  box-shadow: var(--shadow-sm);
}
.sa-topbar-left {
  display: flex;
  align-items: center;
  gap: 14px;
  min-width: 0;
}
.sa-mob-toggle {
  display: none;
  background: var(--surface-sub);
  border: 1px solid var(--border);
  color: var(--text-primary);
  font-size: 1.2rem;
  cursor: pointer;
  padding: 8px 12px;
  border-radius: 10px;
  min-height: 38px;
  min-width: 38px;
  align-items: center;
  justify-content: center;
  transition: all 0.15s ease;
}
.sa-mob-toggle:hover {
  background: var(--primary-light);
  color: var(--primary);
  border-color: rgba(11, 94, 215, 0.2);
}
.sa-breadcrumbs {
  font-size: 0.75rem;
  color: var(--text-secondary);
  font-weight: 600;
  margin-bottom: 2px;
}
.sa-topbar-title {
  font-family: 'Outfit', 'Inter', sans-serif;
  font-size: 1.2rem;
  font-weight: 800;
  color: var(--text-primary);
  margin: 0;
  letter-spacing: -0.01em;
}

.sa-topbar-center {
  flex: 1;
  max-width: 440px;
  margin: 0 12px;
}
.sa-search-wrap {
  display: flex;
  align-items: center;
  gap: 10px;
  background: var(--surface-sub);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 0 14px;
  height: 40px;
  width: 100%;
  transition: all 0.15s ease;
}
.sa-search-wrap:focus-within {
  border-color: var(--primary);
  background: #FFFFFF;
  box-shadow: 0 0 0 3px rgba(11, 94, 215, 0.12);
}
.sa-search-icon {
  font-size: 0.95rem;
  color: var(--text-muted);
}
.sa-global-search {
  background: none;
  border: none;
  outline: none;
  color: var(--text-primary);
  font-size: 0.85rem;
  font-family: inherit;
  width: 100%;
}
.sa-global-search::placeholder {
  color: var(--text-muted);
}

.sa-topbar-right {
  display: flex;
  align-items: center;
  gap: 10px;
}
.sa-btn-icon {
  width: 38px;
  height: 38px;
  border-radius: 10px;
  border: 1px solid var(--border);
  background: var(--surface);
  color: var(--text-secondary);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.15s ease;
  position: relative;
  font-size: 1rem;
}
.sa-btn-icon:hover {
  background: var(--surface-sub);
  color: var(--text-primary);
  border-color: #D1D5DB;
}
.sa-badge-dot {
  position: absolute;
  top: 7px;
  right: 7px;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--danger);
  border: 1.5px solid #FFFFFF;
}

.sa-content {
  padding: 1.8rem;
  flex: 1;
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
  box-sizing: border-box;
}

/* ── TABS & PANES ── */
.sa-tab-pane { display: none; }
.sa-tab-pane.active { display: block; animation: saFadeIn 0.2s ease-out; }

@keyframes saFadeIn {
  from { opacity: 0; transform: translateY(4px); }
  to { opacity: 1; transform: translateY(0); }
}

/* ── IN-PAGE SEGMENTED TAB CONTROLS ── */
.sa-segmented-nav {
  display: inline-flex;
  align-items: center;
  background: var(--surface-sub);
  padding: 4px;
  border-radius: 12px;
  border: 1px solid var(--border);
  gap: 4px;
  margin-bottom: 22px;
  flex-wrap: wrap;
}
.sa-seg-pill {
  padding: 8px 16px;
  border-radius: 9px;
  font-size: 0.84rem;
  font-weight: 700;
  color: var(--text-secondary);
  background: transparent;
  border: none;
  cursor: pointer;
  transition: all 0.15s ease;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}
.sa-seg-pill:hover {
  color: var(--text-primary);
}
.sa-seg-pill.active {
  background: #FFFFFF;
  color: var(--primary);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

.sa-scope-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
  gap: 8px;
  margin-top: 6px;
}
.sa-scope-btn {
  padding: 10px 14px;
  border-radius: var(--radius-sm);
  font-size: 0.82rem;
  font-weight: 700;
  color: var(--text-secondary);
  background: var(--surface-sub);
  border: 1.5px solid var(--border);
  cursor: pointer;
  transition: all 0.15s ease;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
}
.sa-scope-btn:hover {
  background: #E2E8F0;
  color: var(--text-primary);
}
.sa-scope-btn.active {
  background: var(--primary-light);
  color: var(--primary);
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(11, 94, 215, 0.12);
}

/* ── STAT / KPI CARDS ── */
.sa-stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 1.1rem;
  margin-bottom: 2rem;
}
.sa-stat-card {
  background: #FFFFFF;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 20px 22px;
  box-shadow: var(--shadow-md);
  position: relative;
  overflow: hidden;
  cursor: pointer;
  transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
}
.sa-stat-card:hover {
  transform: translateY(-2px);
  border-color: rgba(11, 94, 215, 0.4);
  box-shadow: var(--shadow-lg);
}
.sa-stat-icon {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  background: var(--primary-light);
  color: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.35rem;
  margin-bottom: 12px;
}
.sa-stat-label {
  font-size: 0.78rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--text-secondary);
}
.sa-stat-value {
  font-family: 'Outfit', 'Inter', sans-serif;
  font-size: 2rem;
  font-weight: 900;
  color: var(--text-primary);
  margin: 4px 0 0;
  line-height: 1.1;
  letter-spacing: -0.02em;
}
.sa-stat-sub {
  font-size: 0.76rem;
  color: var(--text-secondary);
  margin-top: 6px;
  display: flex;
  align-items: center;
  gap: 4px;
}

/* ── CARDS ── */
.sa-card {
  background: #FFFFFF;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
  margin-bottom: 1.5rem;
  overflow: hidden;
  transition: box-shadow 0.2s ease;
}
.sa-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1.2rem 1.6rem;
  border-bottom: 1px solid var(--border);
  flex-wrap: wrap;
  gap: 12px;
  background: #FFFFFF;
}
.sa-card-title {
  font-family: 'Outfit', 'Inter', sans-serif;
  font-size: 1.08rem;
  font-weight: 800;
  color: var(--text-primary);
  margin: 0;
  display: flex;
  align-items: center;
  gap: 8px;
  letter-spacing: -0.01em;
}
.sa-card-body { padding: 1.6rem; }
.sa-card-body-np { padding: 0; }

/* ── BUTTONS ── */
.sa-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 9px 16px;
  min-height: 40px;
  border-radius: var(--radius-sm);
  font-size: 0.84rem;
  font-weight: 700;
  cursor: pointer;
  border: 1px solid transparent;
  transition: all 0.15s ease;
  text-decoration: none;
  white-space: nowrap;
  font-family: inherit;
  box-sizing: border-box;
}
.sa-btn:disabled { opacity: 0.5; cursor: not-allowed; }
.sa-btn-primary {
  background: var(--primary);
  color: #FFFFFF;
  box-shadow: 0 2px 6px rgba(11, 94, 215, 0.25);
}
.sa-btn-primary:hover {
  background: var(--primary-dark);
  transform: translateY(-1px);
}
.sa-btn-success { background: var(--success); color: #fff; }
.sa-btn-success:hover { background: #146c43; transform: translateY(-1px); }
.sa-btn-danger { background: var(--danger); color: #fff; }
.sa-btn-danger:hover { background: #b02a37; transform: translateY(-1px); }
.sa-btn-warning { background: var(--warning); color: #111827; }
.sa-btn-warning:hover { background: #d97706; color:#fff; transform: translateY(-1px); }
.sa-btn-info { background: #0284C7; color: #fff; }
.sa-btn-secondary {
  background: var(--surface-sub);
  color: var(--text-primary);
  border: 1px solid var(--border);
}
.sa-btn-secondary:hover {
  background: #E2E8F0;
}
.sa-btn-ghost {
  background: transparent;
  color: var(--text-secondary);
  border: 1px solid var(--border);
}
.sa-btn-ghost:hover {
  background: var(--surface-sub);
  color: var(--text-primary);
}
.sa-btn-sm { padding: 6px 12px; font-size: 0.78rem; min-height: 34px; border-radius: 8px; }
.sa-btn-xs { padding: 4px 10px; font-size: 0.72rem; min-height: 30px; border-radius: 6px; }

/* ── TABLE OVERFLOW & STYLES ── */
.sa-table-wrap {
  width: 100%;
  max-width: 100%;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  border-radius: 12px;
}
.sa-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.85rem;
  min-width: 650px;
}
.sa-table th {
  padding: 12px 16px;
  font-size: 0.72rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--text-secondary);
  border-bottom: 1px solid var(--border);
  white-space: nowrap;
  text-align: left;
  background: var(--surface-sub);
}
.sa-table td {
  padding: 14px 16px;
  border-bottom: 1px solid var(--border);
  color: var(--text-primary);
  vertical-align: middle;
}
.sa-table tr:hover td {
  background: var(--surface-sub);
}
.sa-table tr:last-child td { border-bottom: none; }
.sa-table-actions { display: flex; gap: 6px; flex-wrap: nowrap; }
.sa-col-check { width: 40px; }
input[type=checkbox].sa-check { width: 18px; height: 18px; accent-color: var(--primary); cursor: pointer; }

/* ── BADGES ── */
.badge {
  display: inline-flex;
  align-items: center;
  padding: 4px 10px;
  border-radius: 20px;
  font-size: 0.72rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  white-space: nowrap;
}
.badge-indigo { background: var(--indigo-light); color: var(--indigo); }
.badge-purple { background: #F5F3FF; color: #7C3AED; }
.badge-green { background: var(--success-light); color: var(--success); }
.badge-red { background: var(--danger-light); color: var(--danger); }
.badge-yellow { background: var(--warning-light); color: #B45309; }
.badge-blue { background: var(--primary-light); color: var(--primary); }
.badge-gray { background: var(--surface-sub); color: var(--text-secondary); }

/* ── FILTERS / SEARCH ── */
.sa-toolbar {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 1.1rem 1.6rem;
  border-bottom: 1px solid var(--border);
  flex-wrap: wrap;
  background: #FFFFFF;
}
.sa-search {
  display: flex;
  align-items: center;
  gap: 8px;
  background: var(--surface-sub);
  border: 1.5px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 0 12px;
  flex: 1;
  min-width: 200px;
  height: 42px;
}
.sa-search input {
  background: none;
  border: none;
  color: var(--text-primary);
  outline: none;
  font-size: 0.85rem;
  flex: 1;
