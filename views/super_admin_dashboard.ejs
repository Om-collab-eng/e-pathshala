function updateLiveAdPreview(localBlobUrl = null, isVideo = false) {
  const type = (document.getElementById('adFormType')?.value || 'BANNER').toUpperCase();
  const title = document.getElementById('adFormTitle')?.value || '';
  const content = document.getElementById('adFormContentText')?.value || '';
  const sub = document.getElementById('adFormSubtitle')?.value || '';
  const cat = document.getElementById('adFormCategory')?.value || '';
  const cta = document.getElementById('adFormCta')?.value || (type === 'INTERESTING_FACT' ? 'Read Fact' : 'Explore Now');
  const grad = document.getElementById('adFormGradient')?.value || 'linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%)';
  const mediaUrl = localBlobUrl || document.getElementById('adFormMediaUrl')?.value || '';

  const item = document.getElementById('adLivePreviewItem');
  const pTitle = document.getElementById('adPrevTitle');
  const pSub = document.getElementById('adPrevSub');
  const pCta = document.getElementById('adPrevCta');
  const pCat = document.getElementById('adPrevFactCategory');
  const pIcon = document.getElementById('adPrevIcon');
  const pMediaBox = document.getElementById('adPrevMediaBox');
  const pImg = document.getElementById('adPrevImg');
  const pVid = document.getElementById('adPrevVid');

  if (item) item.style.background = grad;
  if (pCta) pCta.textContent = cta ? `${cta} →` : 'View →';

  if (type === 'INTERESTING_FACT') {
    if (pIcon) pIcon.textContent = '💡';
    if (pCat) {
      pCat.style.display = 'inline-block';
      pCat.textContent = cat || 'DID YOU KNOW?';
    }
    if (pTitle) pTitle.textContent = title || 'Fascinating Fact';
    if (pSub) pSub.textContent = content || 'Educational facts expand student horizons and spark curiosity.';
  } else if (type === 'VIDEO') {
    if (pIcon) pIcon.textContent = '🎥';
    if (pCat) pCat.style.display = 'none';
    if (pTitle) pTitle.textContent = title || 'Featured Video / Reel';
    if (pSub) pSub.textContent = content || sub || 'Tap to watch short educational preview.';
  } else if (type === 'IMAGE') {
    if (pIcon) pIcon.textContent = '🖼️';
    if (pCat) pCat.style.display = 'none';
    if (pTitle) pTitle.textContent = title || 'Featured Visual';
    if (pSub) pSub.textContent = content || sub || 'Discover highlighted library collections.';
  } else if (type === 'TEXT') {
    if (pIcon) pIcon.textContent = '📝';
    if (pCat) pCat.style.display = 'none';
    if (pTitle) pTitle.textContent = title || 'Notice & Announcement';
    if (pSub) pSub.textContent = content || sub || 'Important notification for students and faculty.';
  } else {
    // BANNER
    if (pIcon) pIcon.textContent = '📢';
    if (pCat) pCat.style.display = 'none';
    if (pTitle) pTitle.textContent = title || 'Interactive Promotion';
    if (pSub) pSub.textContent = sub || content || 'Explore reading challenges and resources.';
  }

  // Handle media preview
  if (mediaUrl && pMediaBox) {
    pMediaBox.style.display = 'block';
    const isVidUrl = isVideo || mediaUrl.match(/\.(mp4|webm|mov)(\?.*)?$/i);
    if (isVidUrl) {
      if (pImg) pImg.style.display = 'none';
      if (pVid) {
        pVid.style.display = 'block';
        pVid.src = mediaUrl;
      }
    } else {
      if (pVid) pVid.style.display = 'none';
      if (pImg) {
        pImg.style.display = 'block';
        pImg.src = mediaUrl;
      }
    }
  } else if (pMediaBox) {
    pMediaBox.style.display = 'none';
  }
}

