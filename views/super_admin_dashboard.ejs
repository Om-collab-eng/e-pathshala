          <span class="sa-stat-chip sa-chip-valid" id="chipValidRows">Valid: 0</span>
          <span class="sa-stat-chip sa-chip-invalid" id="chipInvalidRows">Invalid: 0</span>
          <span class="sa-stat-chip sa-chip-duplicate" id="chipDuplicateRows">Duplicates: 0</span>
        </div>
        <div id="csvValidationErrorsWrap" style="display:none">
          <div style="color:var(--danger);font-weight:700;font-size:.82rem;margin-bottom:6px">⚠️ Invalid Rows Found (These will be skipped):</div>
          <div class="sa-table-wrap" style="max-height:220px;overflow-y:auto;border:1px solid var(--border);border-radius:8px">
            <table class="sa-table" style="font-size:.78rem">
              <thead><tr><th>Row #</th><th>Name</th><th>Mobile</th><th>Reason / Error</th></tr></thead>
              <tbody id="csvErrorsTableBody"></tbody>
            </table>
          </div>
        </div>
        <div id="csvValidPreviewNotice" style="margin-top:1rem;color:var(--success);font-weight:600;font-size:.85rem"></div>
      </div>

    </div>
    <div class="sa-modal-footer">
      <button class="sa-btn sa-btn-ghost" onclick="closeModal('userCsvImportModal')">Cancel</button>
      <button class="sa-btn sa-btn-secondary" id="btnCsvBack" style="display:none" onclick="backToCsvStep1()">← Back</button>
      <button class="sa-btn sa-btn-primary" id="btnCsvValidate" onclick="validateUserCsv()">Inspect & Validate CSV →</button>
      <button class="sa-btn sa-btn-success" id="btnCsvConfirm" style="display:none" onclick="confirmImportUserCsv()">✅ Confirm & Import Users</button>
    </div>
  </div>
</div>

