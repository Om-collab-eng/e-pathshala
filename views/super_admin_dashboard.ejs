<div class="sa-overlay-dim" id="saDim" onclick="closeSidebar()"></div>

<!-- ═══════════ MAIN ═══════════ -->
<div class="sa-main">
  <!-- Topbar -->
  <div class="sa-topbar">
    <div class="sa-topbar-left">
      <button class="sa-mob-toggle" onclick="toggleSidebar()">☰</button>
      <div>
        <div class="sa-breadcrumbs" id="saBreadcrumbs">Super Admin / Overview</div>
        <h1 class="sa-topbar-title" id="pageTitle">Dashboard</h1>
      </div>
    </div>
    <div class="sa-topbar-right">
        <button class="sa-btn sa-btn-xs sa-btn-primary" onclick="toggleAiChat()" style="font-weight: 700;">🤖 AI Chat</button>
      <button class="sa-btn sa-btn-ghost sa-btn-sm" onclick="refreshCurrentTab()" title="Refresh Tab">↻ Refresh</button>
      <a href="/logout" class="sa-btn sa-btn-danger sa-btn-sm">🚪 Logout</a>
    </div>
  </div>

  <div class="sa-content">
<div class="sa-tab-pane active" id="tab-dashboard">
      <div class="sa-stats-grid">
        <div class="sa-stat-card" style="--glow:rgba(99,102,241,.18)" onclick="switchTab('users',document.querySelector('[onclick*=\'users\']'))">
          <span class="sa-stat-icon">👥</span>
          <div class="sa-stat-label">Total Users</div>
          <div class="sa-stat-value"><%= stats.users %></div>
          <div class="sa-stat-sub">All roles & schools</div>
        </div>
        <div class="sa-stat-card" style="--glow:rgba(16,185,129,.15)" onclick="switchTab('schools',document.querySelector('[onclick*=\'schools\']'))">
          <span class="sa-stat-icon">🏫</span>
          <div class="sa-stat-label">Schools</div>
          <div class="sa-stat-value"><%= stats.schools %></div>
          <div class="sa-stat-sub">Registered institutions</div>
        </div>
        <div class="sa-stat-card" style="--glow:rgba(245,158,11,.15)" onclick="switchTab('books',document.querySelector('[onclick*=\'books\']'))">
          <span class="sa-stat-icon">📚</span>
          <div class="sa-stat-label">Total Books</div>
          <div class="sa-stat-value"><%= stats.books %></div>
          <div class="sa-stat-sub">Physical catalogue</div>
        </div>
        <div class="sa-stat-card" style="--glow:rgba(59,130,246,.15)" onclick="switchTab('transactions',document.querySelector('[onclick*=\'transactions\']'))">
          <span class="sa-stat-icon">📖</span>
          <div class="sa-stat-label">Active Borrows</div>
          <div class="sa-stat-value"><%= stats.active %></div>
          <div class="sa-stat-sub">Currently issued</div>
        </div>
        <div class="sa-stat-card" style="--glow:rgba(239,68,68,.15)" onclick="switchTab('transactions',document.querySelector('[onclick*=\'transactions\']'))">
          <span class="sa-stat-icon">⚠️</span>
          <div class="sa-stat-label">Overdue</div>
          <div class="sa-stat-value"><%= stats.overdue %></div>
          <div class="sa-stat-sub">Past due date</div>
        </div>
        <div class="sa-stat-card" style="--glow:rgba(245,158,11,.15)">
          <span class="sa-stat-icon">💸</span>
          <div class="sa-stat-label">Total Fines</div>
          <div class="sa-stat-value">₹<%= stats.fines.toLocaleString() %></div>
          <div class="sa-stat-sub">Accumulated fines</div>
        </div>
        <div class="sa-stat-card" style="--glow:rgba(168,85,247,.15)" onclick="switchTab('content',document.querySelector('[onclick*=\'content\']'))">
          <span class="sa-stat-icon">🌐</span>
          <div class="sa-stat-label">Digital Content</div>
          <div class="sa-stat-value"><%= stats.content %></div>
          <div class="sa-stat-sub">All uploads</div>
        </div>
        <div class="sa-stat-card" style="--glow:rgba(16,185,129,.15)" onclick="switchTab('ads',document.querySelector('[onclick*=\'ads\']'))">
          <span class="sa-stat-icon">📢</span>
          <div class="sa-stat-label">Active Ads</div>
          <div class="sa-stat-value"><%= stats.ads %></div>
          <div class="sa-stat-sub">Live banners</div>
        </div>
      </div>

      <div class="sa-quick-grid">
        <div class="sa-quick-card" onclick="openModal('createUserModal')"><div class="sa-quick-icon">➕</div><div class="sa-quick-label">Add User</div></div>
        <div class="sa-quick-card" onclick="openModal('createSchoolModal')"><div class="sa-quick-icon">🏫</div><div class="sa-quick-label">Add School</div></div>
        <div class="sa-quick-card" onclick="switchTab('notifications',document.querySelector('[onclick*=\'notifications\']'))"><div class="sa-quick-icon">📣</div><div class="sa-quick-label">Broadcast</div></div>
        <div class="sa-quick-card" onclick="switchTab('settings',document.querySelector('[onclick*=\'settings\']'))"><div class="sa-quick-icon">🛠</div><div class="sa-quick-label">Settings</div></div>
        <div class="sa-quick-card" onclick="switchTab('analytics',document.querySelector('[onclick*=\'analytics\']'))"><div class="sa-quick-icon">📈</div><div class="sa-quick-label">Analytics</div></div>
        <div class="sa-quick-card" onclick="window.location.href='/super-admin/export-report'"><div class="sa-quick-icon">📥</div><div class="sa-quick-label">Export CSV</div></div>
      </div>

      <% if (advertisements && advertisements.length) { %>
      <div class="sa-card">
        <div class="sa-card-header">
          <div class="sa-card-title">📢 Live Advertisements</div>
          <button class="sa-btn sa-btn-ghost sa-btn-sm" onclick="switchTab('ads',document.querySelector('[onclick*=\'ads\']'))">View All →</button>
        </div>
        <div class="sa-card-body-np">
          <div class="sa-table-wrap">
            <table class="sa-table">
              <thead><tr><th>Title</th><th>Section</th><th>Status</th><th>Views</th><th>Clicks</th><th>CTR</th></tr></thead>
              <tbody>
                <% advertisements.slice(0,6).forEach(ad => { %>
                <tr>
                  <td style="color:#e2e8f0;font-weight:600;"><%= ad.title %></td>
                  <td><span class="badge badge-blue"><%= ad.target_section %></span></td>
                  <td><span class="badge <%= ad.computed_status==='active'?'badge-green':ad.computed_status==='expired'?'badge-red':'badge-gray' %>"><%= ad.computed_status %></span></td>
                  <td><%= ad.impressions||0 %></td>
                  <td><%= ad.clicks||0 %></td>
                  <td><%= ad.ctr||0 %>%</td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
      <% } %>
    </div>

    <!-- ═══ TAB: SCHOOLS ═══ -->
    <div class="sa-tab-pane" id="tab-schools">
      <div class="sa-card">
        <div class="sa-card-header">
          <div class="sa-card-title">🏫 School Management</div>
          <button class="sa-btn sa-btn-primary sa-btn-sm" onclick="openModal('createSchoolModal')">+ Add School</button>
        </div>
        <div class="sa-toolbar">
          <div class="sa-search"><span>🔍</span><input type="text" id="schoolSearch" placeholder="Search name or code..." oninput="filterSchools()"></div>
          <select class="sa-select" id="schoolStatusFilter" onchange="filterSchools()">
            <option value="">All Status</option>
            <option value="active">Active</option>
            <option value="suspended">Suspended</option>
          </select>
        </div>
        <div id="schoolsBulkBar" class="sa-bulk-bar" style="margin:0 1.4rem">
          <span class="sa-bulk-count" id="schoolsBulkCount">0 selected</span>
          <button class="sa-btn sa-btn-danger sa-btn-sm" onclick="bulkDeleteSchools()">🗑️ Delete Selected</button>
        </div>
        <div id="schoolsTableWrap" class="sa-loading"><span class="sa-spinner"></span>Loading schools...</div>
        <div class="sa-pagination" id="schoolsPagination"></div>
      </div>
    </div>

    <!-- ═══ TAB: USERS ═══ -->
    <div class="sa-tab-pane" id="tab-users">
      <div class="sa-card">
        <div class="sa-card-header">
          <div class="sa-card-title">👥 User Management</div>
          <button class="sa-btn sa-btn-primary sa-btn-sm" onclick="openModal('createUserModal')">+ Add User</button>
        </div>
        <div class="sa-toolbar">
          <div class="sa-search" style="flex:2;"><span>🔍</span><input type="text" id="userSearch" placeholder="Name, phone, email, admission no..." oninput="debouncedLoadUsers()"></div>
          <select class="sa-select" id="userRoleFilter" onchange="loadUsers(1)">
            <option value="">All Roles</option>
            <option value="super_admin">Super Admin</option>
            <option value="admin">Admin</option>
            <option value="librarian">Librarian</option>
            <option value="teacher">Teacher</option>
            <option value="parent">Parent</option>
            <option value="student">Student</option>
          </select>
          <select class="sa-select" id="userBanFilter" onchange="loadUsers(1)">
            <option value="">All Status</option>
            <option value="false">Active</option>
            <option value="true">Banned</option>
          </select>
          <select class="sa-select" id="userSchoolFilter" onchange="loadUsers(1)">
            <option value="">All Schools</option>
          </select>
        </div>
        <div id="usersBulkBar" class="sa-bulk-bar" style="margin:0 1.4rem">
          <span class="sa-bulk-count" id="usersBulkCount">0 selected</span>
          <button class="sa-btn sa-btn-danger sa-btn-sm" onclick="bulkDeleteUsers()">🗑️ Delete</button>
          <button class="sa-btn sa-btn-warning sa-btn-sm" onclick="bulkBanUsers()">🚫 Ban</button>
          <button class="sa-btn sa-btn-success sa-btn-sm" onclick="bulkUnbanUsers()">✅ Unban</button>
        </div>
        <div id="usersTableWrap" class="sa-loading"><span class="sa-spinner"></span>Loading users...</div>
        <div class="sa-pagination" id="usersPagination"></div>
      </div>
    </div>

    <!-- ═══ TAB: BOOKS ═══ -->
    <div class="sa-tab-pane" id="tab-books">
      <div class="sa-card">
        <div class="sa-card-header">
          <div class="sa-card-title">📚 Book Management</div>
          <div style="display:flex;gap:6px">
            <label class="sa-btn sa-btn-ghost sa-btn-sm" style="cursor:pointer">📤 Bulk Upload<input type="file" id="bulkBookCsv" accept=".csv" style="display:none" onchange="bulkUploadBooks(this)"></label>
            <button class="sa-btn sa-btn-primary sa-btn-sm" onclick="openModal('createBookModal')">+ Add Book</button>
          </div>
        </div>
        <div class="sa-toolbar">
          <div class="sa-search"><span>🔍</span><input type="text" id="bookSearch" placeholder="Title, author, ISBN, barcode..." oninput="debouncedLoadBooks()"></div>
          <select class="sa-select" id="bookSchoolFilter" onchange="loadBooks(1)">
            <option value="">All Schools</option>
          </select>
          <select class="sa-select" id="bookBanFilter" onchange="loadBooks(1)">
            <option value="">All Status</option>
            <option value="false">Active</option>
            <option value="true">Banned</option>
          </select>
        </div>
        <div id="booksBulkBar" class="sa-bulk-bar" style="margin:0 1.4rem">
          <span class="sa-bulk-count" id="booksBulkCount">0 selected</span>
          <button class="sa-btn sa-btn-danger sa-btn-sm" onclick="bulkDeleteBooks()">🗑️ Delete</button>
        </div>
        <div id="booksTableWrap" class="sa-loading"><span class="sa-spinner"></span>Loading books...</div>
        <div class="sa-pagination" id="booksPagination"></div>
      </div>
    </div>

    <!-- ═══ TAB: TRANSACTIONS ═══ -->
    <div class="sa-tab-pane" id="tab-transactions">
      <div class="sa-card">
        <div class="sa-card-header">
          <div class="sa-card-title">📋 Transaction Management</div>
        </div>
        <div class="sa-toolbar">
          <select class="sa-select" id="txSchoolFilter" onchange="loadTransactions(1)"><option value="">All Schools</option></select>
          <select class="sa-select" id="txStatusFilter" onchange="loadTransactions(1)">
            <option value="">All Status</option>
            <option value="issued">Issued</option>
            <option value="returned">Returned</option>
            <option value="overdue">Overdue</option>
          </select>
        </div>
        <div id="txTableWrap" class="sa-loading"><span class="sa-spinner"></span>Loading...</div>
        <div class="sa-pagination" id="txPagination"></div>
      </div>
    </div>

    <!-- ═══ TAB: DIGITAL CONTENT ═══ -->
    <div class="sa-tab-pane" id="tab-content">
      <div class="sa-card">
        <div class="sa-card-header">
          <div class="sa-card-title">🌐 Digital Content Moderation</div>
          <button class="sa-btn sa-btn-primary sa-btn-sm" onclick="openModal('createDcModal')">+ Add Content</button>
        </div>
        <div class="sa-toolbar">
          <select class="sa-select" id="dcStatusFilter" onchange="loadDigitalContent(1)">
            <option value="">All Status</option>
            <option value="pending">Pending Review</option>
            <option value="approved">Approved</option>
            <option value="rejected">Rejected</option>
          </select>
          <select class="sa-select" id="dcSchoolFilter" onchange="loadDigitalContent(1)"><option value="">All Schools</option></select>
        </div>
        <div id="dcTableWrap" class="sa-loading"><span class="sa-spinner"></span>Loading...</div>
        <div class="sa-pagination" id="dcPagination"></div>
      </div>
    </div>

    <div class="sa-modal-overlay" id="createDcModal">
      <div class="sa-modal">
        <div class="sa-modal-header"><h3>🌐 Add Digital Content</h3><button class="sa-close-btn" onclick="closeModal('createDcModal')">✕</button></div>
        <div class="sa-modal-body">
          <div class="sa-form-group"><label>Title *</label><input type="text" class="sa-input" id="cdcTitle"></div>
          <div class="sa-form-row">
            <div class="sa-form-group"><label>Category</label><input type="text" class="sa-input" id="cdcCategory"></div>
            <div class="sa-form-group"><label>Subject</label><input type="text" class="sa-input" id="cdcSubject"></div>
          </div>
          <div class="sa-form-row">
            <div class="sa-form-group"><label>Class</label><input type="text" class="sa-input" id="cdcClass"></div>
            <div class="sa-form-group"><label>Tags</label><input type="text" class="sa-input" id="cdcTags" placeholder="comma, separated"></div>
          </div>
          <div class="sa-form-group"><label>File / External URL</label><input type="text" class="sa-input" id="cdcUrl" placeholder="https://... or /uploads/..."></div>
          <div class="sa-form-group"><label>School Code</label><input type="text" class="sa-input" id="cdcSchool" placeholder="Leave blank for all, or GLOBAL"></div>
          <div class="sa-form-group"><label>Description</label><textarea class="sa-textarea" id="cdcDesc" rows="2"></textarea></div>
        </div>
        <div class="sa-modal-footer">
          <button class="sa-btn sa-btn-ghost" onclick="closeModal('createDcModal')">Cancel</button>
          <button class="sa-btn sa-btn-primary" onclick="createDigitalContent()">✅ Add</button>
