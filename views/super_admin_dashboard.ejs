          <label>Or Paste CSV Text Directly</label>
          <textarea class="sa-textarea" id="csvTextarea" rows="6" placeholder="Full Name,Mobile Number,Email Address,Role,School / Organization,Class,Section,Admission No,Gender,Date of Birth&#10;Aarav Sharma,9876543210,aarav@school.org,Student,VBPS01,10,A,ADM001,male,2010-05-15"></textarea>
        </div>
      </div>

      <!-- Step 2: Validation Preview -->
      <div id="csvWizardStep2" style="display:none">
        <div style="font-weight:700;margin-bottom:8px">Step 2: Validation Breakdown & Preview</div>
        <div style="display:flex;gap:10px;margin-bottom:1.2rem;flex-wrap:wrap">
