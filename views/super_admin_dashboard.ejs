async function loadRolePerms() {
  try {
    const d = await (await fetch('/super-admin/role-permissions')).json();
    const perms = d.permissions || {};
    const roles = ['super_admin','admin','librarian','student','teacher','parent','personal'];
    document.getElementById('rolePermWrap').innerHTML = `
      <table class="sa-table">
        <thead><tr><th>Role</th><th>Permissions JSON</th><th>Actions</th></tr></thead>
        <tbody>${roles.map(r => `
          <tr>
            <td><span class="badge badge-indigo">${r}</span></td>
            <td><textarea class="sa-textarea" style="min-height:60px" id="rp-${r}">${JSON.stringify(perms[r] || {}, null, 2)}</textarea></td>
            <td><button class="sa-btn sa-btn-primary sa-btn-xs" onclick="saveRolePerm('${r}')">Save</button></td>
          </tr>`).join('')}
        </tbody>
      </table>`;
  } catch (e) { document.getElementById('rolePermWrap').innerHTML = '<p style="color:#f87171">Failed to load.</p>'; }
}
async function saveRolePerm(role) {
  const txt = document.getElementById('rp-' + role).value;
  try {
    let json;
    try { json = JSON.parse(txt); } catch (e) { return showToast('Invalid JSON', 'error'); }
    // Backend merges with existing config, so only send the role being saved.
    const d = await apiPost('/super-admin/role-permissions', { permissions: { [role]: json } });
    if (d.success) { showToast(`Saved ${role}`, 'success'); SA.rolePerms = { ...SA.rolePerms, [role]: json }; }
    else showToast(d.error || 'Failed', 'error');
  } catch (e) { showToast('Error: ' + e.message, 'error'); }
}

