function getRoleIcon(slug) {
  const s = String(slug || '').toLowerCase();
  const found = STANDARD_USER_ROLES.find(r => r.slug === s);
  return found ? found.icon : '🛡️';
}

function roleBadge(r) {
  const map = {
    'super_admin':'badge-yellow', 'admin':'badge-blue', 'school_admin':'badge-blue', 'librarian':'badge-green',
    'student':'badge-indigo', 'teacher':'badge-purple', 'parent':'badge-pink',
    'quiz_manager':'badge-yellow', 'content_manager':'badge-blue', 'personal':'badge-gray'
  };
  return map[String(r || '').toLowerCase()] || 'badge-gray';
}

function closeAllActionDropdowns() {
  document.querySelectorAll('.sa-action-dropdown-menu').forEach(m => m.style.display = 'none');
}

// Close action dropdown menus when clicking outside or when an action item is clicked
window.addEventListener('click', e => {
  if (e.target.closest('.sa-action-dropdown-item') || !e.target.closest('.sa-dropdown-wrap')) {
    closeAllActionDropdowns();
  }
});

function toggleActionDropdown(e, menuId) {
  e.stopPropagation();
  const menu = document.getElementById(menuId);
  const isOpen = menu && menu.style.display === 'block';
  closeAllActionDropdowns();
  if (menu && !isOpen) menu.style.display = 'block';
}

function clearUserFilters() {
  if (document.getElementById('userSearch')) document.getElementById('userSearch').value = '';
  if (document.getElementById('userRoleFilter')) document.getElementById('userRoleFilter').value = '';
  if (document.getElementById('userBanFilter')) document.getElementById('userBanFilter').value = '';
  if (document.getElementById('userSchoolFilter')) document.getElementById('userSchoolFilter').value = '';
  if (document.getElementById('userGenderFilter')) document.getElementById('userGenderFilter').value = '';
  loadUsers(1);
}

async function loadUsers(page = 1) {
  _usersPage = page;
  document.getElementById('usersTableWrap').innerHTML = '<div class="sa-loading"><span class="sa-spinner"></span>Loading users directory...</div>';
  const search = document.getElementById('userSearch')?.value || '';
  const role = document.getElementById('userRoleFilter')?.value || '';
  const status = document.getElementById('userBanFilter')?.value || '';
  const school = document.getElementById('userSchoolFilter')?.value || '';
  const gender = document.getElementById('userGenderFilter')?.value || '';

  // Ensure schools filter dropdown is populated
  populateSchoolDropdowns();

  const params = new URLSearchParams({ page, limit: 50 });
  if (search) params.set('search', search);
  if (role) params.set('role', role);
  if (status) params.set('status', status);
  if (school) params.set('school_code', school);
  if (gender) params.set('gender', gender);

  try {
    const r = await fetch('/super-admin/users?' + params);
    const d = await r.json();
    SA.users = d.users || [];
    _usersTotal = d.total || SA.users.length;
    renderUsersTable(SA.users);
    renderPagination('usersPagination', page, _usersTotal, 50, 'loadUsers');
  } catch(e) {
    document.getElementById('usersTableWrap').innerHTML = '<div class="sa-empty"><p style="color:var(--danger)">Failed to load users.</p></div>';
  }
}

function populateSchoolDropdowns() {
  const schoolFilter = document.getElementById('userSchoolFilter');
  const bulkSchool = document.getElementById('bulkTargetSchool');
  if (SA.schools && SA.schools.length > 0 && schoolFilter && schoolFilter.options.length <= 1) {
    SA.schools.forEach(s => {
      const code = s.school_code || s.code;
      const name = s.name || code;
      const opt = new Option(`${name} (${code})`, code);
      schoolFilter.add(opt);
      if (bulkSchool) bulkSchool.add(new Option(`${name} (${code})`, code));
    });
  }
}

