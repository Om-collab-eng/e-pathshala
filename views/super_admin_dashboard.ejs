  else showToast(d.error || 'Failed', 'error');
}
async function exitImpersonation() {
  const d = await apiPost('/super-admin/impersonate/exit', {});
  if (d.success) { showToast('Exited impersonation', 'success'); window.location.href = d.redirect || '/super-admin'; }
  else showToast(d.error || 'Failed', 'error');
}

