    const maxVal=Math.max(...Object.values(byRole),1);
    const roleLabels={'super_admin':'Super Admin','admin':'Admin','librarian':'Librarian','student':'Student','teacher':'Teacher'};
    document.getElementById('roleChart').innerHTML=Object.entries(byRole).map(([r,c])=>`
      <div class="sa-bar-row">
        <div class="sa-bar-label">${roleLabels[r]||r}</div>
        <div class="sa-bar-track"><div class="sa-bar-fill" style="width:${Math.round((c/maxVal)*100)}%"></div></div>
        <div class="sa-bar-count">${c}</div>
      </div>`).join('');
  }
  if(health && health.success){
    document.getElementById('healthGrid').innerHTML=`
      <div class="sa-health-item"><div class="sa-health-val sa-health-${health.db_status==='ok'?'ok':'err'}">${health.db_status==='ok'?'✓':'✗'}</div><div class="sa-health-label">Database</div></div>
      <div class="sa-health-item"><div class="sa-health-val">${Math.round(health.uptime_seconds/3600)}h</div><div class="sa-health-label">Uptime</div></div>
      <div class="sa-health-item"><div class="sa-health-val sa-health-${health.memory_mb>400?'warn':'ok'}">${health.memory_mb}MB</div><div class="sa-health-label">Memory</div></div>
      <div class="sa-health-item"><div class="sa-health-val">${health.sessions||0}</div><div class="sa-health-label">Sessions</div></div>
      <div class="sa-health-item"><div class="sa-health-val">${health.node_version||'?'}</div><div class="sa-health-label">Node</div></div>
      <div class="sa-health-item"><div class="sa-health-val">${health.total_logs||0}</div><div class="sa-health-label">Log Entries</div></div>
    `;
  }
}

