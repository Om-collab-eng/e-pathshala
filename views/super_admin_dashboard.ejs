            ${!r.is_system ? `
              <button class="sa-btn sa-btn-danger sa-btn-xs" onclick="deleteRole(${r.id}, '${(r.name||'').replace(/'/g,"\\'")}')" title="Delete Custom Role">🗑️</button>
