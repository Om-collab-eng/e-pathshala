function switchProfileTab(tab) {
  document.querySelectorAll('.sa-profile-nav-pill').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.sa-profile-pane').forEach(p => p.classList.remove('active'));
  
  const targetPane = document.getElementById('pane-up-' + tab);
  if (targetPane) targetPane.classList.add('active');
  const targetPill = document.querySelector(`.sa-profile-nav-pill[onclick*="'${tab}'"]`);
  if (targetPill) targetPill.classList.add('active');
}

async function openUserProfile(userId) {
  await openUserProfileTab(userId, 'basic');
}

async function openUserProfileTab(userId, initialTab = 'basic') {
  closeAllActionDropdowns();
  try {
    const r = await fetch(`/super-admin/users/${userId}/profile`);
    const d = await r.json();
    if (!d.success || !d.profile) return showToast(d.error || 'Failed to load profile', 'error');

    _currentProfileUser = d.profile;
    const u = d.profile;

    document.getElementById('upId').value = u.id;
    document.getElementById('upModalTitle').textContent = `👤 ${u.name || 'User Profile'}`;
    document.getElementById('upModalSubtitle').textContent = `User ID: #${u.id} • ${u.role_name || u.role} • ${u.school_name || 'Independent'}`;

    // Tab 1: Basic
    document.getElementById('upName').value = u.name || '';
    document.getElementById('upFirstName').value = u.first_name || '';
    document.getElementById('upLastName').value = u.last_name || '';
    document.getElementById('upPhone').value = u.phone || '';
    document.getElementById('upAltPhone').value = u.alt_phone || '';
    document.getElementById('upEmail').value = u.email || '';
    document.getElementById('upGender').value = u.gender || '';
    document.getElementById('upDob').value = u.dob ? String(u.dob).slice(0, 10) : '';
    document.getElementById('upAddress').value = u.address || '';
    document.getElementById('upCity').value = u.city || '';
    document.getElementById('upState').value = u.state || '';
    document.getElementById('upCountry').value = u.country || 'India';
    document.getElementById('upPincode').value = u.pincode || '';

    const phoneBadge = document.getElementById('upPhoneCheckBadge');
    if (phoneBadge) {
      phoneBadge.style.display = /^[6-9]\d{9}$/.test(String(u.phone || '').replace(/\D/g, '').slice(-10)) ? 'inline-block' : 'none';
    }

    // Tab 2: Education & Org
    document.getElementById('upSchoolCode').value = u.school_code || '';
    document.getElementById('upRole').value = u.role || 'student';
    document.getElementById('upClass').value = u.class || '';
    document.getElementById('upSection').value = u.section || '';
    document.getElementById('upStream').value = u.stream || '';
    document.getElementById('upAcademicYear').value = u.academic_year || '';
    document.getElementById('upStudentId').value = u.student_id || '';
    document.getElementById('upAdmissionNo').value = u.admission_no || '';
    document.getElementById('upEmployeeId').value = u.employee_id || '';
    document.getElementById('upDepartment').value = u.department || '';
    document.getElementById('upDesignation').value = u.designation || '';

    // Tab 3: Interests & Prefs
    document.getElementById('upInterests').value = u.interests || '';
    const prefs = String(u.communication_preferences || '').toLowerCase();
    document.getElementById('upPrefEmail').checked = prefs.includes('email');
    document.getElementById('upPrefSms').checked = prefs.includes('sms');
    document.getElementById('upPrefWhatsApp').checked = prefs.includes('whatsapp');

    // Tab 4: Account & Security
    document.getElementById('upStatus').value = u.status || (u.is_banned ? 'suspended' : 'active');
    document.getElementById('upCreatedAt').value = u.created_at ? new Date(u.created_at).toLocaleString() : '—';
    document.getElementById('upLastLoginAt').value = u.last_login_at ? new Date(u.last_login_at).toLocaleString() : 'Never logged in';
    document.getElementById('upLastActiveAt').value = u.last_active_at ? new Date(u.last_active_at).toLocaleString() : '—';

    // Tab 5: Avatar & Photo
    _selectedAvatarId = u.avatar_id || 'avatar_01';
    const currentAvatarSrc = u.profile_picture || `/static/avatars/${_selectedAvatarId}.svg`;
    document.getElementById('upAvatarCurrentImg').src = currentAvatarSrc;
    document.getElementById('upAvatarCurrentName').textContent = u.profile_picture ? 'Custom Profile Picture' : `Character: ${_selectedAvatarId.replace('_', ' ').toUpperCase()}`;
    renderAvatarPickerGrid(_selectedAvatarId);

    // Tab: Role & Permissions Init
    _selectedUserRole = u.role || 'student';
    _userProfileAvailableRoles = d.available_roles || [];
    const upRoleSchool = document.getElementById('upRoleSchoolCode');
    if (upRoleSchool) upRoleSchool.value = u.school_code || '';
    const curBadge = document.getElementById('upCurrentRoleBadge');
    if (curBadge) {
      curBadge.textContent = u.role_name || u.role;
      curBadge.className = 'badge ' + roleBadge(u.role);
    }
    const curSchool = document.getElementById('upCurrentSchoolText');
    if (curSchool) curSchool.textContent = u.school_name || u.school_code || 'Independent';
    const curIcon = document.getElementById('upCurrentRoleIcon');
    if (curIcon) curIcon.textContent = getRoleIcon(u.role);
    renderUserRoleSelection(_selectedUserRole, _userProfileAvailableRoles);

    // Tab 6: Activity Timeline & Login History
    renderProfileTimeline(u.timeline || []);
    renderProfileLogins(u.logins || []);

    switchProfileTab(initialTab);
    openModal('userProfileModal');
  } catch (err) {
    showToast('Failed to fetch profile: ' + err.message, 'error');
  }
}

