function debouncedLoadLoginHistory() {
  clearTimeout(window._lhDebounce);
  window._lhDebounce = setTimeout(() => loadLoginHistory(1), 300);
}

async function loadLoginHistory(page=1) {
  _lhPage = page;
  const wrap = document.getElementById('lhTableWrap');
  if (!wrap) return;
  wrap.innerHTML = '<div class="sa-loading"><span class="sa-spinner"></span>Loading logins...</div>';
  
  const search = document.getElementById('lhSearch')?.value?.trim() || '';
  const timeframe = document.getElementById('lhTimeframe')?.value || 'today';
  const success = document.getElementById('lhSuccessFilter')?.value || '';

  const params = new URLSearchParams({ page, limit: 50 });
  if (search) params.set('search', search);
  if (timeframe) params.set('timeframe', timeframe);
  if (success) params.set('success', success);

  try {
    const d = await (await fetch('/super-admin/login-history?' + params)).json();
    const h = d.history || [];
    if (!h.length) {
      const msg = timeframe === 'today' ? "No logins recorded today yet." : "No login records found for this selection.";
      wrap.innerHTML = `<div class="sa-empty"><div class="sa-empty-icon">🔐</div><p>${msg}</p></div>`;
      renderPagination('lhPagination', 1, 0, 50, 'loadLoginHistory');
      return;
    }

    wrap.innerHTML = `
      <div class="sa-table-wrap"><table class="sa-table">
        <thead><tr><th>Time</th><th>User</th><th>Identifier</th><th>Role</th><th>IP Address</th><th>Status</th><th>Details</th></tr></thead>
        <tbody>${h.map(r => {
          const dateObj = r.created_at ? new Date(r.created_at) : null;
          const timeStr = dateObj ? dateObj.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' }) : '—';
          const dateStr = dateObj ? dateObj.toISOString().slice(0, 10) : '';
          return `
          <tr>
            <td style="font-size:.78rem;color:#0f172a;white-space:nowrap;">
              <strong>${timeStr}</strong>
              <div style="font-size:0.7rem;color:#94a3b8;">${dateStr}</div>
            </td>
            <td style="font-weight:600;color:#0f172a">${r.user_name || 'Anonymous User'}</td>
            <td style="font-size:.78rem;color:#475569">${r.phone || r.email || '—'}</td>
            <td><span class="badge badge-indigo">${r.role || '—'}</span></td>
            <td><code style="font-size:.78rem">${r.ip_address || '—'}</code></td>
            <td><span class="badge ${r.success ? 'badge-green' : 'badge-red'}">${r.success ? '✓ Successful' : '✗ Failed'}</span></td>
            <td style="font-size:.78rem;color:${r.success ? '#10b981' : '#f87171'}">${r.failure_reason || (r.success ? 'Verified' : '—')}</td>
          </tr>`;
        }).join('')}
        </tbody></table></div>`;
    renderPagination('lhPagination', page, d.total || h.length, 50, 'loadLoginHistory');
  } catch (e) {
    wrap.innerHTML = '<div class="sa-empty"><p>Failed to load login history.</p></div>';
  }
}

