async function createUser() {
  const rawPhone = document.getElementById('cuPhone').value.trim();
  const cleanPhone = rawPhone.replace(/\D/g, '').slice(-10);
  if (!/^[6-9]\d{9}$/.test(cleanPhone)) {
    return showToast('Mobile number must be a valid 10-digit Indian number starting with 6, 7, 8, or 9.', 'error');
  }

  const body = {
    name: document.getElementById('cuName').value.trim(),
    phone: cleanPhone,
    email: document.getElementById('cuEmail').value.trim(),
    password: document.getElementById('cuPassword').value || 'password123',
    role: document.getElementById('cuRole').value,
    school_code: document.getElementById('cuSchool').value.trim(),
    class: document.getElementById('cuClass').value.trim(),
    section: document.getElementById('cuSection').value.trim(),
    admission_no: document.getElementById('cuAdmNo').value.trim(),
    gender: document.getElementById('cuGender').value,
    dob: document.getElementById('cuDob').value
  };

  if (!body.name) return showToast('Full name is required', 'error');

  const d = await apiPost('/super-admin/users/create', body);
  if (d.success) {
    closeModal('createUserModal');
    showToast('User created successfully!', 'success');
    loadUsers(1);
  } else {
    showToast(d.error || 'Failed to create user', 'error');
  }
}

async function toggleUserStatus(id, currentStatus) {
