function setNotifScope(scope, btn) {
  SA.notifScope=scope;
  document.querySelectorAll('.sa-scope-btn').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  const fields={
    school:`<div class="sa-form-group"><label>School Code</label><input type="text" class="sa-input" id="notifSchool" placeholder="e.g. DPS001"></div>`,
    role:`<div class="sa-form-group"><label>Role</label><select class="sa-select" id="notifRole"><option value="student">Student</option><option value="admin">Admin</option><option value="librarian">Librarian</option><option value="teacher">Teacher</option></select></div>`,
    user:`<div class="sa-form-group"><label>User ID</label><input type="number" class="sa-input" id="notifUserId" placeholder="User ID"></div>`,
    all:''
  };
  document.getElementById('notifScopeFields').innerHTML=fields[scope]||'';
