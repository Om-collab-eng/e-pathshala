        <td>${c.uploader_name || '—'}</td>
        <td><span class="badge badge-gray" style="font-size:.62rem">${c.school_code || (c.school_code === 'GLOBAL' ? '🌍 Global' : '—')}</span></td>
        <td style="font-size:.78rem">${c.category || '—'}</td>
        <td><span class="badge ${c.status==='approved'?'badge-green':c.status==='rejected'?'badge-red':'badge-yellow'}">${c.status||'pending'}</span></td>
