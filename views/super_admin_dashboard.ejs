        <div class="sa-form-row">
          <div class="sa-form-group" style="flex:1">
            <label>Content Type *</label>
            <select class="sa-select" id="adFormType" name="type" onchange="onAdTypeChange()" required>
              <option value="BANNER">🎨 Interactive Banner</option>
              <option value="INTERESTING_FACT">💡 Interesting Educational Fact</option>
              <option value="IMAGE">🖼️ Image Banner</option>
              <option value="VIDEO">🎥 Video Teaser / Short</option>
              <option value="TEXT">📝 Text Announcement</option>
            </select>
          </div>
          <div class="sa-form-group" style="flex:1">
            <label>Placement / Section</label>
            <select class="sa-select" id="adFormSection" name="target_section">
              <option value="all">Everywhere (All E-Libraries)</option>
              <option value="digital_library">Digital Library Only</option>
              <option value="community_library">Community Library Only</option>
              <option value="home">Student Home Only</option>
            </select>
          </div>
        </div>

        <!-- Dynamic Fields Container -->
        <div id="adFormDynamicFields">
          <!-- Standard Title & Subtitle -->
          <div class="sa-form-group" id="groupAdTitle">
            <label id="lblAdTitle">Title / Headline *</label>
            <input type="text" class="sa-input" id="adFormTitle" name="title" placeholder="e.g. Annual Reading Challenge 2026" oninput="updateLiveAdPreview()">
          </div>

          <!-- Fact Category & Source (Visible for INTERESTING_FACT) -->
          <div class="sa-form-row" id="groupFactMeta" style="display:none;">
            <div class="sa-form-group" style="flex:1">
              <label>Category / Topic</label>
              <input type="text" class="sa-input" id="adFormCategory" name="category" placeholder="e.g. Astronomy, History, Science, Literature" oninput="updateLiveAdPreview()">
            </div>
            <div class="sa-form-group" style="flex:1">
              <label>Source / Reference</label>
              <input type="text" class="sa-input" id="adFormSource" name="source" placeholder="e.g. NASA / Encyclopaedia Britannica" oninput="updateLiveAdPreview()">
            </div>
          </div>

          <!-- Content Text / Fact Body -->
          <div class="sa-form-group" id="groupAdContentText">
            <label id="lblAdContentText">Fact / Announcement Text</label>
            <textarea class="sa-textarea" id="adFormContentText" name="content_text" rows="3" placeholder="Enter the engaging educational fact or announcement body..." oninput="updateLiveAdPreview()"></textarea>
          </div>

          <!-- Subtitle / Tagline -->
          <div class="sa-form-group" id="groupAdSubtitle">
            <label>Subtitle / Tagline</label>
            <input type="text" class="sa-input" id="adFormSubtitle" name="subtitle" placeholder="e.g. Explore over 5,000 new research papers" oninput="updateLiveAdPreview()">
          </div>
        </div>

        <!-- Media Upload & Existing Media URL -->
        <div class="sa-form-row" id="groupAdMedia">
          <div class="sa-form-group" style="flex:1">
            <label>Upload Media File (Max 26MB: JPG, PNG, WEBP, MP4, WebM)</label>
            <input type="file" class="sa-input" id="adFormMediaFile" name="media_file" accept="image/*,video/mp4,video/webm" onchange="handleAdMediaSelected(this)">
          </div>
          <div class="sa-form-group" style="flex:1">
            <label>Or Media URL / Embed Link</label>
            <input type="text" class="sa-input" id="adFormMediaUrl" name="media_url" placeholder="https://..." oninput="updateLiveAdPreview()">
          </div>
        </div>

        <!-- Destination URL & CTA Text -->
        <div class="sa-form-row" id="groupAdDestination">
          <div class="sa-form-group" style="flex:1">
            <label>Destination / Click URL</label>
            <input type="text" class="sa-input" id="adFormUrl" name="destination_url" value="/student#e-library" placeholder="/student#e-library or https://..." oninput="updateLiveAdPreview()">
          </div>
          <div class="sa-form-group" style="flex:1">
