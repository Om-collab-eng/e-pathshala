let _booksPage = 1, _booksTotal = 0;
async function loadBooks(page = 1) {
  _booksPage = page;
  document.getElementById('booksTableWrap').innerHTML = '<div class="sa-loading"><span class="sa-spinner"></span>Loading...</div>';
  const search = document.getElementById('bookSearch')?.value||'';
  const school = document.getElementById('bookSchoolFilter')?.value||'';
  const banned = document.getElementById('bookBanFilter')?.value||'';
  const params = new URLSearchParams({page, limit:50});
  if(search) params.set('search',search); if(school) params.set('school_code',school); if(banned!=='') params.set('banned',banned);
  try {
    const r = await fetch('/super-admin/books?'+params);
    const d = await r.json();
    SA.books = d.books||[];
    _booksTotal = d.total||SA.books.length;
    renderBooksTable(SA.books);
    renderPagination('booksPagination',page,_booksTotal,50,'loadBooks');
  } catch(e) { document.getElementById('booksTableWrap').innerHTML='<div class="sa-empty"><p>Failed to load books.</p></div>'; }
}

function renderBooksTable(books) {
  if (!books.length) { document.getElementById('booksTableWrap').innerHTML='<div class="sa-empty"><div class="sa-empty-icon">📚</div><p>No books found.</p></div>'; return; }
  document.getElementById('booksTableWrap').innerHTML = `
    <div class="sa-table-wrap"><table class="sa-table">
      <thead><tr>
        <th class="sa-col-check"><input type="checkbox" class="sa-check" onchange="toggleAllBooks(this)"></th>
        <th>ID</th><th>Title</th><th>Author</th><th>School</th><th>ISBN</th><th>Copies</th><th>Status</th><th>Actions</th>
      </tr></thead>
      <tbody>${books.map(b => `
        <tr>
          <td><input type="checkbox" class="sa-check book-check" value="${b.id}" onchange="updateBookBulk()"></td>
          <td style="color:#334155;font-size:.75rem">#${b.id}</td>
          <td style="color:#e2e8f0;font-weight:600;max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${b.title||'—'}</td>
          <td style="max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${b.author||'—'}</td>
          <td><span class="badge badge-gray" style="font-size:.65rem">${b.school_code||'—'}</span></td>
          <td style="font-size:.78rem;color:#64748b">${b.isbn||'—'}</td>
          <td><span style="color:${b.available_copies>0?'#34d399':'#f87171'}">${b.available_copies||0}/${b.total_copies||0}</span></td>
          <td><span class="badge ${(b.is_banned==='1'||b.is_banned===1)?'badge-red':'badge-green'}">${(b.is_banned==='1'||b.is_banned===1)?'Banned':'Active'}</span></td>
          <td><div class="sa-table-actions">
            <button class="sa-btn sa-btn-ghost sa-btn-xs" onclick='editBookModal(${JSON.stringify(b).replace(/'/g,"&#39;")})'>✏️</button>
            <button class="sa-btn ${(b.is_banned==='1'||b.is_banned===1)?'sa-btn-success':'sa-btn-warning'} sa-btn-xs" onclick="toggleBanBook(${b.id})">${(b.is_banned==='1'||b.is_banned===1)?'✅':'🚫'}</button>
            <button class="sa-btn sa-btn-danger sa-btn-xs" onclick="deleteBook(${b.id},'${(b.title||'').replace(/'/g,"\\'")}')">🗑️</button>
          </div></td>
        </tr>`).join('')}
      </tbody>
    </table></div>`;
  SA.selectedBooks.clear(); document.getElementById('booksBulkBar').classList.remove('show');
}

function toggleAllBooks(cb) { document.querySelectorAll('.book-check').forEach(c=>{c.checked=cb.checked;if(cb.checked)SA.selectedBooks.add(c.value);else SA.selectedBooks.delete(c.value);}); updateBookBulk(); }
function updateBookBulk() { SA.selectedBooks.clear(); document.querySelectorAll('.book-check:checked').forEach(c=>SA.selectedBooks.add(c.value)); const bar=document.getElementById('booksBulkBar'); if(SA.selectedBooks.size>0){bar.classList.add('show');document.getElementById('booksBulkCount').textContent=SA.selectedBooks.size+' selected';}else bar.classList.remove('show'); }

function editBookModal(b) {
  document.getElementById('ebId').value=b.id; document.getElementById('ebTitle').value=b.title||'';
  document.getElementById('ebAuthor').value=b.author||''; document.getElementById('ebIsbn').value=b.isbn||'';
  document.getElementById('ebPublisher').value=b.publisher||''; document.getElementById('ebGenre').value=b.genre||'';
  document.getElementById('ebCategory').value=b.category||''; document.getElementById('ebShelf').value=b.shelf_location||'';
  document.getElementById('ebCopies').value=b.total_copies||1;
  openModal('editBookModal');
}

async function saveBook() {
  const id = document.getElementById('ebId').value;
  const body = { title:document.getElementById('ebTitle').value, author:document.getElementById('ebAuthor').value, isbn:document.getElementById('ebIsbn').value, publisher:document.getElementById('ebPublisher').value, genre:document.getElementById('ebGenre').value, category:document.getElementById('ebCategory').value, shelf_location:document.getElementById('ebShelf').value, total_copies:document.getElementById('ebCopies').value };
  const d = await apiPost(`/super-admin/books/${id}/edit`, body);
  if (d.success) { closeModal('editBookModal'); showToast('Book updated!','success'); loadBooks(_booksPage); }
  else showToast(d.error||'Failed','error');
}

async function toggleBanBook(id) {
  const d = await apiPost(`/super-admin/books/${id}/toggle-ban`, {});
  if (d.success) { showToast(d.is_banned?'Book banned':'Book unbanned','success'); loadBooks(_booksPage); }
  else showToast(d.error||'Failed','error');
}

async function deleteBook(id, title) {
  if (!confirm(`Delete book "${title}"?`)) return;
  const d = await apiPost(`/super-admin/books/${id}/delete`, {});
  if (d.success) { showToast('Book deleted','success'); loadBooks(_booksPage); }
  else showToast(d.error||'Failed','error');
}

async function bulkDeleteBooks() {
  if (!SA.selectedBooks.size) return;
  if (!confirm(`Delete ${SA.selectedBooks.size} book(s)?`)) return;
  let ok=0; for(const id of SA.selectedBooks){const d=await apiPost(`/super-admin/books/${id}/delete`,{});if(d.success)ok++;}
  showToast(`${ok} book(s) deleted`,'success'); loadBooks(1);
}

async function createBook() {
  const body = {
    title: document.getElementById('cbTitle').value.trim(),
    author: document.getElementById('cbAuthor').value,
    isbn: document.getElementById('cbIsbn').value,
    publisher: document.getElementById('cbPublisher').value,
    genre: document.getElementById('cbGenre').value,
    category: document.getElementById('cbCategory').value,
    subject: document.getElementById('cbSubject').value,
    language: document.getElementById('cbLanguage').value,
    shelf_location: document.getElementById('cbShelf').value,
    barcode_id: document.getElementById('cbBarcode').value,
    school_code: document.getElementById('cbSchool').value,
    total_copies: document.getElementById('cbCopies').value,
    description: document.getElementById('cbDesc').value,
  };
  if (!body.title) return showToast('Title required','error');
  const d = await apiPost('/super-admin/books/create', body);
  if (d.success) { closeModal('createBookModal'); showToast('Book added!','success'); loadBooks(1); }
  else showToast(d.error || 'Failed','error');
}

async function bulkUploadBooks(input) {
  if (!input.files || !input.files.length) return;
  const file = input.files[0];
  const fd = new FormData();
  fd.append('csv', file);
  const r = await fetch('/super-admin/books/bulk-upload', { method:'POST', body: fd });
  const d = await r.json();
  input.value = '';
  if (d.success) { showToast(`Imported ${d.inserted} book(s), ${d.failed} failed`,'success'); loadBooks(1); }
  else showToast(d.error || 'Import failed','error');
}

