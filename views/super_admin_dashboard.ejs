<script>
// ═══════════════════════════════════════
//  STATE
// ═══════════════════════════════════════
const SA = {
  schools: [], users: [], books: [], currentTab: 'dashboard',
  selectedSchools: new Set(), selectedUsers: new Set(), selectedBooks: new Set(),
  notifScope: 'all',
  debounceTimers: {}
};

// ═══════════════════════════════════════
//  SIDEBAR & TABS
// ═══════════════════════════════════════
function toggleSidebar() {
  const sb = document.getElementById('saSidebar');
  const dim = document.getElementById('saDim');
  if (!sb) return;
  sb.classList.toggle('open');
  if (dim) dim.classList.toggle('active', sb.classList.contains('open'));
}
function closeSidebar() {
  const sb = document.getElementById('saSidebar');
  const dim = document.getElementById('saDim');
  if (sb) sb.classList.remove('open');
  if (dim) dim.classList.remove('active');
}

const TAB_TITLES = {
  dashboard:'Dashboard', schools:'School Management', users:'User Management',
  books:'Book Management', transactions:'Transactions', content:'Digital Content',
  ads:'Advertisements', notifications:'Notifications', analytics:'Analytics',
  audit:'Audit Logs', settings:'System Settings', masterauth:'Master Auth', reports:'Reports'
};

function switchTab(name, btn) {
  document.querySelectorAll('.sa-tab-pane').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.sa-nav-link').forEach(l => l.classList.remove('active'));
  const pane = document.getElementById('tab-' + name);
  if (pane) pane.classList.add('active');
  if (btn) btn.classList.add('active');
  const titleName = TAB_TITLES[name] || (name.charAt(0).toUpperCase() + name.slice(1));
  if (document.getElementById('pageTitle')) document.getElementById('pageTitle').textContent = titleName;
  if (document.getElementById('saBreadcrumbs')) document.getElementById('saBreadcrumbs').textContent = 'Super Admin / ' + titleName;
  SA.currentTab = name;
  closeSidebar();
  // Lazy load
  const loaders = {
    schools: () => loadSchools(),
    users: () => loadUsers(1),
    books: () => loadBooks(1),
    transactions: () => loadTransactions(1),
    content: () => loadDigitalContent(1),
    analytics: () => loadAnalytics(),
    audit: () => loadAudit(1),
    settings: () => loadSettings(),
    roles: () => loadRolePerms(),
    digital: () => loadDigitalList(1),
    community: () => loadCommunityList(1),
    global: () => loadGlobalList(1),
    categories: () => loadCategories(),
    goals: () => loadGoals(),
    requests: () => loadBookRequests(1),
    issued: () => loadIssuedBooks(1),
    rfid: () => loadRfid(1),
    scheduled: () => loadScheduled(),
    aiconfig: () => loadAiConfig(),
    maintenance: () => { runDiagnostics(); loadBackups(); loadBackupSchedules(); },
    backups: () => { loadBackups(); loadBackupSchedules(); },
    'login-history': () => loadLoginHistory(1),
    devices: () => loadDevices(),
    'two-factor': () => loadTwoFactor(),
    'ip-allowlist': () => loadIpAllowlist(),
    notifications: () => {}
  };
  if (loaders[name]) loaders[name]();
}

function refreshCurrentTab() { switchTab(SA.currentTab, document.querySelector('.sa-nav-link.active')); }

// ═══════════════════════════════════════
//  MODALS
// ═══════════════════════════════════════
function openModal(id) { document.getElementById(id).classList.add('open'); }
function closeModal(id) { document.getElementById(id).classList.remove('open'); }
document.addEventListener('click', e => {
  if (e.target.classList.contains('sa-modal-overlay')) e.target.classList.remove('open');
});

// ═══════════════════════════════════════
//  DEBOUNCE
// ═══════════════════════════════════════
function debounce(fn, key, ms = 400) {
  clearTimeout(SA.debounceTimers[key]);
  SA.debounceTimers[key] = setTimeout(fn, ms);
}
const debouncedLoadUsers = () => debounce(() => loadUsers(1), 'users');
const debouncedLoadBooks = () => debounce(() => loadBooks(1), 'books');
const debouncedLoadAudit = () => debounce(() => loadAudit(1), 'audit');

// ═══════════════════════════════════════
//  PAGINATION HELPER
// ═══════════════════════════════════════
function renderPagination(containerId, page, total, limit, onPage) {
  const el = document.getElementById(containerId);
  if (!el) return;
  const totalPages = Math.ceil(total / limit);
  if (totalPages <= 1) { el.innerHTML = ''; return; }
  const start = (page-1)*limit+1, end = Math.min(page*limit, total);
  let html = `<div class="sa-page-info">Showing ${start}–${end} of ${total}</div>`;
  html += `<button class="sa-page-btn" onclick="${onPage}(${page-1})" ${page<=1?'disabled':''}>‹ Prev</button>`;
  const startP = Math.max(1, page-2), endP = Math.min(totalPages, page+2);
  for (let i=startP; i<=endP; i++) html += `<button class="sa-page-btn ${i===page?'active':''}" onclick="${onPage}(${i})">${i}</button>`;
  html += `<button class="sa-page-btn" onclick="${onPage}(${page+1})" ${page>=totalPages?'disabled':''}>Next ›</button>`;
  el.innerHTML = html;
}

// ═══════════════════════════════════════
//  API HELPER
// ═══════════════════════════════════════
async function apiPost(url, data) {
  const r = await fetch(url, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(data) });
  return r.json();
}

// ═══════════════════════════════════════
//  SCHOOLS
// ═══════════════════════════════════════
let _schoolsPage = 1;
const SCHOOLS_PAGE_SIZE = 15;
async function loadSchools() {
  document.getElementById('schoolsTableWrap').innerHTML = '<div class="sa-loading"><span class="sa-spinner"></span>Loading schools...</div>';
  try {
    const r = await fetch('/super-admin/schools');
    const d = await r.json();
    SA.schools = d.schools || [];
    filterSchools();
    // Populate school filter dropdowns
    const codes = [...new Set(SA.schools.map(s => s.school_code).filter(Boolean))];
    ['userSchoolFilter','bookSchoolFilter','txSchoolFilter','dcSchoolFilter','auditSchool'].forEach(id => {
      const el = document.getElementById(id);
      if (!el) return;
      const cur = el.value;
      el.innerHTML = '<option value="">All Schools</option>' + codes.map(c => `<option value="${c}">${c}</option>`).join('');
      el.value = cur;
    });
  } catch(e) {
    document.getElementById('schoolsTableWrap').innerHTML = '<div class="sa-empty"><p>Failed to load schools.</p></div>';
  }
}

function filterSchools(resetPage = true) {
  if (resetPage) _schoolsPage = 1;
  const q = (document.getElementById('schoolSearch')?.value || '').toLowerCase();
  const st = document.getElementById('schoolStatusFilter')?.value || '';
  const filtered = SA.schools.filter(s =>
    (!q || (s.school_code||'').toLowerCase().includes(q) || (s.name||'').toLowerCase().includes(q)) &&
    (!st || s.status === st)
  );
  const total = filtered.length;
  const start = (_schoolsPage - 1) * SCHOOLS_PAGE_SIZE;
  renderSchoolsTable(filtered.slice(start, start + SCHOOLS_PAGE_SIZE));
  renderPagination('schoolsPagination', _schoolsPage, total, SCHOOLS_PAGE_SIZE, 'goSchoolsPage');
}
function goSchoolsPage(page) { _schoolsPage = page; filterSchools(false); }

function renderSchoolsTable(schools) {
  if (!schools.length) {
    document.getElementById('schoolsTableWrap').innerHTML = '<div class="sa-empty"><div class="sa-empty-icon">🏫</div><p>No schools found.</p></div>';
    return;
  }
  document.getElementById('schoolsTableWrap').innerHTML = `
    <div class="sa-table-wrap"><table class="sa-table">
      <thead><tr>
        <th class="sa-col-check"><input type="checkbox" class="sa-check" onchange="toggleAllSchools(this)"></th>
        <th>Code</th><th>Name</th><th>Plan</th><th>Status</th><th>Users</th><th>Books</th><th>Due Days</th><th>Actions</th>
      </tr></thead>
      <tbody>${schools.map(s => `
        <tr>
          <td><input type="checkbox" class="sa-check school-check" value="${s.school_code}" onchange="updateSchoolBulk()"></td>
          <td><span class="badge badge-indigo">${s.school_code||'—'}</span></td>
          <td style="color:#e2e8f0;font-weight:600">${s.name||'—'}</td>
          <td><span class="badge ${s.activePlan==='PROFESSIONAL'?'badge-yellow':s.activePlan==='BASIC'?'badge-blue':'badge-gray'}">${s.activePlan||'FREE'}</span></td>
          <td><span class="badge ${s.status==='active'?'badge-green':'badge-red'}">${s.status||'active'}</span></td>
          <td>${s.user_count||0}</td>
          <td>${s.book_count||0}</td>
          <td>${s.due_days||14}d</td>
          <td><div class="sa-table-actions">
            <button class="sa-btn sa-btn-ghost sa-btn-xs" onclick='editSchoolModal(${JSON.stringify(s).replace(/'/g,"&#39;")})'>✏️</button>
            <button class="sa-btn sa-btn-${s.status==='active'?'warning':'success'} sa-btn-xs" onclick="toggleSchoolStatus('${s.school_code}')">${s.status==='active'?'⏸':'▶'}</button>
            <button class="sa-btn sa-btn-danger sa-btn-xs" onclick="deleteSchool('${s.school_code}','${(s.name||'').replace(/'/g,"\\'")}')">🗑️</button>
          </div></td>
        </tr>`).join('')}
      </tbody>
    </table></div>`;
  SA.selectedSchools.clear();
  document.getElementById('schoolsBulkBar').classList.remove('show');
}

function toggleAllSchools(cb) {
  document.querySelectorAll('.school-check').forEach(c => { c.checked = cb.checked; if(cb.checked) SA.selectedSchools.add(c.value); else SA.selectedSchools.delete(c.value); });
  updateSchoolBulk();
}
function updateSchoolBulk() {
  SA.selectedSchools.clear();
  document.querySelectorAll('.school-check:checked').forEach(c => SA.selectedSchools.add(c.value));
  const bar = document.getElementById('schoolsBulkBar');
  if (SA.selectedSchools.size > 0) { bar.classList.add('show'); document.getElementById('schoolsBulkCount').textContent = SA.selectedSchools.size + ' selected'; }
  else bar.classList.remove('show');
}

async function createSchool() {
  const body = { school_code: document.getElementById('sCode').value.trim().toUpperCase(), name: document.getElementById('sName').value.trim(), librarian_name: document.getElementById('sLibrarian').value.trim(), activePlan: document.getElementById('sPlan').value, due_days: document.getElementById('sDueDays').value, studentLimit: document.getElementById('sStudentLimit').value, librarianLimit: document.getElementById('sLibLimit').value, adminLimit: document.getElementById('sAdminLimit').value };
  if (!body.school_code || !body.name) return showToast('Code and name required','error');
  const d = await apiPost('/super-admin/schools/create', body);
  if (d.success) { closeModal('createSchoolModal'); showToast('School created!','success'); SA.schools=[]; loadSchools(); }
  else showToast(d.error||'Failed','error');
}

function editSchoolModal(s) {
  document.getElementById('eSchoolCode').value = s.school_code;
  document.getElementById('eSchoolName').value = s.name||'';
  document.getElementById('eSchoolLibrarian').value = s.librarian_name||'';
  document.getElementById('eSchoolStatus').value = s.status||'active';
  document.getElementById('eSchoolPlan').value = s.activePlan||'FREE';
  document.getElementById('eSchoolDue').value = s.due_days||14;
  document.getElementById('eSchoolExpiry').value = s.expiryDate ? s.expiryDate.substr(0,10) : '';
  document.getElementById('eStudentLimit').value = s.studentLimit||500;
  document.getElementById('eLibLimit').value = s.librarianLimit||2;
  document.getElementById('eAdminLimit').value = s.adminLimit||2;
  openModal('editSchoolModal');
}

async function saveSchool() {
  const code = document.getElementById('eSchoolCode').value;
  const body = { name: document.getElementById('eSchoolName').value, librarian_name: document.getElementById('eSchoolLibrarian').value, status: document.getElementById('eSchoolStatus').value, activePlan: document.getElementById('eSchoolPlan').value, due_days: document.getElementById('eSchoolDue').value, expiryDate: document.getElementById('eSchoolExpiry').value, studentLimit: document.getElementById('eStudentLimit').value, librarianLimit: document.getElementById('eLibLimit').value, adminLimit: document.getElementById('eAdminLimit').value };
  const d = await apiPost(`/super-admin/edit-school/${code}`, body);
  if (d.success) { closeModal('editSchoolModal'); showToast('School updated!','success'); SA.schools=[]; loadSchools(); }
  else showToast(d.error||'Failed','error');
}

async function toggleSchoolStatus(code) {
  const d = await apiPost(`/super-admin/schools/${code}/toggle-status`, {});
  if (d.success) { showToast(`School ${d.status==='active'?'activated':'suspended'}`,'success'); SA.schools=[]; loadSchools(); }
  else showToast(d.error||'Failed','error');
}

async function deleteSchool(code, name) {
  if (!confirm(`Delete school "${name}" (${code})?\nThis cannot be undone.`)) return;
  const d = await apiPost(`/super-admin/delete-school/${code}`, {});
  if (d.success) { showToast('School deleted','success'); SA.schools=[]; loadSchools(); }
  else showToast(d.error||'Failed','error');
}

async function bulkDeleteSchools() {
  if (!SA.selectedSchools.size) return;
  if (!confirm(`Delete ${SA.selectedSchools.size} school(s)?`)) return;
  let ok=0;
  for (const code of SA.selectedSchools) { const d = await apiPost(`/super-admin/delete-school/${code}`,{}); if(d.success) ok++; }
  showToast(`${ok} school(s) deleted`,'success'); SA.schools=[]; loadSchools();
}

// ═══════════════════════════════════════
//  USERS
// ═══════════════════════════════════════
let _usersPage = 1, _usersTotal = 0;
async function loadUsers(page = 1) {
  _usersPage = page;
  document.getElementById('usersTableWrap').innerHTML = '<div class="sa-loading"><span class="sa-spinner"></span>Loading...</div>';
  const search = document.getElementById('userSearch')?.value || '';
  const role = document.getElementById('userRoleFilter')?.value || '';
  const banned = document.getElementById('userBanFilter')?.value || '';
  const school = document.getElementById('userSchoolFilter')?.value || '';
  const params = new URLSearchParams({ page, limit:50 });
  if (search) params.set('search', search);
  if (role) params.set('role', role);
  if (banned !== '') params.set('banned', banned);
  if (school) params.set('school_code', school);
  try {
    const r = await fetch('/super-admin/users?' + params);
    const d = await r.json();
    SA.users = d.users || [];
    _usersTotal = d.total || SA.users.length;
    renderUsersTable(SA.users);
    renderPagination('usersPagination', page, _usersTotal, 50, 'loadUsers');
  } catch(e) {
    document.getElementById('usersTableWrap').innerHTML = '<div class="sa-empty"><p>Failed to load users.</p></div>';
  }
}

function renderUsersTable(users) {
  if (!users.length) { document.getElementById('usersTableWrap').innerHTML = '<div class="sa-empty"><div class="sa-empty-icon">👥</div><p>No users found.</p></div>'; return; }
  const roleBadge = r => ({'super_admin':'badge-yellow','admin':'badge-blue','librarian':'badge-green','student':'badge-indigo','teacher':'badge-purple','parent':'badge-pink'}[r]||'badge-gray');
  document.getElementById('usersTableWrap').innerHTML = `
    <div class="sa-table-wrap"><table class="sa-table">
      <thead><tr>
        <th class="sa-col-check"><input type="checkbox" class="sa-check" onchange="toggleAllUsers(this)"></th>
        <th>ID</th><th>Name</th><th>Phone</th><th>Role</th><th>School</th><th>Class</th><th>Status</th><th>Actions</th>
      </tr></thead>
      <tbody>${users.map(u => `
        <tr>
          <td><input type="checkbox" class="sa-check user-check" value="${u.id}" onchange="updateUserBulk()"></td>
          <td style="color:#334155;font-size:.75rem">#${u.id}</td>
          <td style="color:#e2e8f0;font-weight:600;max-width:140px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${u.name||'—'}</td>
          <td>${u.phone||'—'}</td>
          <td><span class="badge ${roleBadge(u.role)}">${u.role||'—'}</span></td>
          <td><span class="badge badge-gray" style="font-size:.65rem">${u.school_code||'—'}</span></td>
          <td style="font-size:.78rem">${u.class||''} ${u.section||''}</td>
          <td><span class="badge ${(u.is_banned==='1'||u.is_banned===1)?'badge-red':'badge-green'}">${(u.is_banned==='1'||u.is_banned===1)?'Banned':'Active'}</span></td>
          <td><div class="sa-table-actions">
            <button class="sa-btn sa-btn-ghost sa-btn-xs" onclick='editUserModal(${JSON.stringify(u).replace(/'/g,"&#39;")})'>✏️</button>
            <button class="sa-btn sa-btn-ghost sa-btn-xs" onclick="changeRolePrompt(${u.id},'${(u.name||'').replace(/'/g,"\\'")}','${u.role||''}')" title="Change role">🔄</button>
            <button class="sa-btn sa-btn-ghost sa-btn-xs" onclick="transferSchoolPrompt(${u.id},'${(u.name||'').replace(/'/g,"\\'")}','${u.school_code||''}')" title="Transfer school">🏫</button>
