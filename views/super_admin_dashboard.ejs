function setNotifScope(scope, btn) {
  SA.notifScope=scope;
  document.querySelectorAll('.sa-scope-btn').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  const fields={
    school:`<div class="sa-form-group"><label>School Code</label><input type="text" class="sa-input" id="notifSchool" placeholder="e.g. DPS001"></div>`,
    role:`<div class="sa-form-group"><label>Role</label><select class="sa-select" id="notifRole"><option value="student">Student</option><option value="admin">Admin</option><option value="librarian">Librarian</option><option value="teacher">Teacher</option></select></div>`,
    user:`<div class="sa-form-group"><label>User ID</label><input type="number" class="sa-input" id="notifUserId" placeholder="User ID"></div>`,
    all:''
  };
  document.getElementById('notifScopeFields').innerHTML=fields[scope]||'';
}

async function sendNotification(){
  const title=document.getElementById('notifTitle')?.value.trim() || '';
  const message=document.getElementById('notifMessage').value.trim();
  const type=document.getElementById('notifType').value;
  if(!message) return showToast('Message is required','error');
  const body={title,message,type,scope:SA.notifScope};
  if(SA.notifScope==='school') body.school_code=document.getElementById('notifSchool')?.value;
  if(SA.notifScope==='role') body.role=document.getElementById('notifRole')?.value;
  if(SA.notifScope==='user') body.user_id=document.getElementById('notifUserId')?.value;
  const d=await apiPost('/super-admin/notify',body);
  if(d.success){
    showToast(`Notification broadcast to ${d.sent_to} user(s)!`,'success');
    document.getElementById('notifMessage').value='';
    const titleEl = document.getElementById('notifTitle');
    if (titleEl) titleEl.value = '';
  }
  else showToast(d.error||'Failed','error');
}

