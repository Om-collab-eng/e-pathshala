async function handleAdFormSubmit(e) {
  e.preventDefault();
  const form = document.getElementById('adEditorForm');
  const formData = new FormData(form);
  const editId = document.getElementById('adEditId').value;
  const isEdit = Boolean(editId);

  const btn = document.getElementById('btnSaveAd');
  const origText = btn.textContent;
  btn.textContent = 'Saving...';
  btn.disabled = true;

  try {
    const url = isEdit ? `/super-admin/ads/edit/${editId}` : '/super-admin/ads/create';
    const res = await fetch(url, {
      method: 'POST',
      body: formData
    });
    const data = await res.json();

    if (data.success) {
      showToast(data.message || 'Saved successfully!', 'success');
      closeModal('adEditorModal');
      await loadAdsData();
    } else {
      showToast(data.error || 'Failed to save advertisement', 'error');
    }
  } catch (err) {
    console.error('Submit ad form error:', err);
    showToast('Network error saving advertisement', 'error');
  } finally {
    btn.textContent = origText;
    btn.disabled = false;
  }
}

