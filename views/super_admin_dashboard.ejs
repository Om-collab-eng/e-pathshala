  else showToast(d.error || 'Failed', 'error');
}
async function deleteBackupSched(id) {
  if (!confirm('Delete schedule?')) return;
  const d = await apiPost('/super-admin/backup-schedules/' + id + '/delete', {});
  if (d.success) { showToast('Deleted', 'success'); loadBackupSchedules(); }
}

async function loadLoginHistory(page=1) {
  _lhPage = page;
  document.getElementById('lhTableWrap').innerHTML='<div class="sa-loading"><span class="sa-spinner"></span>Loading...</div>';
  const params = new URLSearchParams({ page, limit: 50 });
  const from = document.getElementById('lhDateFrom')?.value;
  const to = document.getElementById('lhDateTo')?.value;
  const success = document.getElementById('lhSuccessFilter')?.value;
  if (from) params.set('date_from', from);
  if (to) params.set('date_to', to);
  if (success) params.set('success', success);
  try {
    const d = await (await fetch('/super-admin/login-history?' + params)).json();
    const h = d.history || [];
    if (!h.length) { document.getElementById('lhTableWrap').innerHTML='<div class="sa-empty"><p>No login history.</p></div>'; return; }
    document.getElementById('lhTableWrap').innerHTML = `
      <div class="sa-table-wrap"><table class="sa-table">
        <thead><tr><th>When</th><th>User</th><th>Phone/Email</th><th>IP</th><th>Success</th><th>Reason</th></tr></thead>
        <tbody>${h.map(r => `
          <tr>
            <td style="font-size:.78rem">${r.created_at?.substr(0,16) || '—'}</td>
            <td>${r.user_name || 'Unknown'}</td>
            <td style="font-size:.78rem">${r.phone || r.email || '—'}</td>
            <td><code style="font-size:.78rem">${r.ip_address||'—'}</code></td>
            <td><span class="badge ${r.success?'badge-green':'badge-red'}">${r.success?'✓':'✗'}</span></td>
            <td style="font-size:.78rem;color:#f87171">${r.failure_reason||''}</td>
          </tr>`).join('')}
        </tbody></table></div>`;
    renderPagination('lhPagination', page, d.total || h.length, 50, 'loadLoginHistory');
  } catch (e) {}
}

async function loadDevices() {
  document.getElementById('devicesWrap').innerHTML='<div class="sa-loading"><span class="sa-spinner"></span>Loading...</div>';
  try {
    const d = await (await fetch('/super-admin/devices')).json();
    const devices = d.devices || [];
    if (!devices.length) { document.getElementById('devicesWrap').innerHTML='<div class="sa-empty"><p>No active sessions.</p></div>'; return; }
    document.getElementById('devicesWrap').innerHTML = `
      <table class="sa-table"><thead><tr><th>SID</th><th>User</th><th>Role</th><th>IP</th><th>Expires</th><th>Actions</th></tr></thead>
      <tbody>${devices.map(s => `
        <tr>
          <td><code style="font-size:.72rem">${(s.sid||'').slice(0,16)}…</code></td>
          <td>${s.user_name || 'Unknown'}</td>
          <td><span class="badge badge-indigo">${s.role || '—'}</span></td>
          <td><code style="font-size:.78rem">${s.ip || '—'}</code></td>
          <td style="font-size:.78rem">${s.expire ? new Date(s.expire).toLocaleString() : '—'}</td>
          <td><button class="sa-btn sa-btn-danger sa-btn-xs" onclick="revokeDevice('${s.sid}')">Revoke</button></td>
        </tr>`).join('')}
      </tbody></table>`;
  } catch (e) {}
}
async function revokeDevice(sid) {
  if (!confirm('Revoke this session? The user will be logged out.')) return;
  const d = await apiPost('/super-admin/devices/' + encodeURIComponent(sid) + '/revoke', {});
  if (d.success) { showToast('Revoked', 'success'); loadDevices(); }
  else showToast(d.error || 'Failed', 'error');
}

async function loadTwoFactor() {
  try {
    const d = await (await fetch('/super-admin/users?limit=500')).json();
    const users = d.users || [];
    document.getElementById('twofaWrap').innerHTML = `
      <p style="color:#94a3b8;font-size:.86rem">Users with <code>two_factor_enabled=1</code> (table-level filter). Use the Users tab "Edit" → "2FA" action to disable for any user.</p>
      <div style="display:flex;gap:.5rem;align-items:center;margin-top:.7rem">
        <input class="sa-search" id="twofaUserId" type="number" placeholder="User ID">
        <button class="sa-btn sa-btn-warning sa-btn-sm" onclick="disableUser2fa()">Disable 2FA</button>
      </div>`;
  } catch (e) {}
}
async function disableUser2fa() {
  const id = document.getElementById('twofaUserId').value;
  if (!id) return showToast('Enter user ID', 'error');
  if (!confirm(`Disable 2FA for user ${id}?`)) return;
  const d = await apiPost('/super-admin/users/' + id + '/2fa/disable', {});
  if (d.success) { showToast('2FA disabled', 'success'); loadTwoFactor(); }
  else showToast(d.error || 'Failed', 'error');
}

async function loadIpAllowlist() {
  try {
    const d = await (await fetch('/super-admin/ip-allowlist')).json();
    const rules = d.rules || [];
    document.getElementById('ipTableWrap').innerHTML = rules.length
      ? `<table class="sa-table"><thead><tr><th>CIDR/IP</th><th>Label</th><th>Status</th><th>Actions</th></tr></thead><tbody>${rules.map(r => `<tr><td><code>${r.cidr}</code></td><td>${r.label||'—'}</td><td><span class="badge ${r.enabled?'badge-green':'badge-gray'}">${r.enabled?'Enabled':'Disabled'}</span></td><td><button class="sa-btn sa-btn-warning sa-btn-xs" onclick="toggleIpRule(${r.id})">Toggle</button> <button class="sa-btn sa-btn-danger sa-btn-xs" onclick="deleteIpRule(${r.id})">🗑</button></td></tr>`).join('')}</tbody></table>`
      : '<p style="color:#475569">No rules yet.</p>';
  } catch (e) {}
}
async function createIpRule() {
  const body = {
    cidr: document.getElementById('ipCidr').value,
    label: document.getElementById('ipLabel').value,
    enabled: true,
  };
  if (!body.cidr) return showToast('CIDR required', 'error');
  const d = await apiPost('/super-admin/ip-allowlist/create', body);
  if (d.success) { closeModal('newIpRuleModal'); showToast('Created', 'success'); loadIpAllowlist(); }
  else showToast(d.error || 'Failed', 'error');
}
async function toggleIpRule(id) {
  const d = await apiPost('/super-admin/ip-allowlist/' + id + '/toggle', {});
  if (d.success) { showToast('Toggled', 'success'); loadIpAllowlist(); }
}
async function deleteIpRule(id) {
  if (!confirm('Delete this rule?')) return;
  const d = await apiPost('/super-admin/ip-allowlist/' + id + '/delete', {});
  if (d.success) { showToast('Deleted', 'success'); loadIpAllowlist(); }
}

async function impersonateUser(id) {
  if (!confirm(`Impersonate user #${id}? You will be logged in as them.`)) return;
  const d = await apiPost('/super-admin/users/' + id + '/impersonate', {});
  if (d.success) { showToast('Impersonating', 'success'); window.location.href = d.redirect || '/'; }
  else showToast(d.error || 'Failed', 'error');
}
async function exitImpersonation() {
  const d = await apiPost('/super-admin/impersonate/exit', {});
  if (d.success) { showToast('Exited impersonation', 'success'); window.location.href = d.redirect || '/super-admin'; }
  else showToast(d.error || 'Failed', 'error');
}

