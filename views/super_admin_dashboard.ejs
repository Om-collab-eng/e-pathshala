      <div class="sa-stat-card" style="--glow:rgba(59,130,246,.15)"><span class="sa-stat-icon">📖</span><div class="sa-stat-label">Active Borrows</div><div class="sa-stat-value">${analytics.active_borrows||0}</div></div>
      <div class="sa-stat-card" style="--glow:rgba(239,68,68,.15)"><span class="sa-stat-icon">⚠️</span><div class="sa-stat-label">Overdue</div><div class="sa-stat-value">${analytics.overdue||0}</div></div>
      <div class="sa-stat-card" style="--glow:rgba(168,85,247,.15)"><span class="sa-stat-icon">🌐</span><div class="sa-stat-label">Digital Content</div><div class="sa-stat-value">${analytics.digital_content||0}</div></div>
