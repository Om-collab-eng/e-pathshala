function toggleAllUsers(cb) {
  document.querySelectorAll('.user-check').forEach(c => {
    c.checked = cb.checked;
    if (cb.checked) SA.selectedUsers.add(c.value);
    else SA.selectedUsers.delete(c.value);
  });
  updateUserBulk();
}

function updateUserBulk() {
  SA.selectedUsers.clear();
  document.querySelectorAll('.user-check:checked').forEach(c => SA.selectedUsers.add(c.value));
  const bar = document.getElementById('usersBulkBar');
  if (SA.selectedUsers.size > 0) {
    bar.classList.add('show');
    document.getElementById('usersBulkCount').textContent = SA.selectedUsers.size + ' selected';
  } else {
    bar.classList.remove('show');
  }
}

function deselectAllUsers() {
  document.querySelectorAll('.user-check').forEach(c => c.checked = false);
  const headCb = document.querySelector('.sa-col-check input');
  if (headCb) headCb.checked = false;
  SA.selectedUsers.clear();
  document.getElementById('usersBulkBar').classList.remove('show');
}

