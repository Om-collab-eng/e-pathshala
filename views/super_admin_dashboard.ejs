<script>
// ═══════════════════════════════════════
//  STATE
// ═══════════════════════════════════════
const SA = {
  schools: [], users: [], books: [], currentTab: 'dashboard',
  selectedSchools: new Set(), selectedUsers: new Set(), selectedBooks: new Set(),
  notifScope: 'all',
  debounceTimers: {}
};

// ═══════════════════════════════════════
//  SIDEBAR & TABS
// ═══════════════════════════════════════
function toggleSidebar() {
  const sb = document.getElementById('saSidebar');
  const dim = document.getElementById('saDim');
  const main = document.querySelector('.sa-main');
  if (!sb) return;

  if (window.innerWidth <= 900) {
    sb.classList.toggle('open');
    if (dim) dim.classList.toggle('active', sb.classList.contains('open'));
  } else {
    // Desktop toggle: collapse/expand sidebar
    sb.classList.toggle('collapsed');
    if (main) main.classList.toggle('expanded', sb.classList.contains('collapsed'));
  }
}

function closeSidebar() {
  const sb = document.getElementById('saSidebar');
  const dim = document.getElementById('saDim');
  if (sb) sb.classList.remove('open');
  if (dim) dim.classList.remove('active');
}

function openSidebar() {
  const sb = document.getElementById('saSidebar');
  const dim = document.getElementById('saDim');
  if (sb) sb.classList.add('open');
  if (dim) dim.classList.add('active');
}

const TAB_TITLES = {
  dashboard: 'Overview & Metrics',
  users: 'Users Directory',
  roles: 'Roles & Permissions',
  schools: 'School Management',
  books: 'Book Catalog',
  digital: 'Digital Vault',
  transactions: 'Circulation & Borrows',
  content: 'Digital Content Moderation',
  ads: 'Advertisements',
  notifications: 'Broadcast Notifications',
  scheduled: 'Scheduled Notifications',
  analytics: 'Analytics & Insights',
  audit: 'Audit Logs',
  'login-history': 'Login History',
  devices: 'Active Devices',
  'two-factor': 'Two-Factor Authentication',
  'ip-allowlist': 'IP Restrictions',
  backups: 'Database Backups',
  categories: 'Categories & Subjects',
  goals: 'Reading Goals',
  requests: 'Book Requests',
  issued: 'Issued Books',
  rfid: 'RFID Records',
  settings: 'System Settings',
  aiconfig: 'AI Configuration',
  maintenance: 'Maintenance & Diagnostics',
  masterauth: 'Master Authentication',
  reports: 'Reports & Exports'
};

const TAB_MODULES = {
  dashboard: 'Overview',
  users: 'User Management',
  roles: 'User Management',
  schools: 'Schools',
  books: 'Library & Content',
  digital: 'Library & Content',
  transactions: 'Library & Content',
  content: 'Library & Content',
  rfid: 'Library & Content',
  categories: 'Library & Content',
  requests: 'Library & Content',
  goals: 'Library & Content',
  issued: 'Library & Content',
  ads: 'Library & Content',
  notifications: 'Communications',
  scheduled: 'Communications',
  analytics: 'Analytics',
  settings: 'System & AI',
  aiconfig: 'System & AI',
  maintenance: 'System & AI',
  masterauth: 'System & AI',
  audit: 'Security & Logs',
  'login-history': 'Security & Logs',
  devices: 'Security & Logs',
  'two-factor': 'Security & Logs',
  'ip-allowlist': 'Security & Logs',
  backups: 'Security & Logs',
  reports: 'Reports'
};

function toggleNavSubmenu(parentId, defaultTab, navLinkBtn) {
  const parent = document.getElementById(parentId);
  if (!parent) return;
  const isAlreadyOpen = parent.classList.contains('open');
  // Toggle current parent
  parent.classList.toggle('open');
  if (!isAlreadyOpen && defaultTab) {
    const subTarget = document.getElementById('nav-' + defaultTab) || navLinkBtn;
    switchTab(defaultTab, subTarget);
  }
}

function switchTab(name, btn) {
  document.querySelectorAll('.sa-tab-pane').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.sa-nav-link, .sa-sub-link').forEach(l => l.classList.remove('active'));

  const pane = document.getElementById('tab-' + name);
  if (pane) pane.classList.add('active');

  let targetNav = btn || document.getElementById('nav-' + name);
  if (targetNav) {
    targetNav.classList.add('active');
    const parentNavItem = targetNav.closest('.sa-nav-item');
    if (parentNavItem) {
      parentNavItem.classList.add('open');
      const parentLink = parentNavItem.querySelector('.sa-nav-link');
      if (parentLink && !parentLink.classList.contains('active')) {
        parentLink.classList.add('active');
      }
    }
  }

  // Update in-page segmented navigation pills
  document.querySelectorAll('.sa-seg-pill').forEach(pill => {
    const sub = pill.getAttribute('data-sub');
    if (sub === name || pill.getAttribute('onclick')?.includes(`'${name}'`)) {
      pill.classList.add('active');
    } else {
      pill.classList.remove('active');
    }
  });

  const titleName = TAB_TITLES[name] || (name.charAt(0).toUpperCase() + name.slice(1));
  const moduleName = TAB_MODULES[name] || 'Control Center';
  if (document.getElementById('pageTitle')) document.getElementById('pageTitle').textContent = titleName;
  if (document.getElementById('saBreadcrumbs')) document.getElementById('saBreadcrumbs').textContent = `Super Admin / ${moduleName} / ${titleName}`;
  SA.currentTab = name;
  closeSidebar();

  // Lazy load
  const loaders = {
    schools: () => loadSchools(),
    users: () => loadUsers(1),
    books: () => loadBooks(1),
    transactions: () => loadTransactions(1),
    content: () => loadDigitalContent(1),
    analytics: () => loadAnalytics(),
    audit: () => loadAudit(1),
    settings: () => loadSettings(),
    roles: () => loadRolePerms(),
    digital: () => loadDigitalList(1),
    community: () => loadCommunityList(1),
    global: () => loadGlobalList(1),
    categories: () => loadCategories(),
    goals: () => loadGoals(),
    requests: () => loadBookRequests(1),
    issued: () => loadIssuedBooks(1),
    rfid: () => loadRfid(1),
    ads: () => loadAdsData(),
    scheduled: () => loadScheduled(),
    aiconfig: () => loadAiConfig(),
    maintenance: () => { runDiagnostics(); loadBackups(); loadBackupSchedules(); },
    backups: () => { loadBackups(); loadBackupSchedules(); },
    'login-history': () => loadLoginHistory(1),
    devices: () => loadDevices(),
    'two-factor': () => loadTwoFactor(),
    'ip-allowlist': () => loadIpAllowlist(),
    notifications: () => {}
  };
  if (loaders[name]) loaders[name]();
}

function handleGlobalSearch(q) {
  if (!q) return;
  const lower = q.toLowerCase().trim();
  if (SA.currentTab === 'users') {
    const input = document.getElementById('userSearch');
    if (input) { input.value = q; debouncedLoadUsers(); }
  } else if (SA.currentTab === 'books') {
    const input = document.getElementById('bookSearch');
    if (input) { input.value = q; debouncedLoadBooks(); }
  } else if (SA.currentTab === 'schools') {
    const input = document.getElementById('schoolSearch');
    if (input) { input.value = q; filterSchools(); }
  } else if (SA.currentTab === 'audit') {
    const input = document.getElementById('auditSearch');
    if (input) { input.value = q; debouncedLoadAudit(); }
  }
}

