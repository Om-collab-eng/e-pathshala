async function loadSettings(){
  try {
    const r=await fetch('/super-admin/settings'); const s=await r.json();
    if(document.getElementById('maintenanceToggle')) document.getElementById('maintenanceToggle').checked=(s.maintenance_mode==='true');
    const entries=Object.entries(s).filter(([k])=>k!=='maintenance_mode');
    const el=document.getElementById('settingsList');
    if(!el) return;
    el.innerHTML=entries.length?`<div class="sa-table-wrap"><table class="sa-table"><thead><tr><th>Key</th><th>Value</th></tr></thead><tbody>${entries.map(([k,v])=>`<tr><td style="font-family:monospace;color:#94a3b8">${k}</td><td style="color:#e2e8f0">${v}</td></tr>`).join('')}</tbody></table></div>`:'<p style="color:#334155;font-size:.82rem">No custom settings yet.</p>';
  } catch(e){}
}
async function toggleMaintenance(){
  const d=await apiPost('/super-admin/toggle-maintenance',{});
  if(d.success) showToast(`Maintenance ${d.maintenance_mode==='true'?'ENABLED':'DISABLED'}`,d.maintenance_mode==='true'?'warning':'success');
  else showToast(d.error||'Failed','error');
}
async function saveSetting(){
  const k=document.getElementById('settingKey').value.trim(),v=document.getElementById('settingVal').value.trim();
  if(!k||!v) return showToast('Both fields required','error');
  const d=await apiPost('/super-admin/settings',{setting_key:k,setting_value:v});
  if(d.success){showToast('Setting saved!','success');document.getElementById('settingKey').value='';document.getElementById('settingVal').value='';loadSettings();}
  else showToast(d.error||'Failed','error');
}

