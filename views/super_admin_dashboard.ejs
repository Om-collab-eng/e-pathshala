async function loadSchools() {
  document.getElementById('schoolsTableWrap').innerHTML = '<div class="sa-loading"><span class="sa-spinner"></span>Loading schools...</div>';
  try {
    const r = await fetch('/super-admin/schools');
    const d = await r.json();
    SA.schools = d.schools || [];
    filterSchools();
    // Populate school filter dropdowns
    const codes = [...new Set(SA.schools.map(s => s.school_code).filter(Boolean))];
    ['userSchoolFilter','bookSchoolFilter','txSchoolFilter','dcSchoolFilter','auditSchool'].forEach(id => {
      const el = document.getElementById(id);
      if (!el) return;
      const cur = el.value;
      el.innerHTML = '<option value="">All Schools</option>' + codes.map(c => `<option value="${c}">${c}</option>`).join('');
      el.value = cur;
    });
  } catch(e) {
    document.getElementById('schoolsTableWrap').innerHTML = '<div class="sa-empty"><p>Failed to load schools.</p></div>';
  }
}

function filterSchools(resetPage = true) {
  if (resetPage) _schoolsPage = 1;
  const q = (document.getElementById('schoolSearch')?.value || '').toLowerCase();
  const st = document.getElementById('schoolStatusFilter')?.value || '';
  const filtered = SA.schools.filter(s =>
    (!q || (s.school_code||'').toLowerCase().includes(q) || (s.name||'').toLowerCase().includes(q)) &&
    (!st || s.status === st)
  );
  const total = filtered.length;
  const start = (_schoolsPage - 1) * SCHOOLS_PAGE_SIZE;
  renderSchoolsTable(filtered.slice(start, start + SCHOOLS_PAGE_SIZE));
  renderPagination('schoolsPagination', _schoolsPage, total, SCHOOLS_PAGE_SIZE, 'goSchoolsPage');
}
function goSchoolsPage(page) { _schoolsPage = page; filterSchools(false); }

