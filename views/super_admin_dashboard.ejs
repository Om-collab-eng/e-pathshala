function toggleSidebar() {
  const sb = document.getElementById('saSidebar');
  const dim = document.getElementById('saDim');
  const main = document.querySelector('.sa-main');
  if (!sb) return;

  if (window.innerWidth <= 900) {
    sb.classList.toggle('open');
    if (dim) dim.classList.toggle('active', sb.classList.contains('open'));
  } else {
    // Desktop toggle: collapse/expand sidebar
    sb.classList.toggle('collapsed');
    if (main) main.classList.toggle('expanded', sb.classList.contains('collapsed'));
  }
}

function closeSidebar() {
  const sb = document.getElementById('saSidebar');
  const dim = document.getElementById('saDim');
  if (sb) sb.classList.remove('open');
  if (dim) dim.classList.remove('active');
}

function openSidebar() {
  const sb = document.getElementById('saSidebar');
  const dim = document.getElementById('saDim');
  if (sb) sb.classList.add('open');
  if (dim) dim.classList.add('active');
}

