function downloadSampleUserCsv() {
  const headers = ['Full Name', 'Mobile Number', 'Email Address', 'Role', 'School / Organization', 'Class', 'Section', 'Admission No', 'Gender', 'Date of Birth'];
  const sampleRow1 = ['Aarav Sharma', '9876543210', 'aarav.sharma@school.org', 'Student', 'VBPS01', '10', 'A', 'ADM2026001', 'male', '2010-05-15'];
  const sampleRow2 = ['Priya Verma', '9123456789', 'priya.verma@school.org', 'Teacher', 'VBPS01', '', '', 'EMP2026002', 'female', '1988-11-20'];
  const sampleRow3 = ['Rajesh Patel', '9988776655', 'rajesh.patel@school.org', 'Librarian', 'GLOBAL', '', '', 'LIB2026003', 'male', '1985-02-10'];

  const csvContent = [headers.join(','), sampleRow1.join(','), sampleRow2.join(','), sampleRow3.join(',')].join('\n');
  const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'librika_users_import_sample.csv';
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
}

function handleCsvFileSelected(input) {
  if (!input.files || !input.files[0]) return;
  const file = input.files[0];
  const reader = new FileReader();
  reader.onload = e => {
    document.getElementById('csvTextarea').value = e.target.result;
  };
  reader.readAsText(file);
}

async function validateUserCsv() {
  const csv_text = document.getElementById('csvTextarea').value.trim();
  if (!csv_text) return showToast('Please select a CSV file or paste CSV text first.', 'error');

  const btn = document.getElementById('btnCsvValidate');
  btn.textContent = 'Inspecting & Validating...';
  btn.disabled = true;

  try {
    const res = await apiPost('/super-admin/users/import-csv-validate', { csv_text });
    btn.textContent = 'Inspect & Validate CSV →';
    btn.disabled = false;

    if (!res.success) return showToast(res.error || 'Validation failed', 'error');

    _csvValidatedRows = res.validRows || [];
    const sum = res.summary || {};

    document.getElementById('chipTotalRows').textContent = `Total Rows: ${sum.totalRows || 0}`;
    document.getElementById('chipValidRows').textContent = `Valid: ${sum.validCount || 0}`;
    document.getElementById('chipInvalidRows').textContent = `Invalid: ${sum.invalidCount || 0}`;
    document.getElementById('chipDuplicateRows').textContent = `Duplicates: ${sum.duplicateCount || 0}`;

    const errorsWrap = document.getElementById('csvValidationErrorsWrap');
    const errorsTbody = document.getElementById('csvErrorsTableBody');
    if (res.invalidRows && res.invalidRows.length > 0) {
      errorsWrap.style.display = 'block';
      errorsTbody.innerHTML = res.invalidRows.map(inv => `
        <tr>
          <td>#${inv.rowNum}</td>
          <td>${inv.name || '—'}</td>
          <td>${inv.mobile || '—'}</td>
          <td style="color:var(--danger)">${inv.errors.join('; ')}</td>
        </tr>
      `).join('');
    } else {
      errorsWrap.style.display = 'none';
    }

    const previewNotice = document.getElementById('csvValidPreviewNotice');
    if (_csvValidatedRows.length > 0) {
      previewNotice.textContent = `✅ Ready to import ${_csvValidatedRows.length} valid user records into Librika.`;
      document.getElementById('btnCsvConfirm').style.display = 'inline-block';
      document.getElementById('btnCsvConfirm').textContent = `✅ Import ${_csvValidatedRows.length} Users`;
    } else {
      previewNotice.textContent = '❌ No valid rows found in CSV. Please correct the errors above and retry.';
      document.getElementById('btnCsvConfirm').style.display = 'none';
    }

    // Switch to step 2 view
    document.getElementById('csvWizardStep1').style.display = 'none';
    document.getElementById('csvWizardStep2').style.display = 'block';
    document.getElementById('btnCsvValidate').style.display = 'none';
    document.getElementById('btnCsvBack').style.display = 'inline-block';
  } catch (err) {
    btn.textContent = 'Inspect & Validate CSV →';
    btn.disabled = false;
    showToast('CSV Parsing Error: ' + err.message, 'error');
  }
}

function backToCsvStep1() {
  document.getElementById('csvWizardStep1').style.display = 'block';
  document.getElementById('csvWizardStep2').style.display = 'none';
  document.getElementById('btnCsvValidate').style.display = 'inline-block';
  document.getElementById('btnCsvBack').style.display = 'none';
  document.getElementById('btnCsvConfirm').style.display = 'none';
}

async function confirmImportUserCsv() {
  if (!_csvValidatedRows.length) return showToast('No validated rows to import.', 'error');

  const btn = document.getElementById('btnCsvConfirm');
  btn.textContent = 'Importing...';
