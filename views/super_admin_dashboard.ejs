function renderUserRoleSelection(activeRole, dbRoles) {
  const listEl = document.getElementById('upRoleSelectionList');
  if (!listEl) return;

  const currentSlug = String(activeRole || 'student').toLowerCase();
  const labelEl = document.getElementById('upSelectedRoleLabel');
  if (labelEl) labelEl.textContent = 'Selected: ' + (currentSlug.replace('_', ' ').toUpperCase());

  // Merge standard roles with any custom roles from db
  let rolesToRender = [...STANDARD_USER_ROLES];
  if (Array.isArray(dbRoles)) {
    dbRoles.forEach(dr => {
      if (!rolesToRender.some(r => r.slug === dr.slug)) {
        rolesToRender.push({
          slug: dr.slug,
          name: dr.name,
          icon: '🛡️',
          badge: 'badge-blue',
          desc: dr.description || 'Custom organization role with custom permissions matrix.'
        });
      }
    });
  }

  listEl.innerHTML = rolesToRender.map(r => {
    const isSelected = r.slug === currentSlug;
    return `
      <div class="sa-role-option-card ${isSelected ? 'selected' : ''}" 
           onclick="selectUserRole('${r.slug}')"
           style="position:relative;border:${isSelected ? '2px solid var(--primary, #0B5ED7)' : '1px solid var(--border, #E2E8F0)'};border-radius:10px;padding:12px 14px;cursor:pointer;background:${isSelected ? 'rgba(11,94,215,0.06)' : '#FFFFFF'};transition:all .18s;box-shadow:${isSelected ? '0 0 0 1px rgba(11,94,215,0.2)' : 'none'};">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">
          <div style="display:flex;align-items:center;gap:8px;">
            <span style="font-size:1.25rem;">${r.icon}</span>
            <strong style="font-size:0.9rem;color:var(--text-primary);">${r.name}</strong>
          </div>
          <span class="badge ${r.badge}" style="font-size:0.68rem;text-transform:none;">${r.slug}</span>
        </div>
        <p style="font-size:0.77rem;color:var(--text-secondary);margin:0;line-height:1.35;">${r.desc}</p>
        ${isSelected ? '<span style="position:absolute;top:8px;right:8px;background:var(--primary,#0B5ED7);color:#fff;width:18px;height:18px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:0.7rem;font-weight:900;">✓</span>' : ''}
      </div>
    `;
  }).join('');

  updateRolePrivilegeSummary(currentSlug);
}

function selectUserRole(roleSlug) {
  _selectedUserRole = roleSlug;
  const upRole = document.getElementById('upRole');
  if (upRole) upRole.value = roleSlug;

  const labelEl = document.getElementById('upSelectedRoleLabel');
  if (labelEl) labelEl.textContent = 'Selected: ' + (roleSlug.replace('_', ' ').toUpperCase());

  renderUserRoleSelection(roleSlug, _userProfileAvailableRoles);
}

function updateRolePrivilegeSummary(slug) {
  const sumEl = document.getElementById('upRolePrivilegeSummary');
  if (!sumEl) return;
  const s = String(slug || '').toLowerCase();

  let text = '';
  if (s === 'super_admin') {
    text = '👑 <strong>Full Root Permissions</strong>: Complete control over all schools, user accounts, role definitions, audit logs, and system maintenance.';
  } else if (s === 'admin' || s === 'school_admin') {
    text = '🏢 <strong>School Administrator Privileges</strong>: Grants immediate access to the Librarian & Admin Console (/admin), faculty records, student management, and school settings.';
  } else if (s === 'librarian') {
    text = '📚 <strong>Library Operator Privileges</strong>: Grants immediate access to the Librarian Console (/admin), book issue/return circulation desk, barcode inventory, and fine collection.';
  } else if (s === 'teacher') {
    text = '👨‍🏫 <strong>Teacher Portal Privileges</strong>: Grants student class management, reading goal assignments, classroom study vault access, and book recommendations.';
  } else if (s === 'student') {
    text = '🎒 <strong>Student Privileges</strong>: Grants access to the Student Library Portal (/student), digital eBook reader, digital library pass, and book checkout requests.';
  } else if (s === 'quiz_manager') {
    text = '🧠 <strong>Quiz Assessment Privileges</strong>: Grants access to creating chapter quizzes, managing trivia, and tracking student comprehension.';
  } else if (s === 'content_manager') {
    text = '🌐 <strong>Content Curation Privileges</strong>: Grants access to digital library repository, uploading e-books/PDFs up to 28MB, and reviewing student ratings.';
  } else {
    text = '📖 <strong>Personal Privileges</strong>: Self-managed personal digital reader vault and individual library profile.';
  }
  sumEl.innerHTML = text;
}

async function saveAndApplyRole() {
  const userId = document.getElementById('upId').value;
  if (!userId) return showToast('User ID missing', 'error');

  const selectedRole = _selectedUserRole || document.getElementById('upRole').value;
  const schoolCode = document.getElementById('upRoleSchoolCode').value.trim();

  const btn = document.getElementById('btnSaveApplyRole');
  if (btn) {
    btn.disabled = true;
    btn.innerHTML = '<span>⏳ Applying Role...</span>';
  }

  try {
    const res = await apiPost(`/super-admin/users/${userId}/change-role`, {
      role: selectedRole,
      school_code: schoolCode || null
    });

    if (res.success) {
      showToast(`✓ Role successfully changed to "${selectedRole}"! Effective immediately across all boards.`, 'success');
      
      // Update modal display elements
      document.getElementById('upRole').value = selectedRole;
      document.getElementById('upSchoolCode').value = schoolCode;
      const curBadge = document.getElementById('upCurrentRoleBadge');
      if (curBadge) {
        curBadge.textContent = selectedRole;
        curBadge.className = 'badge ' + roleBadge(selectedRole);
      }
      const curSchool = document.getElementById('upCurrentSchoolText');
      if (curSchool) curSchool.textContent = schoolCode || 'Independent';
      const curIcon = document.getElementById('upCurrentRoleIcon');
      if (curIcon) curIcon.textContent = getRoleIcon(selectedRole);
      document.getElementById('upModalSubtitle').textContent = `User ID: #${userId} • ${selectedRole} • ${schoolCode || 'Independent'}`;
      
      renderUserRoleSelection(selectedRole, _userProfileAvailableRoles);

      // Refresh table in background
      if (typeof loadUsers === 'function') loadUsers(_usersPage);
    } else {
      showToast(res.error || 'Failed to update role', 'error');
    }
  } catch (err) {
    showToast('Network error: ' + err.message, 'error');
  } finally {
    if (btn) {
      btn.disabled = false;
      btn.innerHTML = '<span>⚡ Save &amp; Apply Role Changes</span>';
    }
  }
}

async function saveUserProfile() {
  const userId = document.getElementById('upId').value;
  if (!userId) return;

  const phone = document.getElementById('upPhone').value.trim();
  const cleanPhone = phone.replace(/\D/g, '').slice(-10);
  if (!/^[6-9]\d{9}$/.test(cleanPhone)) {
    return showToast('Invalid mobile: Indian mobile must be 10 digits starting with 6, 7, 8, or 9.', 'error');
  }

  const prefs = [];
  if (document.getElementById('upPrefEmail')?.checked) prefs.push('email');
  if (document.getElementById('upPrefSms')?.checked) prefs.push('sms');
  if (document.getElementById('upPrefWhatsApp')?.checked) prefs.push('whatsapp');

  const payload = {
    name: document.getElementById('upName').value.trim(),
    first_name: document.getElementById('upFirstName').value.trim(),
    last_name: document.getElementById('upLastName').value.trim(),
    phone: cleanPhone,
    alt_phone: document.getElementById('upAltPhone').value.trim(),
    email: document.getElementById('upEmail').value.trim(),
    gender: document.getElementById('upGender').value,
    dob: document.getElementById('upDob').value,
    address: document.getElementById('upAddress').value.trim(),
    city: document.getElementById('upCity').value.trim(),
    state: document.getElementById('upState').value.trim(),
    country: document.getElementById('upCountry').value.trim(),
    pincode: document.getElementById('upPincode').value.trim(),
    school_code: document.getElementById('upRoleSchoolCode')?.value.trim() || document.getElementById('upSchoolCode').value.trim(),
    role: _selectedUserRole || document.getElementById('upRole').value,
    class: document.getElementById('upClass').value.trim(),
    section: document.getElementById('upSection').value.trim(),
    stream: document.getElementById('upStream').value.trim(),
    academic_year: document.getElementById('upAcademicYear').value.trim(),
    student_id: document.getElementById('upStudentId').value.trim(),
    admission_no: document.getElementById('upAdmissionNo').value.trim(),
    employee_id: document.getElementById('upEmployeeId').value.trim(),
    department: document.getElementById('upDepartment').value.trim(),
    designation: document.getElementById('upDesignation').value.trim(),
    interests: document.getElementById('upInterests').value.trim(),
    communication_preferences: prefs.join(','),
    status: document.getElementById('upStatus').value,
    avatar_id: _selectedAvatarId
  };

  const d = await apiPost(`/super-admin/users/${userId}/profile`, payload);
  if (d.success) {
    showToast('User profile saved successfully!', 'success');
    closeModal('userProfileModal');
    loadUsers(_usersPage);
  } else {
    showToast(d.error || 'Failed to update profile', 'error');
  }
