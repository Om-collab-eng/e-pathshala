<div class="sp-page">
  <div class="sp-layout">
    <%- include('partials/student_sidebar', { active: 'community' }) %>
    <div class="sp-main">
      <%- include('partials/student_topbar', { title: 'Community Library' }) %>
      <main class="sp-content">
<div class="portal-wrapper">
    <aside class="desktop-sidebar">
        <div class="sidebar-brand">
            <span class="brand-icon">🌐</span>
            <div class="brand-info">
                <h4><%= session.school_name || 'Digital Library' %></h4>
                <p><%= (session.role == 'super_admin' || session.role == 'superadmin') ? 'Super Admin' : (session.role == 'admin' ? 'Librarian Panel' : 'Student Portal') %></p>
            </div>
        </div>
        <nav class="sidebar-menu">
            <% if (session.role == 'super_admin' || session.role == 'superadmin') { %>
            <a href="/super-admin" class="sidebar-link"><span class="link-icon">⚙️</span><span>Super Admin</span></a>
            <a href="/digital-library" class="sidebar-link active"><span class="link-icon">🌐</span><span>Community Library</span></a>
            <% } else if (session.role == 'admin') { %>
            <a href="/admin" class="sidebar-link"><span class="link-icon">⬅️</span><span>Librarian Panel</span></a>
            <a href="/digital-library" class="sidebar-link active"><span class="link-icon">🌐</span><span>Community Library</span></a>
            <% } else { %>
            <a href="/student" class="sidebar-link"><span class="link-icon">📊</span><span>Dashboard</span></a>
            <a href="/student/browse" class="sidebar-link"><span class="link-icon">📚</span><span>Digital Library</span></a>
            <a href="/digital-library" class="sidebar-link active"><span class="link-icon">🌐</span><span>Community Library</span></a>
            <a href="/student/publish" class="sidebar-link"><span class="link-icon">✏️</span><span>Publish Content</span></a>
            <a href="/student/my-publications" class="sidebar-link"><span class="link-icon">📄</span><span>Publications</span></a>
            <a href="/student/bookmarks" class="sidebar-link"><span class="link-icon">🔖</span><span>Saved Items</span></a>
            <a href="/student/profile" class="sidebar-link"><span class="link-icon">👤</span><span>My Profile</span></a>
            <% } %>
            <hr class="sidebar-divider">
            <a href="/logout" class="sidebar-link logout-link"><span class="link-icon">🚪</span><span>Log Out</span></a>
        </nav>
        <div class="sidebar-profile-card">
            <div class="profile-card-avatar"><%= session.name ? session.name[0].toUpperCase() : 'U' %></div>
            <div class="profile-card-info">
                <h5><%= session.name %></h5>
                <p><%= (session.role == 'super_admin' || session.role == 'superadmin') ? 'Role: Super Admin' : (session.role == 'admin' ? 'Role: Librarian' : 'Class: ' + (session['class'] || 'N/A')) %></p>
            </div>
        </div>
    </aside>

    <div class="portal-main">
        <header class="comm-header">
            <div class="comm-header-left">
                <div class="globe-icon-box">🌐</div>
                <div style="text-align: left;">
                    <h1 class="comm-header-title">Community Library</h1>
                    <p class="comm-header-subtitle">Discover notes, projects and articles published by your peers.</p>
                </div>
            </div>
            <div class="comm-header-right">
                <button type="button" class="header-bell-btn">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
                    <span class="bell-badge">3</span>
                </button>
                <div class="header-avatar"><%= session.name ? session.name[0].toUpperCase() : 'M' %></div>
            </div>
        </header>

        <form method="GET" action="/digital-library" class="search-filter-row" style="width: 100%; display: flex; gap: 10px; flex-wrap: wrap; align-items: center; margin: 0; box-sizing: border-box;">
            <div class="search-input-wrapper" style="flex: 1; min-width: 220px; display: flex; align-items: center; position: relative;">
                <svg class="search-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; left: 14px;"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                <input type="text" name="q" id="searchInput" class="search-control" style="width: 100%; padding-left: 38px;" placeholder="Search by title, subject, author, tags..." value="<%= search_query || '' %>" oninput="if(!document.getElementById('aiToggle').checked) applyFilters()">
            </div>
            <div style="display: flex; align-items: center; gap: 8px; background: var(--sp-white); border: 1.5px solid var(--border-color); padding: 10px 14px; border-radius: 12px; font-size: 0.8rem; font-weight: 700; color: var(--sp-text-dark); height: 40px; box-shadow: 0 2px 8px rgba(0,0,0,0.02); box-sizing: border-box;">
                <label class="sa-toggle-switch" style="position: relative; display: inline-block; width: 40px; height: 22px; margin: 0; cursor: pointer;">
                    <input type="checkbox" name="ai" id="aiToggle" value="true" <%= ai_search ? 'checked' : '' %> style="opacity: 0; width: 0; height: 0;" onchange="if(this.checked) { this.form.submit() } else { window.location.href='/digital-library' }">
                    <span class="sa-toggle-slider" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-color: #cbd5e1; transition: .3s; border-radius: 34px;"></span>
                </label>
                <span>🤖 AI Search</span>
            </div>
            <% if (ai_search) { %>
            <button type="submit" class="filter-btn" style="height: 40px; background: var(--sp-purple); color: white; display: inline-flex; align-items: center; gap: 6px; border: none; font-weight: 700; box-shadow: 0 4px 12px rgba(92,60,243,0.15); padding: 0 20px;">Search</button>
            <% } else { %>
            <button type="button" class="filter-btn" id="filterOptionsBtn" onclick="toggleSubjectsFilter()" style="height: 40px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="21" x2="4" y2="14"></line><line x1="4" y1="10" x2="4" y2="3"></line><line x1="12" y1="21" x2="12" y2="12"></line><line x1="12" y1="8" x2="12" y2="3"></line><line x1="20" y1="21" x2="20" y2="16"></line><line x1="20" y1="12" x2="20" y2="3"></line><line x1="1" y1="14" x2="7" y2="14"></line><line x1="9" y1="8" x2="15" y2="8"></line><line x1="17" y1="16" x2="23" y2="16"></line></svg>
                <span>Filters</span>
            </button>
            <% } %>
        </form>

        <div class="subjects-select-wrapper" id="subjectsSelectWrapper">
            <select class="subject-select-menu" id="subjectSelectFilter" onchange="applyFilters()">
                <option value="ALL">Show All Subjects</option>
                <option value="Physics">Physics</option>
                <option value="Chemistry">Chemistry</option>
                <option value="Mathematics">Mathematics</option>
                <option value="Biology">Biology</option>
                <option value="Computer Science">Computer Science</option>
                <option value="English">English / Literature</option>
                <option value="History">History & Social Studies</option>
                <option value="General">General / Other</option>
            </select>
        </div>

        <div class="pills-row-wrapper">
            <div class="pill-item active" onclick="selectCategoryPill(this, 'ALL')">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                All
            </div>
            <div class="pill-item" onclick="selectCategoryPill(this, 'NOTES')">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 1 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                Notes
            </div>
            <div class="pill-item" onclick="selectCategoryPill(this, 'PROJECTS')">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                Projects
            </div>
            <div class="pill-item" onclick="selectCategoryPill(this, 'ARTICLES')">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                Articles
            </div>
            <div class="pill-item" onclick="toggleSubjectsFilter()">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.25-2.5 3.5-2.5 3.5h20s-1-2.25-2.5-3.5"></path><path d="M12 2v14.5"></path><path d="M8 8h8"></path><path d="M9 12h6"></path></svg>
                Subjects
            </div>
            <div class="pill-item" onclick="toggleSubjectsFilter()">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"></circle><circle cx="19" cy="12" r="1"></circle><circle cx="5" cy="12" r="1"></circle></svg>
                More
            </div>
        </div>

        <div class="hero-carousel-wrapper" id="heroCarousel">
            <div class="hero-carousel-track" id="carouselTrack">
                <!-- Slide 1 -->
                <div class="hero-slide">
                    <div class="featured-banner-card">
                        <div class="featured-banner-left">
                            <h2 class="featured-banner-title">Learn Together, Grow Together</h2>
                            <p class="featured-banner-subtitle">Share knowledge, support each other and build a smarter community.</p>
                            <div class="featured-stats-row">
                                <div class="featured-stat-box">
                                    <div class="featured-stat-header">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                                        <span><%= 120 + (contributors_count || 0) %></span>
                                    </div>
                                    <span class="featured-stat-label">Active Contributors</span>
                                </div>
                                <div class="featured-stat-box">
                                    <div class="featured-stat-header">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                                        <span><%= 340 + (total_resources || 0) %></span>
                                    </div>
                                    <span class="featured-stat-label">Total Resources</span>
                                </div>
                            </div>
                        </div>
                        <div class="featured-banner-right">
                            <svg width="120" height="110" viewBox="0 0 220 130" fill="none" xmlns="http://www.w3.org/2000/svg" style="max-width: 100%; height: auto;">
                              <circle cx="110" cy="90" r="45" fill="#E8E5FF" opacity="0.6"/>
                              <circle cx="50" cy="50" r="12" fill="#D3CFFF" opacity="0.4"/>
                              <circle cx="170" cy="40" r="16" fill="#D3CFFF" opacity="0.4"/>
                              <path d="M40 25 L41 28 L44 29 L41 30 L40 33 L39 30 L36 29 L39 28 Z" fill="#FFC27A"/>
                              <path d="M185 75 L186 78 L189 79 L186 80 L185 83 L184 80 L181 79 L184 78 Z" fill="#8B5CF6"/>
                              <g transform="translate(145, 15)"><rect width="28" height="20" rx="6" fill="#00F2FE" opacity="0.15"/><rect x="1" y="1" width="26" height="18" rx="5" fill="#ffffff" filter="drop-shadow(0px 2px 4px rgba(92, 60, 243, 0.08))"/><path d="M12 11.5 C12.2 11.7, 12.5 12, 13 12 C13.5 12, 13.8 11.7, 14 11.5 C14.5 11, 17 9.5, 17 8 C17 6.8, 16 6, 15 6 C14.3 6, 13.5 6.5, 13 7.2 C12.5 6.5, 11.7 6, 11 6 C10 6, 9 6.8, 9 8 C9 9.5, 11.5 11, 12 11.5 Z" fill="#ef4444"/><path d="M8 20 L12 17 L8 17 Z" fill="#ffffff"/></g>
                              <g transform="translate(30, 35)"><path d="M10 50 C10 40, 40 40, 40 50 L40 65 L10 65 Z" fill="#3B82F6"/><circle cx="25" cy="25" r="12" fill="#FDBA74"/><path d="M13 23 C13 10, 37 10, 37 23 C37 20, 35 15, 25 15 C15 15, 13 20, 13 23 Z" fill="#1E293B"/><path d="M15 42 L25 46 L35 42 L35 52 L25 56 L15 52 Z" fill="#8B5CF6"/><path d="M25 46 L25 56" stroke="#ffffff" stroke-width="1.5"/></g>
                              <g transform="translate(100, 35)"><path d="M20 50 C20 40, 50 40, 50 50 L50 65 L20 65 Z" fill="#FBBF24"/><circle cx="35" cy="25" r="12" fill="#FDBA74"/><path d="M23 25 C23 8, 47 8, 47 25 C47 38, 23 38, 23 25 Z" fill="#1E293B"/><path d="M25 21 C25 10, 45 10, 45 21 Z" fill="#1E293B"/><path d="M10 54 L40 54 L36 63 L14 63 Z" fill="#94A3B8"/><path d="M10 54 L10 42 L40 42 L40 54 Z" fill="#cbd5e1"/></g>
                            </svg>
                        </div>
                    </div>
                </div>

                <!-- Slide 2 -->
                <div class="hero-slide">
                    <div class="featured-banner-card" style="background: linear-gradient(135deg, #e0f2fe 0%, #bae6fd 100%); border-color: #bae6fd;">
                        <div class="featured-banner-left">
                            <h2 class="featured-banner-title" style="color: #0369a1;">Share Your Knowledge</h2>
                            <p class="featured-banner-subtitle" style="color: #0284c7;">Upload your study notes, research papers, and projects to inspire peers!</p>
                            <a href="/student/publish" style="background: #0284c7; color: white; display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; border-radius: 12px; font-weight: 800; text-decoration: none; font-size: 0.8rem;">✏️ Publish Now</a>
                        </div>
                        <div class="featured-banner-right" style="font-size: 3.5rem; display: flex; align-items: center; justify-content: center;">
                            🚀
                        </div>
                    </div>
                </div>

                <!-- Slide 3 -->
                <div class="hero-slide">
                    <div class="featured-banner-card" style="background: linear-gradient(135deg, #ecfdf5 0%, #a7f3d0 100%); border-color: #a7f3d0;">
                        <div class="featured-banner-left">
                            <h2 class="featured-banner-title" style="color: #065f46;">Smart AI Search Engine</h2>
                            <p class="featured-banner-subtitle" style="color: #059669;">Instant semantic query matching powered by Mistral AI catalog intelligence.</p>
                            <button onclick="document.querySelector('.search-input').focus()" style="background: #059669; color: white; border: none; padding: 8px 16px; border-radius: 12px; font-weight: 800; cursor: pointer; font-size: 0.8rem;">🤖 Try AI Search</button>
                        </div>
                        <div class="featured-banner-right" style="font-size: 3.5rem; display: flex; align-items: center; justify-content: center;">
                            🤖
                        </div>
                    </div>
                </div>

                <!-- Slide 4 -->
                <div class="hero-slide">
                    <div class="featured-banner-card" style="background: linear-gradient(135deg, #fffbeb 0%, #fde68a 100%); border-color: #fde68a;">
                        <div class="featured-banner-left">
                            <h2 class="featured-banner-title" style="color: #92400e;">Leaderboards & Badges</h2>
                            <p class="featured-banner-subtitle" style="color: #d97706;">Earn reader scores, unlock quiz badges, and top your school rankings.</p>
                            <a href="/leaderboard" style="background: #d97706; color: white; padding: 8px 16px; border-radius: 12px; font-weight: 800; text-decoration: none; font-size: 0.8rem;">🏆 View Ranks</a>
                        </div>
                        <div class="featured-banner-right" style="font-size: 3.5rem; display: flex; align-items: center; justify-content: center;">
                            🏆
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="dots-container" id="carouselDots">
            <div class="dot active" onclick="goToSlide(0)"></div>
            <div class="dot" onclick="goToSlide(1)"></div>
            <div class="dot" onclick="goToSlide(2)"></div>
            <div class="dot" onclick="goToSlide(3)"></div>
        </div>

        <div class="uploads-section-header">
            <h3 class="uploads-section-title">Recent Uploads</h3>
            <a href="#" class="uploads-view-all-link" onclick="resetAllFilters(event)">
                View All
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </a>
        </div>

        <div class="uploads-list-container" id="uploadsContainer">
            <% if (!content_list || content_list.length === 0) { %>
            <div style="text-align: center; padding: 3rem 1rem; background: var(--sp-white); border-radius: 16px; border: 1px solid var(--border-color);">
                <h4 style="margin: 0; color: var(--sp-text-dark);">Community Library is Empty</h4>
                <p style="margin: 5px 0 0 0; font-size: 0.75rem; color: var(--sp-text-muted);">Be the first to share notes and help your peers!</p>
            </div>
            <% } else { %>
                <% content_list.forEach(function(item) { %>
                <div class="upload-card-wrapper"
                     data-title="<%= (item.title || '').toLowerCase() %>"
                     data-subject="<%= (item.subject || '').toLowerCase() %>"
                     data-author="<%= (item.student_name || '').toLowerCase() %>"
                     data-tags="<%= (item.tags || '').toLowerCase() %>"
                     data-desc="<%= (item.description || '').toLowerCase() %>"
                     data-category="<%= (item.category || '').toUpperCase() %>"
                     data-subject-raw="<%= item.subject || '' %>">

                    <div class="upload-item-card">
                        <a href="/digital-library/read/<%= item.id %>" class="upload-card-link">
                            <div class="card-cover-wrapper" style="position: relative;">
                                <% if (item.ai_score) { %>
                                <div class="ai-badge" style="left: 5px; top: 5px; font-size: 0.65rem; padding: 2px 6px; white-space: nowrap;">🤖 <%= item.ai_score %>%</div>
                                <% } %>
                                <img src="<%= item.cover_url || '/static/placeholder-cover.jpg' %>" class="card-cover-img" alt="<%= item.title %>" onerror="this.onerror=null; generateBookCoverFallback(this, `<%= (item.title || 'Resource').replace(/[`\\]/g, '') %>`, `<%= (item.author || item.student_name || 'Manager').replace(/[`\\]/g, '') %>`, `<%= (item.category || item.subject || 'E-Book').replace(/[`\\]/g, '') %>`);" data-fallback-title="<%= item.title %>" data-fallback-author="<%= item.author || item.student_name || 'Manager' %>" data-fallback-genre="<%= item.category || item.subject || 'E-Book' %>">
                            </div>
                        </a>

                        <div class="card-details">
                            <% var catUpper = (item.category || '').toUpperCase(); %>
                            <% if (catUpper.indexOf('NOTES') !== -1) { %>
                                <span class="card-cat-badge badge-notes">Notes</span>
                            <% } else if (catUpper.indexOf('PROJECT') !== -1 || catUpper.indexOf('RESEARCH') !== -1 || catUpper.indexOf('PRESENTATION') !== -1) { %>
                                <span class="card-cat-badge badge-project">Project</span>
                            <% } else if (catUpper.indexOf('ARTICLE') !== -1 || catUpper.indexOf('SUMMARY') !== -1 || catUpper.indexOf('MATERIAL') !== -1) { %>
                                <span class="card-cat-badge badge-article">Article</span>
                            <% } else { %>
                                <span class="card-cat-badge badge-other"><%= item.category %></span>
                            <% } %>

                            <a href="/digital-library/read/<%= item.id %>" class="upload-card-link" style="text-align: left;">
                                <h4 class="card-title"><%= item.title %></h4>
                            </a>
                            <p class="card-meta-row"><%= item.student_name %> &bull; Class <%= item.student_class || 'General' %></p>

                            <div class="card-subject-tag">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
                                <span><%= item.subject %></span>
                            </div>
                        </div>

                        <div class="card-right-aside">
                            <span class="card-time-elapsed" data-timestamp="<%= item.created_at %>">1d ago</span>
                            <div class="card-stats-wrapper">
                                <div class="card-stat-item">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                    <span id="view-count-<%= item.id %>"><%= item.views %></span>
                                </div>
                                <div class="card-stat-item">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                                    <span><%= item.downloads %></span>
                                </div>
                            </div>
                            <button type="button" class="card-bookmark-btn <%= item.is_bookmarked ? 'active' : '' %>" onclick="toggleBookmark(event, <%= item.id %>, this)">
                                <svg viewBox="0 0 24 24" fill="<%= item.is_bookmarked ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>
                            </button>
                        </div>
                    </div>
                </div>
                <% }); %>
            <% } %>
        </div>

        <% if (session.role != 'admin') { %>
        <div class="contribute-box-card">
            <div class="contribute-box-left">
                <div class="contribute-icon-circle">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
                </div>
                <div>
                    <h4 class="contribute-title">Be a Contributor</h4>
                    <p class="contribute-subtitle">Share your knowledge and help others learn.</p>
                </div>
            </div>
            <a href="/student/publish" class="btn-publish-yours">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                Publish Yours
            </a>
        </div>
        <% } %>

        
    </div>
</div>
<% contentFor("scripts") %>
<script>
    let activeCategoryFilter = 'ALL';
    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.card-time-elapsed').forEach(el => {
            const timestamp = el.getAttribute('data-timestamp');
            if(timestamp) el.innerText = calculateRelativeTime(timestamp);
        });
        document.querySelectorAll('.ebook-mockup-mini').forEach(el => {
            const idStr = el.id || '';
            const titleText = el.querySelector('.ebook-mockup-mini-title').innerText || 'notes';
            const colors = generatePremiumGradient(titleText);
            el.style.background = `linear-gradient(135deg, ${colors.start} 0%, ${colors.end} 100%)`;
        });
    });
    function generatePremiumGradient(seedText) {
        let hash = 0;
        for (let i = 0; i < seedText.length; i++) {
            hash = seedText.charCodeAt(i) + ((hash << 5) - hash);
        }
        const presets = [
            { start: '#8b5cf6', end: '#5c3cf3' },
            { start: '#ec4899', end: '#be185d' },
            { start: '#3b82f6', end: '#1d4ed8' },
            { start: '#10b981', end: '#047857' },
            { start: '#f59e0b', end: '#b45309' },
            { start: '#06b6d4', end: '#0891b2' },
            { start: '#f43f5e', end: '#be123c' }
        ];
        const index = Math.abs(hash) % presets.length;
        return presets[index];
    }
    function calculateRelativeTime(dateStr) {
        if (!dateStr) return 'some time ago';
        const parts = dateStr.split(' ');
        if(parts.length < 2) return dateStr;
        const dateParts = parts[0].split('-');
        const timeParts = parts[1].split(':');
        const createdDate = new Date(parseInt(dateParts[0]), parseInt(dateParts[1]) - 1, parseInt(dateParts[2]), parseInt(timeParts[0]), parseInt(timeParts[1]));
        const now = new Date();
        const diffMs = now - createdDate;
        const diffSecs = Math.floor(diffMs / 1000);
        const diffMins = Math.floor(diffSecs / 60);
        const diffHours = Math.floor(diffMins / 60);
        const diffDays = Math.floor(diffHours / 24);
        if (diffMins < 1) return 'Just now';
        if (diffMins < 60) return diffMins + 'm ago';
        if (diffHours < 24) return diffHours + 'h ago';
        if (diffDays < 7) return diffDays + 'd ago';
        const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
        return createdDate.getDate() + ' ' + months[createdDate.getMonth()];
    }
    function selectCategoryPill(element, category) {
        document.querySelectorAll('.pill-item').forEach(pill => pill.classList.remove('active'));
        element.classList.add('active');
        activeCategoryFilter = category;
        applyFilters();
    }
    function toggleSubjectsFilter() {
        const wrapper = document.getElementById('subjectsSelectWrapper');
        wrapper.style.display = wrapper.style.display === 'block' ? 'none' : 'block';
    }
    function applyFilters() {
        const searchQuery = document.getElementById('searchInput').value.toLowerCase().trim();
        const subjectQuery = document.getElementById('subjectSelectFilter').value;
        const cards = document.querySelectorAll('.upload-card-wrapper');
        cards.forEach(card => {
            const title = card.getAttribute('data-title') || '';
            const subject = card.getAttribute('data-subject') || '';
            const author = card.getAttribute('data-author') || '';
            const tags = card.getAttribute('data-tags') || '';
            const desc = card.getAttribute('data-desc') || '';
            const cardCategory = card.getAttribute('data-category') || '';
            const cardSubjectRaw = card.getAttribute('data-subject-raw') || '';
            let matchesText = true;
            if(searchQuery) {
                matchesText = title.includes(searchQuery) || subject.includes(searchQuery) || author.includes(searchQuery) || tags.includes(searchQuery) || desc.includes(searchQuery);
            }
            let matchesCategory = true;
            if (activeCategoryFilter !== 'ALL') {
                if (activeCategoryFilter === 'NOTES') matchesCategory = cardCategory.includes('NOTES');
                else if (activeCategoryFilter === 'PROJECTS') matchesCategory = cardCategory.includes('PROJECT') || cardCategory.includes('RESEARCH') || cardCategory.includes('PRESENTATION');
                else if (activeCategoryFilter === 'ARTICLES') matchesCategory = cardCategory.includes('ARTICLE') || cardCategory.includes('SUMMARY') || cardCategory.includes('MATERIAL');
            }
            let matchesSubject = true;
            if (subjectQuery !== 'ALL') matchesSubject = (cardSubjectRaw === subjectQuery);
            card.style.display = (matchesText && matchesCategory && matchesSubject) ? 'block' : 'none';
        });
    }
    function resetAllFilters(e) {
        if(e) e.preventDefault();
        document.getElementById('searchInput').value = '';
        document.getElementById('subjectSelectFilter').value = 'ALL';
        document.querySelectorAll('.pill-item').forEach(pill => pill.classList.remove('active'));
        const allPill = document.querySelector('.pill-item[onclick*="ALL"]');
        if(allPill) allPill.classList.add('active');
        activeCategoryFilter = 'ALL';
        document.getElementById('subjectsSelectWrapper').style.display = 'none';
        applyFilters();
    }
    function toggleBookmark(event, contentId, element) {
        event.preventDefault();
        event.stopPropagation();
        fetch('/digital-library/api/toggle-bookmark', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ content_id: contentId })
        }).then(r => r.json()).then(res => {
            if (res.status === 'success') {
                const svg = element.querySelector('svg');
                if (res.bookmarked) {
                    element.classList.add('active');
                    svg.setAttribute('fill', 'currentColor');
                    showToast('Document bookmarked successfully!', 'success');
                } else {
                    element.classList.remove('active');
                    svg.setAttribute('fill', 'none');
                    showToast('Bookmark removed', 'info');
                }
            } else {
                showToast(res.message || 'Bookmark toggle failed', 'error');
            }
        }).catch(() => showToast('Unable to complete bookmark request', 'error'));
    }
    function pollLiveStats() {
        fetch('/digital-library/api/live-stats').then(res => res.json()).then(data => {
            if(data.status === 'success') {
                for (const [id, views] of Object.entries(data.stats)) {
                    const el = document.getElementById('view-count-' + id);
                    if (el) {
                        const currentViews = parseInt(el.innerText.trim());
                        if (views > currentViews) {
                            el.style.color = '#10b981';
                            setTimeout(() => el.style.color = 'inherit', 1000);
                        }
                        el.innerText = views;
                    }
                }
            }
        }).catch(e => console.error("Live stats error:", e));
    }
    setInterval(pollLiveStats, 5000);

    // Community Library Hero Carousel Controller
    let currentHeroSlide = 0;
    let heroAutoPlayTimer = null;
    const heroTrack = document.getElementById('carouselTrack');
    const heroDots = document.querySelectorAll('#carouselDots .dot');
    const totalHeroSlides = heroDots ? heroDots.length : 0;

    function updateHeroCarousel() {
        if (!heroTrack) return;
        heroTrack.style.transform = `translateX(-${currentHeroSlide * 100}%)`;
        if (heroDots) {
            heroDots.forEach((dot, idx) => {
                dot.classList.toggle('active', idx === currentHeroSlide);
            });
        }
    }

    function nextHeroSlide() {
        if (!totalHeroSlides) return;
        currentHeroSlide = (currentHeroSlide + 1) % totalHeroSlides;
        updateHeroCarousel();
    }

    window.goToSlide = function(index) {
        currentHeroSlide = index;
        updateHeroCarousel();
        startHeroAutoPlay();
    };

    function startHeroAutoPlay() {
        if (heroAutoPlayTimer) clearInterval(heroAutoPlayTimer);
        heroAutoPlayTimer = setInterval(nextHeroSlide, 6000);
    }

    // Touch and Drag Setup
    document.addEventListener('DOMContentLoaded', () => {
        const heroEl = document.getElementById('heroCarousel');
        if (heroEl) {
            let touchStartX = 0;
            let touchEndX = 0;

            heroEl.addEventListener('touchstart', (e) => {
                touchStartX = e.changedTouches[0].screenX;
                if (heroAutoPlayTimer) clearInterval(heroAutoPlayTimer);
            }, { passive: true });

            heroEl.addEventListener('touchend', (e) => {
                touchEndX = e.changedTouches[0].screenX;
                const diff = touchStartX - touchEndX;
                if (Math.abs(diff) > 40) {
                    if (diff > 0) currentHeroSlide = (currentHeroSlide + 1) % totalHeroSlides;
                    else currentHeroSlide = (currentHeroSlide - 1 + totalHeroSlides) % totalHeroSlides;
                    updateHeroCarousel();
                }
                startHeroAutoPlay();
            }, { passive: true });

            heroEl.addEventListener('mouseenter', () => {
                if (heroAutoPlayTimer) clearInterval(heroAutoPlayTimer);
            });
            heroEl.addEventListener('mouseleave', () => {
                startHeroAutoPlay();
            });

            startHeroAutoPlay();
        }
    });
</script>

      </main>
    </div>
  </div>
</div>
