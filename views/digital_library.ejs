<%- layout('base') %>

<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
/* ═══════════════════════════════════════════════
   LIBRIKA COMMUNITY DIGITAL LIBRARY — PRISTINE UNIFIED UI
   Simple, Clean, High-Contrast & 100% Mobile Responsive
═══════════════════════════════════════════════ */
*, *::before, *::after {
    box-sizing: border-box !important;
}

html, body {
    background: #f1f5f9 !important;
    background-color: #f1f5f9 !important;
    color: #0f172a !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow-x: hidden !important;
    width: 100% !important;
    max-width: 100vw !important;
    min-height: 100vh !important;
    font-family: 'Plus Jakarta Sans', sans-serif !important;
}

:root {
    --sp-purple: #818cf8;
    --sp-purple-mid: #6366f1;
    --sp-purple-light: rgba(99, 102, 241, 0.15);
    --sp-green: #34d399;
    --sp-orange: #fb923c;
    --sp-red: #f87171;
    --sp-bg: #f1f5f9;
    --sp-card-bg: #ffffff;
    --sp-sidebar-bg: #ffffff;
    --sp-border: #e2e8f0;
    --sp-text: #0f172a;
    --sp-muted: #64748b;
}

/* ── LAYOUT SHELL ── */
.st-shell {
    display: flex !important;
    min-height: 100vh !important;
    background: var(--sp-bg) !important;
    width: 100vw !important;
    max-width: 100vw !important;
    position: relative !important;
    overflow-x: hidden !important;
}

.st-main {
    flex: 1 !important;
    display: flex !important;
    flex-direction: column !important;
    min-height: 100vh !important;
    margin-left: 280px !important;
    width: calc(100vw - 280px) !important;
    max-width: 100vw !important;
    overflow-x: hidden !important;
    background: var(--sp-bg) !important;
    padding-bottom: 30px !important;
}
@media (max-width: 600px) {
    .st-main { margin-left: 0 !important; width: 100vw !important; max-width: 100vw !important; }
}

/* ── TOPBAR ── */
.st-topbar {
    background: #ffffff !important;
    /* blur removed */
    /* blur removed */
    border-bottom: 1px solid var(--sp-border) !important;
    padding: 0.85rem 1.5rem !important;
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    position: sticky !important;
    top: 0 !important;
    z-index: 100 !important;
    gap: 12px !important;
}
.st-topbar-left { display: flex !important; align-items: center !important; gap: 12px !important; }
.st-menu-btn {
    background: rgba(99, 102, 241, 0.06) !important;
    border: 1px solid #e2e8f0 !important;
    color: #475569 !important;
    width: 38px !important; height: 38px !important; border-radius: 10px !important;
    display: flex !important; align-items: center !important; justify-content: center !important;
    font-size: 1.1rem !important; cursor: pointer !important;
}
@media (min-width: 601px) { .st-menu-btn { display: none !important; } }

.st-brand-title {
    font-family: 'Outfit', sans-serif !important;
    font-size: 1.1rem !important;
    font-weight: 800 !important;
    color: #0f172a !important;
}

.st-topbar-right { display: flex !important; align-items: center !important; gap: 10px !important; }

/* ── SIDEBAR DRAWER ── */
.st-sidebar {
    width: 280px !important;
    max-width: 82vw !important;
    background: var(--sp-sidebar-bg) !important;
    border-right: 1px solid var(--sp-border) !important;
    display: flex !important;
    flex-direction: column !important;
    position: fixed !important;
    top: 0 !important; left: 0 !important;
    height: 100vh !important; height: 100dvh !important;
    z-index: 9999 !important;
    transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1) !important;
    box-shadow: 10px 0 40px rgba(15, 23, 42, 0.08) !important;
    transform: translateX(-105%) !important;
}
@media (max-width: 600px) {
    .st-sidebar.open { transform: translateX(0) !important; box-shadow: 20px 0 60px rgba(15, 23, 42, 0.15) !important; }
}
@media (min-width: 601px) {
    .st-sidebar { transform: translateX(0) !important; position: sticky !important; }
}

.st-sidebar-header {
    padding: 1.1rem 1rem !important;
    border-bottom: 1px solid var(--sp-border) !important;
    display: flex !important; align-items: center !important; justify-content: space-between !important;
    gap: 10px !important; flex-shrink: 0 !important; background: var(--sp-sidebar-bg) !important;
}
.st-sidebar-user { display: flex !important; align-items: center !important; gap: 10px !important; flex: 1 !important; min-width: 0 !important; }
.st-avatar-lg {
    width: 40px !important; height: 40px !important; border-radius: 50% !important;
    background: linear-gradient(135deg, #6366f1, #a855f7) !important; color: #ffffff !important;
    font-weight: 800 !important; font-size: 1.05rem !important; display: flex !important;
    align-items: center !important; justify-content: center !important; flex-shrink: 0 !important;
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3) !important;
}
.st-user-meta { min-width: 0 !important; flex: 1 !important; }
.st-user-name { margin: 0 !important; font-size: 0.9rem !important; font-weight: 800 !important; color: #0f172a !important; white-space: nowrap !important; overflow: hidden !important; text-overflow: ellipsis !important; }
.st-user-school { margin: 1px 0 0 !important; font-size: 0.72rem !important; color: var(--sp-muted) !important; font-weight: 600 !important; white-space: nowrap !important; overflow: hidden !important; text-overflow: ellipsis !important; }

.st-sidebar-close {
    background: rgba(99, 102, 241, 0.08) !important; border: 1px solid #e2e8f0 !important;
    color: var(--sp-muted) !important; width: 32px !important; height: 32px !important; border-radius: 50% !important;
    display: flex !important; align-items: center !important; justify-content: center !important;
    font-size: 0.95rem !important; cursor: pointer !important; flex-shrink: 0 !important;
}

.st-sidebar-nav {
    flex: 1 !important; overflow-y: auto !important; padding: 0.85rem 0.75rem !important;
    display: flex !important; flex-direction: column !important; gap: 4px !important;
}

.st-nav-item {
    display: flex !important; align-items: center !important; height: 48px !important; min-height: 48px !important;
    padding: 0 12px !important; border-radius: 12px !important; color: var(--sp-muted) !important;
    font-size: 0.88rem !important; font-weight: 600 !important; text-decoration: none !important;
    background: transparent !important; border: none !important; border-left: 3.5px solid transparent !important;
    width: 100% !important; cursor: pointer !important; transition: all 0.2s ease !important;
    box-sizing: border-box !important; white-space: nowrap !important;
}
.st-nav-item:hover { background: rgba(99, 102, 241, 0.08) !important; color: #6366f1 !important; }
.st-nav-item.active { background: rgba(99, 102, 241, 0.1) !important; color: #4f46e5 !important; border-left: 4px solid #818cf8 !important; font-weight: 700 !important; }

.st-nav-icon { width: 24px !important; height: 24px !important; font-size: 1.15rem !important; display: inline-flex !important; align-items: center !important; justify-content: center !important; flex-shrink: 0 !important; margin-right: 12px !important; }
.st-nav-text { flex: 1 !important; text-align: left !important; white-space: nowrap !important; overflow: hidden !important; text-overflow: ellipsis !important; }

.st-sidebar-footer {
    padding: 0.85rem 0.75rem !important; border-top: 1px solid var(--sp-border) !important;
    flex-shrink: 0 !important; background: var(--sp-sidebar-bg) !important; display: flex !important; flex-direction: column !important; gap: 6px !important;
}
.st-footer-btn {
    display: flex !important; align-items: center !important; height: 44px !important; min-height: 44px !important;
    padding: 0 12px !important; border-radius: 10px !important; font-size: 0.85rem !important; font-weight: 700 !important;
    color: var(--sp-muted) !important; text-decoration: none !important; background: rgba(99, 102, 241, 0.06) !important;
    border: 1px solid #e2e8f0 !important; transition: all 0.2s ease !important; width: 100% !important; cursor: pointer !important;
}
.st-footer-btn:hover { background: rgba(99, 102, 241, 0.12) !important; color: #6366f1 !important; }
.st-footer-btn.danger { background: rgba(239, 68, 68, 0.08) !important; color: #dc2626 !important; border-color: rgba(239, 68, 68, 0.2) !important; }

.st-overlay-dim {
    position: fixed !important; inset: 0 !important; background: rgba(3, 7, 18, 0.8) !important;
    /* blur removed */ /* blur removed */
    z-index: 9998 !important; opacity: 0 !important; pointer-events: none !important; transition: opacity 0.28s ease !important;
}
.st-overlay-dim.active { opacity: 1 !important; pointer-events: auto !important; }

/* ── CONTENT AREA ── */
.st-content { padding: 1.25rem !important; display: flex !important; flex-direction: column !important; gap: 1.25rem !important; background: var(--sp-bg) !important; }

.browse-hero-card {
    background: linear-gradient(135deg, #eef2ff, #e0e7ff) !important;
    border: 1px solid rgba(99, 102, 241, 0.25) !important;
    border-radius: 20px !important;
    padding: 1.5rem !important;
    color: #312e81 !important;
    box-shadow: 0 10px 30px rgba(99, 102, 241, 0.15) !important;
}

.browse-books-grid {
    display: grid !important;
    grid-template-columns: repeat(2, 1fr) !important;
    gap: 12px !important;
    width: 100% !important;
    box-sizing: border-box !important;
}
@media (min-width: 600px) { .browse-books-grid { grid-template-columns: repeat(3, 1fr) !important; } }
@media (min-width: 600px) { .browse-books-grid { grid-template-columns: repeat(5, 1fr) !important; } }

.browse-book-card {
    background: linear-gradient(145deg, #ffffff, #f8fafc) !important;
    border: 1px solid var(--sp-border) !important;
    border-radius: 16px !important;
    padding: 10px !important;
    display: flex !important;
    flex-direction: column !important;
    overflow: hidden !important;
    box-sizing: border-box !important;
}
.browse-book-cover {
    width: 100% !important;
    height: 170px !important;
    object-fit: cover !important;
    border-radius: 10px !important;
    background: #f1f5f9 !important;
}
.browse-book-title {
    font-size: 0.85rem !important;
    font-weight: 800 !important;
    color: #0f172a !important;
    margin: 8px 0 2px 0 !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
}
.browse-book-author {
    font-size: 0.75rem !important;
    color: var(--sp-muted) !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
}

.st-btn {
    display: inline-flex !important; align-items: center !important; justify-content: center !important;
    gap: 8px !important; padding: 9px 16px !important; min-height: 40px !important; border-radius: 12px !important;
    font-size: 0.85rem !important; font-weight: 700 !important; cursor: pointer !important;
    transition: all 0.2s ease !important; text-decoration: none !important; border: none !important;
    background: rgba(99, 102, 241, 0.08) !important; color: #4f46e5 !important; box-sizing: border-box !important;
}
.st-btn-primary { background: linear-gradient(135deg, #6366f1, #a855f7) !important; color: #ffffff !important; box-shadow: 0 4px 14px rgba(99, 102, 241, 0.3) !important; }
.st-btn-xs { padding: 4px 10px !important; min-height: 32px !important; font-size: 0.75rem !important; border-radius: 8px !important; }

/* REMOVE ALL BOTTOM NAVS */
.bottom-nav, .portal-bottom-nav, nav.bottom-nav, .sp-bottom-nav, .ld-bottom-nav { display: none !important; height: 0 !important; visibility: hidden !important; }

/* ── LIGHT THEME SWEEP: force inline dark-only white text to dark ── */
[style*="color: #ffffff"] { color: #0f172a !important; }
</style>

<div class="st-overlay-dim" id="studentDim" onclick="toggleStudentSidebar()"></div>

<div class="st-shell">
    <!-- ══ SIDEBAR DRAWER ══ -->
    <aside class="st-sidebar" id="studentSidebar">
        <!-- Header -->
        <div class="st-sidebar-header">
            <div class="st-sidebar-user">
                <% const stuName = (typeof session !== 'undefined' && session && (session.user_name || session.name)) ? (session.user_name || session.name) : 'Student'; %>
                <% const stuInitial = stuName.trim()[0].toUpperCase(); %>
                <div class="st-avatar-lg">
                    <%= stuInitial %>
                </div>
                <div class="st-user-meta">
                    <h4 class="st-user-name"><%= stuName %></h4>
                    <p class="st-user-school"><%= (typeof session !== 'undefined' && session && session.school_name) ? session.school_name : 'E-Pathshala Network' %></p>
                </div>
            </div>
            <button class="st-sidebar-close" onclick="toggleStudentSidebar()" aria-label="Close sidebar">✕</button>
        </div>

        <!-- Navigation List -->
        <nav class="st-sidebar-nav">
            <a href="/student" class="st-nav-item">
                <span class="st-nav-icon">🏠</span>
                <span class="st-nav-text">Dashboard</span>
            </a>
            <a href="/student/browse" class="st-nav-item">
                <span class="st-nav-icon">📚</span>
                <span class="st-nav-text">Digital Library</span>
            </a>
            <a href="/digital-library" class="st-nav-item active">
                <span class="st-nav-icon">🌐</span>
                <span class="st-nav-text">Community Library</span>
            </a>
            <a href="/student/my-publications" class="st-nav-item">
                <span class="st-nav-icon">📖</span>
                <span class="st-nav-text">My Books</span>
            </a>
            <a href="/student/assignments" class="st-nav-item">
                <span class="st-nav-icon">📝</span>
                <span class="st-nav-text">Assignments</span>
            </a>
            <a href="/student/requests" class="st-nav-item">
                <span class="st-nav-icon">📋</span>
                <span class="st-nav-text">Book Requests</span>
            </a>
            <a href="/student/calendar" class="st-nav-item">
                <span class="st-nav-icon">📅</span>
                <span class="st-nav-text">Calendar</span>
            </a>
            <a href="/student/goals" class="st-nav-item">
                <span class="st-nav-icon">🎯</span>
                <span class="st-nav-text">Reading Goals</span>
            </a>
            <a href="/student/ai" class="st-nav-item">
                <span class="st-nav-icon">🤖</span>
                <span class="st-nav-text">AI Chat</span>
            </a>
            <a href="/student/notifications" class="st-nav-item">
                <span class="st-nav-icon">🔔</span>
                <span class="st-nav-text">Notifications</span>
            </a>
            <a href="/student/profile" class="st-nav-item">
                <span class="st-nav-icon">👤</span>
                <span class="st-nav-text">My Profile</span>
            </a>
            <a href="/student/settings" class="st-nav-item">
                <span class="st-nav-icon">⚙️</span>
                <span class="st-nav-text">Settings</span>
            </a>
            <a href="/student/help" class="st-nav-item">
                <span class="st-nav-icon">❓</span>
                <span class="st-nav-text">Help & Support</span>
            </a>
        </nav>

        <!-- Sticky Footer -->
        <div class="st-sidebar-footer">
            <a href="/logout" class="st-footer-btn danger">
                <span class="st-nav-icon">🚪</span>
                <span>Logout</span>
            </a>
        </div>
    </aside>

    <!-- ══ MAIN CONTENT ══ -->
    <main class="st-main">
        <!-- Topbar -->
        <div class="st-topbar">
            <div class="st-topbar-left">
                <button class="st-menu-btn" onclick="toggleStudentSidebar()" aria-label="Menu">☰</button>
                <span class="st-brand-title">🌐 Community Digital Library</span>
            </div>
            <div class="st-topbar-right">
                <a href="/student" class="st-btn st-btn-primary st-btn-xs">🏠 Home</a>
            </div>
        </div>

        <div class="st-content">
            <!-- Hero Featured Banner -->
            <div class="browse-hero-card">
                <h2 style="font-family: 'Outfit'; font-size: 1.3rem; color: #ffffff; margin: 0 0 4px 0;">🌐 Global Community Digital Collection</h2>
                <p style="margin: 0; color: #4f46e5; font-size: 0.85rem;">Read books published across the global student and librarian community network!</p>
            </div>

            <!-- Books Grid -->
            <div>
                <h3 style="font-family: 'Outfit'; font-size: 1.1rem; color: #ffffff; margin: 0 0 12px 0;">📚 Community Published Books</h3>
                <div class="browse-books-grid">
                    <% if (typeof books !== 'undefined' && books && books.length > 0) { %>
                        <% books.forEach(b => { %>
                            <div class="browse-book-card">
                                <img src="<%= b.cover_url || b.cover_image || '/static/placeholder-cover.jpg' %>" alt="Cover" class="browse-book-cover">
                                <h4 class="browse-book-title"><%= b.title %></h4>
                                <p class="browse-book-author"><%= b.author || b.student_name || 'Community Author' %></p>
                                <a href="/digital-library/view/<%= b.id %>" class="st-btn st-btn-primary st-btn-xs" style="width: 100%; margin-top: 8px;">Read Book</a>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div style="grid-column: 1 / -1; text-align: center; color: var(--sp-muted); padding: 2rem;">No community publications found yet.</div>
                    <% } %>
                </div>
            </div>
        </div>
    </main>
</div>

<script>
function toggleStudentSidebar() {
    const sb = document.getElementById('studentSidebar');
    const dim = document.getElementById('studentDim');
    if (!sb) return;
    sb.classList.toggle('open');
    if (dim) dim.classList.toggle('active', sb.classList.contains('open'));
}

function autoCloseStudentSidebar() {
    if (window.innerWidth <= 600) {
        const sb = document.getElementById('studentSidebar');
        const dim = document.getElementById('studentDim');
        if (sb) sb.classList.remove('open');
        if (dim) dim.classList.remove('active');
    }
}

document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') autoCloseStudentSidebar();
});
</script>
