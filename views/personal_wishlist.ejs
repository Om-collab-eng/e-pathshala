<%- include('layouts/header', { title: 'My Wishlist - Personal Library' }) %>
<link rel="stylesheet" href="/static/personal.css">
<style>
.priority-high { background: rgba(244, 63, 94, 0.1); color: #f43f5e; border: 1px solid rgba(244, 63, 94, 0.2); padding: 3px 8px; border-radius: 12px; font-size: 0.75rem; font-weight: 700; }
.priority-medium { background: rgba(245, 158, 11, 0.1); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.2); padding: 3px 8px; border-radius: 12px; font-size: 0.75rem; font-weight: 700; }
.priority-low { background: rgba(59, 130, 246, 0.1); color: #3b82f6; border: 1px solid rgba(59, 130, 246, 0.2); padding: 3px 8px; border-radius: 12px; font-size: 0.75rem; font-weight: 700; }
</style>

<div class="personal-layout">
    <aside class="personal-sidebar">
        <div class="personal-brand"><span>📚</span><span>Librika Personal</span></div>
        <nav class="personal-nav">
            <a href="/personal/dashboard" class="personal-nav-link"><span>🏠</span> Dashboard</a>
            <a href="/personal/books" class="personal-nav-link"><span>📖</span> My Books</a>
            <a href="/personal/reading" class="personal-nav-link"><span>⏱️</span> Reading Tracker</a>
            <a href="/personal/borrowing" class="personal-nav-link"><span>🤝</span> Lending System</a>
            <a href="/personal/wishlist" class="personal-nav-link active"><span>✨</span> Wishlist</a>
            <a href="/personal/favorites" class="personal-nav-link"><span>⭐</span> Favorites</a>
            <a href="/personal/elibrary" class="personal-nav-link"><span>🌐</span> E-Library</a>
            <a href="/personal/scan" class="personal-nav-link"><span>📷</span> AI Scanner</a>
            <a href="/personal/settings" class="personal-nav-link"><span>⚙️</span> Settings & Plan</a>
            <hr style="border: 0; border-top: 1px solid var(--glass-border); margin: 1.5rem 0;">
            <a href="/logout" class="personal-nav-link" style="color: #f43f5e;"><span>🚪</span> Sign Out</a>
        </nav>
        <div class="personal-sidebar-profile">
            <img src="<%= lib.profile_photo || 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=100&q=80' %>" class="personal-profile-pic" alt="Profile">
            <div style="flex: 1; overflow: hidden;">
                <div style="font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%= session.user_name %></div>
                <div style="font-size: 0.75rem; color: #9ca3af; text-transform: uppercase;"><%= lib.plan_name %> PLAN</div>
            </div>
        </div>
    </aside>

    <main class="personal-content">
        <% if (locals.messages && messages.success) { %><div style="padding: 12px; margin-bottom: 20px; border-radius: 8px; font-weight: 500; font-size: 0.9rem; background: rgba(16, 185, 129, 0.1); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.2);"><%= messages.success %></div><% } %>
        <% if (locals.messages && messages.error) { %><div style="padding: 12px; margin-bottom: 20px; border-radius: 8px; font-weight: 500; font-size: 0.9rem; background: rgba(244, 63, 94, 0.1); color: #f43f5e; border: 1px solid rgba(244, 63, 94, 0.2);"><%= messages.error %></div><% } %>

        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 15px;">
            <div>
                <h1 style="margin: 0; font-size: 2.2rem; background: linear-gradient(135deg, #ffffff 0%, #9ca3af 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Book Wishlist</h1>
                <p style="color: #9ca3af; margin: 4px 0 0 0;">Save books you want to purchase and track buying priority</p>
            </div>
            <button class="btn-neon" onclick="document.getElementById('addWishModal').style.display='flex'">➕ Add to Wishlist</button>
        </div>

        <div class="personal-card">
            <% if (wishlist && wishlist.length > 0) { %>
            <div style="overflow-x: auto;">
                <table class="responsive-table">
                    <thead><tr><th>Book Title</th><th>Author</th><th>Priority</th><th>Price</th><th>Purchase Link</th><th>Notes</th><th>Actions</th></tr></thead>
                    <tbody>
                        <% wishlist.forEach(function(item) { %>
                        <tr>
                            <td style="color: white; font-weight: 600;"><%= item.title %></td>
                            <td><%= item.author || 'Unknown' %></td>
                            <td><span class="<%= item.priority === 'High' ? 'priority-high' : item.priority === 'Medium' ? 'priority-medium' : 'priority-low' %>"><%= item.priority %></span></td>
                            <td><%= item.price ? '$' + parseFloat(item.price).toFixed(2) : 'N/A' %></td>
                            <td><%= item.purchase_link ? '<a href="' + item.purchase_link + '" target="_blank" style="color: #3b82f6; text-decoration: none; font-weight: 600;">🔗 Shop Now</a>' : '-' %></td>
                            <td style="font-size: 0.85rem; color: #9ca3af; max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="<%= item.notes %>"><%= item.notes || '-' %></td>
                            <td>
                                <div style="display: flex; gap: 10px; align-items: center;">
                                    <form action="/personal/wishlist/buy/<%= item.id %>" method="POST" style="display:inline;">
                                        <button type="submit" class="btn-neon" style="padding: 4px 10px; font-size: 0.75rem; border-radius: 6px; color: black !important;" title="Move to Collection">🛒 Bought</button>
                                    </form>
                                    <form action="/personal/wishlist/delete/<%= item.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Remove this item from wishlist?');">
                                        <button type="submit" style="background: none; border: none; cursor: pointer; font-size: 1rem; color: #f43f5e;">🗑️</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <% } else { %>
            <p style="color: #9ca3af; text-align: center; padding: 3rem 0;">Your wishlist is currently empty. Add books you want to buy!</p>
            <% } %>
        </div>

        <!-- Add Wishlist Modal -->
        <div id="addWishModal" style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.8); z-index: 10000; display: none; align-items: center; justify-content: center; backdrop-filter: blur(10px);">
            <div class="personal-card" style="width: 450px;">
                <h2 style="margin-top: 0; color: white;">Add to Wishlist</h2>
                <form action="/personal/wishlist/add" method="POST" style="margin-top: 1.5rem;">
                    <div class="input-group">
                        <label for="title">Book Title</label>
                        <input type="text" id="title" name="title" required placeholder="E.g. Sapiens">
                    </div>
                    <div class="input-group">
                        <label for="author">Author</label>
                        <input type="text" id="author" name="author" placeholder="E.g. Yuval Noah Harari">
                    </div>
                    <div class="input-group">
                        <label for="priority">Priority</label>
                        <select id="priority" name="priority" style="width: 100%; padding: 0.8rem; border-radius: 8px; border: 1px solid var(--border); background: var(--bg-input); color: white;">
                            <option value="High">High Priority</option>
                            <option value="Medium" selected>Medium Priority</option>
                            <option value="Low">Low Priority</option>
                        </select>
                    </div>
                    <div class="input-group">
                        <label for="price">Target Price ($)</label>
                        <input type="number" step="0.01" id="price" name="price" placeholder="E.g. 14.99">
                    </div>
                    <div class="input-group">
                        <label for="purchase_link">Purchase Link</label>
                        <input type="url" id="purchase_link" name="purchase_link" placeholder="E.g. https://amazon.com/dp/...">
                    </div>
                    <div class="input-group">
                        <label for="notes">Notes</label>
                        <textarea id="notes" name="notes" placeholder="Why do you want this book?" style="width: 100%; padding: 0.8rem; border-radius: 8px; border: 1px solid var(--border); background: var(--bg-input); color: white; font-family: inherit;"></textarea>
                    </div>
                    <div style="display: flex; gap: 10px; justify-content: flex-end; margin-top: 1.5rem;">
                        <button type="button" class="btn-alt" onclick="document.getElementById('addWishModal').style.display='none'">Cancel</button>
                        <button type="submit" class="btn-neon">Save Wish</button>
                    </div>
                </form>
            </div>
        </div>
    </main>
</div>
<%- include('layouts/footer') %>
