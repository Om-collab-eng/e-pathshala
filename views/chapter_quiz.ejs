<%- layout("base") %>
<% block('head').append(`
<link rel="stylesheet" href="/student.css">
<style>
  @media (max-width: 640px) {
    .dashboard { padding: 0 10px !important; }
    .glow-box { padding: 16px 12px !important; border-radius: 14px !important; }
    .quiz-option-label {
      padding: 12px 14px !important;
      min-height: 48px !important;
      border-radius: 10px !important;
    }
    .quiz-submit-btn {
      width: 100% !important;
      padding: 14px 20px !important;
      font-size: 1rem !important;
    }
    .header {
      flex-direction: column !important;
      align-items: flex-start !important;
      gap: 12px !important;
    }
    .quiz-indent {
      padding-left: 0 !important;
      margin-top: 10px !important;
    }
  }
  .quiz-option-label:has(input:checked) {
    background: rgba(11, 94, 215, 0.1) !important;
    border-color: #0B5ED7 !important;
  }
</style>
`) %>
<% contentFor("title") %>Quiz: <%= chapter.title %> - librika.in
<div class="sp-page">
  <div class="sp-layout">
    <%- include('partials/student_sidebar', { active: 'browse' }) %>
    <div class="sp-main">
      <%- include('partials/student_topbar', { title: 'Chapter Quiz' }) %>
      <main class="sp-content">
<div class="dashboard" style="max-width: 800px; margin: 0 auto; padding: 0 20px;">
    <header class="header" style="display:flex; justify-content:space-between; align-items:center; border-bottom: 1px solid var(--border-color); padding-bottom: 15px; margin-bottom: 25px;">
        <div>
            <span style="font-size: 0.85rem; color: var(--accent-primary); font-weight: bold; text-transform: uppercase;">Chapter Quiz</span>
            <h1 style="margin: 5px 0 0 0; color: var(--text-light); font-size: 1.8rem;"><%= chapter.title %></h1>
            <p style="margin: 5px 0 0 0; color: var(--text-mid); font-size: 0.9rem;">Book: <%= book.title %></p>
        </div>
        <div>
            <a href="/digital-library/chapter/<%= chapter.id %>" class="btn-alt" style="text-decoration: none; padding: 8px 16px; font-size: 0.85rem; min-height: 40px; display: inline-flex; align-items: center;">Back to Reading</a>
        </div>
    </header>

    <div class="glow-box" style="padding: 30px;">
        <form method="POST" action="/digital-library/chapter/<%= chapter.id %>/quiz">
            <% questions.forEach(function(q, idx) { %>
            <div style="margin-bottom: 30px; border-bottom: 1px solid var(--border-color); padding-bottom: 25px;">
                <div style="display: flex; gap: 10px; align-items: flex-start; margin-bottom: 12px;">
                    <span style="background: var(--accent-primary); color: white; border-radius: 50%; width: 26px; height: 26px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.85rem; font-weight: bold; flex-shrink: 0;"><%= idx + 1 %></span>
                    <h3 style="margin: 0; font-size: 1.1rem; color: var(--text-light); line-height: 1.4;"><%= q.question %></h3>
                </div>

                <% if (q.type == 'mcq' || q.type == 'tf') { %>
                    <div class="quiz-indent" style="display: flex; flex-direction: column; gap: 10px; padding-left: 34px;">
                        <% q.options.forEach(function(opt, optIdx) { %>
                        <label class="quiz-option-label" style="display: flex; align-items: center; gap: 12px; cursor: pointer; color: var(--text-mid); font-size: 0.95rem; padding: 10px 14px; background: rgba(255,255,255,0.02); border: 1.5px solid var(--border-color); border-radius: 8px; transition: 0.2s; min-height: 44px;">
                            <input type="radio" name="q_<%= idx %>" value="<%= optIdx %>" required style="accent-color: var(--accent-primary); width: 18px; height: 18px;">
                            <span><%= opt %></span>
                        </label>
                        <% }); %>
                    </div>
                <% } else if (q.type == 'fib') { %>
                    <div class="quiz-indent" style="padding-left: 34px; margin-top: 10px;">
                        <input type="text" name="q_<%= idx %>" required placeholder="Type your answer here..." style="width: 100%; max-width: 400px; padding: 12px 14px; border-radius: 8px; background: rgba(255,255,255,0.05); color: var(--text-high); border: 1px solid var(--border-color); font-size: 0.95rem; min-height: 44px;">
                    </div>
                <% } else if (q.type == 'sa') { %>
                    <div class="quiz-indent" style="padding-left: 34px; margin-top: 10px;">
                        <textarea name="q_<%= idx %>" required rows="4" placeholder="Write your short answer here..." style="width: 100%; padding: 12px 16px; border-radius: 8px; background: rgba(255,255,255,0.05); color: var(--text-high); border: 1px solid var(--border-color); font-size: 0.95rem; line-height: 1.5; font-family: inherit; resize: vertical;"></textarea>
                        <div style="font-size: 0.75rem; color: var(--text-low); margin-top: 4px;">AI will evaluate your answer for conceptual completeness.</div>
                    </div>
                <% } %>
            </div>
            <% }); %>

            <div style="text-align: center; margin-top: 2rem;">
                <button type="submit" class="btn-neon quiz-submit-btn" style="font-size: 1.1rem; padding: 14px 40px; min-height: 48px;">Submit Quiz Responses</button>
            </div>
        </form>
    </div>
</div>

      </main>
    </div>
  </div>
</div>
