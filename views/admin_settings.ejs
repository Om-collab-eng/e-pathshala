                <a href="/admin" class="ld-logo">
                    <div class="ld-logo-icon" style="background: #ffffff; padding: 2px;">
                        <img src="/static/logo.png" style="width: 100%; height: 100%; object-fit: contain; border-radius: inherit;">
                    </div>
                    <div>
                        <h4>Librika</h4>
                        <p>Librarian Panel</p>
                    </div>
                </a>
            </div>
            <div class="ld-topbar-right">
                <div class="ld-avatar-btn" onclick="openModal('viewSchoolModal')"><%= (session.user_name || 'L')[0].toUpperCase() %></div>
            </div>
        </div>

        <!-- Page Content -->
        <div class="ld-content">

            <!-- Title Welcome -->
            <div class="ld-welcome" style="margin-bottom: 0.5rem;">
                <div>
                    <h1 style="display:flex; align-items:center; gap:8px;">⚙️ Library Settings</h1>
                    <p>Security & Library Controls</p>
                </div>
                <div class="ld-date-chip">
                    <a href="/admin" style="text-decoration:none; color:inherit; display:flex; align-items:center; gap:4px; font-weight:700;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                        Dashboard
                    </a>
                </div>
            </div>

            <!-- Form Card panel -->
            <div class="ld-panel" style="max-width: 650px; margin: 0 auto; width: 100%;">
                <div class="ld-panel-header" style="border-bottom: 1px solid var(--border); padding-bottom: 12px; margin-bottom: 8px;">
                    <h3 class="ld-panel-title">Update Credentials</h3>
                    <p style="font-size: 0.78rem; color: var(--muted); margin-top: 1px;">Make changes to your institution display details && dynamic codes.</p>
                </div>

                <form method="POST">
                    <div class="ld-form-group">
                        <label for="new_name">Library Display Name</label>
                        <input type="text" id="new_name" name="new_name" value="<%= school.name %>" class="ld-input" required placeholder="e.g. Greenwood Library">
                    </div>

                    <div class="ld-form-group">
                        <label for="due_days">Custom Due Days (Allocation Duration)</label>
                        <input type="number" id="due_days" name="due_days" value="<%= school.due_days || 3 %>" class="ld-input" required min="1" max="365" placeholder="e.g. 3">
                    </div>

                    <div class="ld-form-group">
                        <label for="new_code">Dynamic Library Code</label>
                        <input type="text" id="new_code" name="new_code" value="<%= school.school_code %>" class="ld-input" required pattern="[A-Z0-9\-]+" placeholder="e.g. GREENWOOD-101">
                        
                        <!-- Warning message box -->
                        <div style="background: var(--lr-light); border: 1.5px solid rgba(239, 68, 68, 0.2); border-radius: 12px; padding: 10px 14px; color: var(--lr); font-size: 0.75rem; font-weight: 600; margin-top: 8px; display: flex; align-items: flex-start; gap: 8px;">
