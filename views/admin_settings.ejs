                    <a href="/logout" class="ld-btn-alt ld-btn-danger" style="width: 100%; text-decoration: none;">Switch to Platform Account</a>
                </div>
            </div>

        </div><!-- end ld-content -->

        <!-- Mobile Bottom Nav -->
        

    </div><!-- end ld-main -->
</div><!-- end ld-shell -->

<!-- ══ MODALS ══ -->
<div id="viewSchoolModal" class="ld-modal-overlay">
    <div class="ld-modal-content" style="max-width: 480px;">
        <button class="ld-modal-close" onclick="closeModal('viewSchoolModal')">✕</button>
        <h3 class="ld-modal-title">🏫 School Profile & Subscriptions</h3>
        
        <div style="display: grid; grid-template-columns: 1fr; gap: 14px; font-size: 0.88rem;">
            <div>
                <span style="color:var(--muted); font-weight:700; display:block; margin-bottom:2px;">LIBRARY NAME</span>
                <span style="font-weight:800; font-size:1rem; color:var(--text);"><%= (session.school_name || 'librika.in') %></span>
            </div>
            <div>
                <span style="color:var(--muted); font-weight:700; display:block; margin-bottom:2px;">LIBRARY UNIQUE CODE</span>
                <code style="background:var(--bg); border:1px solid var(--border); padding:4px 8px; border-radius:6px; font-weight:800; font-family:monospace; color:var(--lp); font-size:0.85rem;"><%= (session.school_code || 'GLOBAL') %></code>
            </div>
            <hr style="border:0; border-top:1px solid var(--border); margin:4px 0;">
            <h4 style="font-family:'Outfit'; font-weight:800; color:var(--lp);">Plan Allowances & Quota</h4>
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <span style="font-weight:700; color:var(--mid);">Active Plan</span>
                <span class="ld-badge ld-badge-warning" style="font-size:0.75rem; padding:4px 12px; background:var(--lp-light); color:var(--lp);"><%= school_plan %></span>
            </div>
        </div>
        <div style="display: flex; gap: 10px; margin-top: 1.5rem; width: 100%;">
            <a href="/logout" class="ld-btn ld-btn-danger" style="flex: 1; text-decoration: none; justify-content: center;">🚪 Log Out</a>
            <button class="ld-btn" onclick="closeModal('viewSchoolModal')" style="flex: 1; justify-content: center; background: var(--bg); color: var(--text); border: 1px solid var(--border);">Close Details</button>
        </div>
    </div>
</div>

<script>
    // Modal Helpers
    function openModal(modalId) {
        document.getElementById(modalId).style.display = 'flex';
    }
    function closeModal(modalId) {
        document.getElementById(modalId).style.display = 'none';
    }
    window.onclick = function(event) {
        if (event.target.classList.contains('ld-modal-overlay')) {
            event.target.style.display = 'none';
        }
    }
</script>
</%>
<style>
/* LIBRIKA LIGHT PREMIUM — accent realignment (admin_settings) */
:root {
  --lp: #2563eb !important;
  --lp-mid: #4f46e5 !important;
  --accent-primary: #2563eb !important;
}
</style>
