  <!-- ═════════════════════════════════════════════════════════════════
       5. CLIENT-SIDE JAVASCRIPT LOGIC
       ═════════════════════════════════════════════════════════════════ -->
  <script>
    // Module Navigation Switcher
    function switchStudentModule(moduleName, btnEl = null, subTab = null) {
      document.querySelectorAll('.sp-module-view').forEach(m => m.classList.remove('active'));
      document.querySelectorAll('.sp-nav-btn').forEach(b => b.classList.remove('active'));

      const target = document.getElementById(`module-${moduleName}`);
      if (target) target.classList.add('active');

      // Update sidebar active button
      if (btnEl) {
        btnEl.classList.add('active');
      } else {
        document.querySelectorAll('.sp-nav-btn').forEach(b => {
          if (b.textContent.toLowerCase().includes(moduleName)) {
            b.classList.add('active');
          }
        });
      }

      // Update URL without full reload
      const url = new URL(window.location);
      url.searchParams.set('module', moduleName);
      window.history.pushState({}, '', url);

      // Update mobile bottom dock active button
      document.querySelectorAll('.sp-dock-item').forEach(d => d.classList.remove('active'));
      const dockBtn = document.getElementById('spdock-' + moduleName);
      if (dockBtn) dockBtn.classList.add('active');

      // Close mobile sidebar if open
      const sb = document.getElementById('studentSidebar');
      if (sb) sb.classList.remove('open');
      const backdrop = document.getElementById('spSidebarBackdrop');
      if (backdrop) backdrop.classList.remove('active');
      window.scrollTo({ top: 0, behavior: 'smooth' });

      // Automatically trigger dynamic loaders when entering modules
      if (moduleName === 'learn') {
        loadStudentQuizzes();
        loadStudentAssignments();
      } else if (moduleName === 'catalog') {
        const grid = document.getElementById('catalogGrid');
        if (grid && (!grid.children || grid.children.length === 0 || grid.querySelector('.sp-card'))) {
          loadStudentCatalog();
        }
      }
    }

    function toggleStudentSidebar() {
      const sb = document.getElementById('studentSidebar');
      const backdrop = document.getElementById('spSidebarBackdrop');
      if (sb) {
        const isOpen = sb.classList.toggle('open');
        if (backdrop) backdrop.classList.toggle('active', isOpen);
      }
    }

    // Sub-Tab Switchers
    function switchBorrowingsTab(tab, btn) {
      document.querySelectorAll('.borrowings-tab-pane').forEach(p => p.style.display = 'none');
      document.querySelectorAll('#module-borrowings .sp-tab-btn').forEach(b => b.classList.remove('active'));
      const target = document.getElementById(`borrowings-tab-${tab}`);
      if (target) target.style.display = 'block';
      if (btn) btn.classList.add('active');
    }

    function switchLearnTab(tab, btn) {
      document.querySelectorAll('.learn-tab-pane').forEach(p => p.style.display = 'none');
      document.querySelectorAll('#module-learn .sp-tab-btn').forEach(b => b.classList.remove('active'));
      const target = document.getElementById(`learn-tab-${tab}`);
      if (target) target.style.display = 'block';
      if (btn) btn.classList.add('active');

      if (tab === 'quizzes') {
        loadStudentQuizzes();
      } else if (tab === 'assignments') {
        loadStudentAssignments();
      }
    }

    function switchSavedTab(tab, btn) {
      document.querySelectorAll('.saved-tab-pane').forEach(p => p.style.display = 'none');
      document.querySelectorAll('#module-saved .sp-tab-btn').forEach(b => b.classList.remove('active'));
      const target = document.getElementById(`saved-tab-${tab}`);
      if (target) target.style.display = 'block';
      if (btn) btn.classList.add('active');
    }

    // Modal Helpers
    function openModal(id) {
      const el = document.getElementById(id);
      if (el) el.style.display = 'flex';
    }
    function closeModal(id) {
      const el = document.getElementById(id);
      if (el) el.style.display = 'none';
    }
    function openDigitalPassModal() {
      switchStudentModule('profile');
    }
    function openBookRequestModal() {
      openModal('bookRequestModal');
    }

    // Student Progress Preview (Strictly 3 Metrics & School Isolation)
    async function openStudentProgressPreview(studentId, defaultName) {
      const modal = document.getElementById('studentProgressPreviewModal');
      const nameEl = document.getElementById('previewStudentName');
      const classEl = document.getElementById('previewStudentClass');
      const initialEl = document.getElementById('previewAvatarInitial');
      const loadingEl = document.getElementById('previewLoadingState');
      const restrictedEl = document.getElementById('previewRestrictedState');
      const gridEl = document.getElementById('previewMetricsGrid');
      const booksEl = document.getElementById('previewBooksRead');
      const pointsEl = document.getElementById('previewRecentPoints');
      const streakEl = document.getElementById('previewReadingStreak');
      const streakSubEl = document.getElementById('previewRecordStreakLabel');

      if (!modal) return;
      modal.style.display = 'flex';

      nameEl.textContent = defaultName || 'Student';
      classEl.textContent = 'Student';
      initialEl.textContent = (defaultName || 'S').charAt(0).toUpperCase();

      loadingEl.style.display = 'block';
      restrictedEl.style.display = 'none';
      gridEl.style.display = 'none';

      try {
        const res = await fetch(`/student/api/progress-preview/${encodeURIComponent(studentId)}`);
        const json = await res.json();

        loadingEl.style.display = 'none';

        if (json.success && json.data) {
          const d = json.data;
          nameEl.textContent = d.name || defaultName;
          classEl.textContent = d.class || 'Student';
          initialEl.textContent = (d.name || 'S').charAt(0).toUpperCase();

          booksEl.textContent = d.booksRead || 0;
          pointsEl.textContent = `+${d.recentPoints || 0}`;
          streakEl.textContent = `${d.currentStreak || 0} days`;
          streakSubEl.textContent = d.recordStreak ? `Record: ${d.recordStreak} days` : 'Current streak';

          gridEl.style.display = 'flex';
        } else {
          restrictedEl.textContent = json.message || "This student's reading progress is currently private or restricted.";
          restrictedEl.style.display = 'block';
        }
      } catch (err) {
        loadingEl.style.display = 'none';
        restrictedEl.textContent = 'Unable to connect to progress service. Please try again.';
        restrictedEl.style.display = 'block';
      }
    }

    function closeStudentProgressPreview() {
      const modal = document.getElementById('studentProgressPreviewModal');
      if (modal) modal.style.display = 'none';
    }

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        closeStudentProgressPreview();
      }
    });

    // Publishing Handlers (Max 27MB document validation & progress)
    function validatePubDocSize(input) {
      const alertEl = document.getElementById('pubSizeAlert');
      const submitBtn = document.getElementById('btnSubmitPub');
      if (input.files && input.files[0]) {
        const size = input.files[0].size;
        const max = 27 * 1024 * 1024; // 27MB
        if (size > max) {
          if (alertEl) alertEl.style.display = 'block';
          if (submitBtn) submitBtn.disabled = true;
        } else {
          if (alertEl) alertEl.style.display = 'none';
          if (submitBtn) submitBtn.disabled = false;
        }
      }
    }

    function handlePublishSubmit(e) {
      e.preventDefault();
      const form = document.getElementById('spPublishForm');
      const docInput = document.getElementById('pubDocInput');
      if (docInput.files && docInput.files[0] && docInput.files[0].size > 27 * 1024 * 1024) {
        alert('File size exceeds 27MB limit. Please choose a smaller file.');
        return;
      }
      
      const formData = new FormData(form);
      const progContainer = document.getElementById('pubUploadProgress');
      const progBar = document.getElementById('pubProgressBar');
      const progStatus = document.getElementById('pubProgressStatus');
      const progPct = document.getElementById('pubProgressPct');
      const submitBtn = document.getElementById('btnSubmitPub');

      progContainer.style.display = 'block';
      submitBtn.disabled = true;
      submitBtn.innerText = 'Uploading Document...';

      const xhr = new XMLHttpRequest();
      xhr.open('POST', '/student/publish');
      xhr.setRequestHeader('X-Requested-With', 'XMLHttpRequest');

      xhr.upload.onprogress = function(event) {
        if (event.lengthComputable) {
          const pct = Math.round((event.loaded / event.total) * 100);
          progBar.style.width = pct + '%';
          progPct.innerText = pct + '%';
          progStatus.innerText = `Uploading document (${pct}%)...`;
        }
      };

      xhr.onload = function() {
        if (xhr.status >= 200 && xhr.status < 300) {
          progStatus.innerText = '✅ Upload & Publishing Complete!';
          progBar.style.background = '#16A34A';
          setTimeout(() => {
            window.location.href = '/student?module=my-publications';
          }, 800);
        } else {
          try {
            const err = JSON.parse(xhr.responseText);
            alert('Publishing error: ' + (err.message || 'Upload failed'));
          } catch(e) {
            alert('Upload failed with status ' + xhr.status);
          }
          submitBtn.disabled = false;
          submitBtn.innerText = '🚀 Publish to E-Library';
          progContainer.style.display = 'none';
        }
      };

      xhr.onerror = function() {
        alert('Network error while uploading book.');
        submitBtn.disabled = false;
        submitBtn.innerText = '🚀 Publish to E-Library';
        progContainer.style.display = 'none';
      };

      xhr.send(formData);
    }

    // Actions
    async function reserveBook(bookId) {
      try {
        const res = await fetch(`/student/catalog/${bookId}/reserve`, { method: 'POST' });
        const data = await res.json();
        alert(data.message || (data.success ? 'Book reserved!' : 'Could not reserve'));
        if (data.success) window.location.reload();
      } catch (e) {
        alert('Network error: ' + e.message);
      }
    }

    async function renewLoan(loanId) {
      try {
        const res = await fetch(`/student/borrowings/${loanId}/renew`, { method: 'POST' });
        const data = await res.json();
        alert(data.message || (data.success ? 'Loan renewed!' : 'Renewal failed'));
        if (data.success) window.location.reload();
      } catch (e) {
        alert('Error: ' + e.message);
      }
    }

    async function toggleSaveBook(bookId, btn) {
      try {
        const res = await fetch(`/student/saved/books/${bookId}/toggle`, { method: 'POST' });
        const data = await res.json();
        if (btn) btn.textContent = data.saved ? '⭐' : '☆';
      } catch (e) {}
    }

    async function toggleSaveDoc(docId, btn) {
      try {
        const res = await fetch(`/student/saved/documents/${docId}/toggle`, { method: 'POST' });
        const data = await res.json();
        if (btn) btn.textContent = data.saved ? '⭐' : '☆';
      } catch (e) {}
    }

    async function submitBookRequest(e) {
      e.preventDefault();
      const title = document.getElementById('reqBookTitle').value.trim();
      const author = document.getElementById('reqBookAuthor').value.trim();
      const reason = document.getElementById('reqBookReason').value.trim();
      try {
        const res = await fetch('/student/saved/requests', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title, author, reason })
        });
        const data = await res.json();
        alert(data.message || 'Request submitted');
        closeModal('bookRequestModal');
      } catch (e) {
        alert('Error: ' + e.message);
      }
    }

    function switchQuizSubTab(tab, btn) {
      document.querySelectorAll('#learn-tab-quizzes .sp-tab-btn').forEach(b => b.classList.remove('active'));
      if (btn) btn.classList.add('active');
      const offPane = document.getElementById('quiz-subpane-offline');
      const digPane = document.getElementById('quiz-subpane-digital');
      if (tab === 'offline') {
        if (offPane) offPane.style.display = 'block';
        if (digPane) digPane.style.display = 'none';
      } else {
        if (offPane) offPane.style.display = 'none';
        if (digPane) digPane.style.display = 'block';
      }
    }

    // Reusable animated skeleton loader
    function renderSkeletonCards(count = 3, type = 'card') {
      let html = '';
      for (let i = 0; i < count; i++) {
        if (type === 'book') {
          html += `
            <div class="sp-book-card" style="animation: pulse 1.5s infinite; opacity: 0.7;">
              <div style="height: 180px; background: rgba(0,0,0,0.06); border-radius: 12px 12px 0 0;"></div>
              <div class="sp-book-info">
                <div style="height: 18px; width: 75%; background: rgba(0,0,0,0.08); border-radius: 4px; margin-bottom: 8px;"></div>
                <div style="height: 14px; width: 45%; background: rgba(0,0,0,0.05); border-radius: 4px; margin-bottom: 12px;"></div>
                <div style="height: 32px; width: 100%; background: rgba(0,0,0,0.06); border-radius: 8px;"></div>
              </div>
            </div>
          `;
        } else {
          html += `
            <div class="sp-card" style="animation: pulse 1.5s infinite; opacity: 0.7; min-height: 180px; display:flex; flex-direction:column; justify-content:space-between; margin-bottom:0;">
              <div>
                <div style="width: 80px; height: 20px; background: rgba(0,0,0,0.08); border-radius: 999px; margin-bottom: 12px;"></div>
                <div style="width: 85%; height: 20px; background: rgba(0,0,0,0.08); border-radius: 6px; margin-bottom: 8px;"></div>
                <div style="width: 60%; height: 14px; background: rgba(0,0,0,0.05); border-radius: 4px; margin-bottom: 8px;"></div>
                <div style="width: 40%; height: 14px; background: rgba(0,0,0,0.05); border-radius: 4px;"></div>
              </div>
              <div style="width: 100%; height: 36px; background: rgba(0,0,0,0.08); border-radius: 8px; margin-top: 14px;"></div>
            </div>
          `;
        }
      }
      return html;
    }

    // ── QUIZZES LOADER ──────────────────────────────────────────────────────────
    async function loadStudentQuizzes() {
      const offGrid = document.getElementById('offlineQuizGrid');
      const digGrid = document.getElementById('digitalQuizGrid');

      if (offGrid) offGrid.innerHTML = renderSkeletonCards(3);
      if (digGrid) digGrid.innerHTML = renderSkeletonCards(3);

      try {
        const res = await fetch('/api/quizzes/student');
        if (!res.ok) throw new Error(`Server returned HTTP ${res.status}`);
        const data = await res.json();
        if (data.status !== 'success') throw new Error(data.message || 'Failed to fetch quizzes');

        const renderQuizCards = (list, isOffline) => {
          if (!list || list.length === 0) {
            return `
              <div class="sp-card" style="grid-column: 1 / -1;text-align:center;padding:48px 20px;">
                <span style="font-size:2.5rem;display:block;margin-bottom:8px;">${isOffline ? '📚' : '📱'}</span>
                <h4 style="margin:0 0 6px 0;font-size:1.1rem;font-weight:800;">No Quizzes Available</h4>
                <p style="margin:0;font-size:0.88rem;color:var(--text-secondary);">
                  ${isOffline ? 'Borrow physical books from the library to unlock comprehension quizzes!' : 'Read e-books and PDFs in the E-Library to unlock digital quizzes!'}
                </p>
              </div>
            `;
          }

          return list.map(q => {
            let statusPill = '';
            let actionBtn = '';

            if (q.card_status === 'PASSED') {
              statusPill = `<span class="sp-pill green" style="margin-bottom:8px;">🎉 Passed (${q.best_score}%)</span>`;
              actionBtn = `<a href="/quizzes/${q.id}/take" class="btn-secondary" style="width:100%;text-align:center;text-decoration:none;display:block;">Review / Retake</a>`;
            } else if (q.card_status === 'IN_PROGRESS') {
              statusPill = `<span class="sp-pill yellow" style="margin-bottom:8px;">⏳ In Progress</span>`;
              actionBtn = `<a href="/quizzes/${q.id}/take" class="btn-primary" style="width:100%;text-align:center;text-decoration:none;display:block;">Resume Quiz &rarr;</a>`;
            } else if (q.card_status === 'AVAILABLE') {
              statusPill = `<span class="sp-pill indigo" style="margin-bottom:8px;">✨ Available</span>`;
              actionBtn = `<a href="/quizzes/${q.id}/take" class="btn-primary" style="width:100%;text-align:center;text-decoration:none;display:block;">Start Quiz &rarr;</a>`;
            } else if (q.card_status === 'MAX_ATTEMPTS_REACHED') {
              statusPill = `<span class="sp-pill red" style="margin-bottom:8px;">⛔ Max Attempts Used</span>`;
              actionBtn = `<button class="btn-secondary" style="width:100%;opacity:0.6;cursor:not-allowed;" disabled>No Attempts Left</button>`;
            } else {
              statusPill = `<span class="sp-pill red" style="margin-bottom:8px;">🔒 Locked</span>`;
              actionBtn = `<button class="btn-secondary" style="width:100%;opacity:0.6;cursor:not-allowed;" title="${q.lock_reason || 'Locked'}" disabled>🔒 Locked</button>`;
            }

            return `
              <div class="sp-card" style="margin-bottom:0;display:flex;flex-direction:column;justify-content:space-between;">
                <div>
                  ${statusPill}
                  <h4 style="margin:0 0 6px 0;font-size:1.05rem;font-weight:800;line-height:1.3;">${q.title}</h4>
                  <div style="font-size:0.82rem;color:var(--text-secondary);font-weight:600;margin-bottom:8px;">
                    📖 ${q.book_title || q.subject || 'Curriculum Quiz'}
                  </div>
                  ${q.card_status === 'LOCKED' ? `
                    <div style="font-size:0.75rem;color:#b91c1c;background:#fee2e2;padding:6px 10px;border-radius:8px;margin-bottom:12px;line-height:1.4;">
                      ℹ️ ${q.lock_reason}
                    </div>
                  ` : `
                    <div style="font-size:0.78rem;color:var(--text-secondary);margin-bottom:14px;">
                      ⏱️ ${q.time_limit || 15} Mins · 🏆 Pass: ${q.passing_percentage || 60}% · 🔄 ${q.attempts_remaining ?? 2} attempts left
                    </div>
                  `}
                </div>
                <div>
                  ${actionBtn}
                </div>
              </div>
            `;
          }).join('');
        };

        if (offGrid) offGrid.innerHTML = renderQuizCards(data.offlineQuizzes, true);
        if (digGrid) digGrid.innerHTML = renderQuizCards(data.digitalQuizzes, false);
      } catch (err) {
