<style>
/* ═══════════════════════════════════════════════
   STUDENT PORTAL — PREMIUM DARK NAVY DESIGN SYSTEM
   Zero Whitespace, Mobile Responsive & Isolated Theme
═══════════════════════════════════════════════ */
html, body {
  background: #060d1f !important;
  background-color: #060d1f !important;
  color: #f1f5f9 !important;
  margin: 0 !important;
  padding: 0 !important;
  padding-top: 0 !important;
  overflow-x: hidden !important;
  width: 100% !important;
  max-width: 100vw !important;
  min-height: 100vh !important;
}

:root {
  --sp-purple: #818cf8;
  --sp-purple-light: rgba(99, 102, 241, 0.15);
  --sp-pink-light: rgba(236, 72, 153, 0.15);
  --sp-pink: #f472b6;
  --sp-orange-light: rgba(249, 115, 22, 0.15);
  --sp-orange: #fb923c;
  --sp-green-light: rgba(16, 185, 129, 0.15);
  --sp-green: #34d399;
  --sp-text-dark: #f1f5f9;
  --sp-text-muted: #94a3b8;
  --sp-bg-light: #060d1f;
  --sp-white: #0d1630;
}

.portal-wrapper {
  width: 100vw !important;
  max-width: 100vw !important;
  margin: 0 !important;
  background: #060d1f !important;
  min-height: 100vh;
  display: flex;
  position: relative;
  overflow-x: hidden;
  font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
  color: #f1f5f9;
}

/* ── STUDENT SIDEBAR ── */
.st-sidebar {
  width: 260px;
  max-width: 85vw;
  background: #080f22;
  border-right: 1px solid rgba(99, 102, 241, 0.14);
  display: flex;
  flex-direction: column;
  position: fixed;
  top: 0;
  left: 0;
  height: 100vh;
  height: 100dvh;
  z-index: 9999;
  transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
  overflow: hidden;
  box-shadow: 4px 0 24px rgba(0, 0, 0, 0.4);
}
@media (max-width: 900px) {
  .st-sidebar { transform: translateX(-105%); }
  .st-sidebar.open { transform: translateX(0); box-shadow: 20px 0 60px rgba(0, 0, 0, 0.8); }
}

.st-sidebar-brand {
  padding: 1.1rem 1.2rem 0.9rem;
  border-bottom: 1px solid rgba(99, 102, 241, 0.12);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.st-brand-logo { display: flex; align-items: center; gap: 10px; }
.st-brand-icon {
  width: 38px; height: 38px;
  background: linear-gradient(135deg, #6366f1, #a855f7);
  border-radius: 10px; display: flex; align-items: center; justify-content: center;
  font-size: 1.15rem; flex-shrink: 0; box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
}
.st-brand-text h2 {
  font-family: 'Outfit', sans-serif; font-size: 1rem; font-weight: 900; margin: 0;
  background: linear-gradient(135deg, #818cf8, #c084fc);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
}
.st-brand-text p { font-size: 0.67rem; color: #475569; margin: 1px 0 0; font-weight: 600; }

.st-sidebar-close-mob {
  display: none; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1);
  color: #94a3b8; width: 36px; height: 36px; border-radius: 9px; align-items: center;
  justify-content: center; font-size: 1.1rem; cursor: pointer;
}
@media (max-width: 900px) { .st-sidebar-close-mob { display: flex; } }

.st-nav {
  flex: 1; overflow-y: auto; padding: 0.75rem 0.6rem;
  scrollbar-width: thin; scrollbar-color: rgba(99, 102, 241, 0.2) transparent;
  -webkit-overflow-scrolling: touch;
}
.st-nav-section-title {
  font-size: 0.64rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1.2px;
  color: #475569; padding: 0.7rem 0.7rem 0.35rem; margin-top: 0.5rem;
  display: flex; align-items: center; justify-content: space-between; cursor: pointer; user-select: none;
}
.st-nav-section-title:first-child { margin-top: 0; }
.st-nav-group { display: flex; flex-direction: column; gap: 2px; }
.st-nav-link {
  display: flex; align-items: center; gap: 10px; padding: 10px 12px; min-height: 44px;
  border-radius: 10px; color: #94a3b8; font-size: 0.83rem; font-weight: 600;
  cursor: pointer; transition: all 0.2s ease; margin-bottom: 2px; border: 1px solid transparent;
  background: none; width: 100%; text-align: left; white-space: nowrap; text-decoration: none; box-sizing: border-box;
}
.st-nav-link:hover { background: rgba(99, 102, 241, 0.1); color: #a5b4fc; }
.st-nav-link.active {
  background: linear-gradient(135deg, rgba(99, 102, 241, 0.24), rgba(168, 85, 247, 0.14));
  color: #a5b4fc; border-left: 3.5px solid #818cf8; border-color: rgba(99, 102, 241, 0.25); font-weight: 700;
}

.st-sidebar-footer {
  padding: 0.85rem; border-top: 1px solid rgba(99, 102, 241, 0.12);
  flex-shrink: 0; background: #080f22; display: flex; flex-direction: column; gap: 8px;
}
.st-user-chip {
  display: flex; align-items: center; gap: 9px; padding: 8px 10px;
  background: rgba(99, 102, 241, 0.08); border-radius: 11px; border: 1px solid rgba(99, 102, 241, 0.14);
}

/* Semi-transparent dark overlay for mobile */
.st-overlay-dim {
  position: fixed; inset: 0; background: rgba(3, 7, 18, 0.75);
  backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
  z-index: 9998; opacity: 0; pointer-events: none; transition: opacity 0.28s ease;
}
.st-overlay-dim.active { opacity: 1; pointer-events: auto; }

/* ── MAIN CONTENT ── */
.st-main {
  margin-left: 260px; flex: 1; display: flex; flex-direction: column;
  min-height: 100vh; width: calc(100vw - 260px); max-width: 100vw; overflow-x: hidden;
}
@media (max-width: 900px) {
  .st-main { margin-left: 0 !important; width: 100vw !important; max-width: 100vw !important; }
}

.st-topbar {
  background: rgba(8, 15, 34, 0.92); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
  border-bottom: 1px solid rgba(99, 102, 241, 0.12); padding: 0.85rem 1.5rem;
  display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; z-index: 100; gap: 12px;
}
.st-mob-toggle {
  display: none; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1);
  color: #e2e8f0; font-size: 1.2rem; cursor: pointer; padding: 8px 12px; border-radius: 10px;
  min-height: 44px; min-width: 44px; align-items: center; justify-content: center;
}
@media (max-width: 900px) { .st-mob-toggle { display: flex; } }

.st-content { padding: 1.5rem; flex: 1; width: 100%; max-width: 100%; overflow-x: hidden; box-sizing: border-box; }

/* ── CARDS & TABLES ISOLATION ── */
.reading-card, .recommend-card, .action-card, .stat-card, .goal-banner {
  background: linear-gradient(145deg, #0d1630, #111c3a) !important;
  border: 1px solid rgba(99, 102, 241, 0.14) !important; color: #f1f5f9 !important;
}
.reading-card-title, .recommend-title, .section-title, .goal-title, .stat-value {
  color: #ffffff !important;
}
.reading-card-author, .recommend-author, .stat-label, .goal-subtitle {
  color: #94a3b8 !important;
}

/* Table containment */
.st-page-wrapper table, .st-page-wrapper td, .st-page-wrapper th, .st-page-wrapper tr {
  display: table-cell !important; background: transparent !important; color: #94a3b8 !important;
}
.st-page-wrapper tr { display: table-row !important; }
.st-page-wrapper table { display: table !important; width: 100% !important; border-collapse: collapse !important; }

    /* Styling variables and custom reset */
    :root {
        --sp-purple: #5c3cf3;
        --sp-purple-light: #f0eeff;
        --sp-pink-light: #fff0f3;
        --sp-pink: #ff4d6d;
        --sp-orange-light: #fff4eb;
        --sp-orange: #ff8800;
        --sp-green-light: #ebfbf2;
        --sp-green: #00b050;
        --sp-text-dark: #ffffff;
        --sp-text-muted: #64748b;
        --sp-bg-light: #060d1f;
        --sp-white: #0d1630;
    }

    /* Wrap page in a centered phone frame mockup on mobile/tablet, and expand to full dashboard on desktop */
    .portal-wrapper {
        width: 100%;
        max-width: 480px;
        margin: 0 auto;
        background-color: var(--sp-bg-light);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        position: relative;
        box-shadow: 0 0 40px rgba(0, 0, 0, 0.1);
        overflow-x: hidden;
        font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
    }

    /* Desktop Sidebar styling (hidden by default on mobile) */
    .desktop-sidebar {
        display: none;
    }

    /* Gradient Header */
    .portal-header {
        background: linear-gradient(180deg, #3b2bc4 0%, #5c3cf3 100%);
        padding: 2.5rem 1.5rem 4rem 1.5rem;
        color: var(--sp-white);
        position: relative;
        overflow: hidden;
        border-bottom-left-radius: 32px;
        border-bottom-right-radius: 32px;
    }

    .portal-header-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .portal-header-actions {
        display: flex;
        gap: 12px;
        align-items: center;
    }

    .header-btn {
        background: rgba(255, 255, 255, 0.15);
        border: none;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--sp-white);
        cursor: pointer;
        font-size: 1.2rem;
        transition: background 0.2s;
    }

    .header-btn:hover {
        background: rgba(255, 255, 255, 0.25);
    }

    .header-badge {
        position: absolute;
        top: -2px;
        right: -2px;
        background: #ef4444;
        color: white;
        font-size: 0.65rem;
        font-weight: 800;
        padding: 2px 6px;
        border-radius: 10px;
        border: 2px solid #3b2bc4;
    }

    .header-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.3);
        border: 2px solid rgba(255, 255, 255, 0.5);
        color: white;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        text-transform: uppercase;
        cursor: pointer;
    }

    .portal-welcome {
        max-width: 60%;
        position: relative;
        z-index: 10;
    }

    .portal-welcome h2 {
        font-family: 'Outfit', sans-serif;
        font-size: 1.8rem;
        font-weight: 800;
        margin: 0 0 4px 0;
        line-height: 1.2;
    }

    .portal-welcome p {
        font-size: 0.9rem;
        color: rgba(255, 255, 255, 0.8);
        margin: 0;
    }

    .header-illustration {
        position: absolute;
        right: 0;
        bottom: 0;
        width: 170px;
        height: 170px;
        pointer-events: none;
        z-index: 2;
    }

    /* Content Area Overlapping */
    .portal-content {
        flex-grow: 1;
        background: var(--sp-bg-light);
        margin-top: -2.5rem;
        border-top-left-radius: 32px;
        border-top-right-radius: 32px;
        padding: 1.5rem 1.5rem 95px 1.5rem; /* Extra bottom padding so Reading Goal card is never clipped by bottom nav */
        position: relative;
        z-index: 20;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        overflow-x: hidden;
    }

    .portal-grid {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    /* Stats Grid */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 10px;
        background: transparent;
        border-radius: 20px;
        padding: 0;
    }

    .stat-card {
        background: #ffffff;
        border-radius: 18px;
        padding: 12px 6px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.04);
        border: 1px solid #f1f5f9;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .stat-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    }

    .stat-icon-wrapper {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        margin-bottom: 6px;
    }

    .stat-value {
        font-size: 1.3rem;
        font-weight: 800;
        color: #0f172a;
        font-family: 'Outfit', sans-serif;
    }

    .stat-label {
        font-size: 0.7rem;
        color: #475569;
        font-weight: 700;
        margin-top: 2px;
    }

    /* Section Headings */
    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.8rem;
    }

    .section-title {
        font-family: 'Outfit', sans-serif;
        font-size: 1.1rem;
        font-weight: 800;
        color: var(--sp-text-dark);
        margin: 0;
    }

    .section-link {
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--sp-purple);
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    /* Continue Reading Card */
    .reading-card {
        background: var(--sp-white);
        border-radius: 24px;
        padding: 1.25rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.03);
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .reading-card-info {
        display: flex;
        gap: 16px;
        align-items: center;
    }

    .reading-card-cover {
        width: 70px;
        height: 100px;
        border-radius: 8px;
        object-fit: cover;
        box-shadow: 0 8px 16px rgba(0,0,0,0.1);
    }

    .reading-card-cover-fallback {
        width: 70px;
        height: 100px;
        border-radius: 8px;
        background: linear-gradient(135deg, var(--sp-purple) 0%, #7033ff 100%);
        box-shadow: 0 8px 16px rgba(0,0,0,0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.8rem;
    }

    .reading-card-details {
        flex-grow: 1;
    }

    .reading-card-title {
        font-size: 1.05rem;
        font-weight: 800;
        color: var(--sp-text-dark);
        margin: 0 0 4px 0;
    }

    .reading-card-author {
        font-size: 0.85rem;
        color: var(--sp-text-muted);
        margin: 0 0 12px 0;
        font-weight: 500;
    }

    .reading-card-progress-text {
        display: flex;
        justify-content: space-between;
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--sp-text-muted);
        margin-bottom: 6px;
    }

    .reading-card-progress-bar {
        height: 6px;
        background: #f1f5f9;
        border-radius: 3px;
        overflow: hidden;
    }

    .reading-card-progress-fill {
        height: 100%;
        background: var(--sp-purple);
        border-radius: 3px;
    }

    .resume-btn {
        background: var(--sp-purple-light);
        color: var(--sp-purple);
        border: none;
        border-radius: 16px;
        padding: 10px;
        font-size: 0.9rem;
        font-weight: 800;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: opacity 0.2s;
        text-decoration: none;
        width: 100%;
        box-sizing: border-box;
    }

    .resume-btn:hover {
        opacity: 0.9;
    }

    /* Quick Actions */
    .actions-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
    }

    .action-card {
        background: var(--sp-white);
        border-radius: 20px;
        padding: 12px 6px;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        box-shadow: 0 8px 20px rgba(0,0,0,0.02);
        text-decoration: none;
        transition: transform 0.2s;
    }

    .action-card:hover {
        transform: translateY(-2px);
    }

    .action-icon-wrapper {
        width: 44px;
        height: 44px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        margin-bottom: 8px;
    }

    .action-label {
        font-size: 0.72rem;
        font-weight: 700;
        color: var(--sp-text-dark);
        line-height: 1.2;
    }

    /* Recommended Scroller */
    .scroller-container {
        display: flex;
        gap: 16px;
        overflow-x: auto;
        padding-bottom: 10px;
        scroll-snap-type: x mandatory;
        scrollbar-width: none; /* Firefox */
    }

    .scroller-container::-webkit-scrollbar {
        display: none; /* Safari/Chrome */
    }

    .recommend-card {
        flex: 0 0 145px;
        background: var(--sp-white);
        border-radius: 20px;
        padding: 12px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.02);
        scroll-snap-align: start;
        display: flex;
        flex-direction: column;
        position: relative;
    }

    .recommend-cover {
        width: 100%;
        height: 155px;
        border-radius: 12px;
        object-fit: cover;
        margin-bottom: 8px;
        box-shadow: 0 6px 12px rgba(0,0,0,0.08);
    }

    .recommend-cover-fallback {
        width: 100%;
        height: 155px;
        border-radius: 12px;
        background: linear-gradient(135deg, var(--sp-purple) 0%, #7c3aed 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.8rem;
        margin-bottom: 8px;
        box-shadow: 0 6px 12px rgba(0,0,0,0.08);
    }

    .recommend-title {
        font-size: 0.85rem;
        font-weight: 800;
        color: var(--sp-text-dark);
        margin: 0 0 2px 0;
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .recommend-author {
        font-size: 0.72rem;
        color: var(--sp-text-muted);
        margin: 0 0 6px 0;
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .recommend-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: auto;
    }

    .recommend-rating {
        display: flex;
        align-items: center;
        gap: 3px;
        font-size: 0.72rem;
        font-weight: 700;
        color: #ffb800;
    }

    .recommend-dots {
        color: var(--sp-text-muted);
        background: none;
        border: none;
        cursor: pointer;
        padding: 4px;
        font-size: 0.9rem;
    }

    /* Daily Reading Goal Banner */
    .goal-banner {
        background: var(--sp-purple-light);
        border-radius: 20px;
        padding: 1rem;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .goal-header {
        display: flex;
        gap: 12px;
        align-items: center;
    }

    .goal-icon-wrapper {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: var(--sp-white);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        box-shadow: 0 4px 10px rgba(92, 60, 243, 0.1);
    }

    .goal-text {
        flex-grow: 1;
    }

    .goal-title {
        font-size: 0.85rem;
        font-weight: 800;
        color: var(--sp-text-dark);
        margin: 0;
    }

    .goal-subtitle {
        font-size: 0.72rem;
        color: var(--sp-text-muted);
        margin: 2px 0 0 0;
        font-weight: 500;
    }

    .goal-value {
        font-size: 0.85rem;
        font-weight: 800;
        color: var(--sp-purple);
    }

    /* Fixed Bottom Nav Bar (Mobile only) */
    .bottom-nav {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        width: 100%;
        max-width: 480px;
        margin: 0 auto;
        height: 68px;
        background: rgba(255, 255, 255, 0.96);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-top: 1px solid rgba(226, 232, 240, 0.9);
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        align-items: center;
        padding: 0 4px;
        box-sizing: border-box;
        z-index: 1000;
        box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.05);
    }

    .bottom-nav-item {
        background: none;
        border: none;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 3px;
        color: #64748b;
        cursor: pointer;
        text-decoration: none;
        font-size: 0.68rem;
        font-weight: 700;
        transition: all 0.2s ease;
        padding: 6px 2px;
        width: 100%;
        box-sizing: border-box;
        text-align: center;
        line-height: 1.1;
    }

    .bottom-nav-icon {
        font-size: 1.25rem;
        line-height: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .bottom-nav-item span:last-child {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 100%;
        letter-spacing: -0.2px;
    }

    .bottom-nav-item:hover,
    .bottom-nav-item.active {
        color: var(--sp-purple);
    }

    .bottom-nav-item.active .bottom-nav-icon {
        transform: translateY(-2px) scale(1.12);
    }

    /* Hide global floaters inside this dashboard */
    .global-nav-container {
        display: none !important;
    }

    /* Responsive Frame on Widescreens (Fully adapt for Laptop) */
    @media (min-width: 768px) {
        body {
            background-color: var(--sp-bg-light) !important;
        }

        .portal-wrapper {
            max-width: none !important;
            margin: 0 !important;
            height: auto !important;
            min-height: 100vh !important;
            flex-direction: row !important;
            box-shadow: none !important;
            border-radius: 0 !important;
            overflow: visible !important;
        }

        .portal-main {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            background-color: var(--sp-bg-light);
            overflow-y: auto;
        }

        /* Desktop Sidebar Navigation styling */
        .desktop-sidebar {
            display: flex !important;
            flex-direction: column;
            width: 260px;
            background: var(--sp-white);
            border-right: 1px solid #e2e8f0;
            padding: 2rem 1.5rem;
            box-sizing: border-box;
            flex-shrink: 0;
            position: sticky;
            top: 0;
            height: 100vh;
            overflow-y: auto;
            z-index: 100;
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 2.5rem;
        }

        .brand-icon {
            font-size: 2rem;
        }

        .brand-info h4 {
            margin: 0;
            font-family: 'Outfit', sans-serif;
            font-size: 1rem;
            font-weight: 800;
            color: var(--sp-text-dark);
        }

        .brand-info p {
            margin: 2px 0 0 0;
            font-size: 0.75rem;
            color: var(--sp-text-muted);
            font-weight: 600;
        }

        .sidebar-menu {
            display: flex;
            flex-direction: column;
            gap: 6px;
            flex-grow: 1;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 14px;
            border-radius: 12px;
            color: var(--sp-text-dark);
            text-decoration: none;
            font-size: 0.88rem;
            font-weight: 700;
            transition: all 0.2s;
        }

        .sidebar-link:hover {
            background-color: var(--sp-purple-light);
            color: var(--sp-purple);
        }

        .sidebar-link.active {
            background-color: var(--sp-purple-light);
            color: var(--sp-purple);
        }

        .sidebar-divider {
            border: none;
            border-top: 1px solid #e2e8f0;
            margin: 1rem 0;
        }

        .logout-link {
            color: #ef4444;
            margin-top: auto;
        }

        .logout-link:hover {
            background-color: #fff0f3;
            color: #ef4444;
        }

        .sidebar-profile-card {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px;
            background: #f8fafc;
            border-radius: 16px;
            margin-top: 1.5rem;
        }

        .profile-card-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: var(--sp-purple);
            color: white;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.95rem;
        }

        .profile-card-info h5 {
            margin: 0;
            font-size: 0.8rem;
            font-weight: 800;
            color: var(--sp-text-dark);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 130px;
        }

        .profile-card-info p {
            margin: 2px 0 0 0;
            font-size: 0.7rem;
            color: var(--sp-text-muted);
            font-weight: 600;
        }

        /* 2-Column layout grid on laptop viewports */
        .portal-grid {
            display: grid !important;
            grid-template-columns: 1.7fr 1fr !important;
            gap: 1.5rem !important;
            align-items: start !important;
        }

        /* Convert Stats Grid to a 2x2 layout inside the right sidebar column */
        .stats-grid {
            grid-template-columns: repeat(2, 1fr) !important;
            gap: 12px !important;
            padding: 1.25rem !important;
        }

        /* Hide mobile bottom nav on desktop */
        .bottom-nav {
            display: none !important;
        }

        /* Hide hamburger icon in header */
        .portal-header-top .header-btn:first-child {
            display: none !important;
        }

        .portal-header {
            padding: 3rem 2.5rem 4.5rem 2.5rem !important;
            border-bottom-left-radius: 36px !important;
            border-bottom-right-radius: 36px !important;
        }

        .portal-header-top {
            margin-bottom: 2rem !important;
            justify-content: flex-end !important; /* Move actions to right since menu button is hidden */
        }

        .portal-welcome h2 {
            font-size: 2.2rem !important;
        }

        .portal-welcome p {
            font-size: 1rem !important;
        }

        .header-illustration {
            width: 200px !important;
            height: 200px !important;
            right: 2.5rem !important;
        }

        /* Premium scrollbar styling for recommended items */
        .scroller-container {
            scrollbar-width: auto;
        }
        .scroller-container::-webkit-scrollbar {
            display: block;
            height: 6px;
        }
        .scroller-container::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 3px;
        }
        .scroller-container::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 3px;
        }
        .scroller-container::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    }

/* ── QUICK ACTIONS & DARK CARDS CONTRAST FIX ── */
.action-card, .qa-card, .quick-action-btn {
    background: linear-gradient(145deg, #0d1630, #111c3a) !important;
    border: 1px solid rgba(99, 102, 241, 0.18) !important;
    border-radius: 16px !important;
    padding: 12px 8px !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    text-align: center !important;
