<%- layout('base') %>

<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
/* ── Student Portal Shell — Light Theme ─────────────────────── */
:root {
    --sp-bg:           #f1f5f9;
    --sp-sidebar-bg:   #ffffff;
    --sp-card-bg:      #ffffff;
    --sp-topbar-bg:    #ffffff;
    --sp-text-dark:    #0f172a;
    --sp-text-mid:     #475569;
    --sp-muted:        #94a3b8;
    --sp-border:       #e2e8f0;
    --sp-accent:       #6366f1;
    --sp-accent-2:     #a855f7;
    --sp-accent-soft:  rgba(99,102,241,0.1);
    --sp-shadow:       0 1px 3px rgba(0,0,0,0.06);
    --sp-shadow-lg:    0 4px 24px rgba(0,0,0,0.08);
    --sp-green:        #10b981;
    --sp-red:          #ef4444;
    --sp-orange:       #f59e0b;
    --sp-purple:       #8b5cf6;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body {
    background: var(--sp-bg) !important;
    color: var(--sp-text-dark) !important;
    font-family: 'Inter', 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif !important;
}

/* ── Layout ────────────────────────────────────────── */
.sp-page   { background: var(--sp-bg) !important; min-height: 100vh; }
.sp-layout { display: flex; min-height: 100vh; background: var(--sp-bg) !important; }
.sp-main   { flex: 1; min-width: 0; display: flex; flex-direction: column; background: var(--sp-bg) !important; }
.sp-content{ flex: 1; padding: 1.5rem; max-width: 1280px; width: 100%; margin: 0 auto; }
@media (max-width: 600px) { .sp-content { padding: 1rem; } }

/* ── Topbar ────────────────────────────────────────── */
.sp-topbar {
    background: var(--sp-topbar-bg) !important;
    border-bottom: 1px solid var(--sp-border) !important;
    box-shadow: var(--sp-shadow) !important;
    padding: 0.85rem 1.5rem;
    display: flex; align-items: center; gap: 1rem;
    position: sticky; top: 0; z-index: 100;
}
.sp-hamburger {
    display: none;
    background: #f8fafc !important;
    border: 1px solid var(--sp-border) !important;
    color: var(--sp-text-dark) !important;
    width: 38px; height: 38px;
    border-radius: 8px; font-size: 1.1rem;
    cursor: pointer; align-items: center; justify-content: center;
}
@media (max-width: 900px) { .sp-hamburger { display: flex; } }
.sp-topbar-info  { flex: 1; }
.sp-topbar-title { font-size: 1.05rem; font-weight: 700; color: var(--sp-text-dark) !important; }
.sp-topbar-sub   { font-size: 0.78rem; color: var(--sp-muted) !important; }
.sp-topbar-actions { display: flex; align-items: center; gap: 10px; }
.sp-notif-btn {
    background: #f8fafc !important;
    border: 1px solid var(--sp-border) !important;
    color: var(--sp-text-mid) !important;
    width: 38px; height: 38px;
    border-radius: 8px; font-size: 1rem;
    cursor: pointer; position: relative;
    display: flex; align-items: center; justify-content: center;
    text-decoration: none; transition: all 0.15s;
}
.sp-notif-btn:hover { color: var(--sp-accent) !important; border-color: var(--sp-accent) !important; }
.sp-notif-count {
    position: absolute; top: -5px; right: -5px;
    background: var(--sp-red) !important; color: #fff !important;
    font-size: 0.6rem; font-weight: 800;
    border-radius: 999px; min-width: 16px; height: 16px;
    display: flex; align-items: center; justify-content: center; padding: 0 3px;
}
.sp-user-chip {
    display: flex; align-items: center; gap: 8px;
    padding: 4px 10px 4px 4px;
    background: #f8fafc !important;
    border: 1px solid var(--sp-border) !important;
    border-radius: 999px; cursor: pointer; transition: all 0.15s;
}
.sp-user-chip:hover { border-color: var(--sp-accent) !important; }
.sp-avatar {
    width: 30px; height: 30px; border-radius: 50%;
    background: linear-gradient(135deg, var(--sp-accent), var(--sp-accent-2)) !important;
    color: #fff !important; font-weight: 700; font-size: 0.8rem;
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.sp-user-name { font-size: 0.82rem; font-weight: 600; color: var(--sp-text-dark) !important; }
.sp-user-role { font-size: 0.7rem; color: var(--sp-muted) !important; }

/* ── Page header ────────────────────────────────────── */
.sp-page-header {
    background: linear-gradient(135deg, #eef2ff 0%, #f5f3ff 100%) !important;
    border: 1px solid #c7d2fe !important;
    border-radius: 16px !important;
    padding: 1.75rem 2rem !important;
    margin-bottom: 1.5rem !important;
}
.sp-page-title { font-size: 1.6rem; font-weight: 800; color: #3730a3 !important; }
.sp-page-sub   { font-size: 0.9rem; color: #6366f1 !important; margin-top: 4px; }
.sp-section-title { font-size: 1.05rem; font-weight: 700; color: var(--sp-text-dark) !important; margin-bottom: 1rem; }

/* ── Cards ──────────────────────────────────────────── */
.sp-card {
    background: var(--sp-card-bg) !important;
    border: 1px solid var(--sp-border) !important;
    border-radius: 16px !important;
    box-shadow: var(--sp-shadow) !important;
    padding: 1.5rem !important;
    color: var(--sp-text-dark) !important;
    transition: box-shadow 0.2s;
}
.sp-card:hover { box-shadow: var(--sp-shadow-lg) !important; }
.sp-card-text  { color: var(--sp-text-mid) !important; font-size: 0.9rem; }
.sp-mt-1 { margin-top: 0.5rem !important; }

/* ── Stats ──────────────────────────────────────────── */
.sp-stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 1rem; margin-bottom: 1.5rem; }
.sp-stat-card {
    background: var(--sp-card-bg) !important;
    border: 1px solid var(--sp-border) !important;
    border-radius: 14px !important;
    padding: 1.25rem !important;
    box-shadow: var(--sp-shadow) !important;
    display: flex; flex-direction: column; gap: 8px;
}
.sp-stat-icon  { width: 40px; height: 40px; border-radius: 10px; background: var(--sp-accent-soft) !important; color: var(--sp-accent) !important; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; }
.sp-stat-value { font-size: 1.75rem; font-weight: 800; color: var(--sp-text-dark) !important; line-height: 1; }
.sp-stat-label { font-size: 0.78rem; font-weight: 500; color: var(--sp-muted) !important; text-transform: uppercase; letter-spacing: 0.05em; }

/* ── Buttons ────────────────────────────────────────── */
.sp-btn { display: inline-flex; align-items: center; gap: 6px; padding: 9px 18px; border-radius: 10px; font-size: 0.875rem; font-weight: 600; border: none; cursor: pointer; transition: all 0.18s; text-decoration: none; font-family: inherit; }
.sp-btn-primary { background: linear-gradient(135deg, var(--sp-accent), var(--sp-accent-2)) !important; color: #fff !important; box-shadow: 0 2px 12px rgba(99,102,241,0.3) !important; }
.sp-btn-primary:hover { transform: translateY(-1px); box-shadow: 0 4px 20px rgba(99,102,241,0.4) !important; }
.sp-btn-ghost { background: transparent !important; border: 1.5px solid var(--sp-border) !important; color: var(--sp-text-mid) !important; }
.sp-btn-ghost:hover { border-color: var(--sp-accent) !important; color: var(--sp-accent) !important; }
.sp-btn-danger { background: rgba(239,68,68,0.08) !important; border: 1.5px solid var(--sp-red) !important; color: var(--sp-red) !important; }
.sp-btn-sm { padding: 6px 12px !important; font-size: 0.8rem !important; }
.sp-icon-btn { background: #f8fafc !important; border: 1px solid var(--sp-border) !important; color: var(--sp-text-mid) !important; border-radius: 8px !important; padding: 8px !important; cursor: pointer; transition: all 0.15s; }
.sp-icon-btn:hover { color: var(--sp-accent) !important; border-color: var(--sp-accent) !important; }

/* ── Form ───────────────────────────────────────────── */
.sp-form { display: flex; flex-direction: column; gap: 1rem; }
.sp-form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
@media (max-width: 600px) { .sp-form-row { grid-template-columns: 1fr; } }
.sp-field { display: flex; flex-direction: column; gap: 6px; }
.sp-label { font-size: 0.82rem; font-weight: 600; color: var(--sp-text-mid) !important; }
.sp-input {
    padding: 9px 12px; border-radius: 10px;
    border: 1.5px solid var(--sp-border) !important;
    background: #f8fafc !important;
    color: var(--sp-text-dark) !important;
    font-size: 0.9rem; font-family: inherit;
    transition: border-color 0.15s, box-shadow 0.15s;
    width: 100%;
}
.sp-input:focus { border-color: var(--sp-accent) !important; box-shadow: 0 0 0 3px rgba(99,102,241,0.1) !important; outline: none; }
.sp-form-actions { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }

/* ── Chips ──────────────────────────────────────────── */
.sp-chip { display: inline-flex; align-items: center; padding: 3px 10px; border-radius: 999px; font-size: 0.74rem; font-weight: 600; }
.sp-chip-purple { background: rgba(139,92,246,0.1) !important; color: #7c3aed !important; }
.sp-chip-green  { background: rgba(16,185,129,0.1) !important; color: #059669 !important; }
.sp-chip-red    { background: rgba(239,68,68,0.1) !important; color: #dc2626 !important; }
.sp-chip-orange { background: rgba(245,158,11,0.1) !important; color: #d97706 !important; }
.sp-chip-blue   { background: rgba(59,130,246,0.1) !important; color: #2563eb !important; }
.sp-chip-sm { font-size: 0.68rem !important; padding: 2px 7px !important; }
.sp-chip-lg { font-size: 0.85rem !important; padding: 5px 14px !important; }
.sp-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; margin-right: 6px; }
.sp-dot-green  { background: var(--sp-green) !important; }
.sp-dot-red    { background: var(--sp-red) !important; }
.sp-dot-purple { background: var(--sp-purple) !important; }

/* ── Lists ──────────────────────────────────────────── */
.sp-list { display: flex; flex-direction: column; gap: 8px; }
.sp-row {
    background: var(--sp-card-bg) !important;
    border: 1px solid var(--sp-border) !important;
    border-radius: 12px !important;
    padding: 12px 16px !important;
    display: flex; align-items: center; gap: 12px;
    transition: all 0.15s; color: var(--sp-text-dark) !important;
}
.sp-row:hover { border-color: var(--sp-accent) !important; box-shadow: var(--sp-shadow) !important; }
.sp-row-main { flex: 1; min-width: 0; }
.sp-row-title { font-size: 0.9rem; font-weight: 600; color: var(--sp-text-dark) !important; }
.sp-row-sub   { font-size: 0.78rem; color: var(--sp-text-mid) !important; margin-top: 2px; }

/* ── Tabs ───────────────────────────────────────────── */
.sp-tabs { display: flex; gap: 4px; padding-bottom: 0; border-bottom: 2px solid var(--sp-border) !important; margin-bottom: 1rem; flex-wrap: wrap; }
.sp-tab { padding: 8px 16px; border-radius: 8px 8px 0 0; font-size: 0.85rem; font-weight: 600; color: var(--sp-text-mid) !important; background: transparent !important; border: none; border-bottom: 2px solid transparent; cursor: pointer; transition: all 0.15s; }
.sp-tab:hover  { color: var(--sp-accent) !important; }
.sp-tab.active { color: var(--sp-accent) !important; border-bottom: 2px solid var(--sp-accent) !important; }

/* ── Banners ────────────────────────────────────────── */
.sp-banner { padding: 12px 16px; border-radius: 10px; font-weight: 600; display: flex; gap: 10px; align-items: center; margin-bottom: 1rem; }
.sp-banner-green { background: rgba(16,185,129,0.08) !important; border: 1px solid #6ee7b7 !important; color: #065f46 !important; }
.sp-banner-red   { background: rgba(239,68,68,0.08) !important; border: 1px solid #fca5a5 !important; color: #991b1b !important; }

/* ── Empty ──────────────────────────────────────────── */
.sp-empty { text-align: center; padding: 3rem 1rem; }
.sp-empty-icon  { font-size: 3rem; margin-bottom: 1rem; display: block; }
.sp-empty-title { font-size: 1.05rem; font-weight: 700; color: var(--sp-text-dark) !important; margin-bottom: 6px; }
.sp-empty-sub   { font-size: 0.88rem; color: var(--sp-text-mid) !important; }

/* ── Book grid ──────────────────────────────────────── */
.sp-books-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 1rem; }
.sp-book-card  { background: var(--sp-card-bg) !important; border: 1px solid var(--sp-border) !important; border-radius: 14px !important; box-shadow: var(--sp-shadow) !important; overflow: hidden; transition: all 0.2s; cursor: pointer; }
.sp-book-card:hover { transform: translateY(-3px); box-shadow: var(--sp-shadow-lg) !important; border-color: var(--sp-accent) !important; }
.sp-book-cover { width: 100%; aspect-ratio: 2/3; object-fit: cover; background: linear-gradient(135deg, #eef2ff, #f5f3ff); }
.sp-book-info  { padding: 10px 12px; }
.sp-book-title { font-size: 0.82rem; font-weight: 700; color: var(--sp-text-dark) !important; line-height: 1.3; }
.sp-book-author{ font-size: 0.75rem; color: var(--sp-text-mid) !important; margin-top: 2px; }
.sp-book-meta  { font-size: 0.72rem; color: var(--sp-muted) !important; margin-top: 4px; }

/* ── Search ─────────────────────────────────────────── */
.sp-search-bar { background: var(--sp-card-bg) !important; border: 1.5px solid var(--sp-border) !important; border-radius: 14px !important; box-shadow: var(--sp-shadow) !important; display: flex; align-items: center; gap: 10px; padding: 10px 16px; margin-bottom: 1.5rem; }
.sp-search-bar input { flex: 1; border: none; background: transparent !important; color: var(--sp-text-dark) !important; font-size: 0.95rem; font-family: inherit; outline: none; }
.sp-search-bar input::placeholder { color: var(--sp-muted) !important; }
.sp-search-icon { color: var(--sp-muted) !important; font-size: 1.1rem; }

/* ── Pills ──────────────────────────────────────────── */
.sp-pills { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 1.25rem; }
.sp-pill  { padding: 6px 16px; border-radius: 999px; font-size: 0.82rem; font-weight: 600; border: 1.5px solid var(--sp-border) !important; background: var(--sp-card-bg) !important; color: var(--sp-text-mid) !important; cursor: pointer; transition: all 0.15s; text-decoration: none; }
.sp-pill:hover, .sp-pill.active { background: var(--sp-accent) !important; border-color: var(--sp-accent) !important; color: #fff !important; }

/* ── Progress ───────────────────────────────────────── */
.sp-progress-track { height: 8px; background: #e2e8f0 !important; border-radius: 999px; overflow: hidden; }
.sp-progress-fill  { height: 100%; background: linear-gradient(90deg, var(--sp-accent), var(--sp-accent-2)) !important; border-radius: 999px; transition: width 0.5s; }

/* ── Goal cards ─────────────────────────────────────── */
.sp-goal-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 12px; }

/* ── Calendar ───────────────────────────────────────── */
.sp-calendar-layout { display: grid; grid-template-columns: 1fr 340px; gap: 1.5rem; }
@media (max-width: 900px) { .sp-calendar-layout { grid-template-columns: 1fr; } }
.sp-calendar-card { padding: 1.25rem !important; }
.sp-calendar-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; }
.sp-calendar-month { font-size: 1rem; font-weight: 700; color: var(--sp-text-dark) !important; }
.sp-calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; }
.sp-cal-day { aspect-ratio: 1; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: 500; border-radius: 8px; cursor: pointer; color: var(--sp-text-dark) !important; transition: all 0.15s; }
.sp-cal-day:hover { background: var(--sp-accent-soft) !important; color: var(--sp-accent) !important; }
.sp-cal-day.today { background: var(--sp-accent) !important; color: #fff !important; font-weight: 700; }
.sp-cal-day.has-event { border: 2px solid var(--sp-accent) !important; color: var(--sp-accent) !important; }
.sp-cal-day.other-month { color: var(--sp-muted) !important; }
.sp-cal-header { font-size: 0.72rem; font-weight: 700; color: var(--sp-muted) !important; text-transform: uppercase; text-align: center; padding: 4px; }
.sp-events-list { display: flex; flex-direction: column; gap: 1rem; }

/* ── Assignment card ────────────────────────────────── */
.sp-assignment-card { display: block; background: var(--sp-card-bg) !important; border: 1px solid var(--sp-border) !important; border-radius: 14px !important; padding: 1rem 1.25rem !important; transition: all 0.18s; margin-bottom: 10px; text-decoration: none; color: inherit; }
.sp-assignment-card:hover { border-color: var(--sp-accent) !important; box-shadow: var(--sp-shadow-lg) !important; transform: translateX(2px); }

/* ── Notification item ──────────────────────────────── */
.sp-notif { transition: all 0.15s; }
.sp-notif.unread { border-left: 4px solid var(--sp-accent) !important; }
.sp-notif-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; margin-right: 8px; flex-shrink: 0; }
.sp-dot-red    { background: var(--sp-red) !important; }
.sp-dot-green  { background: var(--sp-green) !important; }
.sp-dot-purple { background: var(--sp-purple) !important; }

/* ── Settings ───────────────────────────────────────── */
.sp-settings-grid { display: grid; grid-template-columns: 240px 1fr; gap: 1.5rem; }
@media (max-width: 800px) { .sp-settings-grid { grid-template-columns: 1fr; } }
.sp-settings-nav  { display: flex; flex-direction: column; gap: 4px; }
.sp-settings-tab  { padding: 10px 14px; border-radius: 10px; font-size: 0.875rem; font-weight: 600; color: var(--sp-text-mid) !important; cursor: pointer; border: none; background: transparent !important; text-align: left; width: 100%; transition: all 0.15s; }
.sp-settings-tab:hover  { background: var(--sp-accent-soft) !important; color: var(--sp-accent) !important; }
.sp-settings-tab.active { background: var(--sp-accent-soft) !important; color: var(--sp-accent) !important; font-weight: 700 !important; }
.sp-settings-panel { display: none; }
.sp-settings-panel.active { display: block; }
.sp-avatar-lg { width: 72px; height: 72px; border-radius: 50%; background: linear-gradient(135deg, var(--sp-accent), var(--sp-accent-2)) !important; color: #fff !important; font-size: 1.8rem; font-weight: 700; display: flex; align-items: center; justify-content: center; }

/* ── AI chat ────────────────────────────────────────── */
.sp-ai-chat { display: flex; flex-direction: column; gap: 1rem; height: calc(100vh - 200px); min-height: 400px; }
.sp-chat-messages { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 10px; padding: 1rem; background: #f8fafc !important; border-radius: 14px; border: 1px solid var(--sp-border) !important; }
.sp-chat-msg { max-width: 75%; padding: 10px 14px; border-radius: 14px; font-size: 0.88rem; line-height: 1.5; }
.sp-chat-msg.user { align-self: flex-end; background: var(--sp-accent) !important; color: #fff !important; border-bottom-right-radius: 4px; }
.sp-chat-msg.ai   { align-self: flex-start; background: #ffffff !important; border: 1px solid var(--sp-border) !important; color: var(--sp-text-dark) !important; border-bottom-left-radius: 4px; }
.sp-chat-input-row { display: flex; gap: 8px; }
.sp-chat-input { flex: 1; padding: 10px 14px; border-radius: 10px; border: 1.5px solid var(--sp-border) !important; background: #f8fafc !important; color: var(--sp-text-dark) !important; font-size: 0.9rem; font-family: inherit; outline: none; }
.sp-chat-input:focus { border-color: var(--sp-accent) !important; box-shadow: 0 0 0 3px rgba(99,102,241,0.1) !important; }

/* ── Digital library category pills ─────────────────── */
.dl-category-strip { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 4px; scrollbar-width: none; margin-bottom: 1.25rem; }
.dl-category-strip::-webkit-scrollbar { display: none; }
.dl-cat-pill { white-space: nowrap; padding: 6px 16px; border-radius: 999px; font-size: 0.82rem; font-weight: 600; border: 1.5px solid var(--sp-border) !important; background: #ffffff !important; color: var(--sp-text-mid) !important; cursor: pointer; transition: all 0.15s; text-decoration: none; flex-shrink: 0; }
.dl-cat-pill:hover, .dl-cat-pill.active { background: var(--sp-accent) !important; border-color: var(--sp-accent) !important; color: #fff !important; }

/* ── Misc ───────────────────────────────────────────── */
.sp-divider { height: 1px; background: var(--sp-border) !important; margin: 1rem 0; }
.sp-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
.sp-grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem; }
@media (max-width: 700px) { .sp-grid-2, .sp-grid-3 { grid-template-columns: 1fr; } }
</style>

<div class="st-overlay-dim" id="studentDim" onclick="toggleStudentSidebar()"></div>

<div class="st-shell">
    <!-- ══ SIDEBAR DRAWER ══ -->
    <aside class="st-sidebar" id="studentSidebar">
        <!-- Header -->
        <div class="st-sidebar-header">
            <div class="st-sidebar-user">
                <% const stuName = (typeof session !== 'undefined' && session && (session.user_name || session.name)) ? (session.user_name || session.name) : (typeof user_name !== 'undefined' ? user_name : 'Student'); %>
                <% const stuInitial = stuName.trim()[0].toUpperCase(); %>
                <div class="st-avatar-lg">
                    <%= stuInitial %>
                </div>
                <div class="st-user-meta">
                    <h4 class="st-user-name"><%= stuName %></h4>
                    <p class="st-user-school"><%= (typeof session !== 'undefined' && session && session.school_name) ? session.school_name : 'E-Pathshala Network' %></p>
                </div>
            </div>
            <button class="st-sidebar-close" onclick="toggleStudentSidebar()" aria-label="Close sidebar">✕</button>
        </div>

        <!-- Navigation List -->
        <nav class="st-sidebar-nav">
            <a href="/student" class="st-nav-item active">
                <span class="st-nav-icon">🏠</span>
                <span class="st-nav-text">Dashboard</span>
            </a>
            <a href="/student/browse" class="st-nav-item">
                <span class="st-nav-icon">📚</span>
                <span class="st-nav-text">Digital Library</span>
            </a>
            <a href="/digital-library" class="st-nav-item">
                <span class="st-nav-icon">🌐</span>
                <span class="st-nav-text">Community Library</span>
            </a>
            <a href="/student/my-publications" class="st-nav-item">
                <span class="st-nav-icon">📖</span>
                <span class="st-nav-text">My Books</span>
            </a>
            <a href="/student/assignments" class="st-nav-item">
                <span class="st-nav-icon">📝</span>
                <span class="st-nav-text">Assignments</span>
            </a>
            <a href="/student/requests" class="st-nav-item">
                <span class="st-nav-icon">📋</span>
                <span class="st-nav-text">Book Requests</span>
            </a>
            <a href="/student/calendar" class="st-nav-item">
                <span class="st-nav-icon">📅</span>
                <span class="st-nav-text">Calendar</span>
            </a>
            <a href="/student/goals" class="st-nav-item">
                <span class="st-nav-icon">🎯</span>
                <span class="st-nav-text">Reading Goals</span>
            </a>
            <a href="/student/ai" class="st-nav-item">
                <span class="st-nav-icon">🔍</span>
                <span class="st-nav-text">AI Chat</span>
            </a>
            <a href="/student/notifications" class="st-nav-item">
                <span class="st-nav-icon">🔔</span>
                <span class="st-nav-text">Notifications</span>
            </a>
            <a href="/student/profile" class="st-nav-item">
                <span class="st-nav-icon">👤</span>
                <span class="st-nav-text">My Profile</span>
            </a>
            <a href="/student/settings" class="st-nav-item">
                <span class="st-nav-icon">⚙️</span>
                <span class="st-nav-text">Settings</span>
            </a>
            <a href="/student/help" class="st-nav-item">
                <span class="st-nav-icon">❓</span>
                <span class="st-nav-text">Help & Support</span>
            </a>
        </nav>

        <!-- Sticky Footer -->
        <div class="st-sidebar-footer">
            <a href="/logout" class="st-footer-btn danger">
                <span class="st-nav-icon">🚪</span>
                <span>Logout</span>
            </a>
        </div>
    </aside>

    <!-- ══ MAIN CONTENT ══ -->
    <main class="st-main">
        <!-- Topbar -->
        <div class="st-topbar">
            <div class="st-topbar-left">
                <button class="st-menu-btn" onclick="toggleStudentSidebar()" aria-label="Menu">☰</button>
                <span class="st-brand-title">🎓 Student Portal</span>
            </div>
            <div class="st-topbar-right">
                <a href="/student/browse" class="st-btn st-btn-primary st-btn-xs">📚 Catalog</a>
                <a href="/student/notifications" class="st-notif-btn">
                    🔔
                    <% const notifBadgeCount = (typeof stats !== 'undefined' && stats) ? ((stats.due_soon_count || 0) + (stats.overdue_count || 0)) : 0; %>
                    <% if (notifBadgeCount > 0) { %><span class="st-notif-badge"><%= notifBadgeCount %></span><% } %>
                </a>
            </div>
        </div>

        <div class="st-content">
            <!-- Hero Welcome Card -->
            <div class="st-card" style="background: linear-gradient(135deg, #1e1b4b, #312e81) !important;">
                <h2 style="font-family: 'Outfit'; font-size: 1.4rem; color: #ffffff; margin: 0 0 6px 0;">Hello, <%= (typeof session !== 'undefined' && session && (session.user_name || session.name)) ? (session.user_name || session.name) : 'Student' %>! 👋</h2>
                <p style="margin: 0; color: #a5b4fc; font-size: 0.88rem;">Welcome back to your Digital Library. Track your reading goals & explore community books!</p>
            </div>

            <!-- Stats Grid -->
            <div class="st-stats-grid">
                <div class="st-stat-card">
                    <div class="st-stat-icon">📚</div>
                    <div class="st-stat-val"><%= (typeof stats !== 'undefined' && stats && stats.borrowed_count) ? stats.borrowed_count : (typeof issued_count !== 'undefined' ? issued_count : 0) %></div>
                    <div class="st-stat-lbl">Active Loans</div>
                </div>
                <div class="st-stat-card">
                    <div class="st-stat-icon">🎯</div>
                    <div class="st-stat-val"><%= (typeof stats !== 'undefined' && stats && stats.goal_pages) ? stats.goal_pages : 20 %></div>
                    <div class="st-stat-lbl">Daily Goal Pages</div>
                </div>
                <div class="st-stat-card">
                    <div class="st-stat-icon">🏆</div>
                    <div class="st-stat-val"><%= (typeof stats !== 'undefined' && stats && stats.reader_score) ? stats.reader_score : 100 %></div>
                    <div class="st-stat-lbl">Reader Score</div>
                </div>
                <div class="st-stat-card">
                    <div class="st-stat-icon">🔥</div>
                    <div class="st-stat-val" style="color: #fb923c;"><%= (typeof stats !== 'undefined' && stats && stats.streak) ? stats.streak : 1 %> Day</div>
                    <div class="st-stat-lbl">Reading Streak</div>
                </div>
            </div>

            <!-- Currently Reading / Issued Books Table -->
            <div class="st-card">
                <h3 style="font-family: 'Outfit'; font-size: 1.1rem; color: #ffffff; margin: 0 0 10px 0;">📖 My Borrowed Books</h3>
                <div class="st-table-container">
                    <table class="st-table">
                        <thead>
                            <tr>
                                <th>Book Title</th>
                                <th>Issue Date</th>
                                <th>Due Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (typeof issued_books !== 'undefined' && issued_books && issued_books.length > 0) { %>
                                <% issued_books.forEach(b => { %>
                                    <tr>
                                        <td style="font-weight: 700; color: #ffffff;"><%= b.title %></td>
                                        <td><%= b.issue_date %></td>
                                        <td><%= b.due_date %></td>
                                        <td>
                                            <% if (b.is_overdue) { %>
                                                <span style="color: #f87171; font-weight: 700;">OVERDUE</span>
                                            <% } else { %>
                                                <span style="color: #34d399; font-weight: 700;">Issued</span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr><td colspan="4" style="text-align: center; color: var(--sp-muted);">No active book loans. <a href="/student/browse" style="color: #818cf8;">Browse Digital Library</a></td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>
</div>

<script>
function toggleStudentSidebar() {
    const sb = document.getElementById('studentSidebar');
    const dim = document.getElementById('studentDim');
    if (!sb) return;
    sb.classList.toggle('open');
    if (dim) dim.classList.toggle('active', sb.classList.contains('open'));
}

function autoCloseStudentSidebar() {
    if (window.innerWidth <= 900) {
        const sb = document.getElementById('studentSidebar');
        const dim = document.getElementById('studentDim');
        if (sb) sb.classList.remove('open');
        if (dim) dim.classList.remove('active');
    }
}

document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') autoCloseStudentSidebar();
});
</script>
