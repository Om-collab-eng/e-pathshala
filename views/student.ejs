    // ─────────────────────────────────────────────────────────────
    //  E-LIBRARY RECTANGULAR HIGHLIGHT BANNER CAROUSEL
    // ─────────────────────────────────────────────────────────────
    let elibHighlights = [];
    let currentHighlightIdx = 0;
    let highlightTimer = null;
    let isHighlightPaused = false;

    async function loadElibraryHighlightBanner() {
      const banner = document.getElementById('elibHighlightBanner');
      if (!banner) return;

      try {
        const res = await fetch('/api/elibrary/advertisements?section=all');
        const data = await res.json();

        if (!data || data.status !== 'success' || !data.advertisements || data.advertisements.length === 0) {
          banner.style.display = 'none';
          return;
        }

        elibHighlights = data.advertisements;
        currentHighlightIdx = 0;
        renderHighlightDots();
        displayHighlight(0);

        banner.style.display = 'flex';

        // Pause on mouse enter or focus, resume on leave
        banner.addEventListener('mouseenter', () => { isHighlightPaused = true; });
        banner.addEventListener('mouseleave', () => { isHighlightPaused = false; });
        banner.addEventListener('focusin', () => { isHighlightPaused = true; });
        banner.addEventListener('focusout', () => { isHighlightPaused = false; });

        // Start slow controlled carousel timer (7 seconds per slide)
        if (highlightTimer) clearInterval(highlightTimer);
        const prefersReducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!prefersReducedMotion && elibHighlights.length > 1) {
          highlightTimer = setInterval(() => {
            if (!isHighlightPaused) {
              nextElibraryHighlight();
            }
          }, 7000);
        }
      } catch (err) {
        console.error('loadElibraryHighlightBanner error:', err);
        banner.style.display = 'none';
      }
    }

    function renderHighlightDots() {
      const dotsContainer = document.getElementById('elibBannerDots');
      if (!dotsContainer) return;
      dotsContainer.innerHTML = elibHighlights.map((_, i) => `
        <span class="elib-banner-dot ${i === 0 ? 'active' : ''}" onclick="goToElibraryHighlight(${i})" title="Slide ${i + 1}"></span>
      `).join('');
    }

    function displayHighlight(idx) {
      if (elibHighlights.length === 0) return;
      currentHighlightIdx = (idx + elibHighlights.length) % elibHighlights.length;
      const ad = elibHighlights[currentHighlightIdx];

      const slide = document.getElementById('elibBannerSlide');
      if (slide) slide.classList.add('transitioning');

      setTimeout(() => {
        const type = (ad.type || 'BANNER').toUpperCase();
        let icon = '💡';
        let cat = 'FEATURED';

        if (type === 'INTERESTING_FACT') {
          icon = '💡';
          cat = (ad.category || 'DID YOU KNOW?').toUpperCase();
        } else if (type === 'IMAGE' || type === 'BANNER') {
          icon = '📢';
          cat = 'ANNOUNCEMENT';
        } else if (type === 'VIDEO') {
          icon = '🎥';
          cat = 'WORKSHOP';
        }

        const iconEl = document.getElementById('elibBannerIcon');
        const catEl = document.getElementById('elibBannerCat');
        const titleEl = document.getElementById('elibBannerTitle');
        const descEl = document.getElementById('elibBannerDesc');
        const ctaEl = document.getElementById('elibBannerCta');

        if (iconEl) iconEl.textContent = icon;
        if (catEl) catEl.textContent = cat;
        if (titleEl) titleEl.textContent = ad.title || (type === 'INTERESTING_FACT' ? (ad.category || 'Did You Know?') : 'Curriculum Highlight');
        if (descEl) descEl.textContent = ad.content_text || ad.subtitle || ad.description || 'Explore curated library resources and educational materials.';
        if (ctaEl) {
          ctaEl.href = ad.destination_url || ad.target_url || '#';
          ctaEl.textContent = (ad.cta_text || (type === 'INTERESTING_FACT' ? 'Read Fact' : 'Explore Resource')) + ' →';
          ctaEl.onclick = (e) => trackAdClick(ad.id, e);
        }

        // Update dots
        document.querySelectorAll('.elib-banner-dot').forEach((d, i) => {
          d.classList.toggle('active', i === currentHighlightIdx);
        });

        if (slide) slide.classList.remove('transitioning');
      }, 200);
    }

    function nextElibraryHighlight() {
      displayHighlight(currentHighlightIdx + 1);
    }

    function prevElibraryHighlight() {
      displayHighlight(currentHighlightIdx - 1);
    }

    function goToElibraryHighlight(idx) {
      displayHighlight(idx);
    }

    // Alias for backward compatibility
    const loadElibraryTicker = loadElibraryHighlightBanner;

    async function trackAdClick(id, event) {
      if (!id) return;
      try {
        if (navigator.sendBeacon) {
          const blob = new Blob([JSON.stringify({ clicked: true })], { type: 'application/json' });
          navigator.sendBeacon(`/api/elibrary/advertisements/${id}/click`, blob);
        } else {
          fetch(`/api/elibrary/advertisements/${id}/click`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ clicked: true }),
            keepalive: true
          });
        }
      } catch (e) {}
    }

    // ═══════════════════════════════════════════════════════════════
    // DYNAMIC INSPIRATIONAL QUOTE ENGINE (STUDENT DASHBOARD)
    // ═══════════════════════════════════════════════════════════════
    const STUDENT_QUOTES = [
      { quote: "Today a reader, tomorrow a leader.", author: "Margaret Fuller" },
      { quote: "There is no friend as loyal as a book.", author: "Ernest Hemingway" },
      { quote: "The more that you read, the more things you will know. The more that you learn, the more places you'll go.", author: "Dr. Seuss" },
      { quote: "Books are a uniquely portable magic.", author: "Stephen King" },
      { quote: "Reading is essential for those who seek to rise above the ordinary.", author: "Jim Rohn" },
      { quote: "Once you learn to read, you will be forever free.", author: "Frederick Douglass" },
      { quote: "A reader lives a thousand lives before he dies. The man who never reads lives only one.", author: "George R.R. Martin" },
      { quote: "One best book is equal to a hundred good friends, but one good friend is equal to a library.", author: "Dr. A.P.J. Abdul Kalam" },
      { quote: "Live as if you were to die tomorrow. Learn as if you were to live forever.", author: "Mahatma Gandhi" },
      { quote: "Education is the most powerful weapon which you can use to change the world.", author: "Nelson Mandela" },
      { quote: "An investment in knowledge pays the best interest.", author: "Benjamin Franklin" },
      { quote: "Reading brings us unknown friends.", author: "Honoré de Balzac" },
      { quote: "A room without books is like a body without a soul.", author: "Marcus Tullius Cicero" },
      { quote: "When in doubt go to the library.", author: "J.K. Rowling" },
      { quote: "The highest education is that which makes our life in harmony with all existence.", author: "Rabindranath Tagore" }
    ];

    let currentStudentQuoteIdx = Math.floor(Math.random() * STUDENT_QUOTES.length);
    let lastStudentAwayTime = Date.now();
    let isCyclingStudentQuote = false;

    function cycleStudentHeroQuote(isManual = false) {
      if (isCyclingStudentQuote) return;
      isCyclingStudentQuote = true;

      const spinIcon = document.getElementById('spQuoteSpinIcon');
      if (spinIcon && isManual) spinIcon.style.transform = 'rotate(360deg)';

      const container = document.getElementById('spQuoteContainer');
      if (container) {
        container.style.opacity = '0';
        container.style.transform = 'translateY(4px)';
      }

      let nextIdx;
      do {
        nextIdx = Math.floor(Math.random() * STUDENT_QUOTES.length);
      } while (nextIdx === currentStudentQuoteIdx && STUDENT_QUOTES.length > 1);
      currentStudentQuoteIdx = nextIdx;
      const q = STUDENT_QUOTES[nextIdx];

      setTimeout(() => {
        const textEl = document.getElementById('spQuoteText');
        const authorEl = document.getElementById('spQuoteAuthor');
        if (textEl && q) textEl.textContent = `"${q.quote}"`;
        if (authorEl && q) authorEl.textContent = `— ${q.author}`;

        try { sessionStorage.setItem('last_student_quote_idx', currentStudentQuoteIdx); } catch(e) {}

        if (container) {
          container.style.opacity = '1';
          container.style.transform = 'translateY(0)';
        }

        setTimeout(() => {
          if (spinIcon) spinIcon.style.transform = 'none';
          isCyclingStudentQuote = false;
        }, 300);
      }, 200);
    }

    // Auto-cycle quote when student comes back to the tab
    function onStudentReturn() {
      const now = Date.now();
      if (now - lastStudentAwayTime > 4000) {
        cycleStudentHeroQuote(false);
      }
      lastStudentAwayTime = now;
    }

    window.addEventListener('focus', onStudentReturn);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') onStudentReturn();
      else lastStudentAwayTime = Date.now();
    });

    document.addEventListener('DOMContentLoaded', () => {
      try {
        const savedIdx = sessionStorage.getItem('last_student_quote_idx');
        if (savedIdx !== null) cycleStudentHeroQuote(false);
        else cycleStudentHeroQuote(false);
      } catch(e) {}

      loadElibraryTicker();
      loadStudentQuizzes();
      loadStudentAssignments();
    });
  </script>

  <!-- Student Mobile Bottom Navigation Dock -->
  <nav class="sp-mobile-bottom-dock" aria-label="Student Mobile Navigation">
    <button class="sp-dock-item <%= currentModule === 'dashboard' ? 'active' : '' %>" id="spdock-dashboard" onclick="switchStudentModule('dashboard', null)">
      <span class="sp-dock-icon">🏠</span>
      <span>Home</span>
    </button>
    <button class="sp-dock-item <%= currentModule === 'catalog' ? 'active' : '' %>" id="spdock-catalog" onclick="switchStudentModule('catalog', null)">
      <span class="sp-dock-icon">📚</span>
      <span>Catalog</span>
    </button>
    <button class="sp-dock-item <%= currentModule === 'borrowings' ? 'active' : '' %>" id="spdock-borrowings" onclick="switchStudentModule('borrowings', null)">
      <span class="sp-dock-icon">🔄</span>
      <span>My Loans</span>
    </button>
    <button class="sp-dock-item <%= currentModule === 'e-library' ? 'active' : '' %>" id="spdock-e-library" onclick="switchStudentModule('e-library', null)">
      <span class="sp-dock-icon">📖</span>
      <span>E-Library</span>
    </button>
    <button class="sp-dock-item" onclick="toggleStudentSidebar()">
      <span class="sp-dock-icon">☰</span>
      <span>Menu</span>
    </button>
  </nav>

</body>
</html>
