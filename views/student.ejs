    // ── ASSIGNMENTS LOADER & MODALS ─────────────────────────────────────────────
    async function loadStudentAssignments() {
      const container = document.getElementById('assignmentsGrid');
      if (!container) return;
      container.innerHTML = renderSkeletonCards(3);

      try {
        const res = await fetch('/student/api/assignments');
        if (!res.ok) throw new Error(`Server returned HTTP ${res.status}`);
        const data = await res.json();
        if (data.status !== 'success') throw new Error(data.message || 'Failed to load assignments');

        const list = data.assignments || [];
        if (list.length === 0) {
          container.innerHTML = `
            <div class="sp-card" style="grid-column: 1 / -1; text-align: center; padding: 48px 20px; border-radius: 16px;">
              <span style="font-size: 2.5rem; display: block; margin-bottom: 8px;">📝</span>
              <h4 style="margin: 0 0 6px 0; font-size: 1.1rem; font-weight: 800;">No Pending Assignments</h4>
              <p style="margin: 0; font-size: 0.88rem; color: var(--text-secondary);">Your instructors have not posted any active assignments for your class right now.</p>
            </div>
          `;
          return;
        }

        container.innerHTML = list.map(a => {
          let pill = 'yellow';
          let label = '⏳ Pending';
          if (a.sub_status === 'GRADED') {
            pill = 'green';
            label = `🎯 Graded (${a.score})`;
          } else if (a.sub_status === 'SUBMITTED') {
            pill = 'green';
            label = '✅ Submitted';
          } else if (a.sub_status === 'OVERDUE') {
            pill = 'red';
            label = '⚠️ Overdue';
          }

          const dueDateStr = a.due_at ? new Date(a.due_at).toLocaleDateString(undefined, { day: 'numeric', month: 'short', year: 'numeric' }) : 'No Due Date';

          return `
            <div class="sp-card" style="margin-bottom:0;display:flex;flex-direction:column;justify-content:space-between;">
              <div>
                <span class="sp-pill ${pill}" style="margin-bottom:8px;">${label}</span>
                <h4 style="margin:0 0 6px 0;font-size:1rem;font-weight:800;">${a.title}</h4>
                <p style="font-size:0.8rem;color:var(--text-secondary);margin:0 0 12px 0;">${a.description || 'No instructions provided.'}</p>
                <div style="font-size:0.78rem;color:var(--text-secondary);margin-bottom:16px;">
                  📅 Due: <strong>${dueDateStr}</strong>
                </div>
              </div>
              <div>
                <button class="btn-primary" style="width:100%;justify-content:center;" onclick="openAssignmentModal('${a.id}', '${(a.title || '').replace(/'/g, "\\'")}')">
                  ${a.sub_status === 'SUBMITTED' || a.sub_status === 'GRADED' ? 'View / Resubmit' : 'Submit Work &rarr;'}
                </button>
              </div>
            </div>
          `;
        }).join('');
      } catch (err) {
        console.warn('Load assignments error:', err);
        container.innerHTML = `
          <div class="sp-card" style="grid-column: 1 / -1; text-align:center; padding:36px 20px; border: 1px dashed #ef4444; background: #fef2f2; border-radius: 14px;">
            <span style="font-size: 2.2rem; display:block; margin-bottom: 8px;">⚠️</span>
            <h4 style="margin: 0 0 6px 0; font-size: 1.05rem; font-weight: 800; color: #991b1b;">Unable to Load Assignments</h4>
            <p style="margin: 0 0 16px 0; font-size: 0.85rem; color: #7f1d1d;">${err.message || 'Could not fetch your class assignments. Please try again.'}</p>
            <button class="btn-primary" onclick="loadStudentAssignments()" style="margin: 0 auto; display: inline-flex; align-items: center; gap: 6px; padding: 8px 18px; font-size: 0.85rem;">🔄 Try Again</button>
          </div>
        `;
      }
    }

    function openAssignmentModal(id, title) {
      const modal = document.getElementById('assignmentModal');
      if (!modal) {
        window.location.href = `/student/assignments/${id}`;
        return;
      }
      document.getElementById('assignmentModalId').value = id;
      document.getElementById('assignmentModalTitle').innerText = '📝 Submit: ' + title;
      document.getElementById('assignmentModalNotes').value = '';
      document.getElementById('assignmentModalFile').value = '';
      openModal('assignmentModal');
    }

    async function submitAssignmentWork(e) {
      e.preventDefault();
      const assignmentId = document.getElementById('assignmentModalId').value;
      const fileInput = document.getElementById('assignmentModalFile');
      const notes = document.getElementById('assignmentModalNotes').value;
      const btn = document.getElementById('btnSubmitAssignmentWork');

      if ((!fileInput.files || fileInput.files.length === 0) && !notes.trim()) {
        alert('Please either attach a file or write answer notes before submitting.');
        return;
      }

      const formData = new FormData();
      if (fileInput.files && fileInput.files[0]) {
        formData.append('file', fileInput.files[0]);
      }
      formData.append('notes', notes);

      btn.disabled = true;
      btn.innerText = 'Submitting...';

      try {
        const res = await fetch(`/student/assignments/${assignmentId}/submit`, {
          method: 'POST',
          body: formData
        });
        closeModal('assignmentModal');
        alert('Work submitted successfully!');
        loadStudentAssignments();
      } catch (err) {
        alert('Submission error: ' + err.message);
      } finally {
        btn.disabled = false;
        btn.innerText = 'Submit Work →';
      }
    }

    // ── PHYSICAL BOOKS CATALOG LOADER ───────────────────────────────────────────
    let currentCatalogGenre = 'ALL';
    let catalogSearchTimeout = null;

    async function loadStudentCatalog(searchQuery = '', genre = currentCatalogGenre) {
      const grid = document.getElementById('catalogGrid');
      if (!grid) return;
      grid.innerHTML = renderSkeletonCards(4, 'book');

      try {
        const url = new URL('/student/api/catalog', window.location.origin);
        if (searchQuery) url.searchParams.set('q', searchQuery);
        if (genre && genre !== 'ALL') url.searchParams.set('genre', genre);

        const res = await fetch(url);
        if (!res.ok) throw new Error(`Server returned HTTP ${res.status}`);
        const data = await res.json();
        if (data.status !== 'success') throw new Error(data.message || 'Failed to load catalog');

        const books = data.books || [];
        if (books.length === 0) {
          grid.innerHTML = `
            <div style="grid-column:1/-1;text-align:center;padding:48px 20px;background:var(--surface-sub);border-radius:var(--radius-md);border:1px dashed var(--border);">
              <div style="font-size:2.4rem;margin-bottom:12px;">📚</div>
              <h4 style="margin:0 0 6px 0;font-weight:800;color:var(--text-primary);">No Books Found</h4>
              <p style="margin:0 0 16px 0;font-size:0.85rem;color:var(--text-secondary);">No physical books matched your search criteria or genre filter.</p>
              <button class="btn-secondary" onclick="resetCatalogFilters()" style="display:inline-flex;padding:6px 14px;font-size:0.82rem;">Reset Filters</button>
            </div>
          `;
          return;
        }

        grid.innerHTML = books.map(b => `
          <div class="sp-book-card" data-genre="${(b.genre || '').toLowerCase()}" data-title="${(b.title || '').toLowerCase()}" data-author="${(b.author || '').toLowerCase()}">
            <div class="sp-book-cover-wrap">
              <img src="${b.cover_url || 'https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?w=400&auto=format&fit=crop&q=60'}" class="sp-book-cover" alt="${b.title}">
              <span class="sp-book-badge ${b.available_copies > 0 ? 'available' : 'out'}">
                ${b.available_copies > 0 ? (b.available_copies + ' in Library') : 'Issued Out'}
              </span>
            </div>
            <div class="sp-book-info">
              <h4 class="sp-book-title">${b.title}</h4>
              <div class="sp-book-author">${b.author}</div>
              <div class="sp-book-location">
                📍 Rack ${b.rack_location || 'A-1'} · Shelf ${b.shelf_no || '2'}
              </div>
              <div class="sp-book-actions">
                <button class="btn-primary" style="flex:1;justify-content:center;padding:6px;font-size:0.78rem;" onclick="reserveBook('${b.id}')">
                  ${b.is_reserved ? 'Reserved' : 'Reserve'}
                </button>
                <button class="btn-secondary" style="padding:6px 10px;font-size:0.78rem;" onclick="toggleSaveBook('${b.id}', this)" title="Save to Wishlist">
                  ${b.is_saved ? '⭐' : '☆'}
                </button>
              </div>
            </div>
          </div>
        `).join('');
      } catch (err) {
        console.warn('Load catalog error:', err);
        grid.innerHTML = `
          <div style="grid-column: 1 / -1; text-align:center; padding:36px 20px; border: 1px dashed #ef4444; background: #fef2f2; border-radius: 14px;">
            <span style="font-size: 2.2rem; display:block; margin-bottom: 8px;">⚠️</span>
            <h4 style="margin: 0 0 6px 0; font-size: 1.05rem; font-weight: 800; color: #991b1b;">Unable to Load Books Catalog</h4>
            <p style="margin: 0 0 16px 0; font-size: 0.85rem; color: #7f1d1d;">${err.message || 'Could not fetch catalog books. Please try again.'}</p>
            <button class="btn-primary" onclick="loadStudentCatalog()" style="margin: 0 auto; display: inline-flex; align-items: center; gap: 6px; padding: 8px 18px; font-size: 0.85rem;">🔄 Try Again</button>
          </div>
