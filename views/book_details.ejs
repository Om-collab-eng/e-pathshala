<%- layout("base") %>
<% block('head').append('<link rel="stylesheet" href="/student.css">') %>

<% contentFor("content") %>
<div class="sp-page">
  <div class="sp-layout">
    <%- include('partials/student_sidebar', { active: 'browse' }) %>
    <div class="sp-main">
      <%- include('partials/student_topbar', { title: 'Book Details' }) %>
      <main class="sp-content">
<style>
    .nav-pills-container {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        justify-content: flex-end;
        align-items: center;
    }
    
    .nav-pill-btn {
        padding: 8px 16px;
        border-radius: 99px;
        font-size: 0.8rem;
        font-weight: 700;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        transition: all 0.2s ease;
        box-sizing: border-box;
    }

    .nav-pill-btn.btn-catalog, .nav-pill-btn.btn-dashboard {
        background: rgba(92, 60, 243, 0.08);
        color: #5c3cf3;
        border: 1px solid rgba(92, 60, 243, 0.15);
    }
    .nav-pill-btn.btn-catalog:hover, .nav-pill-btn.btn-dashboard:hover {
        background: rgba(92, 60, 243, 0.15);
        transform: translateY(-1px);
    }

    .nav-pill-btn.btn-logout {
        background: rgba(244, 63, 94, 0.08);
        color: #f43f5e;
        border: 1px solid rgba(244, 63, 94, 0.15);
    }
    .nav-pill-btn.btn-logout:hover {
        background: rgba(244, 63, 94, 0.15);
        transform: translateY(-1px);
    }

    @media (max-width: 768px) {
        .nav-pills-container {
            justify-content: center;
            width: 100%;
            margin-top: 10px;
        }
        .nav-pill-btn {
            flex: 1 1 auto;
            min-width: 100px;
        }
    }
</style>

<div class="content-container slide-up">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 15px;">
        <h1><span class="icon">📖</span> Book Details</h1>
        <div class="nav-pills-container">
            <a href="/student/browse" class="nav-pill-btn btn-catalog">← Back to Catalog</a>
            <a href="/student" class="nav-pill-btn btn-dashboard">Back to Dashboard</a>
            <a href="/logout" class="nav-pill-btn btn-logout">Log Out</a>
        </div>
    </div>

    <div class="glass-panel" style="display: flex; gap: 2rem; flex-wrap: wrap;">
        <!-- Book Cover -->
        <div style="flex: 1; min-width: 250px; text-align: center;">
            <% if (book.cover_url) { %>
            <img src="<%= book.cover_url %>" alt="Book Cover" onerror="this.onerror=null; this.outerHTML='<div style="width:100%;max-width:240px;height:320px;background:linear-gradient(135deg,#6366f1,#a855f7);border-radius:16px;display:flex;align-items:center;justify-content:center;font-size:4rem;color:white;margin:0 auto;'>📖</div>';" style="width: 100%; max-width: 300px; border-radius: var(--border-radius); box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
            <% } else { %>
            <div style="width: 100%; max-width: 300px; height: 400px; background: rgba(255,255,255,0.05); border-radius: var(--border-radius); display: flex; align-items: center; justify-content: center; font-size: 5rem; color: var(--text-low); margin: 0 auto;">
                📚
            </div>
            <% } %>
        </div>

        <!-- Book Info -->
        <div style="flex: 2; min-width: 300px; display: flex; flex-direction: column; gap: 1.5rem;">
            <div>
                <h2 style="font-size: 2.5rem; margin-bottom: 0.5rem; color: var(--text-high);"><%= book.title %></h2>
                <h3 style="font-size: 1.2rem; color: var(--accent-primary); font-weight: normal;">by <%= book.author %></h3>
            </div>

            <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
                <span class="status-badge" style="background: rgba(255,255,255,0.1); color: var(--text-med);"><span class="icon">🏷️</span> <%= book.genre || 'General' %></span>
                <span class="status-badge" style="background: rgba(255,255,255,0.1); color: var(--text-med);"><span class="icon">📍</span> Shelf: <%= (book.shelf_location && book.shelf_location !== 'null') ? book.shelf_location : 'Main Shelf' %></span>
                <% if (book.available_copies > 0) { %>
                <span class="status-badge status-active"><span class="icon">✅</span> <%= (book.available_copies && book.available_copies < 90000) ? book.available_copies : 1 %> Available</span>
                <% } else { %>
                <span class="status-badge status-error"><span class="icon">❌</span> Out of Stock</span>
                <% } %>
            </div>

            <div style="line-height: 1.6; color: var(--text-med);">
                <h4 style="color: var(--text-high); margin-bottom: 0.5rem;">Description</h4>
                <p><%= (book.description && book.description !== 'null') ? book.description : "No description available for this title." %></p>
            </div>

            <div style="margin-top: auto; padding-top: 1rem; border-top: 1px solid rgba(255,255,255,0.1);">
                <% if (has_reservation) { %>
                <button class="btn-alt" style="width: 100%; cursor: not-allowed; opacity: 0.7;" disabled>Reservation Pending</button>
                <p style="text-align: center; font-size: 0.8rem; color: var(--text-low); margin-top: 0.5rem;">You have already reserved this book.</p>
                <% } else { %>
                <form action="/student/reserve/<%= book.id %>" method="POST">
                    <button type="submit" class="btn-neon" style="width: 100%;">
                        <span class="icon">🔖</span> Reserve Book
                    </button>
                </form>
                <% } %>
            </div>
        </div>
    </div>
</div>

      </main>
    </div>
  </div>
</div>