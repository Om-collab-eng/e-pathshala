<%- include('layouts/header', { title: 'Personal Library Dashboard' }) %>
<link rel="stylesheet" href="/static/personal.css">
<style>
.streak-counter {
    background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
    border-radius: 16px;
    padding: 1.5rem;
    color: white;
    text-align: center;
    box-shadow: 0 4px 15px rgba(245, 158, 11, 0.3);
}
.streak-num {
    font-size: 3rem;
    font-weight: 800;
    line-height: 1;
}
.overdue-banner {
    background: rgba(244, 63, 94, 0.1);
    border: 1px solid rgba(244, 63, 94, 0.2);
    color: #f43f5e;
    padding: 1rem;
    border-radius: 12px;
    margin-bottom: 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
}
</style>

<div class="personal-layout">
    <aside class="personal-sidebar">
        <div class="personal-brand" style="display: flex; align-items: center; gap: 12px; margin-bottom: 1.5rem;">
            <% const pOwnerName = (typeof session !== 'undefined' && session && (session.user_name || session.name)) ? (session.user_name || session.name) : 'Personal Owner'; %>
            <% const pOwnerInitial = pOwnerName.trim()[0].toUpperCase(); %>
            <div style="width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg, #10b981, #3b82f6); color: white; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1.1rem; flex-shrink: 0; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);">
                <%= pOwnerInitial %>
            </div>
            <div style="min-width: 0;">
                <div style="font-size: 0.95rem; font-weight: 800; color: white; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%= pOwnerName %></div>
                <div style="font-size: 0.72rem; color: #9ca3af; font-weight: 600;">Personal Library</div>
            </div>
        </div>
        <div style="margin-bottom: 1.5rem; background: rgba(255,255,255,0.03); border: 1px solid var(--glass-border); padding: 8px 12px; border-radius: 12px;">
            <label style="display: block; font-size: 0.7rem; color: #9ca3af; text-transform: uppercase; font-weight: bold; margin-bottom: 4px;">Active Collection</label>
            <select onchange="if(this.value === 'manage_collections') { window.location.href='/personal/libraries'; } else { window.location.href='/personal/libraries/switch/' + this.value; }" style="width: 100%; background: #0f0f15; color: white; border: 1px solid var(--glass-border); border-radius: 8px; padding: 6px; font-size: 0.85rem; cursor: pointer;">
                <optgroup label="My Libraries">
                    <% (locals.personal_my_libraries || []).forEach(function(lib) { %>
                    <option value="<%= lib.id %>" <%= locals.personal_active_library && locals.personal_active_library.id === lib.id ? 'selected' : '' %>><%= lib.library_name %></option>
                    <% }) %>
                </optgroup>
                <% if (locals.personal_shared_libraries && locals.personal_shared_libraries.length > 0) { %>
                <optgroup label="Shared with Me">
                    <% locals.personal_shared_libraries.forEach(function(lib) { %>
                    <option value="<%= lib.id %>" <%= locals.personal_active_library && locals.personal_active_library.id === lib.id ? 'selected' : '' %>>🤝 <%= lib.library_name %> (<%= lib.owner_name %>)</option>
                    <% }) %>
                </optgroup>
                <% } %>
                <optgroup label="Actions">
                    <option value="manage_collections">📂 Manage Collections (+)</option>
                </optgroup>
            </select>
        </div>
        <nav class="personal-nav">
            <a href="/personal/dashboard" class="personal-nav-link active"><span>🏠</span> Dashboard</a>
            <a href="/personal/books" class="personal-nav-link"><span>📖</span> My Books</a>
            <a href="/personal/reading" class="personal-nav-link"><span>⏱️</span> Reading Tracker</a>
            <a href="/personal/borrowing" class="personal-nav-link"><span>🤝</span> Lending System</a>
            <a href="/personal/wishlist" class="personal-nav-link"><span>✨</span> Wishlist</a>
            <a href="/personal/favorites" class="personal-nav-link"><span>⭐</span> Favorites</a>
            <a href="/personal/libraries" class="personal-nav-link"><span>📂</span> Collections</a>
            <a href="/personal/elibrary" class="personal-nav-link"><span>🌐</span> E-Library</a>
            <a href="/personal/scan" class="personal-nav-link"><span>📷</span> AI Scanner</a>
            <a href="/personal/settings" class="personal-nav-link"><span>⚙️</span> Settings & Plan</a>
            <hr style="border: 0; border-top: 1px solid var(--glass-border); margin: 1.5rem 0;">
            <a href="/logout" class="personal-nav-link" style="color: #f43f5e;"><span>🚪</span> Sign Out</a>
        </nav>
        <div class="personal-sidebar-profile">
            <img src="<%= lib.profile_photo || 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=100&q=80' %>" class="personal-profile-pic" alt="Profile">
            <div style="flex: 1; overflow: hidden;">
                <div style="font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%= session.user_name %></div>
                <div style="font-size: 0.75rem; color: #9ca3af; text-transform: uppercase;"><%= lib.plan_name %> PLAN</div>
            </div>
        </div>
    </aside>

    <main class="personal-content">
        <% if (locals.messages && messages.success) { %>
        <div style="padding: 12px; margin-bottom: 20px; border-radius: 8px; font-weight: 500; font-size: 0.9rem; background: rgba(16, 185, 129, 0.1); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.2);"><%= messages.success %></div>
        <% } %>
        <% if (locals.messages && messages.error) { %>
        <div style="padding: 12px; margin-bottom: 20px; border-radius: 8px; font-weight: 500; font-size: 0.9rem; background: rgba(244, 63, 94, 0.1); color: #f43f5e; border: 1px solid rgba(244, 63, 94, 0.2);"><%= messages.error %></div>
        <% } %>

        <% if (overdue_loans && overdue_loans.length > 0) { %>
        <div class="overdue-banner">
            <div style="display: flex; align-items: center; gap: 10px;">
                <span>⚠️</span>
                <span>You have <strong><%= overdue_loans.length %></strong> overdue books lent to friends!</span>
            </div>
            <a href="/personal/borrowing" class="btn-alt" style="border-color: #f43f5e; color: #f43f5e; padding: 4px 12px; font-size: 0.8rem; border-radius: 6px;">Manage Loans</a>
        </div>
        <% } %>

        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
            <div>
                <h1 style="margin: 0; font-size: 2.2rem; background: linear-gradient(135deg, #ffffff 0%, #9ca3af 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                    Welcome back, <%= session.user_name %>
                </h1>
                <p style="color: #9ca3af; margin: 4px 0 0 0;">Here is what's happening in your library: <strong><%= lib.library_name %></strong></p>
            </div>
            <div style="font-size: 0.9rem; background: rgba(255,255,255,0.02); padding: 6px 16px; border-radius: 20px; border: 1px solid var(--glass-border);">
                📅 <%= new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
            </div>
        </div>

        <div class="dashboard-grid-4">
            <div class="personal-card stat-card purple-glow">
                <div>
                    <div style="font-size: 0.85rem; color: #9ca3af; font-weight: 600; text-transform: uppercase;">Total Collection</div>
                    <div style="font-size: 2rem; font-weight: 800; margin-top: 5px;"><%= total_books %></div>
                </div>
                <div class="stat-icon">📚</div>
            </div>
            <div class="personal-card stat-card pink-glow">
                <div>
                    <div style="font-size: 0.85rem; color: #9ca3af; font-weight: 600; text-transform: uppercase;">Books Read</div>
                    <div style="font-size: 2rem; font-weight: 800; margin-top: 5px;"><%= books_read %></div>
                </div>
                <div class="stat-icon">✅</div>
            </div>
            <div class="personal-card stat-card blue-glow">
                <div>
                    <div style="font-size: 0.85rem; color: #9ca3af; font-weight: 600; text-transform: uppercase;">Currently Reading</div>
                    <div style="font-size: 2rem; font-weight: 800; margin-top: 5px;"><%= books_reading %></div>
                </div>
                <div class="stat-icon">📖</div>
            </div>
            <div class="personal-card stat-card purple-glow" style="border-color: rgba(16, 185, 129, 0.2);">
                <div>
                    <div style="font-size: 0.85rem; color: #9ca3af; font-weight: 600; text-transform: uppercase;">Wishlist</div>
                    <div style="font-size: 2rem; font-weight: 800; margin-top: 5px;"><%= wishlist_count %></div>
                </div>
                <div class="stat-icon" style="color: #10b981; background: rgba(16, 185, 129, 0.15);">✨</div>
            </div>
        </div>

        <h2 style="font-size: 1.3rem; margin-bottom: 1rem; color: #ffffff;">Quick Actions</h2>
        <div class="actions-container">
            <a href="/personal/books/add" class="action-btn"><span>➕</span> Add Book</a>
            <a href="/personal/scan" class="action-btn"><span>📷</span> Scan Cover</a>
            <a href="/personal/reading" class="action-btn"><span>⏱️</span> Reading Progress</a>
            <a href="/personal/borrowing" class="action-btn"><span>🤝</span> Lend Book</a>
            <a href="/personal/libraries" class="action-btn"><span>📂</span> Collections</a>
        </div>

        <div class="dashboard-panels">
            <div style="display: flex; flex-direction: column; gap: 30px;">
                <div class="personal-card">
                    <h3 style="margin-top: 0; font-size: 1.2rem; color: #ffffff;">Reading Tracker Insights</h3>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 20px; margin-top: 1.5rem;">
                        <div style="background: rgba(255,255,255,0.01); border: 1px solid var(--glass-border); padding: 1.2rem; border-radius: 12px; text-align: center;">
                            <div style="font-size: 0.75rem; color: #9ca3af; font-weight: 600; text-transform: uppercase;">Read This Month</div>
                            <div style="font-size: 1.8rem; font-weight: 800; color: #ec4899; margin-top: 5px;"><%= read_this_month %></div>
                        </div>
                        <div style="background: rgba(255,255,255,0.01); border: 1px solid var(--glass-border); padding: 1.2rem; border-radius: 12px; text-align: center;">
                            <div style="font-size: 0.75rem; color: #9ca3af; font-weight: 600; text-transform: uppercase;">Completion Rate</div>
                            <div style="font-size: 1.8rem; font-weight: 800; color: #3b82f6; margin-top: 5px;"><%= completion_rate %>%</div>
                        </div>
                        <div style="background: rgba(255,255,255,0.01); border: 1px solid var(--glass-border); padding: 1.2rem; border-radius: 12px; text-align: center;">
                            <div style="font-size: 0.75rem; color: #9ca3af; font-weight: 600; text-transform: uppercase;">Total Pages Read</div>
                            <div style="font-size: 1.8rem; font-weight: 800; color: #8b5cf6; margin-top: 5px;"><%= pages_read %></div>
                        </div>
                    </div>
                </div>

                <div class="personal-card">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <h3 style="margin: 0; font-size: 1.2rem; color: #ffffff;">Favorites Collection</h3>
                        <a href="/personal/favorites" style="color: #8b5cf6; text-decoration: none; font-size: 0.85rem; font-weight: 600;">View All</a>
                    </div>
                    <% if (favorites && favorites.length > 0) { %>
                    <div style="display: flex; flex-direction: column; gap: 12px; margin-top: 1.5rem;">
                        <% favorites.slice(0, 5).forEach(function(fav) { %>
                        <div style="display: flex; justify-content: space-between; align-items: center; background: rgba(255,255,255,0.01); border: 1px solid var(--glass-border); padding: 10px 16px; border-radius: 12px;">
                            <div style="display: flex; align-items: center; gap: 10px;">
                                <span style="font-size: 1.2rem;">⭐</span>
                                <div>
                                    <strong style="color: white; font-size: 0.9rem;"><%= fav.item_value %></strong>
                                    <div style="font-size: 0.7rem; color: #9ca3af; text-transform: uppercase;"><%= fav.item_type %></div>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                    </div>
                    <% } else { %>
                    <p style="color: #9ca3af; font-size: 0.9rem; text-align: center; margin-top: 1.5rem;">No favorites saved yet. Star books, authors, or genres to see them here.</p>
                    <% } %>
                </div>
            </div>

            <div style="display: flex; flex-direction: column; gap: 30px;">
                <div class="streak-counter">
                    <div style="font-size: 0.85rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px; opacity: 0.9;">Reading Streak</div>
                    <div class="streak-num" style="margin: 10px 0;">🔥 <%= streak %></div>
                    <div style="font-size: 0.85rem; opacity: 0.9;">Consecutive active days</div>
                </div>

                <div class="personal-card" style="flex: 1;">
                    <h3 style="margin-top: 0; font-size: 1.2rem; color: #ffffff;">Recent Activity</h3>
                    <% if (activity_logs && activity_logs.length > 0) { %>
                    <div class="activity-timeline">
                        <% activity_logs.forEach(function(log) { %>
                        <div class="activity-item">
                            <div class="activity-badge">📝</div>
                            <div class="activity-details">
                                <div style="font-size: 0.85rem; font-weight: 600; color: #ffffff;"><%= log.action %></div>
                                <div class="activity-time"><%= log.created_at %></div>
                            </div>
                        </div>
                        <% }) %>
                    </div>
                    <% } else { %>
                    <p style="color: #9ca3af; font-size: 0.9rem; text-align: center; margin-top: 1.5rem;">No activities logged yet.</p>
                    <% } %>
                </div>
            </div>
        </div>
    </main>
</div>
<%- include('layouts/footer') %>
