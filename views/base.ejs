        <a href="/exit-demo" style="background: black; color: white; padding: 4px 12px; border-radius: 4px; text-decoration: none; font-size: 0.7rem;">Exit Demo</a>
    </div>
    <script>
        let timeLeft = 300;
        const timerDisplay = document.getElementById('demoTimer');
        const timerInterval = setInterval(() => {
            const minutes = Math.floor(timeLeft / 60);
            const seconds = timeLeft % 60;
            timerDisplay.innerText = `${minutes}:${seconds < 10 ? '0' : ''}${seconds}`;
            if (timeLeft <= 0) {
                clearInterval(timerInterval);
                window.location.href = '/exit-demo';
            }
            timeLeft--;
        }, 1000);
    </script>
