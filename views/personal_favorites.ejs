<%- include('layouts/header', { title: 'Favorites Collection - Personal Library' }) %>
<link rel="stylesheet" href="/static/personal.css">
<style>
.fav-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 30px; }
@media (max-width: 1024px) { .fav-grid { grid-template-columns: 1fr; } }
.fav-section-title { font-size: 1.2rem; color: white; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--glass-border); padding-bottom: 10px; }
.fav-list { display: flex; flex-direction: column; gap: 12px; }
.fav-item { display: flex; justify-content: space-between; align-items: center; background: rgba(255, 255, 255, 0.02); border: 1px solid var(--glass-border); padding: 10px 16px; border-radius: 12px; }
</style>

<div class="personal-layout">
    <aside class="personal-sidebar">
        <div class="personal-brand"><span>📚</span><span>Librika Personal</span></div>
        <div style="margin-bottom: 1.5rem; background: rgba(255,255,255,0.03); border: 1px solid var(--glass-border); padding: 8px 12px; border-radius: 12px;">
            <label style="display: block; font-size: 0.7rem; color: #9ca3af; text-transform: uppercase; font-weight: bold; margin-bottom: 4px;">Active Collection</label>
            <select onchange="if(this.value === 'manage_collections') { window.location.href='/personal/libraries'; } else { window.location.href='/personal/libraries/switch/' + this.value; }" style="width: 100%; background: #0f0f15; color: white; border: 1px solid var(--glass-border); border-radius: 8px; padding: 6px; font-size: 0.85rem; cursor: pointer;">
                <optgroup label="My Libraries">
                    <% (locals.personal_my_libraries || []).forEach(function(l) { %>
                    <option value="<%= l.id %>" <%= locals.personal_active_library && locals.personal_active_library.id === l.id ? 'selected' : '' %>><%= l.library_name %></option>
                    <% }) %>
                </optgroup>
                <% if (locals.personal_shared_libraries && locals.personal_shared_libraries.length > 0) { %>
                <optgroup label="Shared with Me">
                    <% locals.personal_shared_libraries.forEach(function(l) { %>
                    <option value="<%= l.id %>" <%= locals.personal_active_library && locals.personal_active_library.id === l.id ? 'selected' : '' %>>🤝 <%= l.library_name %> (<%= l.owner_name %>)</option>
                    <% }) %>
                </optgroup>
                <% } %>
                <optgroup label="Actions">
                    <option value="manage_collections">📂 Manage Collections (+)</option>
                </optgroup>
            </select>
        </div>
        <nav class="personal-nav">
            <a href="/personal/dashboard" class="personal-nav-link"><span>🏠</span> Dashboard</a>
            <a href="/personal/books" class="personal-nav-link"><span>📖</span> My Books</a>
            <a href="/personal/reading" class="personal-nav-link"><span>⏱️</span> Reading Tracker</a>
            <a href="/personal/borrowing" class="personal-nav-link"><span>🤝</span> Lending System</a>
            <a href="/personal/wishlist" class="personal-nav-link"><span>✨</span> Wishlist</a>
            <a href="/personal/favorites" class="personal-nav-link active"><span>⭐</span> Favorites</a>
            <a href="/personal/libraries" class="personal-nav-link"><span>📂</span> Collections</a>
            <a href="/personal/elibrary" class="personal-nav-link"><span>🌐</span> E-Library</a>
            <a href="/personal/scan" class="personal-nav-link"><span>📷</span> AI Scanner</a>
            <a href="/personal/settings" class="personal-nav-link"><span>⚙️</span> Settings & Plan</a>
            <hr style="border: 0; border-top: 1px solid var(--glass-border); margin: 1.5rem 0;">
            <a href="/logout" class="personal-nav-link" style="color: #f43f5e;"><span>🚪</span> Sign Out</a>
        </nav>
        <div class="personal-sidebar-profile">
            <img src="<%= lib.profile_photo || 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=100&q=80' %>" class="personal-profile-pic" alt="Profile">
            <div style="flex: 1; overflow: hidden;">
                <div style="font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%= session.user_name %></div>
                <div style="font-size: 0.75rem; color: #9ca3af; text-transform: uppercase;"><%= lib.plan_name %> PLAN</div>
            </div>
        </div>
    </aside>

    <main class="personal-content">
        <% if (locals.messages && messages.success) { %><div style="padding: 12px; margin-bottom: 20px; border-radius: 8px; font-weight: 500; font-size: 0.9rem; background: rgba(16, 185, 129, 0.1); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.2);"><%= messages.success %></div><% } %>
        <% if (locals.messages && messages.error) { %><div style="padding: 12px; margin-bottom: 20px; border-radius: 8px; font-weight: 500; font-size: 0.9rem; background: rgba(244, 63, 94, 0.1); color: #f43f5e; border: 1px solid rgba(244, 63, 94, 0.2);"><%= messages.error %></div><% } %>

        <div style="margin-bottom: 2rem;">
            <h1 style="margin: 0; font-size: 2.2rem; background: linear-gradient(135deg, #ffffff 0%, #9ca3af 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Favorites Collection</h1>
            <p style="color: #9ca3af; margin: 4px 0 0 0;">Star your preferred books, authors, and genres/categories</p>
        </div>

        <div class="fav-grid">
            <div class="personal-card">
                <div class="fav-section-title"><span>📚 Favorite Books</span></div>
                <div class="fav-list">
                    <% if (fav_books && fav_books.length > 0) { %>
                        <% fav_books.forEach(function(book) { %>
                        <div class="fav-item">
                            <div>
                                <strong style="color: white;"><%= book.title %></strong>
                                <div style="font-size: 0.75rem; color: #9ca3af;">By <%= book.author %></div>
                            </div>
                            <form action="/personal/favorites/delete/<%= book.fav_id %>" method="POST">
                                <button type="submit" style="background: none; border: none; cursor: pointer; font-size: 1.1rem; color: #f43f5e;">★</button>
                            </form>
                        </div>
                        <% }) %>
                    <% } else { %>
                        <p style="color: #9ca3af; font-size: 0.9rem; text-align: center; padding: 2rem 0;">No favorite books starred. Click star in your book collection.</p>
                    <% } %>
                </div>
            </div>

            <div class="personal-card">
                <div class="fav-section-title">
                    <span>✍️ Favorite Authors</span>
                    <button class="action-icon-btn" onclick="openAddModal('author')" style="font-size: 1.2rem; background:none; border:none; color:#9ca3af; cursor:pointer;">➕</button>
                </div>
                <div class="fav-list">
                    <% if (fav_authors && fav_authors.length > 0) { %>
                        <% fav_authors.forEach(function(author) { %>
                        <div class="fav-item">
                            <span style="color: white; font-weight: 600;"><%= author.item_value %></span>
                            <form action="/personal/favorites/delete/<%= author.id %>" method="POST">
                                <button type="submit" style="background: none; border: none; cursor: pointer; font-size: 1rem; color: #f43f5e;">🗑️</button>
                            </form>
                        </div>
                        <% }) %>
                    <% } else { %>
                        <p style="color: #9ca3af; font-size: 0.9rem; text-align: center; padding: 2rem 0;">No favorite authors added.</p>
                    <% } %>
                </div>
            </div>

            <div class="personal-card">
                <div class="fav-section-title">
                    <span>🏷️ Favorite Categories</span>
                    <button class="action-icon-btn" onclick="openAddModal('category')" style="font-size: 1.2rem; background:none; border:none; color:#9ca3af; cursor:pointer;">➕</button>
                </div>
                <div class="fav-list">
                    <% if (fav_categories && fav_categories.length > 0) { %>
                        <% fav_categories.forEach(function(cat) { %>
                        <div class="fav-item">
                            <span style="color: white; font-weight: 600;"><%= cat.item_value %></span>
                            <form action="/personal/favorites/delete/<%= cat.id %>" method="POST">
                                <button type="submit" style="background: none; border: none; cursor: pointer; font-size: 1rem; color: #f43f5e;">🗑️</button>
                            </form>
                        </div>
                        <% }) %>
                    <% } else { %>
                        <p style="color: #9ca3af; font-size: 0.9rem; text-align: center; padding: 2rem 0;">No favorite categories added.</p>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Add Favorite Modal -->
        <div id="addFavModal" style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(15, 23, 42, 0.35); z-index: 10000; display: none; align-items: center; justify-content: center; ">
            <div class="personal-card" style="width: 400px;">
                <h2 style="margin-top: 0; color: white;" id="modalHeader">Add Favorite</h2>
                <form action="/personal/favorites/add" method="POST" style="margin-top: 1.5rem;">
                    <input type="hidden" id="fav_item_type" name="item_type">
                    <div class="input-group">
                        <label for="fav_item_value" id="modalInputLabel">Value</label>
                        <input type="text" id="fav_item_value" name="item_value" required placeholder="E.g. J.K. Rowling">
                    </div>
                    <div style="display: flex; gap: 10px; justify-content: flex-end; margin-top: 1.5rem;">
                        <button type="button" class="btn-alt" onclick="document.getElementById('addFavModal').style.display='none'">Cancel</button>
                        <button type="submit" class="btn-neon">Save Favorite</button>
                    </div>
                </form>
            </div>
        </div>
    </main>
</div>

<script>
function openAddModal(type) {
    document.getElementById('fav_item_type').value = type;
    const header = document.getElementById('modalHeader');
    const label = document.getElementById('modalInputLabel');
    const input = document.getElementById('fav_item_value');
    if (type === 'author') {
        header.innerText = "Add Favorite Author";
        label.innerText = "Author Name";
        input.placeholder = "E.g. J.K. Rowling";
    } else {
        header.innerText = "Add Favorite Category";
        label.innerText = "Category/Genre Name";
        input.placeholder = "E.g. Science Fiction";
    }
    document.getElementById('addFavModal').style.display = 'flex';
}
</script>
<%- include('layouts/footer') %>
