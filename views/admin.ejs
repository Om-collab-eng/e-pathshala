    // ─────────────────────────────────────────────────────────────────
    // 3. ISSUE DESK READINESS CHECK & SUBMIT
    // ─────────────────────────────────────────────────────────────────
    function checkIssueReadiness() {
      const btn = document.getElementById('circConfirmIssueBtn');
      const hint = document.getElementById('circIssueReadinessHint');
      if (!btn) return;

      if (!activeCheckoutMember && !activeCheckoutBook) {
        btn.disabled = true;
        btn.innerText = 'CONFIRM ISSUE';
        if (hint) {
          hint.innerText = 'Select Student & Book to Issue';
          hint.style.color = '#64748B';
        }
        return;
      }

      if (!activeCheckoutMember) {
        btn.disabled = true;
        btn.innerText = 'SELECT STUDENT FIRST';
        if (hint) {
          hint.innerText = 'Please search and select a borrower student';
          hint.style.color = '#0B5ED7';
        }
        return;
      }

      if (!activeCheckoutBook) {
        btn.disabled = true;
        btn.innerText = 'SELECT BOOK FIRST';
        if (hint) {
          hint.innerText = 'Please search and select a book to issue';
          hint.style.color = '#0B5ED7';
        }
        return;
      }

      // Check member quota
      if (!activeCheckoutMember.can_borrow) {
        btn.disabled = true;
        btn.innerText = `QUOTA REACHED (MAX ${activeCheckoutMember.borrowing_limit} BOOKS)`;
        if (hint) {
          hint.innerText = `⚠️ ${activeCheckoutMember.name} has reached maximum quota of ${activeCheckoutMember.borrowing_limit} books`;
          hint.style.color = '#DC3545';
        }
        return;
      }

      // Check book stock
      if (!activeCheckoutBook.is_available) {
        btn.disabled = true;
        btn.innerText = 'BOOK OUT OF STOCK';
        if (hint) {
          hint.innerText = `⚠️ '${activeCheckoutBook.title}' has 0 available copies in stock`;
          hint.style.color = '#DC3545';
        }
        return;
      }

      // All good!
      btn.disabled = false;
      btn.innerText = `CONFIRM ISSUE TO ${activeCheckoutMember.name.toUpperCase()}`;
      if (hint) {
        hint.innerText = `✓ Ready! ${activeCheckoutMember.borrowing_limit - activeCheckoutMember.active_count} loan spot(s) remaining for this member.`;
        hint.style.color = '#059669';
      }
    }

    async function submitCirculationIssue() {
      if (!activeCheckoutMember || !activeCheckoutBook) return;
      if (!activeCheckoutMember.can_borrow) {
        alert(`❌ Cannot issue book: Member ${activeCheckoutMember.name} has reached maximum quota (${activeCheckoutMember.borrowing_limit} books).`);
        return;
      }
      if (!activeCheckoutBook.is_available) {
        alert(`❌ Cannot issue book: '${activeCheckoutBook.title}' has 0 copies available in stock.`);
        return;
      }

      const days = document.getElementById('circLoanDays').value;
      const targetBarcode = activeCheckoutBook.copy_barcode || activeCheckoutBook.barcode_id;

      try {
        const res = await fetch('/admin/api/circulation/issue', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            member_id: activeCheckoutMember.id,
            book_id: activeCheckoutBook.id,
            barcode: targetBarcode,
            due_days: days
          })
        });
        const data = await res.json();
        if (data.status === 'success') {
          alert(`✅ ${data.message}`);
          window.location.reload();
        } else {
