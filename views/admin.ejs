<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800;900&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/librarian-pro.css">
  <link rel="stylesheet" href="/mobile-first.css">
  <style>
    .lp-logout-btn {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 5px 9px;
      background: #FEE2E2;
      color: #DC2626 !important;
      border: 1px solid #FCA5A5;
      border-radius: 6px;
      font-size: 0.76rem;
      font-weight: 800;
      text-decoration: none;
      transition: all 0.15s ease;
      flex-shrink: 0;
      line-height: 1;
    }
    .lp-logout-btn:hover {
      background: #DC2626;
      color: #ffffff !important;
      border-color: #DC2626;
    }
  </style>
</head>
<body class="lp-body">
<%
  function renderDate(d) {
    if (!d) return '';
    try {
      const dt = new Date(d);
      if (isNaN(dt.getTime())) return '';
      return dt.toISOString().slice(0, 10);
    } catch (e) {
      return '';
    }
  }
%>

  <div class="lp-shell">
    
    <!-- ═══════════════════════════════════════════════════════════════
         1. PRIMARY 9-MODULE SIDEBAR NAVIGATION
         ═══════════════════════════════════════════════════════════════ -->
    <!-- Backdrop Dimming Overlay for Mobile Drawer Sidebar -->
    <div class="lp-sidebar-backdrop" id="lpSidebarBackdrop" onclick="toggleSidebar()"></div>

    <aside class="lp-sidebar" id="lpSidebar">
      
      <!-- Top Utility Controls (Back, Home, Night Toggle) Above Logo -->
      <div class="lp-sidebar-top-bar">
        <button onclick="window.history.back()" class="lp-top-nav-btn" title="Go Back">
          ← <span>Back</span>
        </button>
        <a href="/" class="lp-top-nav-btn" title="Go Home">
          🏠 <span>Home</span>
        </a>
        <button onclick="toggleTheme()" class="lp-top-nav-btn icon-only" id="lpThemeBtn" title="Toggle Theme">
          <span id="lpThemeIcon">🌙</span>
        </button>
      </div>

      <!-- Brand Header -->
      <div class="lp-sidebar-header">
        <a href="/admin" class="lp-brand-badge">
          <div class="lp-brand-icon">📚</div>
          <div>
            <h1 class="lp-brand-name">Librika</h1>
            <span class="lp-brand-sub">Librarian Pro</span>
          </div>
        </a>
      </div>

      <!-- 9 Core Navigation Items -->
      <nav class="lp-sidebar-nav">
        
        <!-- 1. Dashboard -->
        <button class="lp-nav-item <%= currentModule === 'dashboard' ? 'active' : '' %>" onclick="navigateToModule('dashboard')">
          <span class="lp-nav-icon">📊</span>
          <span>Dashboard</span>
        </button>

        <!-- 2. Catalog -->
        <button class="lp-nav-item <%= currentModule === 'catalog' ? 'active' : '' %>" onclick="navigateToModule('catalog')">
          <span class="lp-nav-icon">📚</span>
          <span>Catalog</span>
          <span class="lp-nav-badge"><%= stats.total_books %></span>
        </button>

        <!-- 3. Members -->
        <button class="lp-nav-item <%= currentModule === 'members' ? 'active' : '' %>" onclick="navigateToModule('members')">
          <span class="lp-nav-icon">👥</span>
          <span>Members</span>
          <span class="lp-nav-badge"><%= stats.total_members %></span>
        </button>

        <!-- 4. Circulation -->
        <button class="lp-nav-item <%= currentModule === 'circulation' ? 'active' : '' %>" data-module="circulation" onclick="navigateToModule('circulation')">
          <span class="lp-nav-icon">🔄</span>
          <span>Circulation</span>
          <% if (stats.overdue_count > 0) { %>
            <span class="lp-nav-badge danger"><%= stats.overdue_count %></span>
          <% } else { %>
            <span class="lp-nav-badge primary"><%= stats.active_issues %></span>
          <% } %>
        </button>

        <!-- 5. Student Progress (Books, Quizzes, Courses) -->
        <button class="lp-nav-item <%= currentModule === 'student-progress' ? 'active' : '' %>" data-module="student-progress" onclick="navigateToModule('student-progress')">
          <span class="lp-nav-icon">🎓</span>
          <span>Student Progress</span>
          <% if (typeof stats.student_progress_count !== 'undefined' && stats.student_progress_count > 0) { %>
            <span class="lp-nav-badge" style="background:#4F46E5;color:#fff;"><%= stats.student_progress_count %></span>
          <% } %>
        </button>

        <!-- 5. Requests -->
        <button class="lp-nav-item <%= currentModule === 'requests' ? 'active' : '' %>" onclick="navigateToModule('requests')">
          <span class="lp-nav-icon">📖</span>
          <span>Requests</span>
          <% if (stats.pending_reservations > 0) { %>
            <span class="lp-nav-badge warning"><%= stats.pending_reservations %></span>
          <% } %>
        </button>

        <!-- 6. E-Library -->
        <button class="lp-nav-item <%= currentModule === 'e-library' ? 'active' : '' %>" onclick="navigateToModule('e-library')">
          <span class="lp-nav-icon">🌐</span>
          <span>E-Library</span>
          <span class="lp-nav-badge"><%= stats.total_digital %></span>
        </button>

        <!-- 7. Studio -->
        <button class="lp-nav-item <%= currentModule === 'studio' ? 'active' : '' %>" onclick="navigateToModule('studio')">
          <span class="lp-nav-icon">🎥</span>
          <span>Studio</span>
          <span class="lp-nav-badge primary" style="background:#0B5ED7;color:#fff;">LIVE</span>
        </button>

        <!-- 8. Analytics -->
        <button class="lp-nav-item <%= currentModule === 'analytics' ? 'active' : '' %>" onclick="navigateToModule('analytics')">
          <span class="lp-nav-icon">📈</span>
          <span>Analytics</span>
        </button>

        <!-- 9. Settings -->
        <button class="lp-nav-item <%= currentModule === 'settings' ? 'active' : '' %>" onclick="navigateToModule('settings')">
          <span class="lp-nav-icon">⚙️</span>
          <span>Settings</span>
        </button>

      </nav>

      <!-- Sidebar Footer User Profile -->
      <div class="lp-sidebar-footer">
        <div class="lp-user-pill">
          <div class="lp-user-avatar">
            <%= ((typeof session !== 'undefined' && session && session.name) ? session.name[0] : 'L').toUpperCase() %>
          </div>
          <div class="lp-user-info" style="min-width:0;flex:1;">
            <h4 class="lp-user-name" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= (typeof session !== 'undefined' && session && session.name) ? session.name : 'Chief Librarian' %></h4>
            <p class="lp-user-role" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= school.name %></p>
          </div>
          <a href="/logout" class="lp-logout-btn" title="Sign Out">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
            <span>Logout</span>
          </a>
        </div>
      </div>

    </aside>

    <!-- ═══════════════════════════════════════════════════════════════
         2. MAIN APP VIEWPORT & TOPBAR
         ═══════════════════════════════════════════════════════════════ -->
    <main class="lp-main">
      
      <!-- Topbar Header -->
      <header class="lp-topbar">
        <div class="lp-topbar-left">
          <button class="lp-menu-toggle" onclick="toggleSidebar()" aria-label="Toggle menu">☰</button>
          
          <div class="lp-search-bar">
            <span class="lp-search-icon">🔍</span>
            <input type="text" class="lp-search-input" id="globalSearchInput" placeholder="Quick search books, members, barcodes..." onkeyup="handleGlobalSearch(this.value)">
          </div>
        </div>

        <div class="lp-topbar-right">
          <button class="ai-button" onclick="toggleAiCopilot()" style="padding:7px 14px;font-size:0.85rem;">
            ✨ Ask Library AI
          </button>
          
          <button class="btn-primary" onclick="openModal('addBookModal')" style="padding:7px 14px;font-size:0.85rem;">
            + Add Book
          </button>

          <button class="btn-secondary" onclick="navigateToModule('circulation', 'issue')" style="padding:7px 14px;font-size:0.85rem;">
            Issue Book
          </button>

          <div style="position:relative;">
            <button class="btn-secondary" onclick="toggleNotifDropdown()" style="padding:7px 12px;border-radius:50%;" title="Notifications">
              🔔
              <% if (stats.overdue_count > 0) { %>
                <span style="position:absolute;top:-4px;right:-4px;background:#DC3545;color:#fff;font-size:0.65rem;font-weight:800;padding:2px 6px;border-radius:9999px;">
                  <%= stats.overdue_count %>
                </span>
              <% } %>
            </button>
          </div>
        </div>
      </header>

      <!-- Main Content Container -->
      <div style="padding: 24px 28px;">
        
        <!-- ─────────────────────────────────────────────────────────────
             MODULE 01 — DASHBOARD
             ───────────────────────────────────────────────────────────── -->
        <section id="module-dashboard" class="lp-module-view" style="display:<%= currentModule === 'dashboard' ? 'block' : 'none' %>;">
          
          <!-- Hero Section + Today Card -->
          <div class="lp-hero-section">
            <div class="lp-hero-left">
              <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:12px;flex-wrap:wrap;">
                <span class="lp-hero-pill" style="margin-bottom:0;">✨ Intelligent Library Workspace</span>
                <span class="lp-quote-pill" id="lpQuotePillTag">
                  <span>💡</span> Thought of the Moment
                </span>
              </div>
              <h1 class="hero-title">
                Your library,<br>
                always in motion.
              </h1>
              <p class="hero-sub">
                Manage books, readers, circulation and digital resources from one intelligent workspace.
              </p>

              <!-- Dynamic Inspirational Literary Quote Card -->
              <div class="lp-hero-quote-card" id="lpHeroQuoteCard">
                <div class="lp-quote-header">
                  <span style="font-size:0.75rem;font-weight:700;color:var(--text-secondary);display:inline-flex;align-items:center;gap:4px;">
                    📚 Daily Literary Inspiration
                  </span>
                  <button type="button" class="lp-quote-shuffle-btn" onclick="cycleHeroQuote(true)" title="Get a new quote">
                    <span id="lpQuoteSpinIcon" style="display:inline-block;transition:transform 0.4s ease;">↻</span> <span>New Quote</span>
                  </button>
                </div>
                <div class="lp-quote-body-wrap" id="lpQuoteContainer">
                  <span class="lp-quote-mark">“</span>
                  <div style="flex:1;">
                    <p id="lpQuoteText" class="lp-quote-text">
                      "<%= (typeof dailyQuote !== 'undefined' && dailyQuote && dailyQuote.quote) ? dailyQuote.quote : 'Google can bring you back 100,000 answers. A librarian can bring you back the right one.' %>"
                    </p>
                    <span id="lpQuoteAuthor" class="lp-quote-author">
                      — <%= (typeof dailyQuote !== 'undefined' && dailyQuote && dailyQuote.author) ? dailyQuote.author : 'Neil Gaiman' %>
                    </span>
                  </div>
                </div>
              </div>

              <div class="lp-hero-actions">
                <button class="btn-primary" onclick="openModal('addBookModal')">+ Add Book</button>
                <button class="btn-secondary" onclick="navigateToModule('circulation', 'issue')">Issue Book</button>
                <button class="ai-button" onclick="toggleAiCopilot()">✨ Ask Library AI</button>
              </div>
            </div>

            <!-- TODAY Card -->
            <div class="lp-today-card">
              <div class="lp-today-head">
                <span class="lp-today-badge">TODAY'S PULSE</span>
                <span style="font-size:0.8rem;color:var(--text-secondary);font-weight:600;"><%= new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
              </div>

              <div class="lp-today-metrics">
                <div class="lp-today-stat">
                  <div class="lp-today-stat-val active"><%= stats.active_issues %></div>
                  <div class="lp-today-stat-lbl">Active Issues</div>
                </div>
                <div class="lp-today-stat">
                  <div class="lp-today-stat-val overdue"><%= stats.overdue_count %></div>
                  <div class="lp-today-stat-lbl">Overdue</div>
                </div>
                <div class="lp-today-stat">
                  <div class="lp-today-stat-val due"><%= stats.due_today %></div>
                  <div class="lp-today-stat-lbl">Due Today</div>
                </div>
              </div>

              <div class="lp-today-footer">
                <span>Total Catalog: <strong><%= stats.total_books %> Titles</strong></span>
                <button onclick="navigateToModule('circulation')" style="background:transparent;border:none;color:var(--primary);font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:4px;">
                  Circulation Desk &rarr;
                </button>
              </div>
            </div>
          </div>

          <!-- KPI Stats Grid -->
          <div class="lp-stats-grid">
            <div class="lp-stat-card">
              <div class="lp-stat-info">
                <span class="lp-stat-title">Total Books</span>
                <h3 class="lp-stat-value"><%= stats.total_books %></h3>
                <span class="lp-stat-change" style="color:#198754;">✓ <%= stats.available_copies %> Available Copies</span>
              </div>
              <div class="lp-stat-icon-wrap blue">📚</div>
            </div>

            <div class="lp-stat-card">
              <div class="lp-stat-info">
                <span class="lp-stat-title">Active Members</span>
                <h3 class="lp-stat-value"><%= stats.total_members %></h3>
                <span class="lp-stat-change" style="color:#5B4BDB;">👥 <%= stats.total_students %> Students, <%= stats.total_teachers %> Staff</span>
              </div>
              <div class="lp-stat-icon-wrap indigo">👥</div>
            </div>

            <div class="lp-stat-card">
              <div class="lp-stat-info">
                <span class="lp-stat-title">Active Loans</span>
                <h3 class="lp-stat-value"><%= stats.active_issues %></h3>
                <span class="lp-stat-change" style="color:#0B5ED7;">🔄 <%= stats.total_returned %> Total Returned</span>
              </div>
              <div class="lp-stat-icon-wrap blue">🔄</div>
            </div>

            <div class="lp-stat-card">
              <div class="lp-stat-info">
                <span class="lp-stat-title">Pending Requests</span>
                <h3 class="lp-stat-value"><%= stats.pending_reservations %></h3>
                <span class="lp-stat-change" style="color:#F59E0B;">⚡ Waiting Queue</span>
              </div>
              <div class="lp-stat-icon-wrap warning">📖</div>
            </div>
          </div>

          <!-- Quick Actions Bar -->
          <div class="card lp-quick-actions-card" style="margin-bottom:24px;padding:18px 24px;">
            <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
              <span style="font-weight:800;font-size:0.95rem;color:#111827;">⚡ Quick Actions:</span>
              <div class="lp-quick-actions-btns" style="display:flex;gap:10px;flex-wrap:wrap;">
                <button class="btn-secondary" onclick="openModal('addBookModal')">➕ Add Book</button>
                <button class="btn-secondary" onclick="navigateToModule('circulation', 'issue')">📤 Issue Book</button>
                <button class="btn-secondary" onclick="navigateToModule('circulation', 'return')">📥 Return Book</button>
                <button class="btn-secondary" onclick="openModal('addMemberModal')">👤 Register Member</button>
                <button class="btn-secondary" onclick="navigateToModule('requests')">📖 View Requests</button>
              </div>
            </div>
          </div>

          <!-- Two-Column Grid: Recent Activity & Needs Attention -->
          <div class="lp-dashboard-grid">
            
            <!-- Recent Activity -->
            <div class="card">
              <div class="lp-card-header">
                <div>
                  <h3 class="lp-card-title">🕒 Recent Circulation Activity</h3>
                  <p class="lp-card-sub">Latest borrow and return transactions</p>
                </div>
                <button class="btn-secondary" onclick="navigateToModule('circulation')" style="font-size:0.78rem;padding:4px 10px;">View All</button>
              </div>

              <div style="display:flex;flex-direction:column;gap:10px;">
                <% if (activeLoans.length === 0 && returnedLoans.length === 0) { %>
                  <p style="color:#94A3B8;text-align:center;padding:20px;">No recent circulation transactions recorded.</p>
                <% } else { %>
                  <% const recentItems = [...activeLoans, ...returnedLoans].slice(0, 5); %>
                  <% recentItems.forEach(t => { %>
                    <div style="display:flex;align-items:center;justify-content:space-between;padding:10px 14px;border-radius:12px;background:#F8FAFC;border:1px solid #E2E8F0;">
                      <div style="display:flex;align-items:center;gap:12px;">
                        <span style="font-size:1.3rem;"><%= t.return_date ? '✅' : '📖' %></span>
                        <div>
                          <div style="font-weight:700;font-size:0.9rem;color:#111827;"><%= t.book_title %></div>
                          <div style="font-size:0.75rem;color:#64748B;">Borrower: <strong><%= t.user_name %></strong> (<%= t.user_admission || t.user_role %>)</div>
                        </div>
                      </div>
                      <span class="lp-status-pill <%= t.return_date ? 'available' : (t.is_overdue ? 'overdue' : 'issued') %>">
                        <%= t.return_date ? 'Returned' : (t.is_overdue ? 'Overdue' : 'Active Loan') %>
                      </span>
                    </div>
                  <% }) %>
                <% } %>
              </div>
            </div>

            <!-- Needs Attention / Overdue Queue -->
            <div class="card">
              <div class="lp-card-header">
                <div>
                  <h3 class="lp-card-title">🚨 Needs Attention</h3>
                  <p class="lp-card-sub">Overdue books and pending fines</p>
                </div>
                <span class="lp-nav-badge danger"><%= stats.overdue_count %> Overdue</span>
              </div>

              <div style="display:flex;flex-direction:column;gap:10px;">
                <% const overdueItems = activeLoans.filter(l => l.is_overdue); %>
                <% if (overdueItems.length === 0) { %>
                  <div style="text-align:center;padding:30px 10px;color:#198754;">
                    <span style="font-size:2rem;">🎉</span>
                    <div style="font-weight:700;margin-top:6px;">All clean! No overdue books today.</div>
                  </div>
                <% } else { %>
                  <% overdueItems.slice(0, 5).forEach(o => { %>
                    <div style="display:flex;align-items:center;justify-content:space-between;padding:10px 14px;border-radius:12px;background:#FEF2F2;border:1px solid #FCA5A5;">
                      <div>
                        <div style="font-weight:700;font-size:0.88rem;color:#991B1B;"><%= o.book_title %></div>
                        <div style="font-size:0.75rem;color:#B91C1C;">Student: <strong><%= o.user_name %></strong> &bull; <%= o.days_overdue %> days late</div>
                      </div>
                      <div style="text-align:right;">
                        <div style="font-weight:800;color:#DC3545;font-size:0.9rem;">₹<%= o.fine %></div>
                        <button onclick="rapidReturnPrompt('<%= o.id %>')" class="btn-danger" style="padding:2px 8px;font-size:0.72rem;margin-top:2px;">Return</button>
                      </div>
                    </div>
                  <% }) %>
                <% } %>
              </div>
            </div>

          </div>

        </section>

        <!-- ─────────────────────────────────────────────────────────────
             MODULE 02 — CATALOG (BOOKS, INVENTORY, ACQUISITIONS)
             ───────────────────────────────────────────────────────────── -->
        <section id="module-catalog" class="lp-module-view" style="display:<%= currentModule === 'catalog' ? 'block' : 'none' %>;">
          
          <div class="lp-tabs-bar">
            <button class="lp-tab-btn active" onclick="switchCatalogTab('books', this)">
              📚 Books Catalog <span class="lp-tab-badge"><%= books.length %></span>
            </button>
            <button class="lp-tab-btn" onclick="switchCatalogTab('inventory', this)">
              📦 Inventory & Copies <span class="lp-tab-badge"><%= stats.total_copies %></span>
            </button>
            <button class="lp-tab-btn" onclick="switchCatalogTab('acquisitions', this)">
              🛒 Acquisitions & Vendors
            </button>
          </div>

          <!-- Catalog Tab 1: Books -->
          <div id="catalog-tab-books" class="lp-tab-pane active">
            <div class="card" style="margin-bottom:20px;padding:16px 20px;">
              <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
                <div style="display:flex;align-items:center;gap:10px;flex:1;max-width:480px;">
                  <input type="text" id="catalogSearchInput" class="lp-search-input" placeholder="Search by title, author, genre, ISBN, rack..." onkeyup="filterCatalogTable(this.value)">
                </div>
                <div style="display:flex;gap:10px;">
                  <button class="btn-primary" onclick="openModal('addBookModal')">+ Add New Book</button>
                  <button class="btn-secondary" onclick="exportBooksCSV()">Export CSV</button>
                </div>
              </div>
            </div>

            <div class="lp-table-container">
              <table class="lp-table" id="catalogTable">
                <thead>
                  <tr>
                    <th>Book Details</th>
                    <th>ISBN / Barcode</th>
                    <th>Genre & Lang</th>
                    <th>Stock / Copies</th>
                    <th>Rack / Shelf</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% books.forEach(b => { %>
                    <tr>
                      <td>
                        <div style="display:flex;align-items:center;gap:12px;">
                          <div style="width:38px;height:52px;background:#E2E8F0;border-radius:6px;overflow:hidden;flex-shrink:0;display:flex;align-items:center;justify-content:center;">
                            <% if (b.cover_url) { %>
                              <img src="<%= b.cover_url %>" style="width:100%;height:100%;object-fit:cover;">
                            <% } else { %>
                              <span style="font-size:1.2rem;">📖</span>
                            <% } %>
                          </div>
                          <div>
                            <div style="font-weight:700;color:#111827;"><%= b.title %></div>
                            <div style="font-size:0.75rem;color:#64748B;">by <%= b.author || 'Unknown' %></div>
                          </div>
                        </div>
                      </td>
                      <td>
                        <div style="font-family:monospace;font-weight:700;"><%= b.barcode_id || b.isbn || 'N/A' %></div>
                        <% if (b.isbn) { %><div style="font-size:0.7rem;color:#94A3B8;">ISBN: <%= b.isbn %></div><% } %>
                      </td>
                      <td>
                        <div><%= b.genre || 'General' %></div>
                        <div style="font-size:0.72rem;color:#94A3B8;"><%= b.language || 'English' %></div>
                      </td>
                      <td>
                        <div style="font-weight:700;"><%= b.available_copies %> / <%= b.total_copies %> Copies</div>
                      </td>
                      <td>
                        <span style="background:#F1F5F9;padding:3px 8px;border-radius:6px;font-weight:600;font-size:0.8rem;">
                          <%= b.shelf_location || 'Rack A-1' %>
                        </span>
                      </td>
                      <td>
                        <span class="lp-status-pill <%= parseInt(b.available_copies) > 0 ? 'available' : 'overdue' %>">
                          <%= parseInt(b.available_copies) > 0 ? 'In Stock' : 'Issued Out' %>
                        </span>
                      </td>
                      <td>
                        <div style="display:flex;gap:6px;">
                          <button class="btn-secondary" style="padding:4px 8px;font-size:0.75rem;" onclick="quickIssueBook('<%= b.id %>', '<%= b.barcode_id %>')">Issue</button>
                          <button class="btn-secondary" style="padding:4px 8px;font-size:0.75rem;" onclick="openEditBookModal('<%= b.id %>', '<%= (b.title || '').replace(/'/g, '\\\'') %>', '<%= (b.author || '').replace(/'/g, '\\\'') %>', '<%= b.isbn || b.barcode_id %>', '<%= b.total_copies %>', '<%= b.shelf_location || '' %>')">Edit</button>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Catalog Tab 2: Inventory & Physical Copies -->
          <div id="catalog-tab-inventory" class="lp-tab-pane">
            <div class="lp-stats-grid" style="margin-bottom:20px;">
              <div class="lp-stat-card">
                <div class="lp-stat-info">
                  <span class="lp-stat-title">Total Physical Copies</span>
                  <h3 class="lp-stat-value"><%= stats.total_copies %></h3>
                </div>
                <div class="lp-stat-icon-wrap blue">📦</div>
              </div>
              <div class="lp-stat-card">
                <div class="lp-stat-info">
                  <span class="lp-stat-title">Available on Shelf</span>
                  <h3 class="lp-stat-value"><%= stats.available_copies %></h3>
                </div>
                <div class="lp-stat-icon-wrap green">✅</div>
              </div>
              <div class="lp-stat-card">
                <div class="lp-stat-info">
                  <span class="lp-stat-title">Currently Issued</span>
                  <h3 class="lp-stat-value"><%= stats.active_issues %></h3>
                </div>
                <div class="lp-stat-icon-wrap indigo">🔄</div>
              </div>
              <div class="lp-stat-card">
                <div class="lp-stat-info">
                  <span class="lp-stat-title">Damaged / Lost</span>
                  <h3 class="lp-stat-value"><%= stats.damaged_copies + stats.lost_copies %></h3>
                </div>
                <div class="lp-stat-icon-wrap red">⚠️</div>
              </div>
            </div>

            <div class="lp-table-container">
              <table class="lp-table">
                <thead>
                  <tr>
                    <th>Copy Barcode</th>
                    <th>Book Title</th>
                    <th>Condition Status</th>
                    <th>Availability</th>
                    <th>Acquired Date</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (bookCopies.length === 0) { %>
                    <tr><td colspan="6" style="text-align:center;padding:24px;color:#94A3B8;">No individual barcode copies seeded yet.</td></tr>
                  <% } else { %>
                    <% bookCopies.forEach(c => { %>
                      <tr>
                        <td style="font-family:monospace;font-weight:700;color:#0B5ED7;"><%= c.barcode %></td>
                        <td style="font-weight:600;"><%= c.book_title %></td>
                        <td>
                          <span class="lp-status-pill <%= c.condition_status === 'GOOD' ? 'available' : 'overdue' %>">
                            <%= c.condition_status %>
                          </span>
                        </td>
                        <td>
                          <span class="lp-status-pill <%= c.availability_status === 'AVAILABLE' ? 'available' : 'issued' %>">
                            <%= c.availability_status %>
                          </span>
                        </td>
                        <td style="font-size:0.8rem;color:#64748B;"><%= renderDate(c.acquired_at) || 'Recent' %></td>
                        <td>
                          <button class="btn-secondary" style="padding:4px 8px;font-size:0.75rem;" onclick="printBarcodeLabel('<%= c.barcode %>')">🖨️ Print Label</button>
                        </td>
                      </tr>
                    <% }) %>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Catalog Tab 3: Acquisitions & Vendors -->
          <div id="catalog-tab-acquisitions" class="lp-tab-pane">
            <div class="card" style="margin-bottom:20px;">
              <div class="lp-card-header">
                <div>
                  <h3 class="lp-card-title">🛒 Book Procurement &amp; Inventory Reconciliation</h3>
                  <p class="lp-card-sub">Manage supplier invoices, purchase orders, and reconcile registered copies vs invoice totals</p>
                </div>
                <div style="display:flex;gap:8px;">
                  <a href="/admin/acquisitions" class="btn-primary">Open Acquisitions Dashboard &rarr;</a>
                </div>
              </div>
              <p style="color:#64748B;font-size:0.9rem;margin-bottom:16px;">
                Track every purchase order, scan physical invoices with AI OCR, and match incoming shipments directly to library accession numbers.
              </p>
              
              <!-- Quick Overview Stats -->
              <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));gap:14px;margin-top:16px;">
                <div style="background:#F8FAFC;padding:16px;border-radius:12px;border:1px solid #E2E8F0;">
                  <span style="font-size:0.75rem;color:#64748B;font-weight:700;">TOTAL PHYSICAL STOCK</span>
                  <div style="font-size:1.4rem;font-weight:800;color:var(--brand-primary);margin:6px 0;"><%= stats.total_copies %> Copies</div>
                  <div style="font-size:0.75rem;color:#10B981;font-weight:700;">● Active in Physical Catalog</div>
                </div>
                <div style="background:#F8FAFC;padding:16px;border-radius:12px;border:1px solid #E2E8F0;">
                  <span style="font-size:0.75rem;color:#64748B;font-weight:700;">UNIQUE CATALOG TITLES</span>
                  <div style="font-size:1.4rem;font-weight:800;color:#0F172A;margin:6px 0;"><%= books.length %> Titles</div>
                  <div style="font-size:0.75rem;color:#64748B;">Reconciled across racks &amp; shelves</div>
                </div>
                <div style="background:#F8FAFC;padding:16px;border-radius:12px;border:1px solid #E2E8F0;">
                  <span style="font-size:0.75rem;color:#64748B;font-weight:700;">INVOICE MANAGEMENT</span>
                  <div style="margin-top:10px;">
                    <a href="/admin/acquisitions" class="btn-secondary" style="padding:6px 12px;font-size:0.82rem;font-weight:700;display:inline-flex;">
                      📄 View Invoices &amp; Vendor Orders &rarr;
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </section>

        <!-- ─────────────────────────────────────────────────────────────
             MODULE 03 — MEMBERS (STUDENTS, TEACHERS, STAFF)
             ───────────────────────────────────────────────────────────── -->
        <section id="module-members" class="lp-module-view" style="display:<%= currentModule === 'members' ? 'block' : 'none' %>;">
          
          <div class="lp-tabs-bar">
            <button class="lp-tab-btn active" onclick="switchMemberTab('students', this)">
              🎓 Students <span class="lp-tab-badge"><%= students.length %></span>
            </button>
            <button class="lp-tab-btn" onclick="switchMemberTab('teachers', this)">
              👨‍🏫 Teachers <span class="lp-tab-badge"><%= teachers.length %></span>
            </button>
            <button class="lp-tab-btn" onclick="switchMemberTab('staff', this)">
              👔 Staff & Librarians <span class="lp-tab-badge"><%= staff.length %></span>
            </button>
          </div>

          <!-- Actions Bar -->
          <div class="card" style="margin-bottom:20px;padding:16px 20px;">
            <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
              <input type="text" id="memberSearchInput" class="lp-search-input" style="max-width:380px;" placeholder="Search member by name, admission no, phone..." onkeyup="filterMemberTable(this.value)">
              <button class="btn-primary" onclick="openModal('addMemberModal')">+ Register New Member</button>
            </div>
          </div>

          <!-- Member Table -->
          <div class="lp-table-container">
            <table class="lp-table" id="membersTable">
              <thead>
                <tr>
                  <th>Member Name</th>
                  <th>Member ID / Adm No</th>
                  <th>Class / Dept</th>
                  <th>Contact Info</th>
                  <th>Online Presence</th>
                  <th>Account Status</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% allUsers.forEach(u => { %>
                  <tr data-role="<%= u.role %>">
                    <td>
                      <div style="display:flex;align-items:center;gap:10px;">
                        <div style="position:relative;">
                          <div class="lp-preview-avatar" style="width:36px;height:36px;font-size:0.95rem;">
                            <%= (u.name || 'M')[0].toUpperCase() %>
                          </div>
                          <% if (u.isOnline) { %>
                            <span style="position:absolute;bottom:0;right:0;width:10px;height:10px;background:#10B981;border:2px solid #FFFFFF;border-radius:50%;box-shadow:0 0 6px rgba(16,185,129,0.8);" title="Currently Online"></span>
                          <% } %>
                        </div>
                        <div>
                          <div style="font-weight:700;color:#111827;display:flex;align-items:center;gap:6px;">
                            <%= u.name %>
                          </div>
                          <div style="font-size:0.72rem;color:#64748B;text-transform:capitalize;"><%= u.role %></div>
                        </div>
                      </div>
                    </td>
                    <td style="font-family:monospace;font-weight:700;"><%= u.admission_no || `MEM-${u.id}` %></td>
                    <td><%= u.class || 'Faculty' %></td>
                    <td>
                      <div><%= u.phone || 'N/A' %></div>
                      <div style="font-size:0.72rem;color:#94A3B8;"><%= u.email || '' %></div>
                    </td>
                    <td>
                      <% if (u.isOnline) { %>
                        <span class="lp-status-pill" style="background:rgba(16,185,129,0.12);color:#059669;border:1px solid rgba(16,185,129,0.3);font-weight:800;display:inline-flex;align-items:center;gap:5px;">
                          <span style="width:6px;height:6px;border-radius:50%;background:#10B981;box-shadow:0 0 6px #10B981;animation:pulse 1.5s infinite;"></span>
                          Online
                        </span>
                      <% } else { %>
                        <span class="lp-status-pill" style="background:#F1F5F9;color:#64748B;font-weight:600;" title="Last active: <%= u.lastActiveFormatted || 'Never' %>">
                          ⚪ Offline
                        </span>
                      <% } %>
                    </td>
                    <td>
                      <% const isBanned = (u.is_banned === 1 || u.is_banned === '1' || u.is_banned === true || u.is_banned === 'true'); %>
                      <span class="lp-status-pill <%= isBanned ? 'overdue' : 'available' %>">
                        <%= isBanned ? 'Suspended' : 'Active' %>
                      </span>
                    </td>
                    <td>
                      <button class="btn-secondary" style="padding:4px 10px;font-size:0.78rem;" onclick="openMemberDrawer('<%= u.id %>')">
                        View Profile &rarr;
                      </button>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>

        </section>

        <!-- ─────────────────────────────────────────────────────────────
             MODULE 04 — CIRCULATION (DESK SCANNER: ISSUE, RETURN, RENEW)
             ───────────────────────────────────────────────────────────── -->
        <section id="module-circulation" class="lp-module-view" style="display:<%= currentModule === 'circulation' ? 'block' : 'none' %>;">
          
          <div class="lp-tabs-bar">
            <button class="lp-tab-btn active" id="circ-tab-btn-issue" onclick="switchCirculationTab('issue', this)">
              📤 Issue Desk
            </button>
            <button class="lp-tab-btn" id="circ-tab-btn-return" onclick="switchCirculationTab('return', this)">
              📥 Return Station
            </button>
            <button class="lp-tab-btn" id="circ-tab-btn-renew" onclick="switchCirculationTab('renewals', this)">
              🔄 Active Loans & Renewals (<%= activeLoans.length %>)
            </button>
          </div>

          <!-- Circulation Tab 1: Rapid Issue Desk -->
          <div id="circ-pane-issue" class="lp-tab-pane active">
            <div class="lp-circulation-grid">
              
              <!-- Left: Big Scanner Inputs -->
              <div class="card">
                <h3 class="lp-card-title" style="margin-bottom:16px;">🎯 Rapid Checkout & Issue Station</h3>
                
                <!-- 1. Scan Member -->
                <div class="lp-scanner-box" style="margin-bottom:18px;">
                  <label class="lp-scanner-label">
                    <span>1. SCAN / ENTER MEMBER ID OR ADMISSION NO</span>
                  </label>
                  <div style="display:flex;gap:8px;">
                    <input type="text" id="circMemberInput" class="lp-scanner-input" placeholder="e.g. ADM101 or phone..." onkeydown="if(event.key==='Enter') lookupMemberForIssue()">
                    <button class="btn-primary" onclick="lookupMemberForIssue()">Find</button>
                  </div>
                  <div id="circMemberPreview" style="display:none;"></div>
                </div>

                <!-- 2. Scan Book -->
                <div class="lp-scanner-box" style="margin-bottom:18px;">
                  <label class="lp-scanner-label">
                    <span>2. SCAN / ENTER BOOK BARCODE OR ISBN</span>
                  </label>
                  <div style="display:flex;gap:8px;">
                    <input type="text" id="circBookInput" class="lp-scanner-input" placeholder="e.g. LIB-BK1-C1 or ISBN..." onkeydown="if(event.key==='Enter') lookupBookForIssue()">
                    <button class="btn-primary" onclick="lookupBookForIssue()">Scan</button>
                  </div>
                  <div id="circBookPreview" style="display:none;"></div>
                </div>

                <!-- Loan Options -->
                <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px;">
                  <label style="font-size:0.85rem;font-weight:700;">Loan Duration:</label>
                  <select id="circLoanDays" class="lp-search-input" style="width:140px;">
                    <option value="7">7 Days</option>
                    <option value="14" selected>14 Days</option>
                    <option value="21">21 Days</option>
                    <option value="30">30 Days</option>
                  </select>
                </div>

                <!-- Confirm Issue Button -->
                <button class="btn-primary" id="circConfirmIssueBtn" style="width:100%;justify-content:center;padding:14px;font-size:1.05rem;" onclick="submitCirculationIssue()" disabled>
                  CONFIRM ISSUE
                </button>
              </div>

              <!-- Right: Checkout Summary & Rules -->
              <div class="card">
                <h3 class="lp-card-title">📋 Circulation Summary</h3>
                <div style="background:#F8FAFC;border:1px solid #E2E8F0;border-radius:14px;padding:18px;margin-top:14px;">
                  <div style="font-weight:700;color:#111827;margin-bottom:8px;">Active Lending Rules:</div>
                  <ul style="padding-left:18px;font-size:0.85rem;color:#64748B;line-height:1.7;margin:0;">
                    <li>Default Student limit: <strong>3 books</strong> (14 days)</li>
                    <li>Default Teacher limit: <strong>10 books</strong> (30 days)</li>
                    <li>Fine rate: <strong>₹<%= settings.fine_per_day || 5 %>/day</strong> after <%= settings.grace_period_days || 2 %> grace days</li>
                    <li>Automatic stock updates upon confirmed checkout</li>
                  </ul>
                </div>
              </div>

            </div>
          </div>

          <!-- Circulation Tab 2: Return Station -->
          <div id="circ-pane-return" class="lp-tab-pane">
            <div class="card" style="max-width:720px;margin:0 auto;">
              <h3 class="lp-card-title" style="margin-bottom:16px;">📥 Book Check-In & Return Station</h3>
              
              <div class="lp-scanner-box" style="margin-bottom:20px;">
                <label class="lp-scanner-label">SCAN BOOK BARCODE TO COMPLETE RETURN</label>
                <div style="display:flex;gap:8px;">
                  <input type="text" id="circReturnBarcode" class="lp-scanner-input" placeholder="Scan barcode..." onkeydown="if(event.key==='Enter') submitCirculationReturn()">
                  <button class="btn-success" onclick="submitCirculationReturn()">COMPLETE RETURN</button>
                </div>
              </div>

              <div id="circReturnResult" style="display:none;background:#F0FDF4;border:1px solid #86EFAC;border-radius:14px;padding:18px;"></div>
            </div>
          </div>

          <!-- Circulation Tab 3: Active Loans & Renewals -->
          <div id="circ-pane-renewals" class="lp-tab-pane">
            <div class="lp-table-container">
              <table class="lp-table">
                <thead>
                  <tr>
                    <th>Book Title</th>
                    <th>Borrower</th>
                    <th>Issue Date</th>
                    <th>Due Date</th>
                    <th>Overdue / Fine</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (activeLoans.length === 0) { %>
                    <tr><td colspan="6" style="text-align:center;padding:24px;color:#94A3B8;">No active loans right now.</td></tr>
                  <% } else { %>
                    <% activeLoans.forEach(l => { %>
                      <tr>
                        <td>
                          <div style="font-weight:700;"><%= l.book_title %></div>
                          <div style="font-size:0.72rem;color:#94A3B8;">Barcode: <%= l.book_barcode || 'N/A' %></div>
                        </td>
                        <td>
                          <div style="font-weight:600;"><%= l.user_name %></div>
                          <div style="font-size:0.72rem;color:#64748B;"><%= l.user_admission || l.user_role %></div>
                        </td>
                        <td><%= renderDate(l.issue_date) %></td>
                        <td style="font-weight:700;"><%= renderDate(l.due_date) %></td>
                        <td>
                          <% if (l.is_overdue) { %>
                            <span class="lp-status-pill overdue"><%= l.days_overdue %> days late (₹<%= l.fine %>)</span>
                          <% } else { %>
                            <span class="lp-status-pill available">On Time</span>
                          <% } %>
                        </td>
                        <td>
                          <div style="display:flex;gap:6px;">
                            <button class="btn-secondary" style="padding:4px 8px;font-size:0.75rem;" onclick="renewLoan('<%= l.id %>')">Extend +14d</button>
                            <button class="btn-danger" style="padding:4px 8px;font-size:0.75rem;" onclick="rapidReturnPrompt('<%= l.id %>')">Return</button>
                          </div>
                        </td>
                      </tr>
                    <% }) %>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>

        </section>

        <!-- ─────────────────────────────────────────────────────────────
             MODULE 05 — REQUESTS (RESERVATIONS, BOOK REQUESTS)
             ───────────────────────────────────────────────────────────── -->
        <section id="module-requests" class="lp-module-view" style="display:<%= currentModule === 'requests' ? 'block' : 'none' %>;">
          <div class="lp-tabs-bar">
            <button class="lp-tab-btn active" onclick="switchRequestTab('reservations', this)">
              📖 Book Reservations Queue (<%= reservations.length %>)
            </button>
            <button class="lp-tab-btn" onclick="switchRequestTab('acquisitions', this)">
              🛒 Acquisition Requests
            </button>
          </div>

          <div class="lp-table-container">
            <table class="lp-table">
              <thead>
                <tr>
                  <th>Requested Book</th>
                  <th>Student Name</th>
                  <th>Request Date</th>
                  <th>Available Stock</th>
                  <th>Status</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (reservations.length === 0) { %>
                  <tr><td colspan="6" style="text-align:center;padding:24px;color:#94A3B8;">No pending reservation requests.</td></tr>
                <% } else { %>
                  <% reservations.forEach(r => { %>
                    <tr>
                      <td style="font-weight:700;"><%= r.book_title %></td>
                      <td>
                        <div><%= r.student_name %></div>
                        <div style="font-size:0.72rem;color:#94A3B8;"><%= r.student_admission || r.student_class %></div>
                      </td>
                      <td><%= renderDate(r.created_at) %></td>
                      <td><%= r.available_copies %> Copies</td>
                      <td>
                        <span class="lp-status-pill <%= r.status === 'Approved' ? 'available' : (r.status === 'Pending' ? 'reserved' : 'overdue') %>">
                          <%= r.status %>
                        </span>
                      </td>
                      <td>
                        <% if (r.status === 'Pending' || r.status === 'pending') { %>
                          <div style="display:flex;gap:6px;">
                            <button class="btn-success" style="padding:4px 8px;font-size:0.75rem;" onclick="approveReservation('<%= r.id %>')">Approve</button>
                            <button class="btn-danger" style="padding:4px 8px;font-size:0.75rem;" onclick="rejectReservation('<%= r.id %>')">Decline</button>
                          </div>
                        <% } else { %>
                          <span style="font-size:0.8rem;color:#94A3B8;">Processed</span>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
        </section>

        <!-- ─────────────────────────────────────────────────────────────
             MODULE — STUDENT PROGRESS (BOOKS, QUIZZES, LIVE COURSES) [READ-ONLY]
             ───────────────────────────────────────────────────────────── -->
        <section id="module-student-progress" class="lp-module-view" style="display:<%= currentModule === 'student-progress' ? 'block' : 'none' %>;">
          <!-- Section Header -->
          <div class="lp-section-header" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:14px;margin-bottom:20px;">
            <div>
              <div style="display:flex;align-items:center;gap:10px;">
                <h2 style="font-size:1.4rem;font-weight:800;color:#1E293B;margin:0;">🎓 Student Learning & Activity Progress</h2>
                <span style="display:inline-flex;align-items:center;gap:4px;padding:3px 10px;background:#F1F5F9;color:#475569;border-radius:20px;font-size:0.75rem;font-weight:700;border:1px solid #CBD5E1;">
                  🔒 Read-Only Monitor
                </span>
              </div>
              <p style="font-size:0.85rem;color:#64748B;margin:4px 0 0 0;">
                Live consolidated view of ongoing physical book borrowings, digital reading, quiz assessments, and enrolled live courses per student.
              </p>
            </div>
            <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
              <button class="btn-secondary" onclick="exportStudentProgressCSV()" style="font-size:0.8rem;padding:7px 12px;">
                📥 Export CSV
              </button>
              <button class="btn-secondary" onclick="refreshStudentProgressData()" style="font-size:0.8rem;padding:7px 12px;">
                🔄 Refresh
              </button>
            </div>
          </div>

          <!-- KPI Metric Cards Grid -->
          <div class="lp-stats-grid" style="margin-bottom:24px;">
            <div class="lp-stat-card" style="border-left:4px solid #0B5ED7;cursor:pointer;" onclick="setStudentProgressFilter('category', 'BOOK')">
              <div class="lp-stat-info">
                <span class="lp-stat-title">Ongoing Books</span>
                <h3 class="lp-stat-value" id="spMetricBooks"><%= (typeof studentProgressCounts !== 'undefined' ? studentProgressCounts.books : 0) %></h3>
                <span class="lp-stat-change" style="color:#0B5ED7;">📚 Physical loans + Digital e-books</span>
              </div>
              <div class="lp-stat-icon-wrap blue">📚</div>
            </div>

            <div class="lp-stat-card" style="border-left:4px solid #10B981;cursor:pointer;" onclick="setStudentProgressFilter('category', 'QUIZ')">
              <div class="lp-stat-info">
                <span class="lp-stat-title">Quizzes Attempted</span>
                <h3 class="lp-stat-value" id="spMetricQuizzes"><%= (typeof studentProgressCounts !== 'undefined' ? studentProgressCounts.quizzes : 0) %></h3>
                <span class="lp-stat-change" style="color:#059669;">🎯 Assessments & Scores</span>
              </div>
              <div class="lp-stat-icon-wrap" style="background:rgba(16,185,129,0.15);color:#059669;">🎯</div>
            </div>

            <div class="lp-stat-card" style="border-left:4px solid #8B5CF6;cursor:pointer;" onclick="setStudentProgressFilter('category', 'COURSE')">
              <div class="lp-stat-info">
                <span class="lp-stat-title">Live Courses</span>
                <h3 class="lp-stat-value" id="spMetricCourses"><%= (typeof studentProgressCounts !== 'undefined' ? studentProgressCounts.courses : 0) %></h3>
                <span class="lp-stat-change" style="color:#7C3AED;">🎓 Ongoing Enrollments</span>
              </div>
              <div class="lp-stat-icon-wrap indigo">🎓</div>
            </div>

            <div class="lp-stat-card" style="border-left:4px solid #F59E0B;cursor:pointer;" onclick="setStudentProgressFilter('category', 'ALL')">
              <div class="lp-stat-info">
                <span class="lp-stat-title">Active Students</span>
                <h3 class="lp-stat-value" id="spMetricStudents"><%= (typeof studentProgressCounts !== 'undefined' ? studentProgressCounts.students : 0) %></h3>
                <span class="lp-stat-change" style="color:#D97706;">👥 Engaged Learners</span>
              </div>
              <div class="lp-stat-icon-wrap warning">👥</div>
            </div>
          </div>

          <!-- Filter & Search Controls Toolbar -->
          <div class="card" style="padding:16px 20px;margin-bottom:20px;border:1px solid var(--border-color);border-radius:12px;background:var(--bg-surface);">
            <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:14px;">
              
              <!-- Category Filter Tabs -->
              <div class="lp-tabs-bar" style="border-bottom:none;margin:0;padding:0;gap:8px;" id="spCategoryTabs">
                <button class="lp-tab-btn active" id="spTabAll" onclick="setStudentProgressCategory('ALL', this)">
                  All Activities (<span id="spCountAll"><%= (typeof studentProgressItems !== 'undefined' ? studentProgressItems.length : 0) %></span>)
                </button>
                <button class="lp-tab-btn" id="spTabBooks" onclick="setStudentProgressCategory('BOOK', this)">
                  📚 Books (<span id="spCountBooks"><%= (typeof studentProgressCounts !== 'undefined' ? studentProgressCounts.books : 0) %></span>)
                </button>
                <button class="lp-tab-btn" id="spTabQuizzes" onclick="setStudentProgressCategory('QUIZ', this)">
                  🎯 Quizzes (<span id="spCountQuizzes"><%= (typeof studentProgressCounts !== 'undefined' ? studentProgressCounts.quizzes : 0) %></span>)
                </button>
                <button class="lp-tab-btn" id="spTabCourses" onclick="setStudentProgressCategory('COURSE', this)">
                  🎓 Courses (<span id="spCountCourses"><%= (typeof studentProgressCounts !== 'undefined' ? studentProgressCounts.courses : 0) %></span>)
                </button>
              </div>

              <!-- View Switcher (Table vs Student Grouped Cards) -->
              <div style="display:flex;align-items:center;gap:6px;background:var(--bg-main, #F1F5F9);padding:4px;border-radius:8px;border:1px solid var(--border-color, #E2E8F0);">
                <button type="button" id="spViewTableBtn" class="btn-primary" style="padding:5px 12px;font-size:0.75rem;border-radius:6px;" onclick="switchStudentProgressView('table')">
                  📋 Table View
                </button>
                <button type="button" id="spViewGroupedBtn" class="btn-secondary" style="padding:5px 12px;font-size:0.75rem;border-radius:6px;background:transparent;border:none;" onclick="switchStudentProgressView('grouped')">
                  👥 By Student
                </button>
              </div>
            </div>

            <!-- Search Input & Status Dropdown Filter -->
            <div style="display:flex;align-items:center;gap:12px;margin-top:14px;flex-wrap:wrap;">
              <div class="lp-search-bar" style="flex:1;min-width:240px;background:#F8FAFC;border:1px solid #E2E8F0;">
                <span class="lp-search-icon">🔍</span>
                <input type="text" id="spSearchInput" class="lp-search-input" placeholder="Search by student name, phone, class, book, quiz, or course title..." oninput="filterStudentProgress()">
              </div>

              <div style="display:flex;align-items:center;gap:8px;">
                <label for="spStatusFilter" style="font-size:0.8rem;font-weight:700;color:#64748B;white-space:nowrap;">Status:</label>
                <select id="spStatusFilter" class="lp-search-input" style="padding:8px 14px;border-radius:8px;background:#F8FAFC;border:1px solid #E2E8F0;font-size:0.85rem;font-weight:600;min-width:140px;" onchange="filterStudentProgress()">
                  <option value="ALL">All Statuses</option>
                  <option value="ACTIVE">Issued / Reading</option>
                  <option value="OVERDUE">Overdue Only</option>
                  <option value="PASSED">Passed / Completed</option>
                  <option value="ENROLLED">Enrolled</option>
                </select>
              </div>

              <button type="button" class="btn-secondary" onclick="resetStudentProgressFilters()" style="padding:7px 12px;font-size:0.8rem;" title="Clear filters">
                Reset
              </button>
            </div>
          </div>

          <!-- TABLE VIEW -->
          <div id="spTableView" class="lp-table-container card" style="padding:0;overflow:hidden;border:1px solid var(--border-color);border-radius:12px;">
            <div style="padding:14px 20px;border-bottom:1px solid var(--border-color);display:flex;align-items:center;justify-content:space-between;background:var(--bg-surface);">
              <div style="font-size:0.85rem;font-weight:700;color:#334155;">
                Showing <span id="spVisibleCount"><%= (typeof studentProgressItems !== 'undefined' ? studentProgressItems.length : 0) %></span> active learning activities
              </div>
              <div style="font-size:0.75rem;color:#94A3B8;display:flex;align-items:center;gap:4px;">
                <span>🔒 Read-Only (Librarian View)</span>
              </div>
            </div>

            <div class="lp-table-wrap" style="overflow-x:auto;">
              <table class="lp-table" id="spTable" style="margin:0;width:100%;">
                <thead>
                  <tr style="background:#F8FAFC;">
                    <th style="width:22%;">Student</th>
                    <th style="width:28%;">Activity / Item Name</th>
                    <th style="width:12%;">Type</th>
                    <th style="width:14%;">Status</th>
                    <th style="width:12%;">Progress</th>
                    <th style="width:12%;">Assigned / Due Date</th>
                  </tr>
                </thead>
                <tbody id="spTableBody">
                  <% if (typeof studentProgressItems === 'undefined' || studentProgressItems.length === 0) { %>
                    <tr class="sp-empty-row">
                      <td colspan="6" style="text-align:center;padding:48px 20px;color:#94A3B8;">
                        <div style="font-size:2.5rem;margin-bottom:8px;">🎓</div>
                        <div style="font-weight:700;font-size:1rem;color:#475569;">No ongoing activities found</div>
                        <div style="font-size:0.85rem;margin-top:4px;">Students with active book loans, quizzes, or courses will appear here.</div>
                      </td>
                    </tr>
                  <% } else { %>
                    <% studentProgressItems.forEach(item => { %>
                      <% 
                        const isOverdue = (item.status === 'OVERDUE' || (item.due_date && new Date(item.due_date) < new Date() && item.category === 'BOOK'));
                        let badgeClass = 'issued';
                        let badgeStyle = '';
                        if (isOverdue) {
                          badgeClass = 'overdue';
                          badgeStyle = 'background:#FEE2E2;color:#991B1B;border:1px solid #FCA5A5;';
                        } else if (item.status === 'PASSED' || item.status === 'COMPLETED') {
                          badgeClass = 'available';
                          badgeStyle = 'background:#ECFDF5;color:#047857;border:1px solid #A7F3D0;';
                        } else if (item.status === 'ENROLLED') {
                          badgeStyle = 'background:#F5F3FF;color:#6D28D9;border:1px solid #DDD6FE;';
                        } else {
                          badgeStyle = 'background:#EFF6FF;color:#1D4ED8;border:1px solid #BFDBFE;';
                        }

                        let icon = '📚';
                        if (item.category === 'QUIZ') icon = '🎯';
                        else if (item.category === 'COURSE') icon = '🎓';
                        else if (item.item_type === 'Digital E-Book') icon = '🌐';
                      %>
                      <tr class="sp-row" 
                          data-student="<%= (item.student_name || '').toLowerCase() %>" 
                          data-phone="<%= (item.student_phone || '').toLowerCase() %>" 
                          data-class="<%= (item.student_class || '').toLowerCase() %>" 
                          data-item="<%= (item.item_name || '').toLowerCase() %>" 
                          data-category="<%= item.category %>" 
                          data-status="<%= isOverdue ? 'OVERDUE' : item.status %>"
                          data-raw-student="<%= item.student_name || '' %>"
                          data-raw-class="<%= item.student_class || '' %>"
                          data-raw-phone="<%= item.student_phone || '' %>"
                          data-raw-item="<%= item.item_name || '' %>"
                          data-raw-type="<%= item.item_type || '' %>"
                          data-raw-progress="<%= item.progress || '' %>"
                          data-raw-assigned="<%= renderDate(item.assigned_date) %>"
                          data-raw-due="<%= item.due_date ? renderDate(item.due_date) : '' %>">
                        <td>
                          <div style="font-weight:700;color:#1E293B;font-size:0.92rem;"><%= item.student_name %></div>
                          <div style="font-size:0.75rem;color:#64748B;display:flex;align-items:center;gap:6px;margin-top:2px;">
                            <span style="background:#F1F5F9;padding:1px 6px;border-radius:4px;font-weight:600;"><%= item.student_class %></span>
                            <% if (item.student_phone) { %>
                              <span>📞 <%= item.student_phone %></span>
                            <% } %>
                          </div>
                        </td>
                        <td>
                          <div style="font-weight:700;color:#1E293B;font-size:0.9rem;display:flex;align-items:center;gap:6px;">
                            <span><%= icon %></span>
                            <span><%= item.item_name %></span>
                          </div>
                        </td>
                        <td>
                          <span style="font-size:0.78rem;font-weight:700;padding:2px 8px;border-radius:6px;background:#F8FAFC;color:#475569;border:1px solid #E2E8F0;">
                            <%= item.item_type %>
                          </span>
                        </td>
                        <td>
                          <span class="lp-status-pill <%= badgeClass %>" style="<%= badgeStyle %>font-size:0.75rem;font-weight:800;padding:3px 8px;border-radius:6px;">
                            <%= isOverdue ? 'OVERDUE' : item.status %>
                          </span>
                        </td>
                        <td>
                          <div style="font-weight:700;font-size:0.85rem;color:#334155;">
                            <%= item.progress || '—' %>
                          </div>
                          <% if (item.progress && item.progress.includes('%')) { %>
                            <% const pct = parseInt(item.progress) || 0; %>
                            <div style="width:100%;height:5px;background:#E2E8F0;border-radius:3px;margin-top:4px;overflow:hidden;">
                              <div style="width:<%= Math.min(100, Math.max(0, pct)) %>%;height:100%;background:<%= pct >= 70 ? '#10B981' : (pct >= 40 ? '#F59E0B' : '#EF4444') %>;border-radius:3px;"></div>
                            </div>
                          <% } %>
                        </td>
                        <td>
                          <div style="font-size:0.82rem;color:#334155;">
                            <span style="color:#64748B;font-size:0.72rem;display:block;">Assigned:</span>
                            <strong><%= renderDate(item.assigned_date) || '—' %></strong>
                          </div>
                          <% if (item.due_date) { %>
                            <div style="font-size:0.82rem;margin-top:4px;<%= isOverdue ? 'color:#DC2626;font-weight:700;' : 'color:#64748B;' %>">
                              <span style="font-size:0.72rem;display:block;">Due:</span>
                              <%= renderDate(item.due_date) %>
                              <% if (isOverdue) { %>
                                <span style="font-size:0.7rem;background:#FEE2E2;color:#DC2626;padding:1px 4px;border-radius:3px;font-weight:800;margin-left:2px;">LATE</span>
                              <% } %>
                            </div>
                          <% } else { %>
                            <div style="font-size:0.72rem;color:#94A3B8;margin-top:2px;">Due: — (Self-paced)</div>
                          <% } %>
                        </td>
                      </tr>
                    <% }) %>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>

          <!-- GROUPED BY STUDENT VIEW -->
          <div id="spGroupedView" style="display:none;margin-top:10px;">
            <div id="spGroupedContainer" style="display:grid;grid-template-columns:repeat(auto-fill, minmax(360px, 1fr));gap:16px;">
              <!-- Populated dynamically via JS -->
            </div>
          </div>
        </section>

        <!-- ─────────────────────────────────────────────────────────────
             MODULE 06 — E-LIBRARY (E-BOOKS, DOCUMENTS, REVIEWS)
             ───────────────────────────────────────────────────────────── -->
        <section id="module-e-library" class="lp-module-view" style="display:<%= currentModule === 'e-library' ? 'block' : 'none' %>;">
          <div class="lp-tabs-bar" style="margin-bottom:20px;">
            <button class="lp-tab-btn active" id="btn-tab-elib-books" onclick="switchElibraryTab('books', this)">
              🌐 Digital Publications (<%= digitalItems.length %>)
            </button>
            <button class="lp-tab-btn" id="btn-tab-elib-reviews" onclick="switchElibraryTab('reviews', this)">
              ⭐ Student Reviews &amp; Moderation (<%= reviews.length %>)
            </button>
          </div>

          <!-- E-Library Tab 1: Books -->
          <div id="elib-tab-books" class="elib-tab-pane active">
            <div style="display:grid;grid-template-columns:repeat(auto-fill, minmax(240px, 1fr));gap:20px;">
              <% if (digitalItems.length === 0) { %>
                <div class="card" style="grid-column:1/-1;text-align:center;padding:40px;">
                  <p style="color:#94A3B8;">No digital publications uploaded yet.</p>
                </div>
              <% } else { %>
                <% digitalItems.forEach(d => { %>
                  <div class="card" style="padding:16px;display:flex;flex-direction:column;justify-content:space-between;">
                    <div>
                      <div style="height:140px;background:#F1F5F9;border-radius:12px;margin-bottom:12px;display:flex;align-items:center;justify-content:center;overflow:hidden;">
                        <% if (d.cover_url) { %>
                          <img src="<%= d.cover_url %>" style="width:100%;height:100%;object-fit:cover;">
                        <% } else { %>
                          <span style="font-size:2.5rem;">📄</span>
                        <% } %>
                      </div>
                      <h4 style="font-size:0.95rem;font-weight:700;margin:0 0 4px 0;color:#111827;"><%= d.title %></h4>
                      <p style="font-size:0.75rem;color:#64748B;margin:0 0 10px 0;"><%= d.author || 'Faculty' %></p>
                    </div>
                    <div style="display:flex;gap:6px;margin-top:12px;">
                      <a href="/admin/e-library/read/<%= d.id %>" class="btn-primary" style="flex:1;justify-content:center;padding:6px;font-size:0.8rem;">Read</a>
                      <a href="<%= d.file_url || '#' %>" target="_blank" class="btn-secondary" style="padding:6px 10px;font-size:0.8rem;">Download</a>
                    </div>
                  </div>
                <% }) %>
              <% } %>
            </div>
          </div>

          <!-- E-Library Tab 2: Review Moderation -->
          <div id="elib-tab-reviews" class="elib-tab-pane" style="display:none;">
            <div class="card" style="margin-bottom:20px;">
              <div class="lp-card-header">
                <div>
                  <h3 class="lp-card-title">⭐ Student Book Reviews Moderation</h3>
                  <p class="lp-card-sub">Approve or reject student reading submissions, ratings, and chapter summaries</p>
                </div>
              </div>
            </div>

            <div class="lp-table-container">
              <table class="lp-table">
                <thead>
                  <tr>
                    <th>Book</th>
                    <th>Student</th>
                    <th>Rating / Review</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (reviews.length === 0) { %>
                    <tr><td colspan="5" style="text-align:center;padding:24px;color:#94A3B8;">No book reviews pending moderation.</td></tr>
                  <% } else { %>
                    <% reviews.forEach(r => { %>
                      <tr>
                        <td style="font-weight:700;"><%= r.book_title %></td>
                        <td><%= r.student_name %></td>
                        <td>
                          <div>⭐ <%= r.rating || 5 %>/5</div>
                          <div style="font-size:0.8rem;color:#64748B;"><%= r.review || r.learned || 'Recommended read.' %></div>
                        </td>
                        <td><span class="lp-status-pill <%= r.status === 'approved' ? 'available' : 'reserved' %>"><%= r.status %></span></td>
                        <td>
                          <button class="btn-success" style="padding:4px 8px;font-size:0.75rem;" onclick="approveReview('<%= r.id %>')">Approve</button>
                          <button class="btn-danger" style="padding:4px 8px;font-size:0.75rem;" onclick="rejectReview('<%= r.id %>')">Reject</button>
                        </td>
                      </tr>
                    <% }) %>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- ─────────────────────────────────────────────────────────────
             MODULE 07 — STUDIO (LIVE LECTURES & MASTERCLASSES)
             ───────────────────────────────────────────────────────────── -->
        <section id="module-studio" class="lp-module-view" style="display:<%= currentModule === 'studio' ? 'block' : 'none' %>;">
          <%
            const nowMs = Date.now();
            const studioSessionsEnhanced = studioSessions.map(s => {
              const startMs = new Date(s.scheduled_start || s.scheduled_at || nowMs).getTime();
              const durMs = (parseInt(s.duration_minutes) || 60) * 60 * 1000;
              const endMs = s.scheduled_end ? new Date(s.scheduled_end).getTime() : (startMs + durMs);
              
              let autoStatus = s.status ? s.status.toUpperCase() : 'SCHEDULED';
              if (autoStatus === 'LIVE' || (nowMs >= startMs && nowMs <= endMs && autoStatus !== 'COMPLETED' && autoStatus !== 'CANCELLED')) {
                autoStatus = 'LIVE';
              } else if (nowMs > endMs || autoStatus === 'COMPLETED' || autoStatus === 'CANCELLED') {
                autoStatus = 'COMPLETED';
              } else if (nowMs < startMs) {
                autoStatus = 'SCHEDULED';
              }
              return { ...s, calculatedStatus: autoStatus };
            });

            const studioLiveList = studioSessionsEnhanced.filter(s => s.calculatedStatus === 'LIVE');
            const studioUpcomingList = studioSessionsEnhanced.filter(s => s.calculatedStatus === 'SCHEDULED');
            const studioPastList = studioSessionsEnhanced.filter(s => s.calculatedStatus === 'COMPLETED');
            const totalAttendees = studioSessions.reduce((acc, s) => acc + (parseInt(s.attendee_count) || 0), 0);
          %>
          
          <!-- Studio Stats Overview -->
          <div class="lp-stats-grid" style="margin-bottom:24px;">
            <div class="lp-stat-card">
              <div class="lp-stat-info">
                <span class="lp-stat-title">Total Sessions</span>
                <h3 class="lp-stat-value"><%= studioSessions.length %></h3>
              </div>
              <div class="lp-stat-icon-wrap indigo">🎥</div>
            </div>
            <div class="lp-stat-card">
              <div class="lp-stat-info">
                <span class="lp-stat-title">Live Now</span>
                <h3 class="lp-stat-value" style="color:#ef4444;"><%= studioLiveList.length %></h3>
              </div>
              <div class="lp-stat-icon-wrap red">🔴</div>
            </div>
            <div class="lp-stat-card">
              <div class="lp-stat-info">
                <span class="lp-stat-title">Student Attendances</span>
                <h3 class="lp-stat-value"><%= totalAttendees %></h3>
              </div>
              <div class="lp-stat-icon-wrap green">👥</div>
            </div>
          </div>

          <!-- Studio Header Card -->
          <div class="card" style="margin-bottom:20px;">
            <div class="lp-card-header">
              <div>
                <h3 class="lp-card-title">🎥 Librika Studio & Jitsi Live Classroom Engine</h3>
                <p class="lp-card-sub">Create, schedule, and host HD interactive classes with attendance logging and collaborative whiteboard</p>
              </div>
              <div style="display:flex;gap:10px;">
                <button class="btn-primary" onclick="openModal('scheduleStudioModal')">
                  + Schedule Live Class
                </button>
              </div>
            </div>
          </div>

          <!-- Studio Sub-Tabs -->
          <div class="lp-tabs-bar" style="margin-bottom:16px;">
            <button class="lp-tab-btn active" id="btn-tab-studio-upcoming" onclick="switchStudioTab('upcoming', this)">
              📅 Upcoming Meetings (<%= studioUpcomingList.length %>)
            </button>
            <button class="lp-tab-btn" id="btn-tab-studio-live" onclick="switchStudioTab('live', this)">
              🔴 Live Meetings (<%= studioLiveList.length %>)
            </button>
            <button class="lp-tab-btn" id="btn-tab-studio-past" onclick="switchStudioTab('past', this)">
              📜 Past & Attendance (<%= studioPastList.length %>)
            </button>
          </div>

          <!-- Tab 1: Upcoming Meetings -->
          <div id="studio-tab-upcoming" class="studio-tab-pane">
            <div class="lp-table-container">
              <table class="lp-table">
                <thead>
                  <tr>
                    <th>Session Title & Agenda</th>
                    <th>Target Class</th>
                    <th>Teacher / Host</th>
                    <th>Meeting Code</th>
                    <th>Date & Time</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (studioUpcomingList.length === 0) { %>
                    <tr><td colspan="6" style="text-align:center;padding:32px;color:#94A3B8;">No upcoming live sessions scheduled. Click "+ Schedule Live Class" to create one.</td></tr>
                  <% } else { %>
                    <% studioUpcomingList.forEach(s => { 
                         const mCode = s.meeting_code || s.meeting_id || ('LIBRIKA-' + s.id);
                    %>
                      <tr>
                        <td>
                          <div style="font-weight:700;color:var(--text-main);"><%= s.title %></div>
                          <% if (s.description) { %>
                            <div style="font-size:0.75rem;color:var(--text-muted);margin-top:2px;max-width:240px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= s.description %></div>
                          <% } %>
                        </td>
                        <td><span class="lp-status-pill available"><%= s.class_name || 'All Students' %></span></td>
                        <td style="font-weight:600;"><%= s.host_name || 'Faculty' %></td>
                        <td>
                          <code style="background:var(--bg-card-sub);padding:3px 8px;border-radius:6px;font-size:0.78rem;font-weight:700;color:var(--brand-primary);"><%= mCode %></code>
                        </td>
                        <td>
                          <div style="font-size:0.85rem;font-weight:600;"><%= renderDate(s.scheduled_start || s.scheduled_at) %></div>
                          <div style="font-size:0.75rem;color:var(--text-muted);"><%= s.duration_minutes || 60 %> mins</div>
                        </td>
                        <td>
                          <div style="display:flex;gap:6px;align-items:center;">
                            <a href="<%= (s.uid ? '/meet/' + s.uid : '/studio/meeting/' + (s.id || mCode)) %>" target="_blank" class="btn-primary" style="padding:5px 10px;font-size:0.78rem;text-decoration:none;">
                              🚀 Launch Room
                            </a>
                            <button class="btn-secondary" onclick="copyStudioLink('<%= mCode %>', '<%= s.id %>', '<%= s.uid || '' %>')" style="padding:5px 10px;font-size:0.78rem;" title="Copy Invite Link">
                              📋 Copy Link
                            </button>
                            <button class="btn-secondary" onclick="deleteStudioMeeting('<%= s.id %>')" style="padding:5px 8px;font-size:0.78rem;color:#ef4444;" title="Cancel Session">
                              🗑️
                            </button>
                          </div>
                        </td>
                      </tr>
                    <% }) %>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Tab 2: Live Meetings -->
          <div id="studio-tab-live" class="studio-tab-pane" style="display:none;">
            <div class="lp-table-container">
              <table class="lp-table">
                <thead>
                  <tr>
                    <th>Live Session</th>
                    <th>Target Class</th>
                    <th>Host</th>
                    <th>Meeting Code</th>
                    <th>Attendees</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (studioLiveList.length === 0) { %>
                    <tr><td colspan="6" style="text-align:center;padding:32px;color:#94A3B8;">No sessions are live right now. Launch an upcoming session to start broadcasting.</td></tr>
                  <% } else { %>
                    <% studioLiveList.forEach(s => { 
                         const mCode = s.meeting_code || s.meeting_id || ('LIBRIKA-' + s.id);
                    %>
                      <tr style="background:rgba(239,68,68,0.04);">
                        <td>
                          <div style="display:flex;align-items:center;gap:8px;">
                            <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:#ef4444;box-shadow:0 0 8px #ef4444;animation:pulse 1.5s infinite;"></span>
                            <span style="font-weight:700;"><%= s.title %></span>
                          </div>
                        </td>
                        <td><span class="lp-status-pill available"><%= s.class_name || 'All Students' %></span></td>
                        <td style="font-weight:600;"><%= s.host_name || 'Faculty' %></td>
                        <td>
                          <code style="background:var(--bg-card-sub);padding:3px 8px;border-radius:6px;font-size:0.78rem;font-weight:700;color:#ef4444;"><%= mCode %></code>
                        </td>
                        <td>
                          <span class="lp-status-pill reserved"><%= s.attendee_count || 0 %> Joined</span>
                        </td>
                        <td>
                          <div style="display:flex;gap:6px;align-items:center;">
                            <a href="<%= (s.uid ? '/meet/' + s.uid : '/studio/meeting/' + (s.id || mCode)) %>" target="_blank" class="btn-primary" style="padding:5px 10px;font-size:0.78rem;background:#ef4444;border-color:#ef4444;text-decoration:none;">
                              🔴 Join as Host
                            </a>
                            <button class="btn-secondary" onclick="copyStudioLink('<%= mCode %>', '<%= s.id %>', '<%= s.uid || '' %>')" style="padding:5px 10px;font-size:0.78rem;">
                              📋 Copy Link
                            </button>
                            <button class="btn-secondary" onclick="endStudioMeeting('<%= s.id %>')" style="padding:5px 10px;font-size:0.78rem;color:#ef4444;" title="End Meeting for all">
                              ⏹️ End
                            </button>
                          </div>
                        </td>
                      </tr>
                    <% }) %>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Tab 3: Past Meetings & Attendance -->
          <div id="studio-tab-past" class="studio-tab-pane" style="display:none;">
            <div class="lp-table-container">
              <table class="lp-table">
                <thead>
                  <tr>
                    <th>Completed Session</th>
                    <th>Target Class</th>
                    <th>Host</th>
                    <th>Held On</th>
                    <th>Status</th>
                    <th>Total Attendees</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (studioPastList.length === 0) { %>
                    <tr><td colspan="6" style="text-align:center;padding:32px;color:#94A3B8;">No past meeting records found.</td></tr>
                  <% } else { %>
                    <% studioPastList.forEach(s => { %>
                      <tr>
                        <td style="font-weight:700;"><%= s.title %></td>
                        <td><span class="lp-status-pill available"><%= s.class_name || 'All Students' %></span></td>
                        <td><%= s.host_name || 'Faculty' %></td>
                        <td><%= renderDate(s.scheduled_start || s.scheduled_at) %></td>
                        <td>
                          <span class="lp-status-pill <%= s.status === 'CANCELLED' ? 'overdue' : 'lost' %>">
                            <%= s.status || 'COMPLETED' %>
                          </span>
                        </td>
                        <td>
                          <strong><%= s.attendee_count || 0 %> students</strong>
                        </td>
                      </tr>
                    <% }) %>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- ─────────────────────────────────────────────────────────────
             MODULE 08 — ANALYTICS (CIRCULATION TRENDS & REPORTS)
             ───────────────────────────────────────────────────────────── -->
        <section id="module-analytics" class="lp-module-view" style="display:<%= currentModule === 'analytics' ? 'block' : 'none' %>;">
          <div class="lp-stats-grid" style="margin-bottom:24px;">
            <div class="lp-stat-card">
              <div class="lp-stat-info">
                <span class="lp-stat-title">Circulation Rate</span>
                <h3 class="lp-stat-value"><%= Math.round((stats.active_issues / Math.max(1, stats.total_books)) * 100) %>%</h3>
              </div>
              <div class="lp-stat-icon-wrap blue">📈</div>
            </div>
            <div class="lp-stat-card">
              <div class="lp-stat-info">
                <span class="lp-stat-title">Return Compliance</span>
                <h3 class="lp-stat-value"><%= Math.max(0, 100 - Math.round((stats.overdue_count / Math.max(1, stats.active_issues)) * 100)) %>%</h3>
              </div>
              <div class="lp-stat-icon-wrap green">✅</div>
            </div>
            <div class="lp-stat-card">
              <div class="lp-stat-info">
                <span class="lp-stat-title">Total Circulation History</span>
                <h3 class="lp-stat-value"><%= allTransactions.length %></h3>
              </div>
              <div class="lp-stat-icon-wrap indigo">📚</div>
            </div>
          </div>

          <div class="card" style="margin-bottom:24px;">
            <div class="lp-card-header">
              <h3 class="lp-card-title">📊 Reports & Export Hub</h3>
              <div style="display:flex;gap:10px;">
                <button class="btn-primary" onclick="exportBooksCSV()">Export Books CSV</button>
                <button class="btn-secondary" onclick="exportCirculationCSV()">Export Loans CSV</button>
              </div>
            </div>
            <p style="color:#64748B;font-size:0.9rem;">
              Download structured data sheets for library accreditation, annual audits, and administrative reporting.
            </p>
          </div>
        </section>

        <!-- ─────────────────────────────────────────────────────────────
             MODULE 09 — SETTINGS (RULES, POLICIES, AUDIT LOGS)
             ───────────────────────────────────────────────────────────── -->
        <section id="module-settings" class="lp-module-view" style="display:<%= currentModule === 'settings' ? 'block' : 'none' %>;">
          
          <div class="lp-tabs-bar">
            <button class="lp-tab-btn active" onclick="switchSettingsTab('rules', this)">⚙️ Lending &amp; Policy Rules</button>
            <button class="lp-tab-btn" onclick="switchSettingsTab('audit', this)">🔒 Audit Trail (<%= auditLogs.length %>)</button>
          </div>

          <!-- Settings Tab 1: Rules -->
          <div id="settings-pane-rules" class="lp-tab-pane active">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;max-width:1050px;">
              <div class="card">
                <h3 class="lp-card-title" style="margin-bottom:14px;">⚙️ Library Policy &amp; Loan Quotas</h3>
                <p style="font-size:0.82rem;color:#64748B;margin-bottom:16px;">Configure loan limits, borrow durations, and daily fine rates.</p>
                
                <form action="/admin/api/settings" method="POST">
                  <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;">
                    <div>
                      <label style="font-size:0.8rem;font-weight:700;display:block;margin-bottom:6px;">Loan Duration (Days)</label>
                      <input type="number" name="loan_duration_days" class="lp-search-input" style="width:100%;" value="<%= settings.loan_duration_days || 14 %>">
                    </div>
                    <div>
                      <label style="font-size:0.8rem;font-weight:700;display:block;margin-bottom:6px;">Grace Period (Days)</label>
                      <input type="number" name="grace_period_days" class="lp-search-input" style="width:100%;" value="<%= settings.grace_period_days || 2 %>">
                    </div>
                  </div>

                  <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;">
                    <div>
                      <label style="font-size:0.8rem;font-weight:700;display:block;margin-bottom:6px;">Student Max Books</label>
                      <input type="number" name="student_max_books" class="lp-search-input" style="width:100%;" value="<%= settings.student_max_books || 3 %>">
                    </div>
                    <div>
                      <label style="font-size:0.8rem;font-weight:700;display:block;margin-bottom:6px;">Teacher Max Books</label>
                      <input type="number" name="teacher_max_books" class="lp-search-input" style="width:100%;" value="<%= settings.teacher_max_books || 10 %>">
                    </div>
                  </div>

                  <div style="margin-bottom:18px;">
                    <label style="font-size:0.8rem;font-weight:700;display:block;margin-bottom:6px;">Overdue Fine Rate per Day (₹)</label>
                    <input type="number" name="fine_per_day" class="lp-search-input" style="width:100%;" value="<%= settings.fine_per_day || 5 %>">
                  </div>

                  <button type="submit" class="btn-primary" style="width:100%;justify-content:center;">Save Policy Rules</button>
                </form>
              </div>

              <!-- Quick Operations & System Health -->
              <div style="display:flex;flex-direction:column;gap:16px;">
                <div class="card">
                  <h4 style="font-weight:800;margin:0 0 10px 0;font-size:0.95rem;">📦 Catalog &amp; Circulation Backups</h4>
                  <p style="font-size:0.82rem;color:#64748B;margin-bottom:12px;">Download live snapshots of all books, members, and transaction history.</p>
                  <div style="display:flex;gap:8px;flex-wrap:wrap;">
                    <button class="btn-secondary" style="padding:6px 12px;font-size:0.8rem;" onclick="exportBooksCSV()">Export Books CSV</button>
                    <button class="btn-secondary" style="padding:6px 12px;font-size:0.8rem;" onclick="exportCirculationCSV()">Export Loans CSV</button>
                  </div>
                </div>

                <div class="card" style="background:#F8FAFC;border:1px solid #E2E8F0;">
                  <h4 style="font-weight:800;margin:0 0 8px 0;font-size:0.95rem;">⭐ Review Moderation</h4>
                  <p style="font-size:0.82rem;color:#64748B;margin-bottom:12px;">Student book reviews and ratings have been consolidated under <strong>E-Library</strong> for convenient content management.</p>
                  <button class="btn-primary" style="padding:6px 12px;font-size:0.8rem;" onclick="switchModule('e-library'); switchElibraryTab('reviews', document.getElementById('btn-tab-elib-reviews'));">
                    Open Review Moderation &rarr;
                  </button>
                </div>
              </div>
            </div>
          </div>

          <!-- Settings Tab 3: Audit Trail -->
          <div id="settings-pane-audit" class="lp-tab-pane">
            <div class="lp-table-container">
              <table class="lp-table">
                <thead>
                  <tr>
                    <th>Timestamp</th>
                    <th>Action</th>
                    <th>User</th>
                    <th>IP / Details</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (auditLogs.length === 0) { %>
                    <tr><td colspan="4" style="text-align:center;padding:24px;color:#94A3B8;">No audit log records recorded yet.</td></tr>
                  <% } else { %>
                    <% auditLogs.forEach(l => { %>
                      <tr>
                        <td style="font-size:0.8rem;color:#64748B;"><%= renderDate(l.created_at) %></td>
                        <td style="font-weight:600;"><%= l.action %></td>
                        <td><%= l.user_name || 'Librarian' %></td>
                        <td style="font-size:0.8rem;color:#94A3B8;"><%= l.ip_address || '127.0.0.1' %></td>
                      </tr>
                    <% }) %>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>

        </section>

      </div>

    </main>

  </div>

  <!-- ═══════════════════════════════════════════════════════════════
       3. GLOBAL AI COPILOT FLOATING BUTTON & DRAWER
       ═══════════════════════════════════════════════════════════════ -->
  <button class="lp-ai-fab" onclick="toggleAiCopilot()" title="Ask Library AI">
    ✨ Ask Library AI
  </button>

  <div class="lp-ai-drawer" id="lpAiDrawer">
    <div class="lp-ai-head">
      <div style="display:flex;align-items:center;gap:8px;">
        <span style="font-size:1.3rem;">✨</span>
        <h3 style="margin:0;font-size:1.05rem;font-weight:800;">Library AI Copilot</h3>
      </div>
      <button onclick="toggleAiCopilot()" style="background:transparent;border:none;color:#fff;font-size:1.2rem;cursor:pointer;">✕</button>
    </div>

    <div class="lp-ai-body" id="lpAiChatBody">
      <div class="lp-ai-msg bot">
        Hello! I am your Library AI Assistant. Ask me anything about book recommendations, overdue tracking, purchase requisitions, or circulation rules.
      </div>
      <div class="lp-ai-chips">
        <button class="lp-ai-chip" onclick="sendAiPrompt('Find books for Class 8')">Find books for Class 8</button>
        <button class="lp-ai-chip" onclick="sendAiPrompt('Show overdue books')">Show overdue books</button>
        <button class="lp-ai-chip" onclick="sendAiPrompt('Suggest mystery books')">Suggest mystery books</button>
        <button class="lp-ai-chip" onclick="sendAiPrompt('What should we purchase?')">What should we purchase?</button>
      </div>
    </div>

    <div class="lp-ai-footer">
      <input type="text" id="lpAiInput" class="lp-ai-input" placeholder="Ask your library anything..." onkeydown="if(event.key==='Enter') sendAiMessage()">
      <button class="btn-primary" onclick="sendAiMessage()">Send</button>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════
       4. MEMBER PROFILE DRAWER
       ═══════════════════════════════════════════════════════════════ -->
  <div class="lp-drawer-overlay" id="lpDrawerOverlay" onclick="closeMemberDrawer()"></div>

  <div class="lp-member-drawer" id="lpMemberDrawer">
    <div style="padding:1.25rem 1.5rem;border-bottom:1px solid #E5E7EB;display:flex;align-items:center;justify-content:space-between;">
      <h3 style="margin:0;font-size:1.1rem;font-weight:800;">Member Profile Dossier</h3>
      <button onclick="closeMemberDrawer()" style="background:transparent;border:none;font-size:1.2rem;cursor:pointer;">✕</button>
    </div>
    
    <div id="lpMemberDrawerBody" style="flex:1;overflow-y:auto;padding:1.5rem;">
      <!-- Loaded dynamically by openMemberDrawer() -->
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════
       5. MODALS (ADD BOOK, ADD MEMBER)
       ═══════════════════════════════════════════════════════════════ -->
  <!-- Add Book Modal -->
  <!-- Enhanced Add Book Modal (Single & Bulk Scan, Covers, Duplicate Detection & Acquisition Linking) -->
  <div id="addBookModal" class="lp-drawer-overlay" style="display:none;align-items:center;justify-content:center;z-index:9999;">
    <div class="card" style="width:95%;max-width:820px;max-height:92vh;overflow-y:auto;position:relative;padding:1.5rem;">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;">
        <div>
          <h3 style="margin:0;font-size:1.25rem;font-weight:800;">📚 Book Registration &amp; Barcode Scanner</h3>
          <p style="margin:2px 0 0 0;font-size:0.8rem;color:#64748B;">Register physical titles with live web metadata, dual cover photos, and duplicate reconciliation.</p>
        </div>
        <button onclick="closeModal('addBookModal')" style="background:transparent;border:none;font-size:1.3rem;cursor:pointer;color:#64748B;">✕</button>
      </div>

      <!-- Mode Switcher Tabs -->
      <div class="lp-tabs-bar" style="margin-bottom:18px;">
        <button type="button" class="lp-tab-btn active" id="btnModeSingle" onclick="switchAddBookMode('single')">
          📖 Single Book Registration
        </button>
        <button type="button" class="lp-tab-btn" id="btnModeBulk" onclick="switchAddBookMode('bulk')">
          ⚡ Bulk Barcode Scan Queue (<span id="bulkQueueBadge">0</span>)
        </button>
      </div>

      <!-- ═══════════════════════════════════════════════════════════════
           MODE 1: SINGLE BOOK SCAN & REGISTRATION
           ═══════════════════════════════════════════════════════════════ -->
      <div id="viewSingleBook">
        <!-- Quick Web Metadata Lookup Strip -->
        <div style="background:#F1F5F9;border:1px solid #E2E8F0;border-radius:12px;padding:12px;margin-bottom:18px;">
          <label style="font-size:0.75rem;font-weight:700;color:#475569;display:block;margin-bottom:6px;">
            🔍 QUICK METADATA LOOKUP (GOOGLE BOOKS &amp; OPENLIBRARY)
          </label>
          <div style="display:flex;gap:8px;">
            <input type="text" id="singleLookupInput" placeholder="Scan Barcode or enter 10/13-digit ISBN / Title..." class="lp-search-input" style="flex:1;" onkeydown="if(event.key==='Enter'){event.preventDefault();lookupSingleBookMetadata();}">
            <button type="button" class="btn-primary" onclick="lookupSingleBookMetadata()" id="btnLookupMetadata" style="padding:6px 14px;font-size:0.85rem;white-space:nowrap;">
              🔍 Fetch Metadata
            </button>
          </div>
          <div id="singleLookupStatus" style="font-size:0.8rem;margin-top:6px;display:none;"></div>
        </div>

        <!-- Live Status Indicators: Duplicate & Acquisition Match Alert Banners -->
        <div id="singleDuplicateAlert" style="display:none;margin-bottom:14px;padding:10px 14px;background:#FFFBEB;border:1px solid #FCD34D;border-radius:10px;font-size:0.85rem;color:#92400E;">
        </div>

        <div id="singleAcquisitionAlert" style="display:none;margin-bottom:14px;padding:10px 14px;background:#ECFDF5;border:1px solid #A7F3D0;border-radius:10px;font-size:0.85rem;color:#065F46;">
        </div>

        <form id="singleBookForm" onsubmit="submitSingleBookForm(event)">
          <input type="hidden" name="acquisition_item_id" id="singleAcqItemId" value="">
          <input type="hidden" name="cover_url" id="singleCoverUrl" value="">
          <input type="hidden" name="back_cover_url" id="singleBackCoverUrl" value="">

          <!-- Front & Back Cover Upload Cards -->
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:18px;">
            <!-- Front Cover Card -->
            <div style="border:1px dashed #CBD5E1;border-radius:12px;padding:12px;background:#F8FAFC;text-align:center;">
              <span style="font-size:0.78rem;font-weight:700;color:#475569;display:block;margin-bottom:8px;">📷 Front Cover Photo</span>
              <div id="frontCoverBox" style="height:110px;border-radius:8px;background:#E2E8F0;display:flex;align-items:center;justify-content:center;overflow:hidden;margin-bottom:8px;">
                <span id="frontCoverPlaceholder" style="font-size:0.78rem;color:#64748B;">No front cover selected</span>
                <img id="frontCoverImg" style="display:none;width:100%;height:100%;object-fit:cover;">
              </div>
              <div style="display:flex;gap:6px;justify-content:center;">
                <label class="btn-secondary" style="padding:4px 8px;font-size:0.75rem;cursor:pointer;">
                  Upload
                  <input type="file" accept="image/*" style="display:none;" onchange="handleCoverUpload(event, 'front')">
                </label>
                <button type="button" class="btn-secondary" style="padding:4px 8px;font-size:0.75rem;" onclick="captureCameraPhoto('front')">Camera</button>
                <button type="button" id="btnFrontClear" style="display:none;background:none;border:none;color:#DC2626;font-size:0.75rem;cursor:pointer;" onclick="clearCoverPhoto('front')">Clear</button>
              </div>
            </div>

            <!-- Back Cover Card -->
            <div style="border:1px dashed #CBD5E1;border-radius:12px;padding:12px;background:#F8FAFC;text-align:center;">
              <span style="font-size:0.78rem;font-weight:700;color:#475569;display:block;margin-bottom:8px;">📷 Back Cover (Blurb/Barcode)</span>
              <div id="backCoverBox" style="height:110px;border-radius:8px;background:#E2E8F0;display:flex;align-items:center;justify-content:center;overflow:hidden;margin-bottom:8px;">
                <span id="backCoverPlaceholder" style="font-size:0.78rem;color:#64748B;">No back cover selected</span>
                <img id="backCoverImg" style="display:none;width:100%;height:100%;object-fit:cover;">
              </div>
              <div style="display:flex;gap:6px;justify-content:center;">
                <label class="btn-secondary" style="padding:4px 8px;font-size:0.75rem;cursor:pointer;">
                  Upload
                  <input type="file" accept="image/*" style="display:none;" onchange="handleCoverUpload(event, 'back')">
                </label>
                <button type="button" class="btn-secondary" style="padding:4px 8px;font-size:0.75rem;" onclick="captureCameraPhoto('back')">Camera</button>
                <button type="button" id="btnBackClear" style="display:none;background:none;border:none;color:#DC2626;font-size:0.75rem;cursor:pointer;" onclick="clearCoverPhoto('back')">Clear</button>
              </div>
            </div>
          </div>

          <!-- Metadata Fields -->
          <div style="margin-bottom:12px;">
            <label style="font-size:0.8rem;font-weight:700;">Book Title *</label>
            <input type="text" name="title" id="sbTitle" required class="lp-search-input" style="width:100%;">
          </div>

          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;">
            <div>
              <label style="font-size:0.8rem;font-weight:700;">Author</label>
              <input type="text" name="author" id="sbAuthor" class="lp-search-input" style="width:100%;">
            </div>
            <div>
              <label style="font-size:0.8rem;font-weight:700;">Genre / Category</label>
              <input type="text" name="genre" id="sbGenre" class="lp-search-input" style="width:100%;" placeholder="Science, Fiction...">
            </div>
          </div>

          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;">
            <div>
              <label style="font-size:0.8rem;font-weight:700;">ISBN / Barcode</label>
              <input type="text" name="isbn" id="sbIsbn" class="lp-search-input" style="width:100%;">
            </div>
            <div>
              <label style="font-size:0.8rem;font-weight:700;">Total Copies</label>
              <input type="number" name="total_copies" id="sbCopies" value="1" min="1" class="lp-search-input" style="width:100%;">
            </div>
          </div>

          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px;">
            <div>
              <label style="font-size:0.8rem;font-weight:700;">Rack / Aisle</label>
              <input type="text" name="rack" id="sbRack" value="A" class="lp-search-input" style="width:100%;">
            </div>
            <div>
              <label style="font-size:0.8rem;font-weight:700;">Shelf No</label>
              <input type="text" name="shelf" id="sbShelf" value="1" class="lp-search-input" style="width:100%;">
            </div>
          </div>

          <div style="margin-bottom:18px;">
            <label style="font-size:0.8rem;font-weight:700;">Description / Synopsis (Optional)</label>
            <textarea name="description" id="sbDescription" class="lp-search-input" style="width:100%;height:60px;resize:vertical;"></textarea>
          </div>

          <button type="submit" id="btnSubmitSingleBook" class="btn-primary" style="width:100%;justify-content:center;padding:10px;font-size:0.95rem;">
            💾 Register Book into Catalog
          </button>
        </form>
      </div>

      <!-- ═══════════════════════════════════════════════════════════════
           MODE 2: BULK SCANNING SEQUENTIAL QUEUE
           ═══════════════════════════════════════════════════════════════ -->
      <div id="viewBulkBook" style="display:none;">
        <div style="background:#EEF2FF;border:1px solid #C7D2FE;border-radius:12px;padding:12px;margin-bottom:16px;">
          <label style="font-size:0.75rem;font-weight:700;color:#3730A3;display:block;margin-bottom:6px;">
            ⚡ RAPID BARCODE SCANNER (SCAN SEQUENTIALLY)
          </label>
          <div style="display:flex;gap:8px;">
            <input type="text" id="bulkScannerInput" placeholder="Scan barcode with scanner gun or type ISBN and press Enter..." class="lp-search-input" style="flex:1;" onkeydown="if(event.key==='Enter'){event.preventDefault();addBarcodeToBulkQueue();}">
            <button type="button" class="btn-primary" onclick="addBarcodeToBulkQueue()" style="padding:6px 14px;font-size:0.85rem;">
              + Add to Queue
            </button>
          </div>
          <div id="bulkScanNotice" style="font-size:0.8rem;color:#4F46E5;margin-top:6px;">
            Point scanner at book barcodes. Each scan automatically queries metadata and enqueues the title.
          </div>
        </div>

        <!-- Bulk Queue Table -->
        <div class="lp-table-container" style="max-height:300px;overflow-y:auto;border:1px solid #E2E8F0;border-radius:10px;margin-bottom:16px;">
