    let currentUnifiedBookId = null;

    async function openUnifiedBookModal(bookId) {
      if (!bookId) return;
      currentUnifiedBookId = bookId;

      let book = (window.CATALOG_BOOKS_DATA || []).find(b => String(b.id) === String(bookId));
      let copies = book && book.copies ? book.copies : [];

      try {
        const res = await fetch(`/admin/api/books/${encodeURIComponent(bookId)}`);
        const data = await res.json();
        if (data.success && data.book) {
          book = data.book;
          if (data.copies) copies = data.copies;
        }
      } catch (err) {
        console.warn('Using local catalog cache for book details', err);
      }

      if (!book) {
        alert('Book details could not be found.');
        return;
      }

      // Populate header & metadata
      document.getElementById('ubdTitle').textContent = book.title || 'Untitled Book';
      document.getElementById('ubdEditionBadge').textContent = book.edition || '1st Edition';
      document.getElementById('ubdAuthor').textContent = book.author ? `by ${book.author}` : 'Unknown Author';

      const coverImg = document.getElementById('ubdCoverImg');
      const coverPlaceholder = document.getElementById('ubdCoverPlaceholder');
      if (coverImg && book.cover_url) {
        coverImg.src = book.cover_url;
        coverImg.style.display = 'block';
        if (coverPlaceholder) coverPlaceholder.style.display = 'none';
      } else {
        if (coverImg) coverImg.style.display = 'none';
        if (coverPlaceholder) coverPlaceholder.style.display = 'block';
      }

      const totalCopies = copies.length > 0 ? copies.length : (parseInt(book.total_copies, 10) || 1);
      const availCopies = copies.length > 0 
        ? copies.filter(c => (c.status === 'AVAILABLE' || c.availability_status === 'AVAILABLE')).length 
        : (parseInt(book.available_copies, 10) || 0);

      document.getElementById('ubdShelfLocation').textContent = book.shelf_location || 'Rack A-1';
      document.getElementById('ubdStockRatio').textContent = `${availCopies} / ${totalCopies} Available`;

      document.getElementById('ubdIsbn').textContent = book.isbn ? `ISBN ${book.isbn}` : 'No ISBN';
      document.getElementById('ubdPublisher').textContent = book.publisher || 'Not Specified';
      document.getElementById('ubdYear').textContent = book.publication_year || 'N/A';
      document.getElementById('ubdCategory').textContent = book.category || book.genre || book.subject || 'General';
      document.getElementById('ubdLanguage').textContent = book.language || 'English';
      document.getElementById('ubdGroupId').textContent = book.book_id || `VBPG-${book.id}`;

      // Complete AI Extracted Summary
      const summaryText = book.summary || book.synopsis || book.description || 'No AI summary or blurb available for this edition.';
      document.getElementById('ubdAiSummary').textContent = summaryText;

      const descEl = document.getElementById('ubdDescription');
      const descBlock = document.getElementById('ubdDescriptionBlock');
      if (book.description && book.description !== book.summary) {
        descEl.textContent = book.description;
        descBlock.style.display = 'block';
      } else {
        descBlock.style.display = 'none';
      }

      // Populate Physical Copies Sub-Table
      const tbody = document.getElementById('ubdCopiesTbody');
      tbody.innerHTML = '';
      document.getElementById('ubdCopiesCount').textContent = copies.length;

      if (copies.length === 0) {
        tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;padding:16px;color:#64748B;">No physical copies registered yet.</td></tr>';
      } else {
        copies.forEach((copy, idx) => {
          const cStatus = (copy.status || copy.availability_status || 'AVAILABLE').toUpperCase();
          const isPrinted = (copy.barcode_printed == 1 || copy.barcode_printed === '1');
          const printedBadge = isPrinted 
            ? `<span style="font-size:0.7rem;background:#DCFCE7;color:#15803D;padding:2px 7px;border-radius:6px;font-weight:700;display:inline-flex;align-items:center;gap:3px;border:1px solid #86EFAC;" title="Printed: ${copy.barcode_printed_at || 'Yes'} by ${copy.barcode_printed_by || 'User'}">🏷️ Printed</span>`
            : `<span style="font-size:0.7rem;background:#FEF3C7;color:#B45309;padding:2px 7px;border-radius:6px;font-weight:700;display:inline-flex;align-items:center;gap:3px;border:1px solid #FDE68A;">⏳ Not Printed</span>`;

          const tr = document.createElement('tr');
          tr.style.borderBottom = '1px solid #F1F5F9';
          tr.innerHTML = `
            <td style="padding:8px 10px;font-weight:700;color:#334155;">Copy ${String(copy.copy_number || (idx+1)).padStart(3, '0')}</td>
            <td style="padding:8px 10px;">
              <span style="font-family:monospace;font-weight:700;color:#1D4ED8;background:#EFF6FF;padding:2px 8px;border-radius:4px;border:1px solid #BFDBFE;">${copy.barcode}</span>
            </td>
            <td style="padding:8px 10px;color:#475569;">Rack ${copy.rack || 'A'}, Shelf ${copy.shelf || '1'}</td>
            <td style="padding:8px 10px;"><span style="font-size:0.72rem;background:#F8FAFC;padding:2px 6px;border-radius:4px;border:1px solid #E2E8F0;font-weight:600;">${copy.condition_status || 'GOOD'}</span></td>
            <td style="padding:8px 10px;"><span class="lp-status-pill ${cStatus === 'AVAILABLE' ? 'available' : (cStatus === 'ISSUED' ? 'issued' : 'overdue')}" style="font-size:0.7rem;padding:2px 8px;">${cStatus}</span></td>
            <td style="padding:8px 10px;">${printedBadge}</td>
            <td style="padding:8px 10px;text-align:right;">
              <button type="button" class="btn-secondary" style="padding:2px 7px;font-size:0.7rem;background:#EFF6FF;color:#1D4ED8;border-color:#BFDBFE;" onclick="printSingleCopyBarcode('${copy.id}')" title="Print this specific copy's barcode label">
                🖨️ Label
              </button>
            </td>
          `;
          tbody.appendChild(tr);
        });
      }

      // Wire footer actions
      document.getElementById('btnUbdEdit').onclick = () => {
        closeModal('unifiedBookDetailModal');
        openEditBookModalFull(book.id);
      };

      document.getElementById('btnUbdPrint').onclick = () => {
        closeModal('unifiedBookDetailModal');
        openBarcodePrintWindow(book.id);
      };

      openModal('unifiedBookDetailModal');
    }

    // ─────────────────────────────────────────────────────────────────
    // ADVANCED BARCODE PRINTING & SELECTION WINDOW (Requirement 2 & 3)
    // ─────────────────────────────────────────────────────────────────
    function openBarcodePrintWindow(targetBookId = null) {
      const searchInp = document.getElementById('bpSearchInput');
      const editInp = document.getElementById('bpEditionFilter');
      const printSel = document.getElementById('bpPrintedFilter');
      const catInp = document.getElementById('bpCategoryFilter');
      const shelfInp = document.getElementById('bpShelfFilter');

      if (searchInp) searchInp.value = '';
      if (editInp) editInp.value = '';
      if (catInp) catInp.value = '';
      if (shelfInp) shelfInp.value = '';

      if (targetBookId) {
        if (printSel) printSel.value = 'all';
      } else {
        if (printSel) printSel.value = 'not_printed';
      }

      renderBarcodeSelectionTree(targetBookId);
      openModal('advancedBarcodePrintModal');
    }

    function filterBarcodeSelectionModal() {
      renderBarcodeSelectionTree(null);
    }

    function renderBarcodeSelectionTree(targetBookId = null) {
      const container = document.getElementById('bpSelectionTreeContainer');
      if (!container) return;

      const books = window.CATALOG_BOOKS_DATA || [];
      const searchVal = (document.getElementById('bpSearchInput')?.value || '').toLowerCase().trim();
      const editionVal = (document.getElementById('bpEditionFilter')?.value || '').toLowerCase().trim();
      const printedFilter = document.getElementById('bpPrintedFilter')?.value || 'all';
      const categoryVal = (document.getElementById('bpCategoryFilter')?.value || '').toLowerCase().trim();
      const shelfVal = (document.getElementById('bpShelfFilter')?.value || '').toLowerCase().trim();

      container.innerHTML = '';
      let matchingBooksCount = 0;

      books.forEach(book => {
        const title = (book.title || '').toLowerCase();
        const author = (book.author || '').toLowerCase();
        const isbn = (book.isbn || '').toLowerCase();
        const edition = (book.edition || '').toLowerCase();
        const category = (book.category || book.genre || book.subject || '').toLowerCase();
        const bShelf = (book.shelf_location || '').toLowerCase();

        // Check book level filters
        if (editionVal && !edition.includes(editionVal)) return;
        if (categoryVal && !category.includes(categoryVal)) return;

        // Filter copies
        const allCopies = book.copies || [];
        const matchingCopies = allCopies.filter(copy => {
          const barcode = (copy.barcode || '').toLowerCase();
          const copyShelf = `${copy.rack || ''} ${copy.shelf || ''}`.toLowerCase();
          const isPrinted = (copy.barcode_printed == 1 || copy.barcode_printed === '1');

          if (printedFilter === 'not_printed' && isPrinted) return false;
          if (printedFilter === 'printed' && !isPrinted) return false;

          if (shelfVal && !copyShelf.includes(shelfVal) && !bShelf.includes(shelfVal)) return false;

          if (searchVal) {
            const matchesText = title.includes(searchVal) || author.includes(searchVal) || isbn.includes(searchVal) || barcode.includes(searchVal);
            if (!matchesText) return false;
          }

          return true;
        });

        if (matchingCopies.length === 0) return;

        matchingBooksCount++;
        const card = document.createElement('div');
        card.className = 'bp-book-card';
        card.id = `bp-card-${book.id}`;

        const isTargetBook = targetBookId && String(book.id) === String(targetBookId);

        let copiesHtml = '';
        matchingCopies.forEach((copy, idx) => {
          const isLast = idx === matchingCopies.length - 1;
          const branch = isLast ? '└──' : '├──';
          const isPrinted = (copy.barcode_printed == 1 || copy.barcode_printed === '1');
          const badgeHtml = isPrinted 
            ? `<span style="font-size:0.68rem;background:#DCFCE7;color:#15803D;padding:2px 6px;border-radius:4px;font-weight:700;border:1px solid #86EFAC;">🏷️ Printed</span>`
            : `<span style="font-size:0.68rem;background:#FEF3C7;color:#B45309;padding:2px 6px;border-radius:4px;font-weight:700;border:1px solid #FDE68A;">⏳ Not Printed</span>`;

          const shouldAutoCheck = isTargetBook || (printedFilter === 'not_printed');

          copiesHtml += `
            <div class="bp-copy-item" id="bp-item-${copy.id}">
              <div style="display:flex;align-items:center;gap:8px;">
                <span style="font-family:monospace;color:#94A3B8;">${branch}</span>
                <input type="checkbox" class="bp-copy-cb" id="cb-copy-${copy.id}" value="${copy.id}" data-book-id="${book.id}" data-barcode="${copy.barcode}" ${shouldAutoCheck ? 'checked' : ''} onchange="toggleBpCopy('${copy.id}')" style="cursor:pointer;width:15px;height:15px;">
                <label for="cb-copy-${copy.id}" style="cursor:pointer;font-weight:700;color:#334155;margin:0;">
                  Copy ${String(copy.copy_number || (idx+1)).padStart(3, '0')}
                </label>
                <span style="font-family:monospace;font-size:0.75rem;background:#EFF6FF;color:#1D4ED8;padding:1px 6px;border-radius:4px;border:1px solid #BFDBFE;">${copy.barcode}</span>
                <span style="font-size:0.72rem;color:#64748B;">Rack ${copy.rack || 'A'}, Shelf ${copy.shelf || '1'}</span>
              </div>
              <div>${badgeHtml}</div>
            </div>
          `;
        });

        const shouldGroupCheck = isTargetBook || (printedFilter === 'not_printed');

        card.innerHTML = `
          <div class="bp-book-header">
            <div style="display:flex;align-items:center;gap:8px;">
              <input type="checkbox" class="bp-group-cb" id="cb-group-${book.id}" data-book-id="${book.id}" ${shouldGroupCheck ? 'checked' : ''} onchange="toggleBpGroup('${book.id}', this.checked)" style="cursor:pointer;width:16px;height:16px;">
              <label for="cb-group-${book.id}" style="cursor:pointer;font-weight:800;color:#0F172A;font-size:0.88rem;margin:0;">
                ${book.title}
              </label>
              <span style="font-size:0.74rem;color:#64748B;">by ${book.author || 'Unknown'}</span>
              <span style="font-size:0.7rem;background:#F1F5F9;color:#475569;padding:1px 6px;border-radius:4px;font-weight:600;">${book.edition || '1st Edition'}</span>
            </div>
            <div style="font-size:0.74rem;font-weight:700;color:#1E40AF;">
              ${matchingCopies.length} Copies Available to Print
            </div>
          </div>
          <div>${copiesHtml}</div>
        `;

        container.appendChild(card);
      });

      if (matchingBooksCount === 0) {
        container.innerHTML = `
          <div style="text-align:center;padding:32px 16px;color:#64748B;">
            <div style="font-size:2rem;margin-bottom:6px;">🔍</div>
            <div style="font-weight:700;color:#1E293B;">No matching physical copies found</div>
            <div style="font-size:0.78rem;margin-top:4px;">Try loosening the filters or selecting 'All Copies' above.</div>
          </div>
        `;
      }

      document.getElementById('bpVisibleCounter').textContent = `Showing ${matchingBooksCount} matching book groups`;
      updateBpSelectionSummary();
    }

    function toggleBpGroup(bookId, isChecked) {
      const copyCheckboxes = document.querySelectorAll(`.bp-copy-cb[data-book-id="${bookId}"]`);
      copyCheckboxes.forEach(cb => cb.checked = isChecked);
      updateBpSelectionSummary();
    }

    function toggleBpCopy(copyId) {
      const cb = document.getElementById(`cb-copy-${copyId}`);
      if (!cb) return;
      const bookId = cb.getAttribute('data-book-id');
      const groupCb = document.getElementById(`cb-group-${bookId}`);
      if (groupCb) {
        const siblings = document.querySelectorAll(`.bp-copy-cb[data-book-id="${bookId}"]`);
        const allChecked = Array.from(siblings).every(s => s.checked);
        const someChecked = Array.from(siblings).some(s => s.checked);
        groupCb.checked = allChecked;
        groupCb.indeterminate = (!allChecked && someChecked);
      }
      updateBpSelectionSummary();
    }

    function bpSelectAllFiltered(selectVal) {
      document.querySelectorAll('.bp-copy-cb').forEach(cb => cb.checked = selectVal);
      document.querySelectorAll('.bp-group-cb').forEach(cb => {
        cb.checked = selectVal;
        cb.indeterminate = false;
      });
      updateBpSelectionSummary();
    }

    function updateBpSelectionSummary() {
      const checkedBoxes = document.querySelectorAll('.bp-copy-cb:checked');
      const count = checkedBoxes.length;
      const uniqueBookIds = new Set(Array.from(checkedBoxes).map(cb => cb.getAttribute('data-book-id')));

      const counterBadge = document.getElementById('bpSelectedCounterBadge');
      if (counterBadge) {
        counterBadge.textContent = `Selected: ${count} physical copies across ${uniqueBookIds.size} books`;
      }

      const btnCount = document.getElementById('btnPdfCount');
      if (btnCount) btnCount.textContent = count;

      const genBtn = document.getElementById('btnGenerateBarcodePdf');
      if (genBtn) genBtn.disabled = (count === 0);
    }

    async function generateSelectedBarcodesPDF() {
      const checkedBoxes = document.querySelectorAll('.bp-copy-cb:checked');
      const copyIds = Array.from(checkedBoxes).map(cb => cb.value);

      if (copyIds.length === 0) {
        alert('Please select at least one physical copy checkbox to print barcodes.');
        return;
      }

      const pdfUrl = `/admin/api/barcodes/pdf?copy_ids=${encodeURIComponent(copyIds.join(','))}`;
      window.open(pdfUrl, '_blank');

      // Update local memory data for barcode_printed audit
      const nowIso = new Date().toISOString();
      (window.CATALOG_BOOKS_DATA || []).forEach(b => {
        (b.copies || []).forEach(c => {
          if (copyIds.includes(String(c.id))) {
            c.barcode_printed = 1;
            c.barcode_printed_at = nowIso;
          }
        });
      });

      closeModal('advancedBarcodePrintModal');
      alert(`Barcode PDF generated for ${copyIds.length} copies! Barcode printed audit status has been permanently recorded.`);
      window.location.reload();
    }

