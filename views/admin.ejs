                  else if (it.type === 'Digital E-Book') icon = '🌐';
                  return `
                    <div style="background:#F8FAFC;border:1px solid #E2E8F0;border-radius:8px;padding:10px 12px;">
                      <div style="display:flex;align-items:center;justify-content:space-between;gap:6px;">
                        <span style="font-size:0.85rem;font-weight:700;color:#1E293B;display:flex;align-items:center;gap:6px;">
                          <span>${icon}</span>
                          <span>${escapeHtml(it.item)}</span>
                        </span>
                        <span style="font-size:0.72rem;font-weight:800;padding:2px 6px;border-radius:4px;${isLate ? 'background:#FEE2E2;color:#991B1B;' : (it.status === 'PASSED' || it.status === 'COMPLETED' ? 'background:#ECFDF5;color:#047857;' : 'background:#EFF6FF;color:#1D4ED8;')}">
                          ${escapeHtml(it.status)}
                        </span>
                      </div>
                      <div style="display:flex;align-items:center;justify-content:space-between;margin-top:6px;font-size:0.75rem;color:#64748B;">
                        <span>Progress: <strong style="color:#1E293B;">${escapeHtml(it.progress || '—')}</strong></span>
                        <span>${it.due ? (isLate ? `<span style="color:#DC2626;font-weight:700;">Due: ${escapeHtml(it.due)} (Late)</span>` : `Due: ${escapeHtml(it.due)}`) : `Assigned: ${escapeHtml(it.assigned)}`}</span>
                      </div>
                    </div>
                  `;
                }).join('')}
              </div>
