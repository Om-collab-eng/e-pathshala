    async function submitScheduleStudioMeeting(e) {
      e.preventDefault();
      const title = document.getElementById('studioMeetingTitle').value.trim();
      const className = document.getElementById('studioMeetingClass').value.trim();
      const scheduledStart = document.getElementById('studioMeetingStart').value;
      const durationMinutes = parseInt(document.getElementById('studioMeetingDuration').value, 10) || 60;
      const description = document.getElementById('studioMeetingDesc').value.trim();

      if (!title || !scheduledStart) {
        alert('Please provide meeting title and start date/time');
        return;
      }

      try {
        const res = await fetch('/api/meetings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            title,
            className,
            scheduledStart,
            durationMinutes,
            description,
            meetingType: 'CLASS',
            sessionType: 'CLASS'
          })
        });
        const data = await res.json();
        if (data.success) {
          const m = data.meeting;
          alert(`✅ Meeting scheduled successfully!\n\nMeeting Code: ${m.meetingCode}\nShare Link: ${m.shareUrl || '/meet/' + m.uid}`);
