    function toggleCirculationRulesEdit(show) {
      const viewBox = document.getElementById('circRulesViewBox');
      const editBox = document.getElementById('circRulesEditBox');
      const editBtn = document.getElementById('circEditRulesBtn');
      if (!viewBox || !editBox) return;

      const shouldShow = (show !== undefined) ? show : (editBox.style.display === 'none');
      if (shouldShow) {
        viewBox.style.display = 'none';
        editBox.style.display = 'block';
        if (editBtn) editBtn.style.display = 'none';
      } else {
        viewBox.style.display = 'block';
        editBox.style.display = 'none';
        if (editBtn) editBtn.style.display = 'inline-flex';
      }
    }

    async function saveCirculationRules() {
      const stuLimit = parseInt(document.getElementById('cfgStudentMaxBooks').value, 10);
      const stuDays = parseInt(document.getElementById('cfgStudentDays').value, 10);
      const teaLimit = parseInt(document.getElementById('cfgTeacherMaxBooks').value, 10);
      const teaDays = parseInt(document.getElementById('cfgTeacherDays').value, 10);
      const staLimit = parseInt(document.getElementById('cfgStaffMaxBooks').value, 10);
      const fineRate = parseInt(document.getElementById('cfgFineRate').value, 10);
      const graceDays = parseInt(document.getElementById('cfgGraceDays').value, 10);
      const lostFee = parseInt(document.getElementById('cfgLostFee').value, 10);

      if (isNaN(stuLimit) || stuLimit < 1) return alert('Student limit must be at least 1 book.');
      if (isNaN(stuDays) || stuDays < 1) return alert('Student loan duration must be at least 1 day.');
      if (isNaN(teaLimit) || teaLimit < 1) return alert('Teacher limit must be at least 1 book.');
      if (isNaN(teaDays) || teaDays < 1) return alert('Teacher loan duration must be at least 1 day.');
      if (isNaN(fineRate) || fineRate < 0) return alert('Fine rate cannot be negative.');
      if (isNaN(graceDays) || graceDays < 0) return alert('Grace period cannot be negative.');

      const saveBtn = document.getElementById('circSaveRulesBtn');
      if (saveBtn) {
        saveBtn.disabled = true;
        saveBtn.innerText = 'Saving...';
      }

      try {
        const res = await fetch('/admin/api/circulation/settings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            student_max_books: stuLimit,
            loan_duration_days: stuDays,
            teacher_max_books: teaLimit,
            teacher_loan_days: teaDays,
            staff_max_books: staLimit,
            fine_per_day: fineRate,
            grace_period_days: graceDays,
            lost_book_charge: lostFee
          })
        });
        const data = await res.json();

        if (data.status === 'success') {
          activeCirculationRules = data.settings;

          // Update View Displays live
          document.getElementById('dispStudentLimit').innerText = `${stuLimit} books`;
          document.getElementById('dispStudentDays').innerText = stuDays;
          document.getElementById('dispTeacherLimit').innerText = `${teaLimit} books`;
          document.getElementById('dispTeacherDays').innerText = teaDays;
          if (document.getElementById('dispStaffLimit')) document.getElementById('dispStaffLimit').innerText = `${staLimit} books`;
          document.getElementById('dispFineRate').innerText = `₹${fineRate}/day`;
          document.getElementById('dispGraceDays').innerText = graceDays;
          if (document.getElementById('dispLostFee')) document.getElementById('dispLostFee').innerText = `₹${lostFee}`;

          // Close edit mode
          toggleCirculationRulesEdit(false);

          // Update loan duration select default
          const loanSelect = document.getElementById('circLoanDays');
          if (loanSelect) {
            loanSelect.value = String(stuDays);
          }

          alert('✅ ' + data.message);
        } else {
          alert('❌ ' + data.message);
        }
      } catch (e) {
        alert('Failed to save settings: ' + e.message);
      } finally {
        if (saveBtn) {
          saveBtn.disabled = false;
          saveBtn.innerText = '💾 Save Rules';
        }
      }
    }

