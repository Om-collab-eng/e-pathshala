    // ─────────────────────────────────────────────────────────────────
    // ─────────────────────────────────────────────────────────────────
    // SMART CAMERA BOOK SCANNER & BARCODE STICKER WORKFLOW
    // Front cam on Desktop, Back cam on Mobile, AI Extraction,
    // Google Books Store Metadata & Printable Code128 Barcode Labels
    // ─────────────────────────────────────────────────────────────────

    let smartCameraStream = null;
    let currentFacingMode = isMobileDevice() ? 'environment' : 'user';
    let alwaysFlippedModel = false; // Default normal orientation (NOT inverted/mirrored) so book text reads properly left-to-right
    let frontSnapBase64 = null;
    let backSnapBase64 = null;
    let frontSnapMeta = { width: 0, height: 0, sizeKb: 0, format: 'JPEG' };
    let lastSmartScanResult = null;
    let currentSavedBook = null;

    function toggleFlippedModel() {
      alwaysFlippedModel = !alwaysFlippedModel;
      const video = document.getElementById('smartBookVideo');
      if (video) {
        video.style.transform = alwaysFlippedModel ? 'scaleX(-1)' : 'none';
      }
      const btn = document.getElementById('btnFlippedModelToggle');
      if (btn) {
        btn.innerHTML = alwaysFlippedModel ? '🪞 Mirror: ON' : '🪞 Mirror: OFF';
        btn.style.background = alwaysFlippedModel ? 'rgba(56,189,248,0.22)' : 'rgba(255,255,255,0.15)';
        btn.style.color = alwaysFlippedModel ? '#38BDF8' : '#94A3B8';
      }
      logDebugStep('01', `Camera Mirror ${alwaysFlippedModel ? 'ACTIVE' : 'OFF'} (Google Lens AI auto-reads both normal & mirrored)`, 'Orientation toggle');
    }

    function isMobileDevice() {
      return /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent) ||
             (window.innerWidth <= 768 && ('ontouchstart' in window || navigator.maxTouchPoints > 0));
    }

    function getDebugTimestamp() {
      const d = new Date();
      return d.toTimeString().split(' ')[0] + '.' + String(d.getMilliseconds()).padStart(3, '0');
    }

    function logDebugStep(stepNum, stepTitle, details = '', isError = false) {
      const consoleEl = document.getElementById('smartScanDebugConsole');
      const badgeEl = document.getElementById('debugStepBadge');
      if (!consoleEl) return;

      const time = getDebugTimestamp();
      const stepStr = `[${String(stepNum).padStart(2, '0')}]`;
      const prefix = isError ? '❌' : (stepNum === '15' ? '✅' : '▶');
      const logLine = `${stepStr} [${time}] ${prefix} ${stepTitle}${details ? ': ' + details : ''}\n`;

      if (consoleEl.textContent.includes('Standby') || consoleEl.textContent.includes('ready. Awaiting')) {
        consoleEl.textContent = '';
      }

      consoleEl.textContent += logLine;
      consoleEl.scrollTop = consoleEl.scrollHeight;

      if (badgeEl) {
        if (isError) {
          badgeEl.textContent = `Step [${stepNum}] Error`;
          badgeEl.style.background = '#991B1B';
          badgeEl.style.color = '#FFF';
        } else if (stepNum === '15') {
          badgeEl.textContent = 'Completed';
          badgeEl.style.background = '#065F46';
          badgeEl.style.color = '#FFF';
        } else {
          badgeEl.textContent = `Step [${stepNum}] Running`;
          badgeEl.style.background = '#1E40AF';
          badgeEl.style.color = '#FFF';
        }
      }
    }

    function copyDebugLog() {
      const consoleEl = document.getElementById('smartScanDebugConsole');
      const btn = document.getElementById('btnCopyDebugLog');
      if (!consoleEl) return;
      const text = consoleEl.textContent || '';
      navigator.clipboard.writeText(text).then(() => {
        if (btn) {
          const orig = btn.innerHTML;
          btn.innerHTML = '✓ Copied!';
          setTimeout(() => { btn.innerHTML = orig; }, 2200);
        }
      }).catch(() => {
        alert('Log copied:\n\n' + text.slice(0, 600));
      });
    }

