    async function submitEditCopyForm(e) {
      e.preventDefault();
      const btn = document.getElementById('btnSaveCopyDetails');
      if (btn) { btn.disabled = true; btn.textContent = '💾 Saving...'; }

      const payload = {
        id: document.getElementById('bcdCopyId').value,
        rack: document.getElementById('bcdRack').value.trim(),
        shelf: document.getElementById('bcdShelf').value.trim(),
        status: document.getElementById('bcdStatus').value,
        condition_status: document.getElementById('bcdCondition').value
      };

      try {
        const res = await fetch('/admin/api/copy/update', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.success && data.copy) {
          const c = data.copy;
          // Update the table row in DOM
          const copyRow = document.getElementById(`copy-row-${c.id}`);
          if (copyRow) {
            const cells = copyRow.querySelectorAll('td');
            if (cells.length >= 5) {
              cells[2].textContent = `Rack ${c.rack || 'A'}, Shelf ${c.shelf || '1'}`;
              cells[3].innerHTML = `<span style="font-size:0.72rem;background:#F8FAFC;padding:2px 6px;border-radius:4px;border:1px solid #E2E8F0;font-weight:600;">${c.condition_status || 'GOOD'}</span>`;
              const cStatus = (c.status || 'AVAILABLE').toUpperCase();
              cells[4].innerHTML = `<span class="lp-status-pill ${cStatus === 'AVAILABLE' ? 'available' : (cStatus === 'ISSUED' ? 'issued' : 'overdue')}" style="font-size:0.7rem;padding:2px 8px;">${cStatus}</span>`;
            }
          }
          closeModal('bookCopyDetailModal');
          alert('Physical copy updated successfully!');
        } else {
          alert(data.error || 'Failed to update copy.');
        }
      } catch (err) {
        alert('Network error while saving copy.');
      } finally {
        if (btn) { btn.disabled = false; btn.textContent = '💾 Save Changes'; }
      }
    }

    // ── BARCODE CONFIGURATION (Phase 4) ──
    async function openBarcodeConfigModal() {
      try {
        const res = await fetch('/admin/api/settings/barcode');
        const data = await res.json();
        const cfg = data.settings || {};

        document.getElementById('cfgSchoolCode').value = cfg.school_code || 'VBPGZ';
        document.getElementById('cfgDateFormat').value = cfg.date_format || 'YYYYMMDD';
        document.getElementById('cfgSerialLength').value = cfg.serial_length || '6';
        document.getElementById('cfgPrefix').value = cfg.prefix || '';
        document.getElementById('cfgSuffix').value = cfg.suffix || '';

        updateBarcodePreview();
        openModal('barcodeConfigModal');
      } catch (e) {
        openModal('barcodeConfigModal');
      }
    }

    function updateBarcodePreview() {
      const school = (document.getElementById('cfgSchoolCode')?.value || 'VBPGZ').toUpperCase().replace(/[^A-Z0-9]/g, '');
      const dFormat = document.getElementById('cfgDateFormat')?.value || 'YYYYMMDD';
      const sLen = parseInt(document.getElementById('cfgSerialLength')?.value, 10) || 6;
      const prefix = (document.getElementById('cfgPrefix')?.value || '').toUpperCase().replace(/[^A-Z0-9]/g, '');
      const suffix = (document.getElementById('cfgSuffix')?.value || '').toUpperCase().replace(/[^A-Z0-9]/g, '');

      const now = new Date();
      const yyyy = String(now.getFullYear());
      const mm = String(now.getMonth() + 1).padStart(2, '0');
      const dd = String(now.getDate()).padStart(2, '0');

      let dateStr = '';
      if (dFormat === 'YYYYMMDD') dateStr = `${yyyy}${mm}${dd}`;
      else if (dFormat === 'YYYYMM') dateStr = `${yyyy}${mm}`;
      else if (dFormat === 'YYYY') dateStr = `${yyyy}`;

      const serialStr = String(1).padStart(sLen, '0');
      const preview = `${prefix}${school}${dateStr}${serialStr}${suffix}`;

      const prevEl = document.getElementById('cfgLivePreview');
      if (prevEl) prevEl.textContent = preview;
    }

    async function submitBarcodeConfig(e) {
      e.preventDefault();
      const btn = document.getElementById('btnSaveBarcodeConfig');
      if (btn) { btn.disabled = true; btn.textContent = '💾 Saving...'; }

      const payload = {
        school_code: document.getElementById('cfgSchoolCode').value.trim(),
        date_format: document.getElementById('cfgDateFormat').value,
        include_date: document.getElementById('cfgDateFormat').value !== 'NONE',
        serial_length: parseInt(document.getElementById('cfgSerialLength').value, 10) || 6,
        prefix: document.getElementById('cfgPrefix').value.trim(),
        suffix: document.getElementById('cfgSuffix').value.trim()
      };

      try {
        const res = await fetch('/admin/api/settings/barcode', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.success) {
          closeModal('barcodeConfigModal');
          alert('Barcode and Book Code configuration saved successfully! New book copies will follow this pattern.');
        } else {
          alert(data.error || 'Failed to save configuration.');
        }
      } catch (err) {
        alert('Network error while saving barcode configuration.');
      } finally {
        if (btn) { btn.disabled = false; btn.textContent = '💾 Save Configuration'; }
      }
    }

