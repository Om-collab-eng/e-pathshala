                <% if (overdue_count > 0) { %><span class="ld-nav-badge red"><%= overdue_count %></span><% } %>
            </button>
            <button class="ld-nav-item tab-btn" onclick="switchTab('reservations', this)">
                <span class="ld-nav-icon">📋</span>
                <span class="ld-nav-text">Book Requests</span>
                <% if (reservations) { %><span class="ld-nav-badge orange"><%= reservations.length %></span><% } %>
            </button>
            <button class="ld-nav-item tab-btn" onclick="switchTab('reviews', this)">
                <span class="ld-nav-icon">✍️</span>
                <span class="ld-nav-text">Reviews</span>
                <% if (pending_reviews) { %><span class="ld-nav-badge orange"><%= pending_reviews.length %></span><% } %>
            </button>
            <button class="ld-nav-item tab-btn" onclick="switchTab('moderation', this)">
                <span class="ld-nav-icon">🔍</span>
                <span class="ld-nav-text">Content Review</span>
            </button>

            <a href="/digital-library" class="ld-nav-item">
                <span class="ld-nav-icon">🌐</span>
                <span class="ld-nav-text">Digital Library</span>
            </a>
            <button class="ld-nav-item tab-btn" onclick="switchTab('reports', this)">
                <span class="ld-nav-icon">📈</span>
                <span class="ld-nav-text">Reports & Hub</span>
            </button>
            <a href="/billing" class="ld-nav-item">
                <span class="ld-nav-icon">💳</span>
                <span class="ld-nav-text">Billing & Plan</span>
            </a>
            <a href="/admin/settings" class="ld-nav-item">
                <span class="ld-nav-icon">⚙️</span>
                <span class="ld-nav-text">Settings</span>
            </a>
        </nav>

        <!-- Fixed Footer -->
        <div class="ld-sidebar-footer">
            <a href="/logout" class="ld-nav-item" style="color: #f87171; background: rgba(239,68,68,0.12); border: 1px solid rgba(239,68,68,0.2);">
                <span class="ld-nav-icon">🚪</span>
                <span class="ld-nav-text">Disconnect</span>
            </a>
        </div>
    </aside>

    <!-- ══ MAIN ══ -->
    <div class="ld-main">

        <!-- Mobile Top Bar -->
        <div class="ld-topbar">
            <div class="ld-topbar-left">
                <button class="ld-menu-btn" onclick="toggleAdminSidebar()" type="button" aria-label="Menu">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
                </button>
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="font-size: 1.1rem;">📚</span>
                    <span class="ld-brand-title"><%= (typeof session !== 'undefined' && session && session.school_name) ? session.school_name : 'Librika' %></span>
                </div>
            </div>
            <div class="ld-topbar-right">
                <button class="ld-notif-btn" onclick="switchTab('overdue')" type="button">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                    <% if (overdue_count > 0) { %>
                    <span class="ld-notif-badge"><%= overdue_count %></span>
                    <% } %>
                </button>
                <div class="ld-avatar-btn" onclick="openModal('viewSchoolModal')">
                    <%= (typeof session !== 'undefined' && session && (session.user_name || session.name)) ? (session.user_name || session.name).trim()[0].toUpperCase() : 'L' %>
                </div>
            </div>
        </div>

        <!-- Page Content -->
        <div class="ld-content">

            <!-- =================== 1. DASHBOARD TAB =================== -->
            <div id="tab-dashboard" class="tab-content" style="display: block;">
                <!-- Welcome -->
                <div class="ld-welcome" style="margin-bottom: 1.5rem;">
                    <div>
                        <h1 id="greetingText">Good Morning, <%= (session.user_name || 'Librarian').split(' ')[0] %>!</h1>
                        <p>Here's what's happening in your library today.</p>
                    </div>
                    <div class="ld-date-chip">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        <span id="todayDate"></span>
                    </div>
                </div>

                <!-- Library Overview Card -->
                <div class="ld-overview" style="margin-bottom: 1.5rem;">
                    <div class="ld-overview-header">
                        <h2>Library Overview</h2>
                        <button class="ld-view-reports" onclick="switchTab('reports')">View Reports</button>
                    </div>

                    <div class="ld-stats-grid">
                        <!-- Total Books -->
                        <div class="ld-stat-card">
                            <div class="ld-stat-icon-wrap">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                            </div>
                            <div class="ld-stat-val"><%= books.length %></div>
                            <div class="ld-stat-label">Total Books</div>
                            <span class="ld-stat-delta up">↑ <%= available_books %> available</span>
                        </div>
                        <!-- Total Members -->
                        <div class="ld-stat-card">
                            <div class="ld-stat-icon-wrap">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                            </div>
                            <div class="ld-stat-val"><%= total_students %></div>
                            <div class="ld-stat-label">Total Members</div>
                            <span class="ld-stat-delta up">↑ Active</span>
                        </div>
                        <!-- Issued Books -->
                        <div class="ld-stat-card">
                            <div class="ld-stat-icon-wrap">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
                            </div>
                            <div class="ld-stat-val"><%= transactions.length %></div>
                            <div class="ld-stat-label">Issued Books</div>
                            <span class="ld-stat-delta up">↑ <%= total_issued %> total</span>
                        </div>
                        <!-- Overdue -->
                        <div class="ld-stat-card">
                            <div class="ld-stat-icon-wrap">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                            </div>
                            <div class="ld-stat-val"><%= overdue_count %></div>
                            <div class="ld-stat-label">Overdue Books</div>
                            <span class="ld-stat-delta <% if (overdue_count > 0) { %>down<% } else { %>up<% } %>">
                                <% if (overdue_count > 0) { %>⚠ Needs attention<% } else { %>✓ All good<% } %>
                            </span>
                        </div>
                    </div>

                    <div class="ld-active-members">
                        <span class="ld-active-label">Active Members</span>
                        <div style="display:flex; align-items:center; gap:8px;">
                            <div class="ld-avatar-stack">
                                <% for (let sIdx=0; sIdx<Math.min(students.length,5); sIdx++) { let s = students[sIdx]; %>
                                <div class="ld-avatar-stack-item"><%= s.name ? s.name[0].toUpperCase() : 'M' %></div>
                                <% } %>
                            </div>
                            <% if (total_students > 5) { %>
                            <span class="ld-avatar-stack-more" style="color:white; font-size:0.68rem; font-weight:800;">+<%= total_students - 5 %></span>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Search -->
                <div class="ld-search-bar-wrap">
                    <div class="ld-search-box">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color:var(--muted); flex-shrink:0;"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                        <input type="text" id="globalSearch" placeholder="Search books, members, or ID..." onkeyup="doSearch(this.value)">
                    </div>
                    <% if ('manage_books' in (session.permissions || []) && (typeof school_perms !== 'undefined' && school_perms && school_perms.canUseAIScanner)) { %>
                        <a href="/admin/scanner" class="ld-btn ld-btn-primary ld-scan-action-btn" style="text-decoration: none;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
                            <span>Smart Scan</span>
                        </a>
                    <% } else { %>
                        <button class="ld-btn ld-btn-primary ld-scan-action-btn" onclick="alert('Smart Scan requires AI Scanner permissions')">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="4" height="16"/><rect x="8" y="4" width="2" height="16"/><rect x="12" y="4" width="4" height="16"/><rect x="18" y="4" width="4" height="16"/></svg>
                            <span>Scan ISBN</span>
                        </button>
                    <% } %>
                </div>

                <!-- Quick Actions -->
                <div style="margin-bottom: 1.5rem;">
                    <h2 class="ld-section-title">Quick Actions</h2>
                    <div class="ld-quick-grid">
                        <a href="/admin/issue" class="ld-qa-card">
                            <div class="ld-qa-icon qa-purple">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/><line x1="12" y1="9" x2="12" y2="15"/><line x1="9" y1="12" x2="15" y2="12"/></svg>
                            </div>
                            <span class="ld-qa-name">Issue Book</span>
                            <span class="ld-qa-desc">Issue a book to member</span>
                        </a>
                        <button class="ld-qa-card" onclick="switchTab('transactions')" style="background: var(--white); border: 1px solid var(--border); width: 100%;">
                            <div class="ld-qa-icon qa-green">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/><polyline points="9 12 11 14 15 10"/></svg>
                            </div>
                            <span class="ld-qa-name">Return Book</span>
                            <span class="ld-qa-desc">Receive returned books</span>
                        </button>
                        <a href="/admin/add_book" class="ld-qa-card">
                            <div class="ld-qa-icon qa-blue">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                            </div>
                            <span class="ld-qa-name">Add Book</span>
                            <span class="ld-qa-desc">Add new book to collection</span>
                        </a>
                        <a href="/admin/acquisitions" class="ld-qa-card">
                            <div class="ld-qa-icon qa-teal" style="background: rgba(16, 185, 129, 0.15); color: #10b981;">
                                📦
                            </div>
                            <span class="ld-qa-name">Book Acquisition</span>
                            <span class="ld-qa-desc">Upload invoices &amp; catalog books</span>
                        </a>
                        <button class="ld-qa-card" onclick="openModal('addUserModal')" style="background: var(--white); border: 1px solid var(--border); width: 100%;">
                            <div class="ld-qa-icon qa-orange">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
                            </div>
                            <span class="ld-qa-name">Add Member</span>
                            <span class="ld-qa-desc">Register a new member</span>
                        </button>
                        <button class="ld-qa-card" onclick="switchTab('books')" style="background: var(--white); border: 1px solid var(--border); width: 100%;">
                            <div class="ld-qa-icon qa-teal">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                            </div>
                            <span class="ld-qa-name">Search Books</span>
                            <span class="ld-qa-desc">Search in your collection</span>
                        </button>
                        <button class="ld-qa-card" onclick="switchTab('overdue')" style="background: var(--white); border: 1px solid var(--border); width: 100%;">
                            <div class="ld-qa-icon qa-red">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                            </div>
                            <span class="ld-qa-name">Overdue Books</span>
                            <span class="ld-qa-desc">View overdue books</span>
                        </button>
                        <button class="ld-qa-card" onclick="switchTab('members')" style="background: var(--white); border: 1px solid var(--border); width: 100%;">
                            <div class="ld-qa-icon qa-purple">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                            </div>
                            <span class="ld-qa-name">Member List</span>
                            <span class="ld-qa-desc">View all library members</span>
                        </button>
                        <button class="ld-qa-card" onclick="switchTab('reports')" style="background: var(--white); border: 1px solid var(--border); width: 100%;">
                            <div class="ld-qa-icon qa-amber">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
                            </div>
                            <span class="ld-qa-name">Data Hub</span>
                            <span class="ld-qa-desc">Import/Export library files</span>
                        </button>
                        <button class="ld-qa-card" onclick="switchTab('reservations')" style="background: var(--white); border: 1px solid var(--border); width: 100%; position:relative;">
                            <div class="ld-qa-icon" style="background:#fff7ed; color:#f97316;">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>
                            </div>
                            <span class="ld-qa-name">Book Requests</span>
                            <span class="ld-qa-desc">Student borrow requests</span>
                            <% if (reservations) { %>
                            <span style="position:absolute;top:6px;right:8px;background:#f97316;color:white;font-size:0.6rem;font-weight:800;padding:1px 6px;border-radius:20px;"><%= reservations.length %></span>
                            <% } %>
                        </button>
                    </div>
                </div>

                <% if (reservations) { %>
                <!-- Pending Requests Alert Banner -->
                <div onclick="switchTab('reservations')" style="background: linear-gradient(135deg, #fff7ed, #ffedd5); border: 1.5px solid #f97316; border-radius: 14px; padding: 1rem 1.25rem; display:flex; align-items:center; gap:0.85rem; cursor:pointer; margin-bottom: 1.5rem; transition: all 0.2s;" onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform=''">
                    <div style="background:#f97316; color:white; width:38px; height:38px; border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:1.1rem; flex-shrink:0;">📋</div>
                    <div style="flex:1; min-width:0;">
                        <div style="font-weight:800; font-size:0.9rem; color:#c2410c;"><%= reservations.length %> Pending Book Request<%= reservations.length !== 1 ? 's' : '' %></div>
                        <div style="font-size:0.75rem; color:#ea580c; font-weight:500; margin-top:2px;">Students are waiting — click to review && approve or reject</div>
                    </div>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#f97316" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </div>
                <% } %>

                <!-- Recent Activities -->
                <div>
                    <div class="ld-activity-header">
                        <h2 class="ld-section-title" style="margin-bottom:0;">Recent Activities</h2>
                        <button class="ld-view-all" onclick="switchTab('transactions')">
                            View All
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                        </button>
                    </div>
                    <div class="ld-activity-list">
                        <% if (transactions) { %>
                            <% for (let txIdx=0; txIdx<Math.min(transactions.length,6); txIdx++) { let tx = transactions[txIdx]; %>
                            <div class="ld-activity-card">
                                <div class="ld-activity-icon <% if (tx.is_overdue) { %>qa-red<% } else { %>qa-green<% } %>">
                                    <% if (tx.is_overdue) { %>
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                    <% } else { %>
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                                    <% } %>
                                </div>
                                <div class="ld-activity-info">
                                    <div class="ld-activity-title">
                                        "<%= tx.book_title %>" <% if (tx.is_overdue) { %>OVERDUE for<% } else { %>issued to<% } %> <%= tx.user_name %>
                                    </div>
                                    <div class="ld-activity-meta">
                                        <%= tx.issue_date %> &bull; <span>Due: <%= tx.due_date %></span>
                                        <% if (tx.fine && tx.fine > 0) { %> &bull; <span style="color:var(--lr); font-weight: 700;">Fine: ₹<%= tx.fine %></span><% } %>
                                    </div>
                                </div>
                                <a href="/admin/return/<%= tx.id %>" class="ld-activity-view">Return</a>
                            </div>
                            <% } %>
                        <% } else { %>
                            <div style="text-align:center; padding:2.5rem; background:var(--white); border-radius:var(--radius); border:1px solid var(--border);">
                                <div style="font-size:2.5rem; margin-bottom:0.75rem;">📋</div>
                                <p style="color:var(--muted); font-size:0.85rem; font-weight:600;">No active transactions</p>
                                <p style="color:var(--muted); font-size:0.75rem; margin-top:4px;">Issue a book to get started</p>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- =================== RESERVATIONS TAB =================== -->
            <div id="tab-reservations" class="tab-content" style="display: none;">
                <div class="ld-panel">
                    <div class="ld-panel-header">
                        <div>
                            <h3 class="ld-panel-title">📋 Book Requests</h3>
                            <p style="font-size:0.72rem;color:var(--muted);margin-top:2px;">Students who have requested to borrow a book. Approve to issue, or reject to decline.</p>
                        </div>
                    </div>

                    <% if (reservations) { %>
                    <div class="ld-table-responsive">
                        <table class="ld-table" id="reservationsTable">
                            <thead>
                                <tr>
                                    <th>Student</th>
                                    <th>Book</th>
                                    <th>Requested On</th>
                                    <th style="text-align:right;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% for (const res of reservations) { %>
                                <tr id="res-row-<%= res.id %>">
                                    <td>
                                        <div style="font-weight:700;color:var(--text);"><%= res.student_name %></div>
                                        <div style="font-size:0.72rem;color:var(--muted);"><%= res.student_phone || '' %></div>
                                    </td>
                                    <td>
                                        <div style="font-weight:700;color:var(--text);"><%= res.book_title %></div>
                                        <div style="font-size:0.72rem;color:var(--muted);"><%= res.book_author || '' %></div>
                                    </td>
                                    <td style="font-size:0.8rem;color:var(--muted);"><%= res.created_at %></td>
                                    <td style="text-align:right;">
                                        <div style="display:inline-flex;gap:8px;">
                                            <button onclick="approveReservation(<%= res.id %>, <%= res.book_id %>, <%= res.user_id %>)"
                                                style="background:var(--lg);color:white;border:none;border-radius:8px;padding:6px 14px;font-weight:700;font-size:0.78rem;cursor:pointer;transition:opacity 0.2s;"
                                                onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'">
                                                ✅ Approve
                                            </button>
                                            <button onclick="rejectReservation(<%= res.id %>)"
                                                style="background:#fee2e2;color:#ef4444;border:2px solid #ef4444;border-radius:8px;padding:6px 14px;font-weight:700;font-size:0.78rem;cursor:pointer;transition:all 0.2s;"
                                                onmouseover="this.style.background='#ef4444';this.style.color='white';" onmouseout="this.style.background='#fee2e2';this.style.color='#ef4444';">
                                                ✕ Reject
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                    <% } else { %>
                    <div style="text-align:center;padding:3rem;color:var(--muted);">
                        <div style="font-size:3rem;margin-bottom:1rem;">📭</div>
                        <div style="font-weight:700;font-size:1rem;">No Pending Requests</div>
                        <div style="font-size:0.8rem;margin-top:0.5rem;">When students reserve books from the catalog, they'll appear here.</div>
                    </div>
                    <% } %>
                </div>
            </div>

            <!-- =================== REVIEWS TAB =================== -->
            <div id="tab-reviews" class="tab-content" style="display: none;">
                <div class="ld-panel">
                    <div class="ld-panel-header">
                        <div>
                            <h3 class="ld-panel-title">✍️ Pending Book Reviews</h3>
                            <p style="font-size: 0.72rem; color: var(--muted); margin-top: 2px;">Review student book summaries && approve points allocation (+20 points).</p>
                        </div>
                    </div>

                    <div class="ld-table-responsive">
                        <% if (pending_reviews) { %>
                        <table class="ld-table">
                            <thead>
                                <tr>
                                    <th>Student</th>
                                    <th>Book/Resource</th>
                                    <th>Type</th>
                                    <th>Review Content</th>
                                    <th style="text-align:right;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% for (const r of pending_reviews) { %>
                                <tr>
                                    <td>
                                        <div style="font-weight:700;"><%= r.student_name %></div>
                                    </td>
                                    <td>
                                        <div style="font-weight:700;"><%= r.book_title %></div>
                                    </td>
                                    <td>
                                        <span class="ld-badge" style="background: var(--purple-light); color: var(--purple);">
                                            <%= r.book_type.toUpperCase() %>
                                        </span>
                                    </td>
                                    <td>
                                        <div style="font-size:0.8rem; line-height:1.4;">
                                            <strong>What I learned:</strong> <%= r.learned %><br>
                                            <strong>Favorite:</strong> <%= r.favorite %><br>
                                            <strong>Recommend:</strong> <%= r.recommend %>
                                        </div>
                                    </td>
                                    <td style="text-align:right; white-space:nowrap;">
                                        <form action="/admin/review/<%= r.id %>/approve" method="POST" style="display:inline;">
                                            <button type="submit" class="ld-btn" style="font-size:0.75rem; padding:6px 12px; background:#10b981; border:none; color:white;">Approve</button>
                                        </form>
                                        <form action="/admin/review/<%= r.id %>/reject" method="POST" style="display:inline; margin-left:4px;">
                                            <button type="submit" class="ld-btn" style="font-size:0.75rem; padding:6px 12px; background:#ef4444; border:none; color:white;">Reject</button>
                                        </form>
                                    </td>
                                </tr>
                                <% } %>
                            </tbody>
                        </table>
                        <% } else { %>
                        <div style="text-align:center; padding:3rem; color:var(--muted);">No pending reviews found.</div>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- =================== 2. BOOKS TAB =================== -->
            <div id="tab-books" class="tab-content" style="display: none;">
                <div class="ld-panel">
                    <div class="ld-panel-header">
                        <div>
                            <h3 class="ld-panel-title">See Books (Repository)</h3>
                            <p style="font-size: 0.72rem; color: var(--muted); margin-top: 2px;">Manage catalog inventory, copies, && download barcodes. Click any row to edit or manage.</p>
                        </div>
                        <div style="display:flex; gap:10px; align-items:center;">
                            <button onclick="confirmDeleteAll()" class="ld-btn" style="background:linear-gradient(135deg,#ef4444,#dc2626);border:none;color:#fff;display:flex;align-items:center;gap:6px;" title="Delete all books in this library">
                                <span style="font-size:1rem;">🗑️</span> Delete All Books
                            </button>
                            <a href="/admin/add_book" class="ld-btn">+ Add Book</a>
                        </div>
                    </div>

                    <div class="ld-search-wrap" style="box-shadow: none; border-color: var(--border);">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color:var(--muted); flex-shrink:0;"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                        <input type="text" id="booksSearchInput" placeholder="Search by title, author, barcode..." onkeyup="filterTable('booksSearchInput', 'booksTable', [0, 1])">
                    </div>

                    <div class="ld-table-responsive">
                        <% if (books) { %>
                        <table class="ld-table" id="booksTable">
                            <thead>
                                <tr>
                                    <th style="width:52px;">Cover</th>
                                    <th>Asset Details</th>
                                    <th>Barcode ID</th>
                                    <th>Allocation Progress</th>
                                    <th>Availability</th>
                                    <th style="text-align:right;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% for (const book of books) { %>
                                <tr onclick="openBookMenu(<%= book.id %>, '<%= book.title %>', '<%= book.author %>', '<%= book.cover_url || '' %>', '<%= book.barcode_id %>', <%= book.total_copies %>, <%= book.available_copies %>)" style="cursor:pointer; transition: background 0.15s;" onmouseover="this.style.background='var(--lp-light)'" onmouseout="this.style.background=''">
                                    <td>
                                        <% var isbn = book.isbn || ''; %>
                                        <% if (book.cover_url) { %>
                                            <img src="<%= book.cover_url %>" alt="cover"
                                                 data-isbn="<%= isbn %>"
                                                 style="width:40px;height:54px;object-fit:cover;border-radius:6px;border:1px solid var(--border);"
                                                 onerror="bookCoverFallback(this)">
                                        <% } else if (isbn) { %>
                                            <img src="https://covers.openlibrary.org/b/isbn/<%= isbn %>-S.jpg" alt="cover"
                                                 data-isbn="<%= isbn %>"
                                                 style="width:40px;height:54px;object-fit:cover;border-radius:6px;border:1px solid var(--border);"
                                                 onerror="this.onerror=null; this.outerHTML='<div style=&quot;width:40px;height:54px;background:var(--bg);border-radius:6px;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:1.2rem;&quot;>📖</div>';">
                                        <% } else { %>
                                            <div style="width:40px;height:54px;background:var(--bg);border-radius:6px;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:1.2rem;">📖</div>
                                        <% } %>
                                    </td>
                                    <td>
                                        <div style="font-weight: 700; color: var(--text);"><%= book.title %></div>
                                        <div style="font-size: 0.72rem; color: var(--muted); margin-top: 1px;">by <%= book.author %></div>
                                    </td>
                                    <td><code style="background: var(--bg); border: 1px solid var(--border); padding: 4px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: 600; font-family: monospace;"><%= book.barcode_id %></code></td>
                                    <td>
                                        <% var pct = 0; %>
                                        <% if (book.total_copies > 0) { %>
                                            <% var pct = (book.available_copies / book.total_copies * 100); %>
                                        <% } %>
                                        <div class="ld-progress-container">
                                            <div class="ld-progress-bar">
                                                <div class="ld-progress-fill" style="width: <%= pct %>%; background: <% if (pct < 20) { %>var(--lr)<% } else if (pct < 50) { %>var(--lam)<% } else { %>var(--lp)<% } %>;"></div>
                                            </div>
                                            <span style="font-size: 0.72rem; font-weight: 700; color: var(--mid);"><%= pct %>%</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="ld-badge <% if (book.available_copies > 0) { %>ld-badge-success<% } else { %>ld-badge-danger<% } %>">
                                            <%= book.available_copies %> of <%= book.total_copies %> left
                                        </span>
                                    </td>
                                    <td style="text-align:right;" onclick="event.stopPropagation()">
                                        <div style="display:inline-flex; gap:6px;">
                                            <a href="/static/barcodes/<%= book.barcode_id %>.png" download class="ld-btn-alt" style="font-size: 0.7rem; padding: 6px 12px;">Barcode</a>
                                        </div>
                                    </td>
                                </tr>
                                <% } %>
                            </tbody>
                        </table>
                        <% } else { %>
                        <div style="text-align: center; padding: 3rem; color: var(--muted);">No books in repository. Click Add Book to create one.</div>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- =================== BOOK ACTION MODAL =================== -->
            <div id="bookActionModal" class="ld-modal-overlay" style="display:none;" onclick="if(event.target===this)closeBookMenu()">
                <div class="ld-modal-content" style="max-width:440px; padding:0; overflow:hidden; border-radius:20px;">

                    <!-- Header with cover -->
                    <div id="bamHeader" style="background: linear-gradient(135deg, var(--lp), #7c3aed); padding: 1.5rem; display:flex; gap:1rem; align-items:center;">
                        <img id="bamCover" src="" alt="cover" style="width:54px;height:72px;object-fit:cover;border-radius:8px;box-shadow:0 4px 16px rgba(0,0,0,0.3); background:#fff; flex-shrink:0;" onerror="this.style.display='none';document.getElementById('bamCoverFallback').style.display='flex'">
                        <div id="bamCoverFallback" style="display:none;width:54px;height:72px;background:rgba(255,255,255,0.2);border-radius:8px;align-items:center;justify-content:center;font-size:1.8rem;flex-shrink:0;">📖</div>
                        <div style="flex:1; min-width:0;">
                            <div id="bamTitle" style="color:white;font-family:'Outfit';font-weight:800;font-size:1.05rem;line-height:1.3; word-break:break-word;"></div>
                            <div id="bamAuthor" style="color:rgba(255,255,255,0.75);font-size:0.78rem;margin-top:3px;"></div>
                            <div id="bamCopies" style="color:rgba(255,255,255,0.9);font-size:0.72rem;margin-top:6px;font-weight:700;"></div>
                        </div>
                        <button onclick="closeBookMenu()" style="background:rgba(255,255,255,0.2);border:none;color:white;width:32px;height:32px;border-radius:50%;cursor:pointer;font-size:1rem;align-self:flex-start;flex-shrink:0;">✕</button>
                    </div>

                    <!-- Action buttons grid -->
                    <div id="bamActions" style="padding: 1.25rem; display:grid; grid-template-columns:1fr 1fr; gap:0.75rem;">
                        <button onclick="bamEdit()" style="background:var(--lp-light);border:2px solid var(--lp);border-radius:14px;padding:1rem;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:8px;transition:all 0.2s;" onmouseover="this.style.background='var(--lp)';this.querySelector('div').style.color='white';this.querySelector('span').style.color='white'" onmouseout="this.style.background='var(--lp-light)';this.querySelector('div').style.color='var(--lp)';this.querySelector('span').style.color='var(--muted)'">
                            <div style="font-size:1.5rem;">✏️</div>
                            <div>
                                <div style="font-weight:800;font-size:0.85rem;color:var(--lp);font-family:'Outfit';">Edit Book</div>
                                <span style="font-size:0.68rem;color:var(--muted);">Update details</span>
                            </div>
                        </button>
                        <button onclick="bamAddCopy()" style="background:var(--lg-light);border:2px solid var(--lg);border-radius:14px;padding:1rem;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:8px;transition:all 0.2s;" onmouseover="this.style.background='var(--lg)';this.querySelector('div:first-child').style.opacity='1'" onmouseout="this.style.background='var(--lg-light)'">
                            <div style="font-size:1.5rem;">➕</div>
                            <div>
                                <div style="font-weight:800;font-size:0.85rem;color:var(--lg);font-family:'Outfit';">Add Copy</div>
                                <span style="font-size:0.68rem;color:var(--muted);">Increase stock</span>
                            </div>
                        </button>
                        <button onclick="bamIssue()" style="background:#fff7ed;border:2px solid #f97316;border-radius:14px;padding:1rem;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:8px;transition:all 0.2s;">
                            <div style="font-size:1.5rem;">📤</div>
                            <div>
                                <div style="font-weight:800;font-size:0.85rem;color:#f97316;font-family:'Outfit';">Issue Book</div>
                                <span style="font-size:0.68rem;color:var(--muted);">Lend to member</span>
                            </div>
                        </button>
                        <button onclick="bamView()" style="background:var(--lb-light);border:2px solid var(--lb);border-radius:14px;padding:1rem;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:8px;transition:all 0.2s;">
                            <div style="font-size:1.5rem;">👁️</div>
                            <div>
                                <div style="font-weight:800;font-size:0.85rem;color:var(--lb);font-family:'Outfit';">View Details</div>
                                <span style="font-size:0.68rem;color:var(--muted);">Full catalog info</span>
                            </div>
                        </button>

                        <!-- Delete tile — full width, 5th option -->
                        <button onclick="bamDelete()" id="bamDeleteBtn"
                            style="grid-column:1/-1;background:#fff0f0;border:2px solid #ef4444;border-radius:14px;padding:0.9rem 1rem;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:6px;transition:all 0.2s;"
                            onmouseover="this.style.background='#ef4444';this.style.borderColor='#dc2626';this.querySelectorAll('div,span').forEach(e=>e.style.color='#fff');"
                            onmouseout="this.style.background='#fff0f0';this.style.borderColor='#ef4444';this.querySelectorAll('div,span').forEach(e=>e.style.color='');">
                            <div style="font-size:1.4rem;">🗑️</div>
                            <div>
                                <div style="font-weight:800;font-size:0.85rem;color:#ef4444;font-family:'Outfit';">Delete Book</div>
                                <span style="font-size:0.68rem;color:var(--muted);">Permanently remove</span>
                            </div>
                        </button>
                    </div>
                </div>
            </div>


            <!-- =================== EDIT BOOK MODAL =================== -->
            <div id="editBookModal" class="ld-modal-overlay" style="display:none;" onclick="if(event.target===this)document.getElementById('editBookModal').style.display='none'">
                <div class="ld-modal-content" style="max-width:520px;">
                    <button class="ld-modal-close" onclick="document.getElementById('editBookModal').style.display='none'">✕</button>
                    <h3 class="ld-modal-title">✏️ Edit Book</h3>
                    <form id="editBookForm" onsubmit="submitEditBook(event)">
                        <input type="hidden" id="editBookId">
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;">
                            <div style="grid-column:1/-1;">
                                <label class="ld-label">Title</label>
                                <input class="ld-input" id="editTitle" placeholder="Book title" required>
                            </div>
                            <div style="grid-column:1/-1;">
                                <label class="ld-label">Author</label>
                                <input class="ld-input" id="editAuthor" placeholder="Author name" required>
                            </div>
                            <div>
                                <label class="ld-label">Publisher</label>
                                <input class="ld-input" id="editPublisher" placeholder="Publisher">
                            </div>
                            <div>
                                <label class="ld-label">ISBN</label>
                                <input class="ld-input" id="editIsbn" placeholder="ISBN">
                            </div>
                            <div>
                                <label class="ld-label">Genre / Category</label>
                                <input class="ld-input" id="editGenre" placeholder="Genre">
                            </div>
                            <div>
                                <label class="ld-label">Class / Grade</label>
                                <input class="ld-input" id="editClass" placeholder="e.g. IX, 10">
                            </div>
                            <div>
                                <label class="ld-label">Subject</label>
                                <input class="ld-input" id="editSubject" placeholder="Subject">
                            </div>
                            <div>
                                <label class="ld-label">Language</label>
                                <input class="ld-input" id="editLanguage" placeholder="Language">
                            </div>
                            <div style="grid-column:1/-1;">
                                <label class="ld-label">Description</label>
                                <textarea class="ld-input" id="editDescription" rows="3" placeholder="Short description"></textarea>
                            </div>
                        </div>
                        <div style="display:flex;gap:0.75rem;margin-top:1.25rem;">
                            <button type="button" onclick="document.getElementById('editBookModal').style.display='none'" class="ld-btn-alt" style="flex:1;">Cancel</button>
                            <button type="submit" class="ld-btn" style="flex:2;" id="editBookSaveBtn">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>


            <!-- =================== DELETE BOOK CONFIRM MODAL =================== -->
            <div id="deleteBookModal" class="ld-modal-overlay" style="display:none;" onclick="if(event.target===this)closeDeleteBookModal()">
                <div class="ld-modal-content" style="max-width:400px;text-align:center;">
                    <div style="font-size:3rem;margin-bottom:0.5rem;">🗑️</div>
                    <h3 class="ld-modal-title" style="color:#ef4444;" id="deleteBookModalTitle">Delete Book?</h3>
                    <p id="deleteBookModalMsg" style="color:var(--muted);font-size:0.88rem;margin:0.5rem 0 1.5rem;">This will permanently remove this book && all its transaction history.</p>
                    <div style="display:flex;gap:0.75rem;">
                        <button onclick="closeDeleteBookModal()" class="ld-btn-alt" style="flex:1;">Cancel</button>
                        <button onclick="confirmDeleteBookNow()" id="deleteBookConfirmBtn" class="ld-btn" style="flex:1;background:linear-gradient(135deg,#ef4444,#dc2626);border:none;">Yes, Delete</button>
                    </div>
                </div>
            </div>

            <!-- =================== DELETE ALL BOOKS CONFIRM MODAL =================== -->
            <div id="deleteAllBooksModal" class="ld-modal-overlay" style="display:none;" onclick="if(event.target===this)closeDeleteAllModal()">
                <div class="ld-modal-content" style="max-width:420px;text-align:center;">
                    <div style="font-size:3rem;margin-bottom:0.5rem;">☢️</div>
                    <h3 class="ld-modal-title" style="color:#ef4444;">Delete ALL Books?</h3>
                    <p style="color:var(--muted);font-size:0.88rem;margin:0.5rem 0;">This will permanently wipe <strong>every book</strong> in this library's catalog including all transaction history. This cannot be undone.</p>
                    <p style="color:#ef4444;font-size:0.8rem;font-weight:700;margin-bottom:1.25rem;">Type <code>DELETE ALL</code> below to confirm:</p>
                    <input id="deleteAllConfirmInput" class="ld-input" placeholder="DELETE ALL" style="text-align:center;letter-spacing:2px;font-weight:700;margin-bottom:1rem;">
                    <div style="display:flex;gap:0.75rem;">
                        <button onclick="closeDeleteAllModal()" class="ld-btn-alt" style="flex:1;">Cancel</button>
                        <button onclick="confirmDeleteAllNow()" id="deleteAllConfirmBtn" class="ld-btn" style="flex:1;background:linear-gradient(135deg,#ef4444,#dc2626);border:none;">Wipe All Books</button>
                    </div>
                </div>
            </div>

            <!-- =================== 3. MEMBERS TAB =================== -->
            <div id="tab-members" class="tab-content" style="display: none;">
                <div class="ld-panel">
                    <div class="ld-panel-header">
                        <div>
                            <h3 class="ld-panel-title">User Management</h3>
                            <p style="font-size: 0.72rem; color: var(--muted); margin-top: 2px;">View registered students, ban accounts, or delete records.</p>
                        </div>
                        <button class="ld-btn" onclick="openModal('addUserModal')">+ Create User</button>
                    </div>

                    <div class="ld-search-wrap" style="box-shadow: none; border-color: var(--border);">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color:var(--muted); flex-shrink:0;"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                        <input type="text" id="membersSearchInput" placeholder="Search by name, phone, email, admission ID..." onkeyup="filterTable('membersSearchInput', 'membersTable', [0, 1])">
                    </div>

                    <div class="ld-table-responsive">
                        <% if (students) { %>
                        <table class="ld-table" id="membersTable">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Contact Info</th>
                                    <th>Class / Stream</th>
                                    <th>Role</th>
                                    <th>Status</th>
                                    <th style="text-align:right;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% for (const u of students) { %>
                                <tr>
                                    <td>
                                        <div style="display:flex; align-items:center; gap:8px;">
                                            <div class="ld-sidebar-avatar" style="width:30px; height:30px; font-size:0.75rem; background: var(--lp-light); color: var(--lp);"><%= u.name ? u.name[0].toUpperCase() : 'M' %></div>
                                            <div style="font-weight: 700; color: var(--text);"><%= u.name %></div>
                                        </div>
                                    </td>
                                    <td>
                                        <div style="font-size:0.8rem; font-weight:600;"><%= u.phone %></div>
                                        <div style="font-size:0.7rem; color:var(--muted);"><%= u.email || 'No Email' %></div>
                                    </td>
                                    <td>
                                        <% if (u.role == 'student') { %>
                                        <div style="font-weight:700;">Class <%= u.class || 'N/A' %></div>
                                        <div style="font-size:0.7rem; color:var(--muted);">ID: <%= u.admission_no || 'N/A' %></div>
                                        <% } else { %>
                                        <div style="color:var(--muted); font-style:italic;">N/A (Staff)</div>
                                        <% } %>
                                    </td>
                                    <td>
                                        <span class="ld-badge <% if (u.role == 'admin') { %>ld-badge-warning<% } else { %>ld-badge-info<% } %>">
                                            <%= u.role.toUpperCase() %>
                                        </span>
                                    </td>
                                    <td>
                                        <span class="ld-badge <% if (u.is_banned) { %>ld-badge-danger<% } else { %>ld-badge-success<% } %>">
<%= u.is_banned ? 'Banned' : 'Active' %>
                                        </span>
                                    </td>
                                    <td style="text-align:right;">
                                        <div style="display:inline-flex; gap:6px; align-items:center;">
                                            <button class="ld-btn-alt" style="font-size:0.7rem; padding:6px 12px;" onclick="openViewUserModal(<%= u %>)">Info</button>
                                            
                                            <form action="/admin/student/<%= u.id %>/toggle-ban" method="POST" style="margin:0;">
                                                    <button type="submit" class="ld-btn-alt <% if (u.is_banned) { %>ld-btn-success<% } else { %>ld-btn-danger<% } %>" style="font-size: 0.7rem; padding: 6px 12px;">
<%= u.is_banned ? 'Unban' : 'Ban' %>
                                                    </button>
                                            </form>

                                            <form action="/admin/student/<%= u.id %>/delete" method="POST" style="margin:0;" onsubmit="return confirm('WARNING: Permanently delete this user? This cannot be undone.');">
                                                <button type="submit" class="ld-btn-alt ld-btn-danger" style="font-size: 0.7rem; padding: 6px 12px;">Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                <% } %>
                            </tbody>
                        </table>
                        <% } else { %>
                        <div style="text-align: center; padding: 3rem; color: var(--muted);">No registered members found.</div>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- =================== 4. TRANSACTIONS TAB =================== -->
            <div id="tab-transactions" class="tab-content" style="display: none;">
                <div class="ld-panel">
                    <div class="ld-panel-header">
                        <div>
                            <h3 class="ld-panel-title">Active Borrowed Books</h3>
                            <p style="font-size: 0.72rem; color: var(--muted); margin-top: 2px;">View all active outstanding book distributions && process return sequences.</p>
                        </div>
                        <a href="/admin/issue" class="ld-btn">Issue Book</a>
                    </div>

                    <div class="ld-search-wrap" style="box-shadow: none; border-color: var(--border);">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color:var(--muted); flex-shrink:0;"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                        <input type="text" id="txsSearchInput" placeholder="Search by student, book title..." onkeyup="filterTable('txsSearchInput', 'txsTable', [0, 1])">
                    </div>

                    <div class="ld-table-responsive">
                        <% if (transactions) { %>
                        <table class="ld-table" id="txsTable">
                            <thead>
                                <tr>
                                    <th>Student Entity</th>
                                    <th>Asset Details</th>
                                    <th>Timing</th>
                                    <th>Fine Status</th>
                                    <th style="text-align:right;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% for (const tx of transactions) { %>
                                <tr>
                                    <td>
                                        <div style="font-weight: 700; color: var(--text);"><%= tx.user_name %></div>
                                        <div style="font-size: 0.72rem; color: var(--muted); margin-top: 1px;">
                                            Class <%= tx.class || 'N/A' %>
                                            <% if (tx.user_admission) { %> | ID: <%= tx.user_admission %><% } %>
                                            <% if (tx.user_phone) { %> | Ph: <%= tx.user_phone %><% } %>
                                        </div>
                                    </td>
                                    <td>
                                        <div style="font-weight: 700;"><%= tx.book_title %></div>
                                        <% if (tx.book_barcode) { %>
                                        <div style="font-size: 0.72rem; color: var(--muted); margin-top: 1px;">Barcode: <%= tx.book_barcode %></div>
                                        <% } %>
                                    </td>
                                    <td>
                                        <div style="font-size: 0.85rem; font-weight: 600;">Issued: <%= tx.issue_date %></div>
                                        <div style="font-size: 0.8rem; color: var(--muted); margin-top: 2px;">
                                            Due: <span class="<% if (tx.is_overdue) { %>ld-badge-danger<% } %>" style="font-weight: 600;"><%= tx.due_date %></span>
                                        </div>
                                    </td>
                                    <td>
                                        <% if (tx.fine > 0) { %>
                                        <span class="ld-badge ld-badge-danger" style="font-weight:800;">₹<%= tx.fine %> Fine</span>
                                        <% } else { %>
                                        <span class="ld-badge ld-badge-success">Clean</span>
                                        <% } %>
                                    </td>
                                    <td style="text-align:right;">
                                        <a href="/admin/return/<%= tx.id %>" class="ld-btn" style="font-size: 0.72rem; padding: 6px 12px; background: var(--lg);">Process Return</a>
                                        <form action="/admin/transaction/<%= tx.id %>/lost" method="POST" style="display:inline; margin-left: 4px;" onsubmit="return confirm('Are you sure you want to mark this book as Lost/Damaged? Student will be penalized -50 points.')">
                                            <button type="submit" class="ld-btn" style="font-size: 0.72rem; padding: 6px 12px; background: var(--lr); border: none; color: white; cursor: pointer;">Mark Lost</button>
                                        </form>
                                    </td>
                                </tr>
                                <% } %>
                            </tbody>
                        </table>
                        <% } else { %>
                        <div style="text-align: center; padding: 3rem; color: var(--muted);">No active book issues found.</div>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- =================== 5. OVERDUE TAB =================== -->
            <div id="tab-overdue" class="tab-content" style="display: none;">
                <div class="ld-panel">
                    <div class="ld-panel-header">
                        <div>
                            <h3 class="ld-panel-title">Overdue Alerts</h3>
                            <p style="font-size: 0.72rem; color: var(--muted); margin-top: 2px;">Attention required: active borrowing records that have passed their deadline.</p>
                        </div>
                    </div>

                    <div class="ld-search-wrap" style="box-shadow: none; border-color: var(--border);">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color:var(--muted); flex-shrink:0;"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                        <input type="text" id="overdueSearchInput" placeholder="Search overdue student, book..." onkeyup="filterTable('overdueSearchInput', 'overdueTable', [0, 1])">
                    </div>

                    <div class="ld-table-responsive">
                        <table class="ld-table" id="overdueTable">
                            <thead>
                                <tr>
                                    <th>Student Entity</th>
                                    <th>Asset Details</th>
                                    <th>Timing</th>
                                    <th>Fine Status</th>
                                    <th style="text-align:right;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% var overdue_shown = false; %>
                                <% for (const tx of transactions) { %>
                                    <% if (tx.is_overdue) { %>
                                    <% var overdue_shown = true; %>
                                    <tr>
                                        <td>
                                            <div style="font-weight: 700; color: var(--lr);"><%= tx.user_name %></div>
                                            <div style="font-size: 0.72rem; color: var(--muted); margin-top: 1px;">
                                                Class <%= tx.class || 'N/A' %>
                                                <% if (tx.user_admission) { %> | ID: <%= tx.user_admission %><% } %>
                                                <% if (tx.user_phone) { %> | Ph: <%= tx.user_phone %><% } %>
                                            </div>
                                        </td>
                                        <td>
                                            <div style="font-weight: 700;"><%= tx.book_title %></div>
                                            <% if (tx.book_barcode) { %>
                                            <div style="font-size: 0.72rem; color: var(--muted); margin-top: 1px;">Barcode: <%= tx.book_barcode %></div>
                                            <% } %>
                                        </td>
                                        <td>
                                            <div style="font-size: 0.85rem; font-weight: 600;">Issued: <%= tx.issue_date %></div>
                                            <div style="font-size: 0.8rem; color: var(--muted); margin-top: 2px;">
                                                Due: <span style="font-weight: 700; color: var(--lr); text-decoration: underline;"><%= tx.due_date %></span>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="ld-badge ld-badge-danger" style="font-weight: 800; font-size: 0.75rem;">₹<%= tx.fine %> Fine</span>
                                        </td>
                                        <td style="text-align:right;">
                                            <a href="/admin/return/<%= tx.id %>" class="ld-btn" style="font-size: 0.72rem; padding: 6px 12px; background: var(--lr);">Process Return</a>
                                            <form action="/admin/transaction/<%= tx.id %>/lost" method="POST" style="display:inline; margin-left: 4px;" onsubmit="return confirm('Are you sure you want to mark this book as Lost/Damaged? Student will be penalized -50 points.')">
                                                <button type="submit" class="ld-btn" style="font-size: 0.72rem; padding: 6px 12px; background: var(--lr); border: none; color: white; cursor: pointer;">Mark Lost</button>
                                            </form>
                                        </td>
                                    </tr>
                                    <% } %>
                                <% } %>
                                <% if (! overdue_shown) { %>
                                <tr>
                                    <td colspan="5" style="text-align: center; padding: 3rem; color: var(--muted);">✓ No overdue alert flags! All systems running smoothly.</td>
                                </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- =================== 6. MODERATION TAB =================== -->
            <div id="tab-moderation" class="tab-content" style="display: none;">
                <div class="ld-panel" style="text-align: center; padding: 3.5rem 2rem;">
                    <div style="font-size: 3rem; margin-bottom: 1rem;">⚖️</div>
                    <h3 class="ld-panel-title" style="margin-bottom: 0.5rem; font-size: 1.5rem;">Content Moderation Portal</h3>
                    <p style="color: var(--muted); max-width: 500px; margin: 0 auto 2rem; font-size: 0.88rem; line-height: 1.5;">
                        Review, approve or reject digital book contributions, student summaries, && reading group assets submitted to the digital catalog.
                    </p>
                    <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
                        <a href="/admin/review-queue" class="ld-btn" style="padding: 12px 24px;">Content Review Queue</a>
                        <a href="/digital-library" class="ld-btn-alt" style="padding: 12px 24px;">Digital Library</a>
                    </div>
                </div>
            </div>

            <!-- =================== 7. REPORTS & HUB TAB =================== -->
            <div id="tab-reports" class="tab-content" style="display: none;">
                <!-- Summary Stats -->
                <div class="ld-panel">
                    <h3 class="ld-panel-title">Reports & Data Sync</h3>
                    <p style="font-size: 0.72rem; color: var(--muted); margin-top: 2px;">Download summaries of activities, or manage import/export workflows.</p>

                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-top: 10px;">
                        <div style="background:var(--bg); border:1px solid var(--border); padding: 1.25rem; border-radius:12px;">
                            <div style="font-size: 0.75rem; font-weight:700; color:var(--muted);">LIFETIME ISSUES</div>
                            <div style="font-family:'Outfit'; font-size:1.75rem; font-weight:800; color:var(--lp); margin: 4px 0;"><%= total_issued %></div>
                            <span style="font-size:0.68rem; color:var(--muted); font-weight:600;">Total lifetime checkouts</span>
                        </div>
                        <div style="background:var(--bg); border:1px solid var(--border); padding: 1.25rem; border-radius:12px;">
                            <div style="font-size: 0.75rem; font-weight:700; color:var(--muted);">LIFETIME RETURNS</div>
                            <div style="font-family:'Outfit'; font-size:1.75rem; font-weight:800; color:var(--lg); margin: 4px 0;"><%= total_returned %></div>
                            <span style="font-size:0.68rem; color:var(--muted); font-weight:600;">Total lifetime completions</span>
                        </div>
                        <div style="background:var(--bg); border:1px solid var(--border); padding: 1.25rem; border-radius:12px;">
                            <div style="font-size: 0.75rem; font-weight:700; color:var(--muted);">LIFETIME TRANSACTIONS</div>
                            <div style="font-family:'Outfit'; font-size:1.75rem; font-weight:800; color:var(--lb); margin: 4px 0;"><%= total_issued + total_returned %></div>
                            <span style="font-size:0.68rem; color:var(--muted); font-weight:600;">Combined library transactions</span>
                        </div>
                    </div>

                    <div style="display: flex; gap: 10px; margin-top: 0.5rem; flex-wrap: wrap;">
                        <a href="/admin?export=txt" class="ld-btn-alt">📄 Export Text Summary</a>
                        <a href="/admin?export=csv" class="ld-btn-alt">📊 Export CSV Report</a>
                    </div>
                </div>

                <div class="ld-grid-2">
                    <!-- CSV Excel Import/Export Box -->
                    <div class="ld-panel">
                        <h3 class="ld-panel-title">1. Import CSV Data</h3>
                        <p style="font-size: 0.72rem; color: var(--muted); margin-top: -8px;">Select target table && upload CSV/Excel files.</p>
                        
                        <div class="ld-form-group">
                            <label>Import Target</label>
                            <select id="importModule" class="ld-select">
                                <option value="books">Books</option>
                                <option value="students">Students</option>
                                <option value="librarians">Librarians</option>
                            </select>
                        </div>
                        
                        <div class="ld-form-group">
                            <label>Choose File</label>
                            <input type="file" id="importFile" accept=".csv, .xlsx" style="font-size:0.8rem;">
                        </div>

                        <% if (typeof school_perms !== 'undefined' && school_perms && school_perms.canImportCSV) { %>
                            <button onclick="handleImport()" class="ld-btn" style="justify-content:center;">Upload & Import</button>
                        <% } else { %>
                            <button onclick="alert('Upgrade to BASIC plan to import files')" class="ld-btn" style="background:var(--border); color:var(--muted); cursor:not-allowed; justify-content:center;">🔒 Upload & Import (BASIC required)</button>
                        <% } %>
                        <div id="importResult" style="font-size: 0.75rem; font-weight: 600; margin-top: 5px;"></div>
                    </div>

                    <div class="ld-panel">
                        <h3 class="ld-panel-title">2. Export Core Tables</h3>
                        <p style="font-size: 0.72rem; color: var(--muted); margin-top: -8px;">Export database tables directly into spreadsheets.</p>
                        
                        <div class="ld-form-group">
                            <label>Export Target</label>
                            <select id="exportModule" class="ld-select">
                                <option value="books">Books</option>
                                <option value="students">Students</option>
                                <option value="transactions">Transactions</option>
                                <option value="librarians">Librarians</option>
                            </select>
                        </div>
                        
                        <div class="ld-form-group">
                            <label>Format</label>
                            <select id="exportFormat" class="ld-select">
                                <option value="csv">CSV (.csv)</option>
                                <option value="xlsx">Excel (.xlsx)</option>
                            </select>
                        </div>

                        <% if (typeof school_perms !== 'undefined' && school_perms && school_perms.canExportCSV) { %>
                            <button onclick="handleExport()" class="ld-btn-alt" style="justify-content:center;">Download spreadsheet</button>
                        <% } else { %>
                            <button onclick="alert('Upgrade to BASIC plan to export files')" class="ld-btn-alt" style="border-color:var(--border); color:var(--muted); cursor:not-allowed; justify-content:center;">🔒 Download Export (BASIC required)</button>
                        <% } %>
                    </div>
                </div>

                <!-- Template Download Panel -->
                <div class="ld-panel">
                    <h3 class="ld-panel-title">Data Spreadsheets Templates</h3>
                    <p style="font-size: 0.72rem; color: var(--muted); margin-top: -8px;">Download empty formatted CSV templates for correct import mapping.</p>
                    <div style="display: flex; gap: 10px; flex-wrap: wrap; margin-top: 10px;">
                        <a href="/data/template/books" class="ld-btn-alt" style="font-size:0.75rem;">Books Template</a>
                        <a href="/data/template/students" class="ld-btn-alt" style="font-size:0.75rem;">Students Template</a>
                        <a href="/data/template/librarians" class="ld-btn-alt" style="font-size:0.75rem;">Librarians Template</a>
                    </div>
                </div>
            </div>

        </div><!-- end ld-content -->

        <!-- Mobile Bottom Nav -->
        <nav class="ld-bottom-nav">
            <button class="ld-bnav-item active tab-btn" onclick="switchTab('dashboard', this)">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                <span>Dashboard</span>
            </button>
            <button class="ld-bnav-item tab-btn" onclick="switchTab('books', this)">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                <span>Books</span>
            </button>
            <button class="ld-bnav-item tab-btn" onclick="switchTab('members', this)">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                <span>Members</span>
            </button>
            <button class="ld-bnav-item tab-btn" onclick="switchTab('transactions', this)">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
                <span>Activity</span>
            </button>
        </nav>

    </div><!-- end ld-main -->
</div><!-- end ld-shell -->

<!-- ══ MODALS ══ -->

<!-- Admin Book Info Modal (replaces student book page view) -->
<div id="adminBookInfoModal" class="ld-modal-overlay" style="display:none;" onclick="if(event.target===this)document.getElementById('adminBookInfoModal').style.display='none'">
    <div class="ld-modal-content" style="max-width:480px; padding:0; overflow:hidden; border-radius:20px;">
        <div style="background: linear-gradient(135deg, var(--lp), #7c3aed); padding: 1.5rem; display:flex; gap:1rem; align-items:center;">
            <img id="abiCover" src="" alt="cover" style="width:60px;height:80px;object-fit:cover;border-radius:10px;box-shadow:0 4px 16px rgba(0,0,0,0.3);flex-shrink:0;" onerror="this.style.display='none'">
            <div style="flex:1; min-width:0;">
                <div id="abiTitle" style="color:white;font-family:'Outfit';font-weight:800;font-size:1.1rem;line-height:1.3;word-break:break-word;"></div>
                <div id="abiAuthor" style="color:rgba(255,255,255,0.75);font-size:0.8rem;margin-top:4px;"></div>
            </div>
            <button onclick="document.getElementById('adminBookInfoModal').style.display='none'" style="background:rgba(255,255,255,0.2);border:none;color:white;width:32px;height:32px;border-radius:50%;cursor:pointer;font-size:1rem;align-self:flex-start;flex-shrink:0;">✕</button>
        </div>
        <div style="padding:1.25rem; display:flex; flex-direction:column; gap:0.75rem;">
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem;">
                <div style="background:var(--bg);border-radius:12px;padding:0.75rem;">
                    <div style="font-size:0.67rem;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:4px;">Barcode ID</div>
                    <div id="abiBarcode" style="font-size:0.9rem;font-weight:700;color:var(--text);font-family:monospace;"></div>
                </div>
                <div style="background:var(--bg);border-radius:12px;padding:0.75rem;">
                    <div style="font-size:0.67rem;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:4px;">Copies</div>
                    <div id="abiCopies" style="font-size:0.9rem;font-weight:700;color:var(--text);"></div>
                </div>
            </div>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem; margin-top:0.25rem;">
                <button onclick="document.getElementById('adminBookInfoModal').style.display='none'; bamEdit();" style="background:var(--lp-light);border:2px solid var(--lp);border-radius:12px;padding:0.75rem;cursor:pointer;font-weight:700;font-size:0.82rem;color:var(--lp);font-family:'Plus Jakarta Sans',sans-serif;">✏️ Edit Book</button>
                <button onclick="document.getElementById('adminBookInfoModal').style.display='none'; bamIssue();" style="background:#fff7ed;border:2px solid #f97316;border-radius:12px;padding:0.75rem;cursor:pointer;font-weight:700;font-size:0.82rem;color:#f97316;font-family:'Plus Jakarta Sans',sans-serif;">📤 Issue Book</button>
            </div>
        </div>
    </div>
</div>

<!-- Add User Modal -->
<div id="addUserModal" class="ld-modal-overlay">
    <div class="ld-modal-content">
        <button class="ld-modal-close" onclick="closeModal('addUserModal')">✕</button>
        <h3 class="ld-modal-title">👤 Register Member / Staff</h3>
        
        <form action="/admin/student/add" method="POST">
            <div class="ld-form-group">
                <label>Full Name</label>
                <input type="text" name="name" class="ld-input" required placeholder="e.g. Rahul Sharma">
            </div>
            <div class="ld-form-group">
                <label>Email Address</label>
                <input type="email" name="reqEmail" class="ld-input" required placeholder="e.g. name@gmail.com">
            </div>
            <div class="ld-form-group">
                <label>Phone Number (Login ID)</label>
                <input type="text" name="phone" class="ld-input" required placeholder="e.g. 9876543210">
            </div>
            <div class="ld-form-group">
                <label>Password</label>
                <input type="text" name="password" class="ld-input" required value="userpass">
            </div>
            <div class="ld-form-group">
                <label>User Role</label>
                <select name="role" id="addUserRole" class="ld-select" onchange="toggleAddUserClassField()">
                    <option value="student">Student</option>
                    <option value="admin">Admin / Librarian</option>
                </select>
            </div>
            <div class="ld-form-group">
                <label>Library School Code</label>
                <input type="text" name="school_code" readonly value="<%= (session.school_code || '') %>" class="ld-input" style="opacity: 0.7;">
            </div>
            
            <!-- Student Specific Fields -->
            <div id="addUserClassGroup" style="display:block;">
                <div class="ld-form-group">
                    <label>Class Grade</label>
                    <input type="number" name="class" min="1" max="12" class="ld-input" placeholder="e.g. 10">
                </div>
            </div>
            <div id="addUserAdmissionGroup" style="display:block;">
                <div class="ld-form-group">
                    <label>Admission No / Student ID</label>
                    <input type="text" name="admission_no" class="ld-input" placeholder="e.g. SCH7890">
                </div>
            </div>

            <button type="submit" class="ld-btn" style="width: 100%; justify-content: center; margin-top: 1rem; padding: 12px;">Register Account</button>
        </form>
    </div>
</div>

<!-- View User Modal -->
<div id="viewUserModal" class="ld-modal-overlay">
    <div class="ld-modal-content" style="max-width: 450px;">
        <button class="ld-modal-close" onclick="closeModal('viewUserModal')">✕</button>
        <h3 class="ld-modal-title">👤 Member Profile Card</h3>
        
        <div style="display: grid; grid-template-columns: 1fr; gap: 12px; font-size: 0.88rem;">
