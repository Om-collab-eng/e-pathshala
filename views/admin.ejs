    // ─────────────────────────────────────────────────────────────────
    // Book Registration & Scanning (Single & Bulk Queue)
    // ─────────────────────────────────────────────────────────────────
    function switchAddBookMode(mode) {
      const vSingle = document.getElementById('viewSingleBook');
      const vBulk = document.getElementById('viewBulkBook');
      const bSingle = document.getElementById('btnModeSingle');
      const bBulk = document.getElementById('btnModeBulk');
      if (mode === 'single') {
        if (vSingle) vSingle.style.display = 'block';
        if (vBulk) vBulk.style.display = 'none';
        if (bSingle) bSingle.classList.add('active');
        if (bBulk) bBulk.classList.remove('active');
      } else {
        if (vSingle) vSingle.style.display = 'none';
        if (vBulk) vBulk.style.display = 'block';
        if (bSingle) bSingle.classList.remove('active');
        if (bBulk) bBulk.classList.add('active');
        const input = document.getElementById('bulkScannerInput');
        if (input) setTimeout(() => input.focus(), 100);
      }
    }

    async function lookupSingleBookMetadata() {
      const query = (document.getElementById('singleLookupInput')?.value || '').trim();
      const statusEl = document.getElementById('singleLookupStatus');
      const dupAlert = document.getElementById('singleDuplicateAlert');
      const acqAlert = document.getElementById('singleAcquisitionAlert');

      if (!query) {
        if (statusEl) {
          statusEl.style.display = 'block';
          statusEl.style.color = '#DC2626';
          statusEl.textContent = 'Please enter an ISBN or book title.';
        }
        return;
      }

      if (statusEl) {
        statusEl.style.display = 'block';
        statusEl.style.color = '#4F46E5';
        statusEl.textContent = '🔍 Querying Google Books & OpenLibrary...';
      }
      if (dupAlert) dupAlert.style.display = 'none';
      if (acqAlert) acqAlert.style.display = 'none';

      try {
        const res = await fetch(`/admin/api/books/lookup?isbn=${encodeURIComponent(query)}`);
        const data = await res.json();
        if (!data.success) {
          if (statusEl) {
            statusEl.style.color = '#D97706';
            statusEl.textContent = 'No web metadata found. You can fill details manually.';
          }
          return;
        }

        const b = data.book || {};
        if (b.title) document.getElementById('sbTitle').value = b.title;
        if (b.author) document.getElementById('sbAuthor').value = b.author;
        if (b.genre) document.getElementById('sbGenre').value = b.genre;
        if (b.isbn) document.getElementById('sbIsbn').value = b.isbn;
        if (b.description) document.getElementById('sbDescription').value = b.description;

        if (b.cover_url) {
          document.getElementById('singleCoverUrl').value = b.cover_url;
          const fImg = document.getElementById('frontCoverImg');
          const fPh = document.getElementById('frontCoverPlaceholder');
          const fClr = document.getElementById('btnFrontClear');
          if (fImg && fPh) {
            fImg.src = b.cover_url;
            fImg.style.display = 'block';
            fPh.style.display = 'none';
            if (fClr) fClr.style.display = 'inline-block';
          }
        }

        if (statusEl) {
          statusEl.style.color = '#16A34A';
          statusEl.textContent = `✓ Found metadata from ${b.source || 'Web Repository'}`;
        }

        if (data.duplicate) {
          const dup = data.duplicate;
          if (dupAlert) {
            dupAlert.innerHTML = `⚠️ <strong>Duplicate Title Detected:</strong> "${escapeHtml(dup.title)}" is already in your library catalog (${dup.total_copies} total copies). Registering will increase copy inventory.`;
            dupAlert.style.display = 'block';
          }
        }

        if (data.acquisition_match) {
          const acq = data.acquisition_match;
          document.getElementById('singleAcqItemId').value = acq.item_id || '';
          if (acqAlert) {
            acqAlert.innerHTML = `📦 <strong>Invoice Match:</strong> Linked to purchase invoice #${acq.invoice_number || acq.acquisition_id} from ${escapeHtml(acq.vendor_name || 'Vendor')} (Expected ${acq.expected_copies}, Registered ${acq.registered_copies}).`;
            acqAlert.style.display = 'block';
          }
        }
      } catch (err) {
        if (statusEl) {
          statusEl.style.color = '#DC2626';
          statusEl.textContent = 'Error querying metadata service.';
        }
      }
    }

    function handleCoverUpload(event, type) {
      const file = event.target.files && event.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function(e) {
        const dataUrl = e.target.result;
        if (type === 'front') {
          document.getElementById('singleCoverUrl').value = dataUrl;
          const img = document.getElementById('frontCoverImg');
          const ph = document.getElementById('frontCoverPlaceholder');
          const clr = document.getElementById('btnFrontClear');
          if (img) { img.src = dataUrl; img.style.display = 'block'; }
          if (ph) ph.style.display = 'none';
          if (clr) clr.style.display = 'inline-block';
        } else {
          document.getElementById('singleBackCoverUrl').value = dataUrl;
          const img = document.getElementById('backCoverImg');
          const ph = document.getElementById('backCoverPlaceholder');
          const clr = document.getElementById('btnBackClear');
          if (img) { img.src = dataUrl; img.style.display = 'block'; }
          if (ph) ph.style.display = 'none';
          if (clr) clr.style.display = 'inline-block';
        }
      };
      reader.readAsDataURL(file);
    }

    function captureCameraPhoto(type) {
      const camInput = document.createElement('input');
      camInput.type = 'file';
      camInput.accept = 'image/*';
      camInput.capture = 'environment';
      camInput.onchange = (e) => handleCoverUpload(e, type);
      camInput.click();
    }

    function clearCoverPhoto(type) {
      if (type === 'front') {
        document.getElementById('singleCoverUrl').value = '';
        const img = document.getElementById('frontCoverImg');
        const ph = document.getElementById('frontCoverPlaceholder');
        const clr = document.getElementById('btnFrontClear');
        if (img) { img.src = ''; img.style.display = 'none'; }
        if (ph) ph.style.display = 'block';
        if (clr) clr.style.display = 'none';
      } else {
        document.getElementById('singleBackCoverUrl').value = '';
        const img = document.getElementById('backCoverImg');
        const ph = document.getElementById('backCoverPlaceholder');
        const clr = document.getElementById('btnBackClear');
        if (img) { img.src = ''; img.style.display = 'none'; }
        if (ph) ph.style.display = 'block';
        if (clr) clr.style.display = 'none';
      }
    }

    async function submitSingleBookForm(e) {
      e.preventDefault();
      const btn = document.getElementById('btnSubmitSingleBook');
      if (btn) { btn.disabled = true; btn.textContent = 'Saving to Catalog...'; }

      const payload = {
        title: document.getElementById('sbTitle').value.trim(),
        author: document.getElementById('sbAuthor').value.trim(),
        genre: document.getElementById('sbGenre').value.trim(),
        isbn: document.getElementById('sbIsbn').value.trim(),
        total_copies: parseInt(document.getElementById('sbCopies').value, 10) || 1,
        rack: document.getElementById('sbRack').value.trim() || 'A',
        shelf: document.getElementById('sbShelf').value.trim() || '1',
        description: document.getElementById('sbDescription').value.trim(),
        cover_url: document.getElementById('singleCoverUrl').value.trim(),
        back_cover_url: document.getElementById('singleBackCoverUrl').value.trim(),
        acquisition_item_id: document.getElementById('singleAcqItemId').value.trim()
      };

      try {
        const res = await fetch('/admin/book/add', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.success) {
          alert(`✓ Book "${payload.title}" registered successfully!`);
          closeModal('addBookModal');
          window.location.reload();
        } else {
          alert(data.error || 'Failed to register book.');
