    function filterCatalogTable(q) {
      const query = (q || '').trim().toLowerCase();
      const barcodeFilter = document.getElementById('catalogBarcodeFilter')?.value || 'all';
      const rows = document.querySelectorAll('#catalogTable tbody tr.book-group-row');

      rows.forEach(r => {
        const text = r.textContent.toLowerCase();
        const bookId = r.id.replace('book-group-row-', '');
        const treeRow = document.getElementById(`copies-group-${bookId}`);
        const treeText = treeRow ? treeRow.textContent.toLowerCase() : '';

        const hasUnprinted = r.getAttribute('data-has-unprinted') === '1';
        const hasPrinted = r.getAttribute('data-has-printed') === '1';

        let barcodeMatch = true;
        if (barcodeFilter === 'not_printed') barcodeMatch = hasUnprinted;
        else if (barcodeFilter === 'printed') barcodeMatch = hasPrinted;

        const isMatch = barcodeMatch && (!query || text.includes(query) || treeText.includes(query));
        r.style.display = isMatch ? '' : 'none';

        if (treeRow) {
          if (!query && barcodeFilter === 'all') {
            treeRow.style.display = 'none';
            const btn = document.getElementById(`btn-toggle-tree-${bookId}`);
            if (btn) btn.textContent = '▶';
          } else if (isMatch && (barcodeFilter !== 'all' || treeText.includes(query) || query.length >= 6)) {
            // Auto-expand tree and filter inner copy rows if barcode filter is active
            treeRow.style.display = 'table-row';
            const btn = document.getElementById(`btn-toggle-tree-${bookId}`);
            if (btn) btn.textContent = '▼';

            if (barcodeFilter !== 'all') {
              const copyRows = treeRow.querySelectorAll('.physical-copy-item');
              copyRows.forEach(cr => {
                const isCpPrinted = cr.getAttribute('data-printed') === '1';
                if (barcodeFilter === 'not_printed') cr.style.display = !isCpPrinted ? '' : 'none';
                else if (barcodeFilter === 'printed') cr.style.display = isCpPrinted ? '' : 'none';
              });
            }
          } else {
            treeRow.style.display = 'none';
          }
        }
      });
    }

    function filterMemberTable(q) {
      const rows = document.querySelectorAll('#membersTable tbody tr');
      rows.forEach(r => {
        r.style.display = r.textContent.toLowerCase().includes(q.toLowerCase()) ? '' : 'none';
