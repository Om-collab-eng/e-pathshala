    async function sendAiMessage() {
      const input = document.getElementById('lpAiInput');
      const msg = input.value.trim();
      if (!msg) return;

      const body = document.getElementById('lpAiChatBody');
      const userBubble = document.createElement('div');
      userBubble.className = 'lp-ai-msg user';
      userBubble.textContent = msg;
      body.appendChild(userBubble);
      input.value = '';

      const botBubble = document.createElement('div');
      botBubble.className = 'lp-ai-msg bot';
      botBubble.innerHTML = '<em>Thinking...</em>';
      body.appendChild(botBubble);
      body.scrollTop = body.scrollHeight;

      try {
        const res = await fetch('/admin/api/ai/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message: msg })
        });
        const data = await res.json();
        botBubble.innerHTML = data.reply.replace(/\n/g, '<br>').replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
        body.scrollTop = body.scrollHeight;
      } catch (e) {
        botBubble.textContent = 'Sorry, could not process request right now.';
      }
    }

