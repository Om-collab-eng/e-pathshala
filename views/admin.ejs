    async function openEditBookModalFull(bookId) {
      if (!bookId) return;
      let book = (window.CATALOG_BOOKS_DATA || []).find(b => String(b.id) === String(bookId));
      if (!book || !book.summary) {
        try {
          const res = await fetch(`/admin/api/books/${encodeURIComponent(bookId)}`);
          const data = await res.json();
          if (data.success && data.book) book = data.book;
        } catch (e) {}
      }

      document.getElementById('ebId').value = book ? book.id : bookId;
      document.getElementById('ebTitle').value = book ? (book.title || '') : '';
      document.getElementById('ebAuthor').value = book ? (book.author || '') : '';
      document.getElementById('ebIsbn').value = book ? (book.isbn || '') : '';
      document.getElementById('ebPublisher').value = book ? (book.publisher || '') : '';
      document.getElementById('ebEdition').value = book ? (book.edition || '') : '';
      document.getElementById('ebYear').value = book ? (book.publication_year || '') : '';
      document.getElementById('ebLanguage').value = book ? (book.language || 'English') : 'English';
      document.getElementById('ebCategory').value = book ? (book.category || book.genre || book.subject || '') : '';
      document.getElementById('ebCopies').value = book ? (book.total_copies || 1) : 1;
      document.getElementById('ebLocation').value = book ? (book.shelf_location || '') : '';
      document.getElementById('ebSummary').value = book ? (book.summary || book.synopsis || '') : '';
      document.getElementById('ebDescription').value = book ? (book.description || '') : '';

      openModal('editBookModal');
    }

