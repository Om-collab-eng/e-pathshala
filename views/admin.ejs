    function closeMemberDrawer() {
      const drawer = document.getElementById('lpMemberDrawer');
      const overlay = document.getElementById('lpDrawerOverlay');
      if (drawer) drawer.classList.remove('open');
      if (overlay) overlay.classList.remove('active');
    }

    // ─────────────────────────────────────────────────────────────────
    // AI Copilot Interactive Chat
    // ─────────────────────────────────────────────────────────────────
    function sendAiPrompt(promptText) {
      document.getElementById('lpAiInput').value = promptText;
      sendAiMessage();
    }

    async function sendAiMessage() {
      const input = document.getElementById('lpAiInput');
      const msg = input.value.trim();
      if (!msg) return;

      const body = document.getElementById('lpAiChatBody');
      const userBubble = document.createElement('div');
      userBubble.className = 'lp-ai-msg user';
      userBubble.textContent = msg;
      body.appendChild(userBubble);
      input.value = '';

      const botBubble = document.createElement('div');
      botBubble.className = 'lp-ai-msg bot';
      botBubble.innerHTML = '<em>Thinking...</em>';
      body.appendChild(botBubble);
      body.scrollTop = body.scrollHeight;

      try {
        const res = await fetch('/admin/api/ai/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message: msg })
        });
        const data = await res.json();
        botBubble.innerHTML = data.reply.replace(/\n/g, '<br>').replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
        body.scrollTop = body.scrollHeight;
      } catch (e) {
        botBubble.textContent = 'Sorry, could not process request right now.';
      }
    }

    // ─────────────────────────────────────────────────────────────────
    // Studio & Jitsi Live Meeting Actions
    // ─────────────────────────────────────────────────────────────────
    function switchStudioTab(tabId, btn) {
      document.querySelectorAll('.studio-tab-pane').forEach(el => el.style.display = 'none');
      document.querySelectorAll('.lp-tabs-bar .lp-tab-btn').forEach(b => {
        if (b.id && b.id.startsWith('btn-tab-studio-')) b.classList.remove('active');
      });
      const targetPane = document.getElementById('studio-tab-' + tabId);
      if (targetPane) targetPane.style.display = 'block';
      if (btn) btn.classList.add('active');
    }

    function copyStudioLink(mCode, mId) {
      const roomSlug = mId || mCode;
      const url = `${window.location.origin}/studio/meeting/${encodeURIComponent(roomSlug)}`;
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(url).then(() => {
          alert(`📋 Join link copied to clipboard!\n\nLink: ${url}\nMeeting Code: ${mCode}`);
        }).catch(() => {
          prompt('Copy this meeting link:', url);
        });
      } else {
        prompt('Copy this meeting link:', url);
      }
    }

    async function endStudioMeeting(id) {
      if (!confirm('Are you sure you want to end this live meeting for all participants?')) return;
      try {
        const res = await fetch(`/api/studio/meetings/${id}/end`, { method: 'POST' });
        const data = await res.json();
        if (data.success) {
          alert('Live meeting ended successfully.');
          window.location.href = '/admin?module=studio';
        } else {
          alert('Failed to end meeting: ' + (data.message || 'Error'));
        }
      } catch (err) {
        alert('Error ending meeting: ' + err.message);
      }
    }

    async function deleteStudioMeeting(id) {
      if (!confirm('Are you sure you want to cancel and delete this scheduled meeting?')) return;
      try {
        const res = await fetch(`/api/studio/meetings/${id}`, { method: 'DELETE' });
        const data = await res.json();
        if (data.success) {
          alert('Meeting deleted.');
          window.location.href = '/admin?module=studio';
        } else {
          alert('Failed to delete: ' + (data.message || 'Error'));
        }
      } catch (err) {
        alert('Error: ' + err.message);
      }
    }

    async function submitScheduleStudioMeeting(e) {
      e.preventDefault();
      const title = document.getElementById('studioMeetingTitle').value.trim();
      const className = document.getElementById('studioMeetingClass').value.trim();
      const scheduledStart = document.getElementById('studioMeetingStart').value;
      const durationMinutes = parseInt(document.getElementById('studioMeetingDuration').value, 10) || 60;
      const description = document.getElementById('studioMeetingDesc').value.trim();

      if (!title || !scheduledStart) {
        alert('Please provide meeting title and start date/time');
        return;
      }

      try {
        const res = await fetch('/api/studio/meetings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            title,
            className,
            scheduledStart,
            durationMinutes,
            description
          })
        });
        const data = await res.json();
        if (data.success) {
          alert(`✅ Meeting scheduled successfully!\n\nMeeting Code: ${data.meeting.meetingCode}\nHost: ${data.meeting.hostName}`);
          closeModal('scheduleStudioModal');
          window.location.href = '/admin?module=studio';
        } else {
          alert('Failed to schedule meeting: ' + (data.message || 'Unknown error'));
        }
      } catch (err) {
        alert('Network error: ' + err.message);
      }
    }

    // ─────────────────────────────────────────────────────────────────
    // Reservations & Moderation Actions
    // ─────────────────────────────────────────────────────────────────
    async function approveReservation(resId) {
      const res = await fetch(`/admin/api/reservation/${resId}/approve`, { method: 'POST' });
      const data = await res.json();
      if (data.status === 'success') { alert('Reservation approved and copy allocated!'); window.location.reload(); }
      else alert(data.message);
    }

    async function rejectReservation(resId) {
      const res = await fetch(`/admin/api/reservation/${resId}/reject`, { method: 'POST' });
      const data = await res.json();
      if (data.status === 'success') { alert('Reservation rejected.'); window.location.reload(); }
      else alert(data.message);
    }

    async function approveReview(id) {
      await fetch(`/admin/api/review/${id}/approve`, { method: 'POST' });
      alert('Review approved for public display!');
      window.location.reload();
    }

    async function rejectReview(id) {
      await fetch(`/admin/api/review/${id}/reject`, { method: 'POST' });
      alert('Review rejected.');
      window.location.reload();
    }

