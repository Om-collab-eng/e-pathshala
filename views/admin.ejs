    async function saveMemberProfile(e, userId) {
      e.preventDefault();
      const payload = {
        name: document.getElementById('editMemName')?.value || '',
        role: document.getElementById('editMemRole')?.value || 'student',
        admission_no: document.getElementById('editMemAdmission')?.value || '',
        class: document.getElementById('editMemClass')?.value || '',
        section: document.getElementById('editMemSection')?.value || '',
        phone: document.getElementById('editMemPhone')?.value || '',
        student_id: document.getElementById('editMemStudentId')?.value || '',
        email: document.getElementById('editMemEmail')?.value || ''
      };

      try {
        const res = await fetch(`/admin/api/member/${userId}/update`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const d = await res.json();
        if (d.success) {
          alert('Member profile updated successfully!');
          // Re-fetch and re-render drawer
          await openMemberDrawer(userId);
          // Also optionally reload or update table row if visible
        } else {
          alert(d.error || 'Failed to update member profile');
        }
      } catch (err) {
        alert('Error saving member profile: ' + err.message);
      }
    }

    async function toggleMemberStatus(userId, shouldSuspend) {
      const action = shouldSuspend ? 'suspend' : 'unsuspend';
      if (!confirm(`Are you sure you want to ${action} this account?`)) return;
      try {
        const res = await fetch(`/admin/api/member/${userId}/toggle-status`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ suspend: shouldSuspend })
        });
        const d = await res.json();
        if (d.success) {
          alert(`Account has been ${shouldSuspend ? 'suspended' : 'activated'} successfully.`);
          openMemberDrawer(userId);
          const badge = document.getElementById(`member-status-${userId}`);
          if (badge) {
            badge.className = `lp-status-pill ${shouldSuspend ? 'overdue' : 'available'}`;
            badge.textContent = shouldSuspend ? 'Suspended' : 'Active';
          }
        } else {
          alert(d.error || 'Failed to update member status');
        }
      } catch (e) {
        alert('Network error while updating status');
      }
    }

