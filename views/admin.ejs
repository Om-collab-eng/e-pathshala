    async function viewPhysicalCopyDetails(copyId, barcode) {
      try {
        const res = await fetch(`/admin/api/copy/lookup/${encodeURIComponent(barcode || copyId)}`);
        const data = await res.json();
        if (!data.success || !data.result) {
          alert(data.error || 'Copy details not found.');
          return;
        }

        const item = data.result;
        const copy = item.copy || {};
        const book = item.book || {};

        document.getElementById('bcdModalHeading').textContent = `Physical Copy: ${copy.copy_number ? 'Copy #' + copy.copy_number : copy.id}`;
        document.getElementById('bcdBookTitle').textContent = book.title || 'Untitled Book';
        document.getElementById('bcdBookAuthor').textContent = book.author ? ('by ' + book.author) : 'Unknown Author';
        document.getElementById('bcdBookIsbn').textContent = book.isbn ? ('ISBN ' + book.isbn) : 'No ISBN';
        document.getElementById('bcdBookEdition').textContent = book.edition || '1st Edition';
        document.getElementById('bcdBookSubject').textContent = book.subject || 'General';

        const coverImg = document.getElementById('bcdBookCoverImg');
        const coverEmpty = document.getElementById('bcdBookCoverEmpty');
        if (coverImg && book.cover_url) {
          coverImg.src = book.cover_url;
          coverImg.style.display = 'block';
          if (coverEmpty) coverEmpty.style.display = 'none';
        } else if (coverEmpty) {
          coverEmpty.style.display = 'block';
          if (coverImg) coverImg.style.display = 'none';
        }

        document.getElementById('bcdCopyIdBadge').textContent = copy.id || '';
        document.getElementById('bcdBarcodeText').textContent = copy.barcode || '';
        document.getElementById('bcdBarcodeImg').src = `/admin/api/barcode/${encodeURIComponent(copy.barcode || '')}`;

        document.getElementById('bcdCopyId').value = copy.id || '';
        document.getElementById('bcdCopyBarcode').value = copy.barcode || '';
        document.getElementById('bcdRack').value = copy.rack || 'A';
        document.getElementById('bcdShelf').value = copy.shelf || '1';
        document.getElementById('bcdStatus').value = (copy.status || copy.availability_status || 'AVAILABLE').toUpperCase();
        document.getElementById('bcdCondition').value = (copy.condition_status || 'GOOD').toUpperCase();

        document.getElementById('bcdAddedDate').textContent = copy.added_date ? new Date(copy.added_date).toLocaleDateString() : 'Recent';
        document.getElementById('bcdAddedBy').textContent = copy.added_by || 'Librarian';

        openModal('bookCopyDetailModal');
      } catch (err) {
        alert('Network error while retrieving physical copy details.');
      }
    }

