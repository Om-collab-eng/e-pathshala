    function handleReturnMemberSearchInput(val) {
      clearTimeout(returnMemberSearchDebounceTimer);
      returnMemberSearchDebounceTimer = setTimeout(() => {
        searchMembersForReturn(val);
      }, 250);
    }

    async function searchMembersForReturn(queryOverride) {
      const q = (queryOverride !== undefined ? queryOverride : (document.getElementById('circReturnMemberInput')?.value || '')).trim();
      const dd = document.getElementById('circReturnMemberDropdown');
      if (!dd) return;

      try {
        const res = await fetch('/admin/api/circulation/search-students', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ query: q })
        });
        const data = await res.json();

        if (data.status === 'success' && data.students && data.students.length > 0) {
          dd.style.display = 'block';
          dd.innerHTML = data.students.map(s => {
            const avatarChar = (s.name && s.name[0]) ? s.name[0].toUpperCase() : 'S';
            const borrowedBadge = s.active_count > 0 
              ? `<span class="lp-search-badge" style="background:#EFF6FF;color:#0B5ED7;font-weight:800;">${s.active_count} Borrowed Books</span>`
              : `<span class="lp-search-badge" style="background:#F1F5F9;color:#64748B;">0 Books Borrowed</span>`;
            const fineBadge = s.total_fines > 0 
              ? `<span class="lp-search-badge fine-warning">Fine: ₹${s.total_fines}</span>` 
              : '';

            return `
              <div class="lp-search-item" onclick="selectMemberForReturn(${JSON.stringify(s).replace(/"/g, '&quot;')})">
                <div class="lp-search-item-avatar">${avatarChar}</div>
                <div class="lp-search-item-info">
                  <div class="lp-search-item-title">${escapeHtml(s.name)}</div>
                  <div class="lp-search-item-sub">
                    <span class="lp-search-badge role">${escapeHtml(s.role || 'student')}</span>
                    ${s.admission_no ? `<span>Adm: <strong>${escapeHtml(s.admission_no)}</strong></span>` : ''}
                    ${s.class ? `<span>Class: <strong>${escapeHtml(s.class)}${s.section ? ' (' + escapeHtml(s.section) + ')' : ''}</strong></span>` : ''}
                    ${s.phone ? `<span>📞 ${escapeHtml(s.phone)}</span>` : ''}
                  </div>
                </div>
                <div style="display:flex;flex-direction:column;align-items:flex-end;gap:4px;">
                  ${borrowedBadge}
                  ${fineBadge}
                </div>
              </div>
            `;
          }).join('');
        } else if (data.status === 'error') {
          dd.style.display = 'block';
          dd.innerHTML = `
            <div style="padding:14px;text-align:center;color:#DC2626;font-size:0.85rem;background:#FEF2F2;">
              ⚠️ Search error: ${escapeHtml(data.message || 'Server error')}
            </div>
          `;
        } else {
          dd.style.display = 'block';
          dd.innerHTML = `
            <div style="padding:16px;text-align:center;color:#64748B;font-size:0.85rem;">
              No students found matching "<strong>${escapeHtml(q)}</strong>".
            </div>
          `;
        }
      } catch (e) {
        console.error('Return member search error:', e);
        dd.style.display = 'block';
        dd.innerHTML = `
          <div style="padding:14px;text-align:center;color:#DC2626;font-size:0.85rem;background:#FEF2F2;">
            ⚠️ Network error searching students. Please try again.
          </div>
        `;
      }
    }

