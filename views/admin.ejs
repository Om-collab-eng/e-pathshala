    function exportStudentProgressCSV() {
      const rows = Array.from(document.querySelectorAll('#spTableBody .sp-row')).filter(r => r.style.display !== 'none');
      if (rows.length === 0) {
        alert('No records available to export.');
        return;
      }
      let csv = 'Student Name,Class,Phone,Item Title,Item Type,Category,Status,Progress,Assigned Date,Due Date\n';
      rows.forEach(r => {
        const student = (r.getAttribute('data-raw-student') || '').replace(/"/g, '""');
        const sClass = (r.getAttribute('data-raw-class') || '').replace(/"/g, '""');
        const phone = (r.getAttribute('data-raw-phone') || '').replace(/"/g, '""');
        const item = (r.getAttribute('data-raw-item') || '').replace(/"/g, '""');
        const type = (r.getAttribute('data-raw-type') || '').replace(/"/g, '""');
        const cat = (r.getAttribute('data-category') || '').replace(/"/g, '""');
        const status = (r.getAttribute('data-status') || '').replace(/"/g, '""');
        const progress = (r.getAttribute('data-raw-progress') || '').replace(/"/g, '""');
        const assigned = (r.getAttribute('data-raw-assigned') || '').replace(/"/g, '""');
        const due = (r.getAttribute('data-raw-due') || '').replace(/"/g, '""');
        csv += `"${student}","${sClass}","${phone}","${item}","${type}","${cat}","${status}","${progress}","${assigned}","${due}"\n`;
      });

      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const link = document.createElement('a');
      link.href = URL.createObjectURL(blob);
      link.setAttribute('download', `student_learning_progress_${new Date().toISOString().slice(0, 10)}.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }

