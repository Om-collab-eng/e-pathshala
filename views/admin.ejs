<%- layout('base') %>

<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
/* ═══════════════════════════════════════════════
   LIBRIKA LIBRARIAN DASHBOARD — PRISTINE SUPER ADMIN STYLE UI
   Simple, Clean, Bug-Free & 100% Mobile Responsive
═══════════════════════════════════════════════ */
*, *::before, *::after {
    box-sizing: border-box !important;
}

html, body {
    background: #f1f5f9 !important;
    background-color: #f1f5f9 !important;
    color: #0f172a !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow-x: hidden !important;
    width: 100% !important;
    max-width: 100vw !important;
    min-height: 100vh !important;
    font-family: 'Plus Jakarta Sans', sans-serif !important;
}

:root {
    --lp: #818cf8;
    --lp-mid: #6366f1;
    --lp-light: rgba(99, 102, 241, 0.15);
    --lg: #34d399;
    --lg-light: rgba(16, 185, 129, 0.15);
    --lo: #fb923c;
    --lo-light: rgba(249, 115, 22, 0.15);
    --lr: #f87171;
    --lr-light: rgba(239, 68, 68, 0.15);
    --lb: #60a5fa;
    --lb-light: rgba(59, 130, 246, 0.15);
    --bg: #f1f5f9;
    --card-bg: #ffffff;
    --sidebar-bg: #ffffff;
    --border: #e2e8f0;
    --text: #0f172a;
    --muted: #64748b;
}

/* ── LAYOUT SHELL ── */
.ld-shell {
    display: flex !important;
    min-height: 100vh !important;
    background: var(--bg) !important;
    width: 100vw !important;
    max-width: 100vw !important;
    position: relative !important;
    overflow-x: hidden !important;
}

.ld-main {
    flex: 1 !important;
    display: flex !important;
    flex-direction: column !important;
    min-height: 100vh !important;
    margin-left: 280px !important;
    width: calc(100vw - 280px) !important;
    max-width: 100vw !important;
    overflow-x: hidden !important;
    background: var(--bg) !important;
    padding-bottom: 30px !important;
}
@media (max-width: 900px) {
    .ld-main { margin-left: 0 !important; width: 100vw !important; max-width: 100vw !important; }
}

/* ── TOPBAR ── */
.ld-topbar {
    background: #ffffff !important;
    
    
    border-bottom: 1px solid var(--border) !important;
    padding: 0.85rem 1.5rem !important;
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    position: sticky !important;
    top: 0 !important;
    z-index: 100 !important;
    gap: 12px !important;
}
.ld-topbar-left { display: flex !important; align-items: center !important; gap: 12px !important; }
.ld-menu-btn {
    background: rgba(99, 102, 241, 0.06) !important;
    border: 1px solid #e2e8f0 !important;
    color: #475569 !important;
    width: 38px !important; height: 38px !important; border-radius: 10px !important;
    display: flex !important; align-items: center !important; justify-content: center !important;
    font-size: 1.1rem !important; cursor: pointer !important;
}
@media (min-width: 901px) { .ld-menu-btn { display: none !important; } }

.ld-brand-title {
    font-family: 'Outfit', sans-serif !important;
    font-size: 1.1rem !important;
    font-weight: 800 !important;
    color: #0f172a !important;
}

.ld-topbar-right { display: flex !important; align-items: center !important; gap: 10px !important; }
.ld-notif-btn {
    background: rgba(99, 102, 241, 0.06) !important;
    border: 1px solid #e2e8f0 !important;
    color: #475569 !important;
    width: 38px !important; height: 38px !important; border-radius: 50% !important;
    display: flex !important; align-items: center !important; justify-content: center !important;
    font-size: 1.1rem !important; cursor: pointer !important; position: relative !important;
}
.ld-notif-badge {
    position: absolute !important; top: -2px !important; right: -2px !important;
    background: #f87171 !important; color: white !important; font-size: 0.65rem !important;
    font-weight: 800 !important; padding: 2px 6px !important; border-radius: 10px !important;
}

/* ── SIDEBAR DRAWER ── */
.ld-sidebar {
    width: 280px !important;
    max-width: 82vw !important;
    background: var(--sidebar-bg) !important;
    border-right: 1px solid var(--border) !important;
    display: flex !important;
    flex-direction: column !important;
    position: fixed !important;
    top: 0 !important; left: 0 !important;
    height: 100vh !important; height: 100dvh !important;
    z-index: 9999 !important;
    transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1) !important;
    box-shadow: 10px 0 40px rgba(15, 23, 42, 0.08) !important;
    transform: translateX(-105%) !important;
}
@media (max-width: 900px) {
    .ld-sidebar.open { transform: translateX(0) !important; box-shadow: 20px 0 60px rgba(15, 23, 42, 0.15) !important; }
}
@media (min-width: 901px) {
    .ld-sidebar { transform: translateX(0) !important; position: sticky !important; }
}

.ld-sidebar-header {
    padding: 1.1rem 1rem !important;
    border-bottom: 1px solid var(--border) !important;
    display: flex !important; align-items: center !important; justify-content: space-between !important;
    gap: 10px !important; flex-shrink: 0 !important; background: var(--sidebar-bg) !important;
}
.ld-sidebar-user { display: flex !important; align-items: center !important; gap: 10px !important; flex: 1 !important; min-width: 0 !important; }
.ld-avatar-lg {
    width: 40px !important; height: 40px !important; border-radius: 50% !important;
    background: linear-gradient(135deg, #6366f1, #a855f7) !important; color: #ffffff !important;
    font-weight: 800 !important; font-size: 1.05rem !important; display: flex !important;
    align-items: center !important; justify-content: center !important; flex-shrink: 0 !important;
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3) !important;
}
.ld-user-meta { min-width: 0 !important; flex: 1 !important; }
.ld-user-name { margin: 0 !important; font-size: 0.9rem !important; font-weight: 800 !important; color: #0f172a !important; white-space: nowrap !important; overflow: hidden !important; text-overflow: ellipsis !important; }
.ld-user-school { margin: 1px 0 0 !important; font-size: 0.72rem !important; color: var(--muted) !important; font-weight: 600 !important; white-space: nowrap !important; overflow: hidden !important; text-overflow: ellipsis !important; }

.ld-sidebar-close {
    background: rgba(99, 102, 241, 0.08) !important; border: 1px solid #e2e8f0 !important;
    color: var(--muted) !important; width: 32px !important; height: 32px !important; border-radius: 50% !important;
    display: flex !important; align-items: center !important; justify-content: center !important;
    font-size: 0.95rem !important; cursor: pointer !important; flex-shrink: 0 !important;
}

.ld-sidebar-nav {
    flex: 1 !important; overflow-y: auto !important; padding: 0.85rem 0.75rem !important;
    display: flex !important; flex-direction: column !important; gap: 4px !important;
}

.ld-nav-item {
    display: flex !important; align-items: center !important; height: 50px !important; min-height: 50px !important;
    padding: 0 12px !important; border-radius: 12px !important; color: var(--muted) !important;
    font-size: 0.88rem !important; font-weight: 600 !important; text-decoration: none !important;
    background: transparent !important; border: none !important; border-left: 3.5px solid transparent !important;
    width: 100% !important; cursor: pointer !important; transition: all 0.2s ease !important;
    box-sizing: border-box !important; white-space: nowrap !important;
}
.ld-nav-item:hover { background: rgba(99, 102, 241, 0.08) !important; color: #6366f1 !important; }
.ld-nav-item.active { background: rgba(99, 102, 241, 0.1) !important; color: #4f46e5 !important; border-left: 4px solid #818cf8 !important; font-weight: 700 !important; }

.ld-nav-icon { width: 24px !important; height: 24px !important; font-size: 1.15rem !important; display: inline-flex !important; align-items: center !important; justify-content: center !important; flex-shrink: 0 !important; margin-right: 12px !important; }
.ld-nav-text { flex: 1 !important; text-align: left !important; white-space: nowrap !important; overflow: hidden !important; text-overflow: ellipsis !important; }
.ld-nav-badge { margin-left: auto !important; font-size: 0.64rem !important; font-weight: 800 !important; padding: 2px 7px !important; border-radius: 20px !important; color: white !important; flex-shrink: 0 !important; }
.ld-nav-badge.red { background: #f87171 !important; }
.ld-nav-badge.orange { background: #fb923c !important; }

.ld-sidebar-footer {
    padding: 0.85rem 0.75rem !important; border-top: 1px solid var(--border) !important;
    flex-shrink: 0 !important; background: var(--sidebar-bg) !important; display: flex !important; flex-direction: column !important; gap: 6px !important;
}
.ld-footer-btn {
    display: flex !important; align-items: center !important; height: 44px !important; min-height: 44px !important;
    padding: 0 12px !important; border-radius: 10px !important; font-size: 0.85rem !important; font-weight: 700 !important;
    color: var(--muted) !important; text-decoration: none !important; background: rgba(99, 102, 241, 0.06) !important;
    border: 1px solid #e2e8f0 !important; transition: all 0.2s ease !important; width: 100% !important;
}
.ld-footer-btn:hover { background: rgba(99, 102, 241, 0.12) !important; color: #6366f1 !important; }
.ld-footer-btn.danger { background: rgba(239, 68, 68, 0.08) !important; color: #dc2626 !important; border-color: rgba(239, 68, 68, 0.2) !important; }

.ld-overlay-dim {
    position: fixed !important; inset: 0 !important; background: rgba(15, 23, 42, 0.35) !important;
     
    z-index: 9998 !important; opacity: 0 !important; pointer-events: none !important; transition: opacity 0.28s ease !important;
}
.ld-overlay-dim.active { opacity: 1 !important; pointer-events: auto !important; }

/* ── CONTENT AREA ── */
.ld-content { padding: 1.25rem !important; display: flex !important; flex-direction: column !important; gap: 1.25rem !important; background: var(--bg) !important; }

/* ── METRIC STAT CARDS GRID ── */
.ld-stats-grid { display: grid !important; grid-template-columns: repeat(2, 1fr) !important; gap: 12px !important; width: 100% !important; }
@media (min-width: 901px) { .ld-stats-grid { grid-template-columns: repeat(4, 1fr) !important; } }

.ld-stat-card {
    background: linear-gradient(145deg, #ffffff, #f8fafc) !important;
    border: 1px solid var(--border) !important; border-radius: 18px !important;
    padding: 14px 12px !important; display: flex !important; flex-direction: column !important;
    align-items: center !important; text-align: center !important; justify-content: center !important; min-height: 105px !important;
}
.ld-stat-icon { font-size: 1.4rem !important; margin-bottom: 4px !important; }
.ld-stat-val { font-family: 'Outfit', sans-serif !important; font-size: 1.4rem !important; font-weight: 900 !important; color: #0f172a !important; line-height: 1.1 !important; }
.ld-stat-lbl { font-size: 0.72rem !important; color: var(--muted) !important; font-weight: 700 !important; margin-top: 2px !important; }

/* ── CARDS & TABLES ── */
.ld-card {
    background: linear-gradient(145deg, #ffffff, #f8fafc) !important;
    border: 1px solid var(--border) !important; border-radius: 20px !important;
    padding: 1.25rem !important; color: #0f172a !important; width: 100% !important; box-sizing: border-box !important; overflow: hidden !important;
}

.ld-table-container { width: 100% !important; max-width: 100% !important; overflow-x: auto !important; -webkit-overflow-scrolling: touch !important; margin-top: 10px !important; border-radius: 14px !important; }
table.ld-table { width: 100% !important; border-collapse: collapse !important; text-align: left !important; font-size: 0.85rem !important; }
table.ld-table th { background: rgba(99, 102, 241, 0.06) !important; color: #4f46e5 !important; font-weight: 800 !important; padding: 12px 14px !important; border-bottom: 1px solid var(--border) !important; white-space: nowrap !important; }
table.ld-table td { padding: 12px 14px !important; border-bottom: 1px solid #eef2f7 !important; color: #475569 !important; vertical-align: middle !important; word-break: break-word !important; }

/* ── BUTTONS ── */
.ld-btn {
    display: inline-flex !important; align-items: center !important; justify-content: center !important;
    gap: 8px !important; padding: 9px 16px !important; min-height: 40px !important; border-radius: 12px !important;
    font-size: 0.85rem !important; font-weight: 700 !important; cursor: pointer !important;
    transition: all 0.2s ease !important; text-decoration: none !important; border: none !important;
    background: rgba(99, 102, 241, 0.08) !important; color: #4f46e5 !important; box-sizing: border-box !important;
}
.ld-btn-primary { background: linear-gradient(135deg, #6366f1, #a855f7) !important; color: #ffffff !important; box-shadow: 0 4px 14px rgba(99, 102, 241, 0.3) !important; }
.ld-btn-danger { background: rgba(239, 68, 68, 0.08) !important; color: #dc2626 !important; border: 1px solid rgba(239, 68, 68, 0.25) !important; }
.ld-btn-success { background: rgba(16, 185, 129, 0.08) !important; color: #059669 !important; border: 1px solid rgba(16, 185, 129, 0.25) !important; }
.ld-btn-xs { padding: 4px 10px !important; min-height: 32px !important; font-size: 0.75rem !important; border-radius: 8px !important; }

/* ── MODALS ── */
.ld-modal-overlay {
    position: fixed !important; inset: 0 !important; background: rgba(15, 23, 42, 0.35) !important;
     
    z-index: 10000 !important; display: none; align-items: center !important; justify-content: center !important;
    padding: 1rem !important; overflow-y: auto !important;
}
.ld-modal-overlay.active { display: flex !important; }
.ld-modal-content {
    background: linear-gradient(145deg, #ffffff, #f8fafc) !important;
    border: 1px solid #e2e8f0 !important; border-radius: 20px !important;
    padding: 1.5rem !important; width: 100% !important; max-width: 500px !important;
    max-height: 90vh !important; overflow-y: auto !important; position: relative !important;
    box-shadow: 0 20px 50px rgba(15, 23, 42, 0.15) !important; color: #0f172a !important;
}
.ld-modal-close { position: absolute !important; top: 14px !important; right: 14px !important; background: rgba(99, 102, 241, 0.08) !important; border: 1px solid #e2e8f0 !important; color: #475569 !important; width: 32px !important; height: 32px !important; border-radius: 50% !important; display: flex !important; align-items: center !important; justify-content: center !important; cursor: pointer !important; }

.ld-form-group { display: flex !important; flex-direction: column !important; gap: 4px !important; width: 100% !important; margin-bottom: 12px !important; }
.ld-form-group label { font-size: 0.78rem !important; font-weight: 700 !important; color: #4f46e5 !important; margin-bottom: 2px !important; }
.ld-input, .ld-select, .ld-textarea { width: 100% !important; background: #f8fafc !important; border: 1px solid #cbd5e1 !important; color: #0f172a !important; border-radius: 12px !important; padding: 10px 14px !important; font-size: 0.88rem !important; min-height: 44px !important; outline: none !important; }

/* ── LIGHT THEME SWEEP: force inline dark-only white text to dark ── */
[style*="color: #ffffff"] { color: #0f172a !important; }
</style>

<div class="ld-overlay-dim" id="adminDim" onclick="toggleAdminSidebar()"></div>

<div class="ld-shell">
    <!-- ══ SIDEBAR DRAWER ══ -->
    <aside class="ld-sidebar" id="adminSidebar">
        <!-- Header -->
        <div class="ld-sidebar-header">
            <div class="ld-sidebar-user">
                <% const adminInitial = ((typeof session !== 'undefined' && session && (session.user_name || session.name)) ? (session.user_name || session.name).trim()[0] : 'L').toUpperCase(); %>
                <div class="ld-avatar-lg">
                    <%= adminInitial %>
                </div>
                <div class="ld-user-meta">
                    <h4 class="ld-user-name"><%= (typeof session !== 'undefined' && session && (session.user_name || session.name)) ? (session.user_name || session.name) : 'Librarian' %></h4>
                    <p class="ld-user-school"><%= (typeof session !== 'undefined' && session && session.school_name) ? session.school_name : 'Library System' %></p>
                </div>
            </div>
            <button class="ld-sidebar-close" onclick="toggleAdminSidebar()" aria-label="Close sidebar">✕</button>
        </div>

        <!-- Navigation List -->
        <nav class="ld-sidebar-nav">
            <button class="ld-nav-item tab-btn active" onclick="switchTab('dashboard', this); autoCloseAdminSidebar();">
                <span class="ld-nav-icon">📊</span>
                <span class="ld-nav-text">Dashboard</span>
            </button>
            <button class="ld-nav-item tab-btn" onclick="switchTab('books', this); autoCloseAdminSidebar();">
                <span class="ld-nav-icon">📚</span>
                <span class="ld-nav-text">Books Catalog</span>
                <span class="ld-nav-badge orange"><%= books ? books.length : 0 %></span>
            </button>
            <button class="ld-nav-item tab-btn" onclick="switchTab('members', this); autoCloseAdminSidebar();">
                <span class="ld-nav-icon">👥</span>
                <span class="ld-nav-text">Members</span>
                <span class="ld-nav-badge"><%= total_students || 0 %></span>
            </button>
            <button class="ld-nav-item tab-btn" onclick="switchTab('transactions', this); autoCloseAdminSidebar();">
                <span class="ld-nav-icon">🔄</span>
                <span class="ld-nav-text">Transactions</span>
                <span class="ld-nav-badge"><%= total_issued || 0 %></span>
            </button>
            <button class="ld-nav-item tab-btn" onclick="switchTab('overdue', this); autoCloseAdminSidebar();">
                <span class="ld-nav-icon">⏰</span>
                <span class="ld-nav-text">Overdue</span>
                <% if (overdue_count > 0) { %><span class="ld-nav-badge red"><%= overdue_count %></span><% } %>
            </button>
            <button class="ld-nav-item tab-btn" onclick="switchTab('reservations', this); autoCloseAdminSidebar();">
                <span class="ld-nav-icon">📖</span>
                <span class="ld-nav-text">Book Requests</span>
                <% if (reservations && reservations.length > 0) { %><span class="ld-nav-badge orange"><%= reservations.length %></span><% } %>
            </button>
            <button class="ld-nav-item tab-btn" onclick="switchTab('reviews', this); autoCloseAdminSidebar();">
                <span class="ld-nav-icon">⭐</span>
                <span class="ld-nav-text">Reviews</span>
                <% if (pending_reviews && pending_reviews.length > 0) { %><span class="ld-nav-badge orange"><%= pending_reviews.length %></span><% } %>
            </button>
            <button class="ld-nav-item tab-btn" onclick="switchTab('analytics', this); autoCloseAdminSidebar();">
                <span class="ld-nav-icon">📊</span>
                <span class="ld-nav-text">Analytics</span>
            </button>
            <button class="ld-nav-item tab-btn" onclick="switchTab('calendar', this); autoCloseAdminSidebar();">
                <span class="ld-nav-icon">📅</span>
                <span class="ld-nav-text">Calendar</span>
            </button>
            <button class="ld-nav-item tab-btn" onclick="switchTab('reports', this); autoCloseAdminSidebar();">
                <span class="ld-nav-icon">📈</span>
                <span class="ld-nav-text">Reports & Data Hub</span>
            </button>
            <button class="ld-nav-item tab-btn" onclick="switchTab('profile', this); autoCloseAdminSidebar();">
                <span class="ld-nav-icon">👤</span>
                <span class="ld-nav-text">My Profile</span>
            </button>
            <button class="ld-nav-item tab-btn" onclick="switchTab('settings', this); autoCloseAdminSidebar();">
                <span class="ld-nav-icon">⚙️</span>
                <span class="ld-nav-text">Settings</span>
            </button>
            <button class="ld-nav-item tab-btn" onclick="switchTab('security', this); autoCloseAdminSidebar();">
                <span class="ld-nav-icon">🔒</span>
                <span class="ld-nav-text">Security</span>
            </button>
            <button class="ld-nav-item tab-btn" onclick="switchTab('support', this); autoCloseAdminSidebar();">
                <span class="ld-nav-icon">❓</span>
                <span class="ld-nav-text">Help & Support</span>
            </button>
            <a href="/digital-library" class="ld-nav-item">
                <span class="ld-nav-icon">🌐</span>
                <span class="ld-nav-text">Digital Library</span>
            </a>
        </nav>

        <!-- Sticky Footer -->
        <div class="ld-sidebar-footer">
            <a href="/admin" class="ld-footer-btn">
                <span class="ld-nav-icon">📊</span>
                <span>Librarian Home</span>
            </a>
            <a href="/logout" class="ld-footer-btn danger">
                <span class="ld-nav-icon">🚪</span>
                <span>Logout</span>
            </a>
        </div>
    </aside>

    <!-- ══ MAIN CONTENT ══ -->
    <main class="ld-main">
        <!-- Topbar -->
        <div class="ld-topbar">
            <div class="ld-topbar-left">
                <button class="ld-menu-btn" onclick="toggleAdminSidebar()" aria-label="Menu">☰</button>
                <span class="ld-brand-title">📚 Librika Librarian</span>
            </div>
            <div class="ld-topbar-right">
                <button class="ld-btn ld-btn-primary ld-btn-xs" onclick="openModal('addBookModal')">+ Add Book</button>
                <button class="ld-btn ld-btn-success ld-btn-xs" onclick="openModal('addUserModal')">+ Add Member</button>
                <button class="ld-notif-btn" onclick="switchTab('overdue', this)">
                    🔔
                    <% if (overdue_count > 0) { %><span class="ld-notif-badge"><%= overdue_count %></span><% } %>
                </button>
            </div>
        </div>

        <div class="ld-content">
            <!-- ── TAB: DASHBOARD ── -->
            <section id="tab-dashboard" class="tab-content">
                <!-- Stats Grid -->
                <div class="ld-stats-grid">
                    <div class="ld-stat-card">
                        <div class="ld-stat-icon">📚</div>
                        <div class="ld-stat-val"><%= books ? books.length : 0 %></div>
                        <div class="ld-stat-lbl">Total Books</div>
                    </div>
                    <div class="ld-stat-card">
                        <div class="ld-stat-icon">✅</div>
                        <div class="ld-stat-val"><%= available_books || 0 %></div>
                        <div class="ld-stat-lbl">Available Copies</div>
                    </div>
                    <div class="ld-stat-card">
                        <div class="ld-stat-icon">🔄</div>
                        <div class="ld-stat-val"><%= total_issued || 0 %></div>
                        <div class="ld-stat-lbl">Active Loans</div>
                    </div>
                    <div class="ld-stat-card">
                        <div class="ld-stat-icon">⏰</div>
                        <div class="ld-stat-val" style="color: #f87171;"><%= overdue_count || 0 %></div>
                        <div class="ld-stat-lbl">Overdue Items</div>
                    </div>
                </div>

                <!-- Recent Transactions Table -->
                <div class="ld-card" style="margin-top: 1rem;">
                    <h3 style="font-family: 'Outfit'; font-size: 1.1rem; color: #ffffff; margin: 0 0 10px 0;">🔄 Recent Transactions</h3>
                    <div class="ld-table-container">
                        <table class="ld-table">
                            <thead>
                                <tr>
                                    <th>Book Title</th>
                                    <th>Member Name</th>
                                    <th>Issue Date</th>
                                    <th>Due Date</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (transactions && transactions.length > 0) { %>
                                    <% transactions.slice(0, 10).forEach(t => { %>
                                        <tr>
                                            <td style="font-weight: 700; color: #ffffff;"><%= t.title %></td>
                                            <td><%= t.user_name || t.student_name || 'Member' %></td>
                                            <td><%= t.issue_date %></td>
                                            <td><%= t.due_date %></td>
                                            <td>
                                                <% if (t.return_date) { %>
                                                    <span style="color: #34d399; font-weight: 700;">Returned</span>
                                                <% } else if (t.is_overdue) { %>
                                                    <span style="color: #f87171; font-weight: 700;">OVERDUE</span>
                                                <% } else { %>
                                                    <span style="color: #fb923c; font-weight: 700;">Issued</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <% if (!t.return_date) { %>
                                                    <form action="/admin/return" method="POST" style="display: inline;">
                                                        <input type="hidden" name="transaction_id" value="<%= t.id %>">
                                                        <button type="submit" class="ld-btn ld-btn-xs ld-btn-success">Return</button>
                                                    </form>
                                                <% } %>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr><td colspan="6" style="text-align: center; color: var(--muted);">No transactions found.</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- ── TAB: BOOKS CATALOG ── -->
            <section id="tab-books" class="tab-content" style="display: none;">
                <div class="ld-card">
                    <div style="display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 1rem;">
                        <h3 style="font-family: 'Outfit'; font-size: 1.1rem; color: #ffffff; margin: 0;">📚 Books Catalog</h3>
                        <button class="ld-btn ld-btn-primary" onclick="openModal('addBookModal')">+ Add New Book</button>
                    </div>

                    <div class="ld-table-container">
                        <table class="ld-table">
                            <thead>
                                <tr>
                                    <th>Cover</th>
                                    <th>Title & Author</th>
                                    <th>Genre</th>
                                    <th>Shelf</th>
                                    <th>Available / Total</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (books && books.length > 0) { %>
                                    <% books.forEach(b => { %>
                                        <tr>
                                            <td>
                                                <img src="<%= b.cover_url || '/static/placeholder-cover.jpg' %>" alt="Cover" style="width: 36px; height: 50px; object-fit: cover; border-radius: 6px;">
                                            </td>
                                            <td>
                                                <div style="font-weight: 700; color: #ffffff;"><%= b.title %></div>
                                                <div style="font-size: 0.75rem; color: var(--muted);"><%= b.author %></div>
                                            </td>
                                            <td><%= b.genre || 'General' %></td>
                                            <td><%= b.shelf_location || 'Main Shelf' %></td>
                                            <td>
                                                <span style="color: #34d399; font-weight: 700;"><%= b.available_copies %></span> / <%= b.quantity %>
                                            </td>
                                            <td>
                                                <div style="display: flex; gap: 6px;">
                                                    <form action="/admin/book/delete" method="POST" onsubmit="return confirm('Delete this book?')">
                                                        <input type="hidden" name="book_id" value="<%= b.id %>">
                                                        <button type="submit" class="ld-btn ld-btn-xs ld-btn-danger">Delete</button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr><td colspan="6" style="text-align: center; color: var(--muted);">No books in catalog.</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- ── TAB: MEMBERS ── -->
            <section id="tab-members" class="tab-content" style="display: none;">
                <div class="ld-card">
                    <div style="display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 1rem;">
                        <h3 style="font-family: 'Outfit'; font-size: 1.1rem; color: #ffffff; margin: 0;">👥 Registered Members</h3>
                        <button class="ld-btn ld-btn-success" onclick="openModal('addUserModal')">+ Add Member</button>
                    </div>

                    <div class="ld-table-container">
                        <table class="ld-table">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Role</th>
                                    <th>Class & Sec</th>
                                    <th>Admission No</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (students && students.length > 0) { %>
                                    <% students.forEach(s => { %>
                                        <tr>
                                            <td style="font-weight: 700; color: #ffffff;"><%= s.name || s.user_name %></td>
                                            <td><span style="text-transform: capitalize;"><%= s.role || 'Student' %></span></td>
                                            <td><%= s.class || '-' %> <%= s.section ? '(' + s.section + ')' : '' %></td>
                                            <td><%= s.admission_no || s.user_id || '-' %></td>
                                            <td>
                                                <% if (s.is_banned) { %>
                                                    <span style="color: #f87171; font-weight: 700;">Banned</span>
                                                <% } else { %>
                                                    <span style="color: #34d399; font-weight: 700;">Active</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <div style="display: flex; gap: 6px;">
                                                    <form action="/admin/student/<%= s.id %>/toggle-ban" method="POST">
                                                        <button type="submit" class="ld-btn ld-btn-xs <%= s.is_banned ? 'ld-btn-success' : 'ld-btn-danger' %>"><%= s.is_banned ? 'Unban' : 'Ban' %></button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr><td colspan="6" style="text-align: center; color: var(--muted);">No registered members.</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- ── TAB: TRANSACTIONS ── -->
            <section id="tab-transactions" class="tab-content" style="display: none;">
                <div class="ld-card">
                    <h3 style="font-family: 'Outfit'; font-size: 1.1rem; color: #ffffff; margin: 0 0 1rem 0;">🔄 Active Issued Loans</h3>
                    <div class="ld-table-container">
                        <table class="ld-table">
                            <thead>
                                <tr>
                                    <th>Book Title</th>
                                    <th>Member Name</th>
                                    <th>Issue Date</th>
                                    <th>Due Date</th>
                                    <th>Fine</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (transactions && transactions.length > 0) { %>
                                    <% transactions.filter(t => !t.return_date).forEach(t => { %>
                                        <tr>
                                            <td style="font-weight: 700; color: #ffffff;"><%= t.title %></td>
                                            <td><%= t.user_name || t.student_name || 'Member' %></td>
                                            <td><%= t.issue_date %></td>
                                            <td><%= t.due_date %></td>
                                            <td style="color: <%= t.calculated_fine > 0 ? '#f87171' : '#34d399' %>; font-weight: 700;">₹<%= t.calculated_fine || 0 %></td>
                                            <td>
                                                <form action="/admin/return" method="POST">
                                                    <input type="hidden" name="transaction_id" value="<%= t.id %>">
                                                    <button type="submit" class="ld-btn ld-btn-xs ld-btn-success">Return Book</button>
                                                </form>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr><td colspan="6" style="text-align: center; color: var(--muted);">No active loans.</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- ── TAB: OVERDUE ── -->
            <section id="tab-overdue" class="tab-content" style="display: none;">
                <div class="ld-card">
                    <h3 style="font-family: 'Outfit'; font-size: 1.1rem; color: #f87171; margin: 0 0 1rem 0;">⏰ Overdue Register</h3>
                    <div class="ld-table-container">
                        <table class="ld-table">
                            <thead>
                                <tr>
                                    <th>Book Title</th>
                                    <th>Member Name</th>
                                    <th>Due Date</th>
                                    <th>Calculated Fine</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (transactions && transactions.filter(t => t.is_overdue).length > 0) { %>
                                    <% transactions.filter(t => t.is_overdue).forEach(t => { %>
                                        <tr>
                                            <td style="font-weight: 700; color: #ffffff;"><%= t.title %></td>
                                            <td><%= t.user_name || t.student_name || 'Member' %></td>
                                            <td style="color: #f87171; font-weight: 700;"><%= t.due_date %></td>
                                            <td style="color: #f87171; font-weight: 800;">₹<%= t.calculated_fine || 0 %></td>
                                            <td>
                                                <form action="/admin/return" method="POST">
                                                    <input type="hidden" name="transaction_id" value="<%= t.id %>">
                                                    <button type="submit" class="ld-btn ld-btn-xs ld-btn-success">Clear & Return</button>
                                                </form>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr><td colspan="5" style="text-align: center; color: var(--muted);">No overdue books! 🎉</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- ── TAB: RESERVATIONS / BOOK REQUESTS ── -->
            <section id="tab-reservations" class="tab-content" style="display: none;">
                <div class="ld-card">
                    <h3 style="font-family: 'Outfit'; font-size: 1.1rem; color: #ffffff; margin: 0 0 1rem 0;">📖 Student Book Requests</h3>
                    <div class="ld-table-container">
                        <table class="ld-table">
                            <thead>
                                <tr>
                                    <th>Book Title</th>
                                    <th>Student Name</th>
                                    <th>Request Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (reservations && reservations.length > 0) { %>
                                    <% reservations.forEach(r => { %>
                                        <tr>
                                            <td style="font-weight: 700; color: #ffffff;"><%= r.title %></td>
                                            <td><%= r.student_name || 'Student' %></td>
                                            <td><%= r.created_at ? r.created_at.slice(0, 10) : 'Recent' %></td>
                                            <td>
                                                <div style="display: flex; gap: 6px;">
                                                    <form action="/admin/reservation/approve" method="POST">
                                                        <input type="hidden" name="reservation_id" value="<%= r.id %>">
                                                        <button type="submit" class="ld-btn ld-btn-xs ld-btn-success">Approve</button>
                                                    </form>
                                                    <form action="/admin/reservation/reject" method="POST">
                                                        <input type="hidden" name="reservation_id" value="<%= r.id %>">
                                                        <button type="submit" class="ld-btn ld-btn-xs ld-btn-danger">Reject</button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr><td colspan="4" style="text-align: center; color: var(--muted);">No pending book requests.</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- ── TAB: REVIEWS ── -->
            <section id="tab-reviews" class="tab-content" style="display: none;">
                <div class="ld-card">
                    <h3 style="font-family: 'Outfit'; font-size: 1.1rem; color: #ffffff; margin: 0 0 1rem 0;">⭐ Book Reviews Moderation</h3>
                    <div class="ld-table-container">
                        <table class="ld-table">
                            <thead>
                                <tr>
                                    <th>Book</th>
                                    <th>Student</th>
                                    <th>Learned Summary</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (pending_reviews && pending_reviews.length > 0) { %>
                                    <% pending_reviews.forEach(rv => { %>
                                        <tr>
                                            <td style="font-weight: 700; color: #ffffff;"><%= rv.book_title %></td>
                                            <td><%= rv.student_name %></td>
                                            <td><%= rv.learned %></td>
                                            <td>
                                                <div style="display: flex; gap: 6px;">
                                                    <form action="/admin/review/approve" method="POST">
                                                        <input type="hidden" name="review_id" value="<%= rv.id %>">
                                                        <button type="submit" class="ld-btn ld-btn-xs ld-btn-success">Approve</button>
                                                    </form>
                                                    <form action="/admin/review/reject" method="POST">
                                                        <input type="hidden" name="review_id" value="<%= rv.id %>">
                                                        <button type="submit" class="ld-btn ld-btn-xs ld-btn-danger">Reject</button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr><td colspan="4" style="text-align: center; color: var(--muted);">No pending reviews for moderation.</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- ── TAB: REPORTS & DATA HUB ── -->
            <section id="tab-reports" class="tab-content" style="display: none;">
                <div class="ld-card">
                    <h3 style="font-family: 'Outfit'; font-size: 1.1rem; color: #ffffff; margin: 0 0 1rem 0;">📈 Reports & Data Hub</h3>
                    <p style="color: var(--muted); font-size: 0.85rem;">Export or import catalog and member records using CSV/Excel formats.</p>

                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 15px; margin-top: 1rem;">
                        <div style="background: rgba(99, 102, 241, 0.08); padding: 1rem; border-radius: 14px; border: 1px solid var(--border);">
                            <h4 style="margin: 0 0 8px 0; color: #ffffff;">📥 Import Data</h4>
                            <div class="ld-form-group">
                                <label>Target Module</label>
                                <select id="importModule" class="ld-select">
                                    <option value="books">Books Catalog</option>
                                    <option value="students">Students / Members</option>
                                </select>
                            </div>
                            <div class="ld-form-group">
                                <label>Select CSV/Excel File</label>
                                <input type="file" id="importFile" accept=".csv,.xlsx" class="ld-input">
                            </div>
                            <button onclick="handleImport()" class="ld-btn ld-btn-primary" style="width: 100%; margin-top: 6px;">Upload & Import</button>
                            <div id="importResult" style="margin-top: 8px; font-size: 0.8rem;"></div>
                        </div>

                        <div style="background: rgba(16, 185, 129, 0.08); padding: 1rem; border-radius: 14px; border: 1px solid var(--border);">
                            <h4 style="margin: 0 0 8px 0; color: #ffffff;">📤 Export Data</h4>
                            <div class="ld-form-group">
                                <label>Export Module</label>
                                <select id="exportModule" class="ld-select">
                                    <option value="books">Books Catalog</option>
                                    <option value="students">Students List</option>
                                    <option value="transactions">Loan Transactions</option>
                                </select>
                            </div>
                            <div class="ld-form-group">
                                <label>Format</label>
                                <select id="exportFormat" class="ld-select">
                                    <option value="csv">CSV</option>
                                    <option value="xlsx">Excel (XLSX)</option>
                                </select>
                            </div>
                            <button onclick="handleExport()" class="ld-btn ld-btn-success" style="width: 100%; margin-top: 6px;">Download Export</button>
                        </div>
                    </div>
                </div>
            </section>
        
            <!-- ── TAB: LIBRARIAN ANALYTICS ── -->
            <section id="tab-analytics" class="tab-content" style="display: none;">
                <div class="ld-card">
                    <h3 style="font-family: 'Outfit'; font-size: 1.1rem; color: #ffffff; margin: 0 0 1rem 0;">📊 Library Analytics & Performance</h3>
                    <div class="ld-stats-grid" style="margin-bottom: 1rem;">
                        <div class="ld-stat-card">
                            <div class="ld-stat-icon">📖</div>
                            <div class="ld-stat-val"><%= total_issued || 0 %></div>
                            <div class="ld-stat-lbl">Active Circulations</div>
                        </div>
                        <div class="ld-stat-card">
                            <div class="ld-stat-icon">↩️</div>
                            <div class="ld-stat-val"><%= total_returned || 0 %></div>
                            <div class="ld-stat-lbl">Completed Returns</div>
                        </div>
                        <div class="ld-stat-card">
                            <div class="ld-stat-icon">👥</div>
                            <div class="ld-stat-val"><%= total_students || 0 %></div>
                            <div class="ld-stat-lbl">Active Readers</div>
                        </div>
                        <div class="ld-stat-card">
                            <div class="ld-stat-icon">⏰</div>
                            <div class="ld-stat-val" style="color: #f87171;"><%= overdue_count || 0 %></div>
                            <div class="ld-stat-lbl">Overdue Items</div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ── TAB: CALENDAR ── -->
            <section id="tab-calendar" class="tab-content" style="display: none;">
                <div class="ld-card">
                    <h3 style="font-family: 'Outfit'; font-size: 1.1rem; color: #ffffff; margin: 0 0 1rem 0;">📅 Library Operations Calendar</h3>
                    <p style="color: var(--muted); font-size: 0.85rem;">Track book return due dates, upcoming library events, and operational schedules.</p>
                    <div style="background: #f8fafc; border-radius: 16px; padding: 1.25rem; border: 1px solid var(--border); margin-top: 1rem;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                            <h4 style="margin: 0; color: #0f172a;">Today: <%= new Date().toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' }) %></h4>
                            <span class="ld-btn ld-btn-xs ld-btn-primary">+ Add Event</span>
                        </div>
                        <p style="color: #34d399; font-size: 0.85rem; font-weight: 700;">✅ All return schedules synced with database.</p>
                    </div>
                </div>
            </section>

            <!-- ── TAB: MY PROFILE ── -->
            <section id="tab-profile" class="tab-content" style="display: none;">
                <div class="ld-card">
                    <h3 style="font-family: 'Outfit'; font-size: 1.1rem; color: #ffffff; margin: 0 0 1rem 0;">👤 Librarian Profile</h3>
                    <form action="/admin/settings" method="POST">
                        <div class="ld-form-group">
                            <label>Full Name</label>
                            <input type="text" name="name" value="<%= (typeof session !== 'undefined' && session && (session.user_name || session.name)) ? (session.user_name || session.name) : 'Librarian' %>" class="ld-input">
                        </div>
                        <div class="ld-form-group">
                            <label>School Name</label>
                            <input type="text" value="<%= (typeof session !== 'undefined' && session && session.school_name) ? session.school_name : 'Library System' %>" disabled class="ld-input" style="opacity: 0.7;">
                        </div>
                        <div class="ld-form-group">
                            <label>Role</label>
                            <input type="text" value="Librarian Admin" disabled class="ld-input" style="opacity: 0.7;">
                        </div>
                        <button type="submit" class="ld-btn ld-btn-primary" style="margin-top: 10px;">Update Profile</button>
                    </form>
                </div>
            </section>

            <!-- ── TAB: SETTINGS ── -->
            <section id="tab-settings" class="tab-content" style="display: none;">
                <div class="ld-card">
                    <h3 style="font-family: 'Outfit'; font-size: 1.1rem; color: #ffffff; margin: 0 0 1rem 0;">⚙️ Library System Settings</h3>
                    <form action="/admin/settings" method="POST">
                        <div class="ld-form-group">
                            <label>Overdue Fine Rate per Day (₹)</label>
                            <input type="number" name="fine_per_day" value="5" min="0" class="ld-input">
                        </div>
                        <div class="ld-form-group">
                            <label>Max Borrow Limit per Student</label>
                            <input type="number" name="max_books" value="3" min="1" class="ld-input">
                        </div>
                        <div class="ld-form-group">
                            <label>Borrowing Duration (Days)</label>
                            <input type="number" name="issue_duration" value="14" min="1" class="ld-input">
                        </div>
                        <button type="submit" class="ld-btn ld-btn-success" style="margin-top: 10px;">Save Settings</button>
                    </form>
                </div>
            </section>

            <!-- ── TAB: SECURITY ── -->
            <section id="tab-security" class="tab-content" style="display: none;">
                <div class="ld-card">
                    <h3 style="font-family: 'Outfit'; font-size: 1.1rem; color: #ffffff; margin: 0 0 1rem 0;">🔒 Security & Authentication</h3>
                    <div style="background: #f8fafc; padding: 1.25rem; border-radius: 16px; border: 1px solid var(--border);">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                            <div>
                                <h4 style="margin: 0; color: #0f172a;">Account Password</h4>
                                <p style="margin: 2px 0 0; font-size: 0.8rem; color: var(--muted);">Change your account password securely.</p>
                            </div>
                            <button class="ld-btn ld-btn-primary ld-btn-xs">Change Password</button>
                        </div>
                        <div style="border-top: 1px solid var(--border); padding-top: 12px; margin-top: 12px;">
                            <span style="color: #34d399; font-weight: 700; font-size: 0.85rem;">🔒 Session Security Active (Encrypted SSL)</span>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ── TAB: HELP & SUPPORT ── -->
            <section id="tab-support" class="tab-content" style="display: none;">
                <div class="ld-card">
                    <h3 style="font-family: 'Outfit'; font-size: 1.1rem; color: #ffffff; margin: 0 0 1rem 0;">❓ Help & Technical Support</h3>
                    <p style="color: var(--muted); font-size: 0.85rem;">Contact Librika technical team or review automated support guides.</p>
                    <div style="background: rgba(99, 102, 241, 0.08); padding: 1.25rem; border-radius: 16px; border: 1px solid var(--border); margin-top: 1rem;">
                        <h4 style="margin: 0 0 6px 0; color: #ffffff;">📞 Support Contact</h4>
                        <p style="margin: 0; font-size: 0.85rem; color: #4f46e5;">Email: support@librika.in | Helpline: +91 (800) LIBRIKA</p>
                    </div>
                </div>
            </section>

</div>
    </main>
</div>

<!-- ══ MODALS ══ -->
<!-- Add Book Modal -->
<div class="ld-modal-overlay" id="addBookModal">
    <div class="ld-modal-content">
        <button class="ld-modal-close" onclick="closeModal('addBookModal')">✕</button>
        <h3 style="font-family: 'Outfit'; font-size: 1.2rem; color: #ffffff; margin: 0 0 1rem 0;">+ Add New Book</h3>
        <form action="/admin/book/add" method="POST">
            <div class="ld-form-group">
                <label>Book Title *</label>
                <input type="text" name="title" required class="ld-input" placeholder="e.g. The Hobbit">
            </div>
            <div class="ld-form-group">
                <label>Author *</label>
                <input type="text" name="author" required class="ld-input" placeholder="e.g. J.R.R. Tolkien">
            </div>
            <div class="ld-form-group">
                <label>Genre / Category</label>
                <input type="text" name="genre" class="ld-input" placeholder="e.g. Fantasy">
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                <div class="ld-form-group">
                    <label>Shelf Location</label>
                    <input type="text" name="shelf_location" class="ld-input" placeholder="A-12">
                </div>
                <div class="ld-form-group">
                    <label>Total Quantity</label>
                    <input type="number" name="quantity" value="1" min="1" class="ld-input">
                </div>
            </div>
            <button type="submit" class="ld-btn ld-btn-primary" style="width: 100%; margin-top: 12px;">Save Book to Catalog</button>
        </form>
    </div>
</div>

<!-- Add Member Modal -->
<div class="ld-modal-overlay" id="addUserModal">
    <div class="ld-modal-content">
        <button class="ld-modal-close" onclick="closeModal('addUserModal')">✕</button>
        <h3 style="font-family: 'Outfit'; font-size: 1.2rem; color: #ffffff; margin: 0 0 1rem 0;">+ Add New Member</h3>
        <form action="/admin/student/add" method="POST">
            <div class="ld-form-group">
                <label>Full Name *</label>
                <input type="text" name="name" required class="ld-input" placeholder="Student Name">
            </div>
            <div class="ld-form-group">
                <label>Role *</label>
                <select name="role" id="addUserRole" onchange="toggleAddUserClassField()" class="ld-select">
                    <option value="student">Student</option>
                    <option value="teacher">Teacher</option>
                </select>
            </div>
            <div class="ld-form-group" id="addUserClassGroup">
                <label>Class & Section</label>
                <input type="text" name="class" class="ld-input" placeholder="e.g. 10th-A">
            </div>
            <div class="ld-form-group" id="addUserAdmissionGroup">
                <label>Admission No / Roll No</label>
                <input type="text" name="admission_no" class="ld-input" placeholder="e.g. ADM-102">
            </div>
            <button type="submit" class="ld-btn ld-btn-success" style="width: 100%; margin-top: 12px;">Add Member</button>
        </form>
    </div>
</div>

<script>
function switchTab(tabName, element) {
    document.querySelectorAll('.tab-content').forEach(el => el.style.display = 'none');
    const target = document.getElementById('tab-' + tabName);
    if (target) target.style.display = 'block';

    if (element) {
        document.querySelectorAll('.ld-nav-item').forEach(b => b.classList.remove('active'));
        element.classList.add('active');
    }
}

function openModal(id) {
    const m = document.getElementById(id);
    if (m) m.classList.add('active');
}

function closeModal(id) {
    const m = document.getElementById(id);
    if (m) m.classList.remove('active');
}

function toggleAdminSidebar() {
    const sb = document.getElementById('adminSidebar');
    const dim = document.getElementById('adminDim');
    if (!sb) return;
    sb.classList.toggle('open');
    if (dim) dim.classList.toggle('active', sb.classList.contains('open'));
}

function autoCloseAdminSidebar() {
    if (window.innerWidth <= 900) {
        const sb = document.getElementById('adminSidebar');
        const dim = document.getElementById('adminDim');
        if (sb) sb.classList.remove('open');
        if (dim) dim.classList.remove('active');
    }
}

function toggleAddUserClassField() {
    const role = document.getElementById('addUserRole').value;
    const classGroup = document.getElementById('addUserClassGroup');
    const admissionGroup = document.getElementById('addUserAdmissionGroup');
    if (role === 'student') {
        classGroup.style.display = 'block';
        admissionGroup.style.display = 'block';
    } else {
        classGroup.style.display = 'none';
        admissionGroup.style.display = 'none';
    }
}

async function handleImport() {
    const fileInput = document.getElementById('importFile');
    const module = document.getElementById('importModule').value;
    const resultDiv = document.getElementById('importResult');

    if (!fileInput.files[0]) {
        resultDiv.innerHTML = '<span style="color:#f87171;">Please select a file first.</span>';
        return;
    }

    resultDiv.innerHTML = '<span style="color:#a5b4fc;">Uploading & processing...</span>';
    const formData = new FormData();
    formData.append('file', fileInput.files[0]);

    try {
        const res = await fetch('/data/import/' + module, { method: 'POST', body: formData });
        const data = await res.json();
        if (res.ok) {
            resultDiv.innerHTML = '<span style="color:#34d399;">Import Complete!</span> Total: ' + data.total + ' | Success: ' + data.success;
        } else {
            resultDiv.innerHTML = '<span style="color:#f87171;">Error: ' + (data.error || 'Upload failed') + '</span>';
        }
    } catch (e) {
        resultDiv.innerHTML = '<span style="color:#f87171;">Network error occurred.</span>';
    }
}

function handleExport() {
    const module = document.getElementById('exportModule').value;
    const format = document.getElementById('exportFormat').value;
    window.location.href = '/data/export/' + module + '?format=' + format;
}

document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
        autoCloseAdminSidebar();
        document.querySelectorAll('.ld-modal-overlay').forEach(m => m.classList.remove('active'));
    }
});
</script>
