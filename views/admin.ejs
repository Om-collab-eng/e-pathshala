                        </div>
                        <a href="/digital-library" target="_blank" class="ld-btn ld-btn-primary ld-btn-xs">🌐 Open Reader View</a>
                    </div>

                    <div class="ld-table-container">
                        <table class="ld-table">
                            <thead>
                                <tr>
                                    <th>Digital Title</th>
                                    <th>Author / Creator</th>
                                    <th>Subject / Category</th>
                                    <th>Status</th>
                                    <th>Action</th>
