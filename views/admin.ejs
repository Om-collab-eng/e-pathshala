        }
      } catch (err) {
        window.location.reload();
      }
    }

    // Bulk Scan Sequential Queue State & Operations
    let bulkScanQueue = [];

    async function addBarcodeToBulkQueue() {
      const input = document.getElementById('bulkScannerInput');
      const code = (input?.value || '').trim();
      if (!code) return;
      input.value = '';
      input.focus();

      const existing = bulkScanQueue.find(item => item.barcode.toLowerCase() === code.toLowerCase() || (item.isbn && item.isbn.toLowerCase() === code.toLowerCase()));
      if (existing) {
        existing.copies = (existing.copies || 1) + 1;
        renderBulkQueue();
        return;
      }

      const tempId = Date.now();
      const queueItem = {
        id: tempId,
        barcode: code,
        isbn: code,
        title: 'Fetching metadata...',
        author: 'Please wait...',
        genre: 'General',
        copies: 1,
        cover_url: '',
        duplicate: null,
        acquisition_item_id: null,
        loading: true
      };
      bulkScanQueue.unshift(queueItem);
      renderBulkQueue();

      try {
        const res = await fetch(`/admin/api/books/lookup?isbn=${encodeURIComponent(code)}`);
        const data = await res.json();
        const item = bulkScanQueue.find(it => it.id === tempId);
        if (item) {
          item.loading = false;
          if (data.success && data.book) {
            item.title = data.book.title || code;
            item.author = data.book.author || 'Unknown Author';
            item.genre = data.book.genre || 'General';
            item.isbn = data.book.isbn || code;
            item.cover_url = data.book.cover_url || '';
          } else {
            item.title = `Barcode ${code}`;
            item.author = 'Unknown (Manual Review)';
          }
          if (data.duplicate) {
            item.duplicate = data.duplicate;
          }
          if (data.acquisition_match) {
            item.acquisition_match = data.acquisition_match;
            item.acquisition_item_id = data.acquisition_match.item_id;
          }
        }
      } catch (err) {
        const item = bulkScanQueue.find(it => it.id === tempId);
        if (item) {
          item.loading = false;
          item.title = `Barcode ${code}`;
          item.author = 'Lookup Offline';
        }
      }
      renderBulkQueue();
    }

    function renderBulkQueue() {
      const tbody = document.getElementById('bulkQueueTbody');
      const badge = document.getElementById('bulkQueueBadge');
      const btn = document.getElementById('btnBatchRegister');
      if (badge) badge.textContent = bulkScanQueue.length;
      if (btn) {
        btn.disabled = bulkScanQueue.length === 0;
        btn.textContent = `🚀 Batch Register (${bulkScanQueue.length}) Books`;
      }
      if (!tbody) return;

      if (bulkScanQueue.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" style="text-align:center;padding:32px;color:#94A3B8;">No scanned books in queue. Scan book barcodes to begin bulk registration.</td></tr>`;
        return;
      }

      tbody.innerHTML = bulkScanQueue.map((item, idx) => {
        let reconBadge = '<span class="lp-status-pill available">New Title</span>';
        if (item.duplicate) {
          reconBadge = `<span class="lp-status-pill overdue" title="Exists: ${escapeHtml(item.duplicate.title)}">Duplicate (+${item.duplicate.total_copies} copies)</span>`;
        } else if (item.acquisition_match) {
          reconBadge = `<span class="lp-status-pill in-review" title="Invoice #${item.acquisition_match.invoice_number}">Matched Invoice</span>`;
        }

        return `
          <tr>
            <td style="font-weight:700;color:#64748B;">${idx + 1}</td>
            <td>
              <div style="font-weight:700;color:#1E293B;">${escapeHtml(item.title)}</div>
              <div style="font-size:0.75rem;color:#64748B;">${escapeHtml(item.author)}</div>
            </td>
            <td style="font-family:monospace;font-size:0.8rem;">${escapeHtml(item.barcode)}</td>
            <td>
              <input type="number" min="1" value="${item.copies}" style="width:60px;padding:3px 6px;border:1px solid #CBD5E1;border-radius:6px;font-size:0.82rem;" onchange="updateBulkItemCopies(${item.id}, this.value)">
            </td>
            <td>${reconBadge}</td>
            <td>
              <button type="button" onclick="removeBulkQueueItem(${item.id})" style="background:none;border:none;color:#DC2626;cursor:pointer;font-size:1rem;">✕</button>
            </td>
          </tr>
        `;
      }).join('');
    }

    function updateBulkItemCopies(id, val) {
      const item = bulkScanQueue.find(it => it.id === id);
      if (item) {
        item.copies = Math.max(1, parseInt(val, 10) || 1);
      }
    }

    function removeBulkQueueItem(id) {
      bulkScanQueue = bulkScanQueue.filter(it => it.id !== id);
      renderBulkQueue();
    }

    function clearBulkQueue() {
      if (bulkScanQueue.length === 0) return;
      if (confirm('Clear all scanned books from queue?')) {
        bulkScanQueue = [];
        renderBulkQueue();
      }
    }

    async function submitBatchRegistration() {
      if (bulkScanQueue.length === 0) return;
      const btn = document.getElementById('btnBatchRegister');
      if (btn) { btn.disabled = true; btn.textContent = 'Registering Batch...'; }

      const payload = {
        books: bulkScanQueue.map(item => ({
          title: item.title,
          author: item.author,
          genre: item.genre || 'General',
          isbn: item.isbn || item.barcode,
          total_copies: item.copies || 1,
          cover_url: item.cover_url || '',
          acquisition_item_id: item.acquisition_item_id || null
        }))
      };

      try {
        const res = await fetch('/admin/api/books/batch-register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.success) {
          alert(`✓ Successfully batch registered ${data.registered} books into catalog!`);
          bulkScanQueue = [];
          closeModal('addBookModal');
          window.location.reload();
        } else {
          alert(data.error || 'Failed to complete batch registration.');
          if (btn) { btn.disabled = false; btn.textContent = `🚀 Batch Register (${bulkScanQueue.length}) Books`; }
        }
      } catch (err) {
        alert('Network error during batch registration.');
        if (btn) { btn.disabled = false; btn.textContent = `🚀 Batch Register (${bulkScanQueue.length}) Books`; }
      }
    }

