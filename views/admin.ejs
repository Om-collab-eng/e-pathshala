    function copyStudioLink(mCode, mId, mUid) {
      const roomSlug = mUid ? `meet/${mUid}` : (mId && String(mId).startsWith('mtg_') ? `meet/${mId}` : `studio/meeting/${encodeURIComponent(mId || mCode)}`);
      const url = `${window.location.origin}/${roomSlug}`;
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(url).then(() => {
          alert(`📋 Meeting invite link copied to clipboard!\n\nLink: ${url}\nMeeting Code: ${mCode}`);
        }).catch(() => {
          prompt('Copy this meeting link:', url);
        });
      } else {
