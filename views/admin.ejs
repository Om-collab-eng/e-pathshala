      document.getElementById('ebId').value = id || '';
      document.getElementById('ebTitle').value = title || '';
      document.getElementById('ebAuthor').value = author || '';
      document.getElementById('ebIsbn').value = isbn || '';
      document.getElementById('ebCopies').value = totalCopies || 1;
