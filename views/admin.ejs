          <!-- Currently Borrowed -->
          <h4 style="font-weight:800;margin:0 0 10px 0;font-size:0.95rem;">📖 Currently Borrowed Books (${data.activeLoans.length})</h4>
          <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:20px;">
            ${data.activeLoans.length === 0 ? '<p style="color:#94A3B8;font-size:0.85rem;">No active borrowed books.</p>' : data.activeLoans.map(l => `
              <div style="padding:10px;border-radius:10px;background:#F8FAFC;border:1px solid #E2E8F0;display:flex;justify-content:space-between;align-items:center;">
                <div>
                  <div style="font-weight:700;font-size:0.85rem;">${l.book_title}</div>
                  <div style="font-size:0.72rem;color:#64748B;">Due: ${new Date(l.due_date).toLocaleDateString()}</div>
                </div>
                ${l.is_overdue ? `<span class="lp-status-pill overdue">${l.days_overdue}d late</span>` : '<span class="lp-status-pill available">Active</span>'}
