<script>
function autoCloseAdminSidebar() {
    if (window.innerWidth <= 768) {
        const sb = document.getElementById('adminSidebar');
        const dim = document.getElementById('adminDim');
        if (sb) sb.classList.remove('open');
        if (dim) dim.classList.remove('active');
    }
}
function toggleAdminSidebar() {
    const sb = document.getElementById('adminSidebar');
    const dim = document.getElementById('adminDim');
    if (!sb) return;
    sb.classList.toggle('open');
    if (dim) dim.classList.toggle('active', sb.classList.contains('open'));
}
document.addEventListener('DOMContentLoaded', function() {
    autoCloseAdminSidebar();
});

document.addEventListener('DOMContentLoaded', function() {
    const params = new URLSearchParams(window.location.search);
    const tab = params.get('tab');
    if (tab) {
        const btn = document.querySelector(`.tab-btn[onclick*="'${tab}'"]`);
        switchTab(tab, btn);
    }
});

document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') autoCloseAdminSidebar();
});

function switchTab(tabName, element) {
    document.querySelectorAll('.tab-content').forEach(el => el.style.display = 'none');
    const target = document.getElementById('tab-' + tabName);
    if (target) target.style.display = 'block';

    if (element) {
        document.querySelectorAll('.ld-nav-item').forEach(b => b.classList.remove('active'));
        element.classList.add('active');
    }

    if (tabName === 'security') {
        loadAdminSecurityLogs();
    }
}

async function loadAdminSecurityLogs() {
    const wrap = document.getElementById('adminSecurityLogsWrap');
    if (!wrap) return;
    try {
        const res = await fetch('/admin/api/security-logs');
        const data = await res.json();
        if (!data.success) {
            wrap.innerHTML = '<div style="text-align:center;padding:2rem;color:#ef4444;">Failed to load logs.</div>';
            return;
        }

        const logs = data.logs || [];
        const loginHistory = data.loginHistory || [];
        const devices = data.devices || [];

        // Render devices
        const devWrap = document.getElementById('adminDevicesList');
        if (devWrap) {
            if (!devices.length) {
                devWrap.innerHTML = '<span style="color:#94a3b8;">Current browser session active.</span>';
            } else {
                devWrap.innerHTML = devices.map(d => `
                    <div style="display:flex;justify-content:space-between;align-items:center;padding:6px 0;border-bottom:1px solid #f1f5f9;">
                        <span>💻 <strong>${d.device_name || d.device_type || 'Browser'}</strong> (${d.ip_address || 'Current IP'})</span>
                        <span style="font-size:0.72rem;color:#94a3b8;">${d.last_active ? new Date(d.last_active).toLocaleString() : 'Active'}</span>
                    </div>
                `).join('');
            }
        }

        if (!logs.length && !loginHistory.length) {
            wrap.innerHTML = '<div style="text-align:center;padding:2rem;color:#94a3b8;">No security activity logged yet.</div>';
            return;
        }

        let rows = '';
        logs.forEach(l => {
            rows += `
                <tr>
                    <td style="font-weight:600;color:#0f172a;">${l.user_name || 'Admin'}</td>
                    <td><span class="badge" style="background:rgba(99,102,241,0.1);color:#4f46e5;padding:2px 8px;border-radius:6px;font-size:0.74rem;font-weight:700;">${l.module || 'system'}</span></td>
                    <td style="color:#334155;font-size:0.82rem;">${l.action || '—'}</td>
                    <td style="font-size:0.78rem;color:#64748b;"><code>${l.ip_address || '—'}</code></td>
                    <td style="font-size:0.75rem;color:#94a3b8;white-space:nowrap;">${l.created_at ? new Date(l.created_at).toLocaleString() : '—'}</td>
                </tr>
            `;
        });

        wrap.innerHTML = `
            <table class="ld-table" style="width:100%;">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Module</th>
                        <th>Action Performed</th>
                        <th>IP Address</th>
                        <th>Time</th>
                    </tr>
                </thead>
                <tbody>${rows}</tbody>
            </table>
        `;
    } catch (e) {
        wrap.innerHTML = '<div style="text-align:center;padding:2rem;color:#ef4444;">Error loading logs.</div>';
    }
}

async function handleAdminPasswordChange(e) {
    e.preventDefault();
    const curr = document.getElementById('adminCurrPass').value;
    const newP = document.getElementById('adminNewPass').value;
    const conf = document.getElementById('adminConfPass').value;

    if (newP !== conf) {
        showToast('New passwords do not match.', 'error', '⚠️ Password Error');
        return;
    }

    try {
        const res = await fetch('/admin/security/password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ current_password: curr, new_password: newP, confirm_password: conf })
        });
        const d = await res.json();
        if (d.success) {
            showToast(d.message || 'Password changed successfully!', 'success', '🔒 Security');
            document.getElementById('adminPasswordForm').reset();
            loadAdminSecurityLogs();
        } else {
            showToast(d.error || 'Failed to change password.', 'error', '⚠️ Password Error');
        }
    } catch (err) {
        showToast('An error occurred updating password.', 'error', '⚠️ Server Error');
    }
}

async function toggleAdmin2fa() {
    try {
        const res = await fetch('/admin/security/2fa', { method: 'POST' });
        const d = await res.json();
        if (d.success) {
            const btn = document.getElementById('admin2faBtn');
            if (btn) {
                btn.textContent = d.enabled ? 'Disable 2FA' : 'Enable 2FA';
                btn.className = d.enabled ? 'ld-btn ld-btn-xs ld-btn-danger' : 'ld-btn ld-btn-xs ld-btn-primary';
            }
            showToast(d.enabled ? 'Two-Factor Authentication Enabled' : 'Two-Factor Authentication Disabled', 'success', '🛡️ 2FA Updated');
            loadAdminSecurityLogs();
        } else {
            showToast(d.error || 'Failed to update 2FA.', 'error', '⚠️ Error');
        }
    } catch (err) {
        showToast('Failed to toggle 2FA.', 'error', '⚠️ Server Error');
    }
}

function openModal(id) {
    const m = document.getElementById(id);
    if (m) m.classList.add('active');
}

function closeModal(id) {
    const m = document.getElementById(id);
    if (m) m.classList.remove('active');
}

function toggleAdminSidebar() {
    const sb = document.getElementById('adminSidebar');
    const dim = document.getElementById('adminDim');
    if (!sb) return;
    sb.classList.toggle('open');
    if (dim) dim.classList.toggle('active', sb.classList.contains('open'));
}

function autoCloseAdminSidebar() {
    if (window.innerWidth <= 600) {
        const sb = document.getElementById('adminSidebar');
        const dim = document.getElementById('adminDim');
        if (sb) sb.classList.remove('open');
        if (dim) dim.classList.remove('active');
    }
}

function toggleAddUserClassField() {
    const role = document.getElementById('addUserRole').value;
    const classGroup = document.getElementById('addUserClassGroup');
    const admissionGroup = document.getElementById('addUserAdmissionGroup');
    if (role === 'student') {
        classGroup.style.display = 'block';
        admissionGroup.style.display = 'block';
    } else {
        classGroup.style.display = 'none';
        admissionGroup.style.display = 'none';
    }
}

async function handleImport() {
    const fileInput = document.getElementById('importFile');
    const module = document.getElementById('importModule').value;
    const resultDiv = document.getElementById('importResult');

    if (!fileInput.files[0]) {
        resultDiv.innerHTML = '<span style="color:#f87171;">Please select a file first.</span>';
        return;
    }

    resultDiv.innerHTML = '<span style="color:#a5b4fc;">Uploading & processing...</span>';
    const formData = new FormData();
    formData.append('file', fileInput.files[0]);

    try {
        const res = await fetch('/data/import/' + module, { method: 'POST', body: formData });
        const data = await res.json();
        if (res.ok) {
            resultDiv.innerHTML = '<span style="color:#34d399;">Import Complete!</span> Total: ' + data.total + ' | Success: ' + data.success;
        } else {
            resultDiv.innerHTML = '<span style="color:#f87171;">Error: ' + (data.error || 'Upload failed') + '</span>';
        }
    } catch (e) {
        resultDiv.innerHTML = '<span style="color:#f87171;">Network error occurred.</span>';
    }
}

function handleExport() {
    const module = document.getElementById('exportModule').value;
    const format = document.getElementById('exportFormat').value;
    window.location.href = '/data/export/' + module + '?format=' + format;
}

document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
        autoCloseAdminSidebar();
        document.querySelectorAll('.ld-modal-overlay').forEach(m => m.classList.remove('active'));
    }
});
</script>
