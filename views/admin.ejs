      const drawer = document.getElementById('lpMemberDrawer');
      const overlay = document.getElementById('lpDrawerOverlay');
      const body = document.getElementById('lpMemberDrawerBody');
      body.innerHTML = '<p style="color:#94A3B8;text-align:center;padding:40px;">Loading profile dossier...</p>';
      
      overlay.classList.add('active');
      drawer.classList.add('open');

      try {
        const res = await fetch(`/admin/api/member/${userId}`);
        const data = await res.json();
        const m = data.member;

        body.innerHTML = `
          <!-- Digital Library Pass Card -->
          <div class="lp-digital-pass">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;">
              <div>
                <span style="font-size:0.75rem;letter-spacing:0.08em;opacity:0.8;">LIBRIKA DIGITAL PASS</span>
                <h2 style="font-size:1.35rem;font-weight:800;margin:4px 0 0 0;">${m.name}</h2>
                <div style="font-size:0.8rem;opacity:0.9;">${m.role.toUpperCase()} &bull; ${m.class || 'General'}</div>
              </div>
              <div style="font-size:1.8rem;">🎓</div>
            </div>
            <div class="lp-pass-barcode">
              <div style="font-family:monospace;font-weight:800;color:#0B5ED7;font-size:1.1rem;letter-spacing:2px;">${m.admission_no || `MEM-${m.id}`}</div>
            </div>
          </div>

          <!-- Overview Stats -->
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:20px;">
            <div style="background:#F8FAFC;padding:12px;border-radius:12px;border:1px solid #E2E8F0;">
              <span style="font-size:0.75rem;color:#64748B;">Active Books</span>
              <div style="font-size:1.25rem;font-weight:800;color:#0B5ED7;">${data.activeLoans.length}</div>
            </div>
            <div style="background:#F8FAFC;padding:12px;border-radius:12px;border:1px solid #E2E8F0;">
              <span style="font-size:0.75rem;color:#64748B;">Pending Fines</span>
              <div style="font-size:1.25rem;font-weight:800;color:#DC3545;">₹${data.totalFines}</div>
            </div>
