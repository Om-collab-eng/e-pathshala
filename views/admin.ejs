                                            </td>
                                            <td>
                                                <a href="/digital-library/content/<%= item.id %>" class="ld-btn ld-btn-xs" style="background: rgba(99, 102, 241, 0.08); color: #6366f1;">Read PDF</a>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="5" style="text-align: center; color: #64748b; padding: 2rem;">No digital items or PDFs uploaded yet. Use Digital Content Manager to publish e-books.</td>
