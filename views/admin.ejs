  <!-- ═══════════════════════════════════════════════════════════════
       6. INTERACTIVE CLIENT-SIDE JAVASCRIPT
       ═══════════════════════════════════════════════════════════════ -->
  <script>
    // ═══════════════════════════════════════════════════════════════
    // DYNAMIC INSPIRATIONAL QUOTE ENGINE (LIBRARIAN HERO)
    // ═══════════════════════════════════════════════════════════════
    window.LIBRARY_QUOTES = <%- JSON.stringify(typeof libraryQuotes !== 'undefined' ? libraryQuotes : []) %>;
    window.CATALOG_BOOKS_DATA = <%- JSON.stringify(typeof books !== 'undefined' ? books : []).replace(/</g, '\\u003c') %>;
    let currentQuoteIndex = <%= (typeof dailyQuote !== 'undefined' && dailyQuote && typeof dailyQuote.index === 'number') ? dailyQuote.index : 0 %>;
    let lastAwayTimestamp = Date.now();
    let isCyclingQuote = false;

    function cycleHeroQuote(isManual = false) {
      if (isCyclingQuote || !window.LIBRARY_QUOTES || window.LIBRARY_QUOTES.length === 0) return;
      isCyclingQuote = true;

      const spinIcon = document.getElementById('lpQuoteSpinIcon');
      if (spinIcon && isManual) {
        spinIcon.style.transform = 'rotate(360deg)';
      }

      const container = document.getElementById('lpQuoteContainer');
      if (container) {
        container.style.opacity = '0';
        container.style.transform = 'translateY(5px)';
      }

      let nextIndex;
      if (window.LIBRARY_QUOTES.length > 1) {
        do {
          nextIndex = Math.floor(Math.random() * window.LIBRARY_QUOTES.length);
        } while (nextIndex === currentQuoteIndex);
      } else {
        nextIndex = 0;
      }
      currentQuoteIndex = nextIndex;
      const q = window.LIBRARY_QUOTES[nextIndex];

      setTimeout(() => {
        const textEl = document.getElementById('lpQuoteText');
        const authorEl = document.getElementById('lpQuoteAuthor');
        if (textEl && q) textEl.textContent = `"${q.quote}"`;
        if (authorEl && q) authorEl.textContent = `— ${q.author}`;

        try {
          sessionStorage.setItem('last_library_quote_idx', currentQuoteIndex);
        } catch(e) {}

        if (container) {
          container.style.opacity = '1';
          container.style.transform = 'translateY(0)';
        }

        setTimeout(() => {
          if (spinIcon) spinIcon.style.transform = 'none';
          isCyclingQuote = false;
        }, 300);
      }, 200);
    }

    // Auto-cycle quote when user "comes back" (focus or tab visible)
    function onUserReturnToApp() {
      const now = Date.now();
      if (now - lastAwayTimestamp > 4000) {
        cycleHeroQuote(false);
      }
      lastAwayTimestamp = now;
    }

    window.addEventListener('focus', onUserReturnToApp);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') {
        onUserReturnToApp();
      } else {
        lastAwayTimestamp = Date.now();
      }
    });

    // On page load/refresh: ensure a fresh quote is presented
    document.addEventListener('DOMContentLoaded', () => {
      try {
        const lastIdx = sessionStorage.getItem('last_library_quote_idx');
        if (lastIdx !== null && parseInt(lastIdx) === currentQuoteIndex && window.LIBRARY_QUOTES.length > 1) {
          cycleHeroQuote(false);
        } else {
          sessionStorage.setItem('last_library_quote_idx', currentQuoteIndex);
        }
      } catch(e) {}
    });

    function navigateToModule(moduleName, subTab = null) {
      document.querySelectorAll('.lp-module-view').forEach(m => m.style.display = 'none');
      document.querySelectorAll('.lp-nav-item').forEach(btn => btn.classList.remove('active'));

      const target = document.getElementById(`module-${moduleName}`);
      if (target) target.style.display = 'block';

      // Update sidebar active button
      document.querySelectorAll('.lp-nav-item').forEach(btn => {
        const dMod = btn.getAttribute('data-module');
        const cleanText = btn.textContent.toLowerCase().replace(/[^a-z0-9]/g, '');
        const cleanMod = moduleName.toLowerCase().replace(/[^a-z0-9]/g, '');
        if (dMod === moduleName || (cleanMod && cleanText.includes(cleanMod))) {
          btn.classList.add('active');
        }
      });

      // Update mobile bottom dock active button
      document.querySelectorAll('.lp-dock-item').forEach(d => d.classList.remove('active'));
      const dockBtn = document.getElementById('lpdock-' + moduleName);
      if (dockBtn) dockBtn.classList.add('active');

      // Auto-close sidebar on mobile
      const sb = document.getElementById('lpSidebar');
      if (sb && window.innerWidth <= 1024) sb.classList.remove('open');
      const backdrop = document.getElementById('lpSidebarBackdrop');
      if (backdrop) backdrop.classList.remove('active');

      // If returning to dashboard, cycle quote to welcome the user back
      if (moduleName === 'dashboard') {
        cycleHeroQuote(false);
      }

      if (subTab) {
        if (moduleName === 'circulation') {
          switchCirculationTab(subTab, document.getElementById(`circ-tab-btn-${subTab}`));
        }
      }

      window.history.replaceState({}, '', `/admin?module=${moduleName}`);
    }

    function switchCatalogTab(tabName, btn) {
      document.querySelectorAll('#module-catalog .lp-tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('#module-catalog .lp-tab-pane').forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      const pane = document.getElementById(`catalog-tab-${tabName}`);
      if (pane) pane.classList.add('active');
    }

    function switchMemberTab(role, btn) {
      document.querySelectorAll('#module-members .lp-tab-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const rows = document.querySelectorAll('#membersTable tbody tr');
      rows.forEach(r => {
        if (role === 'students') r.style.display = r.getAttribute('data-role') === 'student' ? '' : 'none';
        else if (role === 'teachers') r.style.display = r.getAttribute('data-role') === 'teacher' ? '' : 'none';
        else if (role === 'staff') r.style.display = (r.getAttribute('data-role') === 'staff' || r.getAttribute('data-role') === 'librarian' || r.getAttribute('data-role') === 'admin') ? '' : 'none';
      });
    }

    function switchCirculationTab(tabName, btn) {
      document.querySelectorAll('#module-circulation .lp-tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('#module-circulation .lp-tab-pane').forEach(p => p.classList.remove('active'));
      if (btn) btn.classList.add('active');
      const pane = document.getElementById(`circ-pane-${tabName}`);
      if (pane) pane.classList.add('active');
    }

    function switchRequestTab(tabName, btn) {
      document.querySelectorAll('#module-requests .lp-tab-btn').forEach(b => b.classList.remove('active'));
      if (btn) btn.classList.add('active');
    }

    function switchSettingsTab(tabName, btn) {
      document.querySelectorAll('#module-settings .lp-tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('#module-settings .lp-tab-pane').forEach(p => p.classList.remove('active'));
      if (btn) btn.classList.add('active');
      const pane = document.getElementById(`settings-pane-${tabName}`);
      if (pane) pane.classList.add('active');
    }

    // ═══════════════════════════════════════════════════════════════
    // STUDENT PROGRESS CONTROLS (READ-ONLY LIBRARIAN VIEW)
    // ═══════════════════════════════════════════════════════════════
    let currentSpCategory = 'ALL';
    let currentSpView = 'table';

    function setStudentProgressCategory(cat, btn) {
      currentSpCategory = cat;
      document.querySelectorAll('#spCategoryTabs .lp-tab-btn').forEach(b => b.classList.remove('active'));
      if (btn) btn.classList.add('active');
      filterStudentProgress();
    }

    function setStudentProgressFilter(type, value) {
      if (type === 'category') {
        const btnMap = { 'ALL': 'spTabAll', 'BOOK': 'spTabBooks', 'QUIZ': 'spTabQuizzes', 'COURSE': 'spTabCourses' };
        const btn = document.getElementById(btnMap[value]);
        setStudentProgressCategory(value, btn);
      }
    }

    function switchStudentProgressView(view) {
      currentSpView = view;
      const tableView = document.getElementById('spTableView');
      const groupedView = document.getElementById('spGroupedView');
      const tableBtn = document.getElementById('spViewTableBtn');
      const groupedBtn = document.getElementById('spViewGroupedBtn');

      if (view === 'grouped') {
        if (tableView) tableView.style.display = 'none';
        if (groupedView) groupedView.style.display = 'block';
        if (tableBtn) { tableBtn.className = 'btn-secondary'; tableBtn.style.background = 'transparent'; tableBtn.style.border = 'none'; }
        if (groupedBtn) { groupedBtn.className = 'btn-primary'; groupedBtn.style.background = ''; groupedBtn.style.border = ''; }
        renderGroupedStudentView();
      } else {
        if (tableView) tableView.style.display = 'block';
        if (groupedView) groupedView.style.display = 'none';
        if (tableBtn) { tableBtn.className = 'btn-primary'; tableBtn.style.background = ''; tableBtn.style.border = ''; }
        if (groupedBtn) { groupedBtn.className = 'btn-secondary'; groupedBtn.style.background = 'transparent'; groupedBtn.style.border = 'none'; }
      }
    }

    function resetStudentProgressFilters() {
      const search = document.getElementById('spSearchInput');
      if (search) search.value = '';
      const status = document.getElementById('spStatusFilter');
      if (status) status.value = 'ALL';
      setStudentProgressCategory('ALL', document.getElementById('spTabAll'));
    }

    function filterStudentProgress() {
      const q = (document.getElementById('spSearchInput')?.value || '').toLowerCase().trim();
      const statusFilter = document.getElementById('spStatusFilter')?.value || 'ALL';
      const rows = document.querySelectorAll('#spTableBody .sp-row');
      let visibleCount = 0;

      rows.forEach(row => {
        const student = row.getAttribute('data-student') || '';
        const phone = row.getAttribute('data-phone') || '';
        const sClass = row.getAttribute('data-class') || '';
        const item = row.getAttribute('data-item') || '';
        const category = row.getAttribute('data-category') || '';
        const status = (row.getAttribute('data-status') || '').toUpperCase();

        const matchQuery = !q || student.includes(q) || phone.includes(q) || sClass.includes(q) || item.includes(q);
        const matchCategory = (currentSpCategory === 'ALL') || (category === currentSpCategory);

        let matchStatus = true;
        if (statusFilter === 'OVERDUE') {
          matchStatus = (status === 'OVERDUE');
        } else if (statusFilter === 'ACTIVE') {
          matchStatus = (status === 'ISSUED' || status === 'READING');
        } else if (statusFilter === 'PASSED') {
          matchStatus = (status === 'PASSED' || status === 'COMPLETED');
        } else if (statusFilter === 'ENROLLED') {
          matchStatus = (status === 'ENROLLED');
        }

        if (matchQuery && matchCategory && matchStatus) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });

      const countEl = document.getElementById('spVisibleCount');
      if (countEl) countEl.textContent = visibleCount;

      let emptyRow = document.getElementById('spNoMatchRow');
      if (visibleCount === 0 && rows.length > 0) {
        if (!emptyRow) {
          emptyRow = document.createElement('tr');
          emptyRow.id = 'spNoMatchRow';
          emptyRow.innerHTML = `<td colspan="6" style="text-align:center;padding:32px 20px;color:#94A3B8;">No records match the current search or filters.</td>`;
          document.getElementById('spTableBody')?.appendChild(emptyRow);
        } else {
          emptyRow.style.display = '';
        }
      } else if (emptyRow) {
        emptyRow.style.display = 'none';
      }

      if (currentSpView === 'grouped') {
        renderGroupedStudentView();
      }
    }

    function renderGroupedStudentView() {
      const container = document.getElementById('spGroupedContainer');
      if (!container) return;

      const rows = Array.from(document.querySelectorAll('#spTableBody .sp-row')).filter(r => r.style.display !== 'none');
      if (rows.length === 0) {
        container.innerHTML = `<div style="grid-column:1/-1;text-align:center;padding:40px;color:#94A3B8;">No student records found matching the criteria.</div>`;
        return;
      }

      const groups = {};
      rows.forEach(r => {
        const name = r.getAttribute('data-raw-student') || 'Unknown Student';
        if (!groups[name]) {
          groups[name] = {
            name,
            class: r.getAttribute('data-raw-class') || '',
            phone: r.getAttribute('data-raw-phone') || '',
            items: []
          };
        }
        groups[name].items.push({
          item: r.getAttribute('data-raw-item') || '',
          type: r.getAttribute('data-raw-type') || '',
          category: r.getAttribute('data-category') || '',
          status: r.getAttribute('data-status') || '',
          progress: r.getAttribute('data-raw-progress') || '',
          assigned: r.getAttribute('data-raw-assigned') || '',
          due: r.getAttribute('data-raw-due') || ''
        });
      });

      container.innerHTML = Object.values(groups).map(g => {
        return `
          <div class="card" style="padding:18px;border:1px solid var(--border-color);border-radius:12px;display:flex;flex-direction:column;justify-content:space-between;background:var(--bg-surface);">
            <div>
              <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:10px;margin-bottom:12px;border-bottom:1px solid var(--border-color);padding-bottom:10px;">
                <div>
