    function setCommonCover(url) {
      document.getElementById('cbfCoverUrl').value = url || '';
      const img = document.getElementById('cbfCoverImg');
      const ph = document.getElementById('cbfCoverPlaceholder');
      if (url) {
        if (img) { img.src = url; img.style.display = 'block'; }
        if (ph) ph.style.display = 'none';
      } else {
        if (img) { img.src = ''; img.style.display = 'none'; }
        if (ph) ph.style.display = 'block';
      }
    }

    function handleCommonCoverUpload(e) {
      const file = e.target.files && e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function(evt) {
        setCommonCover(evt.target.result);
        const coverLabel = document.getElementById('cbfCoverSourceLabel');
        if (coverLabel) coverLabel.innerHTML = 'Cover: <strong style="color:#475569;">Custom Upload</strong>';
      };
      reader.readAsDataURL(file);
    }

    function resetSmartScanner() {
      resetSmartScannerState();
      startSmartCamera();
    }

    async function fetchNextBookId() {
      const displayEl = document.getElementById('cbfBookIdDisplay');
      const inputEl = document.getElementById('cbfBookId');
      if (displayEl) displayEl.textContent = 'Generating ID...';
      try {
        const res = await fetch('/admin/api/books/next-id');
        const data = await res.json();
        if (data.success && data.bookId) {
          if (displayEl) displayEl.textContent = data.bookId;
          if (inputEl) inputEl.value = data.bookId;
          const barcodeImg = document.getElementById('barcodePreviewImg');
          if (barcodeImg) {
            barcodeImg.src = '/admin/api/barcode/' + encodeURIComponent(data.bookId);
            barcodeImg.style.display = 'block';
          }
        }
      } catch (e) {
        const fallback = 'VBPG' + new Date().getFullYear() + '0001';
        if (displayEl) displayEl.textContent = fallback;
        if (inputEl) inputEl.value = fallback;
      }
    }

    async function submitCommonBookForm(e) {
      e.preventDefault();
      const btn = document.getElementById('btnSaveCommonBook');
      if (btn) { btn.disabled = true; btn.textContent = '💾 Saving Book & Preparing Barcode...'; }

      const payload = {
        book_id: document.getElementById('cbfBookId').value.trim(),
        title: document.getElementById('cbfTitle').value.trim(),
        author: document.getElementById('cbfAuthor').value.trim(),
        publisher: document.getElementById('cbfPublisher').value.trim(),
        edition: document.getElementById('cbfEdition').value.trim(),
        publication_year: document.getElementById('cbfYear').value.trim(),
        language: document.getElementById('cbfLanguage').value.trim() || 'English',
        isbn: document.getElementById('cbfIsbn').value.trim(),
        price: document.getElementById('cbfPrice').value.trim(),
        subject: document.getElementById('cbfSubject').value.trim(),
        class: document.getElementById('cbfClass').value.trim(),
        total_copies: parseInt(document.getElementById('cbfCopies').value, 10) || 1,
        rack: document.getElementById('cbfRack').value.trim() || 'A',
        shelf: document.getElementById('cbfShelf').value.trim() || '1',
        book_condition: document.getElementById('cbfCondition').value || 'GOOD',
        description: document.getElementById('cbfDescription').value.trim(),
        cover_url: document.getElementById('cbfCoverUrl').value.trim(),
        back_cover_url: document.getElementById('cbfBackCoverUrl')?.value?.trim() || '',
        acquisition_item_id: document.getElementById('cbfAcqItemId')?.value?.trim() || ''
      };

      if (!payload.title) {
        alert('Book Title is required.');
        if (btn) { btn.disabled = false; btn.textContent = '💾 Verify & Save Book to Library'; }
        return;
      }

      try {
        const res = await fetch('/admin/book/add', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.success) {
          const assignedId = (data.book && data.book.book_id) ? data.book.book_id : (data.bookId || payload.book_id);
          currentSavedBook = {
            bookId: assignedId,
            title: payload.title,
            author: payload.author || 'Unknown'
          };

          // 1. Hide emptyCatalogRow if present
          const emptyRow = document.getElementById('emptyCatalogRow');
          if (emptyRow) emptyRow.style.display = 'none';

          // 2. Prepend newly added book to catalog table immediately
          const catalogTbody = document.getElementById('catalogTableBody');
          if (catalogTbody) {
            const tr = document.createElement('tr');
            tr.style.backgroundColor = '#EFF6FF';
            tr.style.transition = 'background-color 2s ease';
            const safeCover = payload.cover_url 
              ? `<img src="${payload.cover_url}" style="width:100%;height:100%;object-fit:cover;">`
              : `<span style="font-size:1.2rem;">📖</span>`;
            const shelfStr = (payload.rack && payload.shelf) ? `Rack ${payload.rack}-${payload.shelf}` : (payload.rack || 'Rack A-1');
            const copiesNum = parseInt(payload.total_copies, 10) || 1;
            const bookDbId = data.id || assignedId;
            const safeTitle = (payload.title || '').replace(/'/g, "\\'");
            const safeAuthor = (payload.author || '').replace(/'/g, "\\'");

            const escapeTxt = (s) => String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

            tr.innerHTML = `
              <td>
                <div style="display:flex;align-items:center;gap:12px;">
                  <div style="width:38px;height:52px;background:#E2E8F0;border-radius:6px;overflow:hidden;flex-shrink:0;display:flex;align-items:center;justify-content:center;">
                    ${safeCover}
                  </div>
                  <div>
                    <div style="font-weight:700;color:#111827;">${escapeTxt(payload.title)} <span style="font-size:0.65rem;background:#DCFCE7;color:#15803D;padding:1px 6px;border-radius:4px;font-weight:700;margin-left:4px;">NEW</span></div>
                    <div style="font-size:0.75rem;color:#64748B;">by ${escapeTxt(payload.author || 'Unknown')}</div>
                  </div>
                </div>
              </td>
              <td>
                <div style="font-family:monospace;font-weight:700;">${escapeTxt(assignedId)}</div>
                ${payload.isbn ? `<div style="font-size:0.7rem;color:#94A3B8;">ISBN: ${escapeTxt(payload.isbn)}</div>` : ''}
              </td>
              <td>
                <div>${escapeTxt(payload.subject || 'General')}</div>
                <div style="font-size:0.72rem;color:#94A3B8;">${escapeTxt(payload.language || 'English')}</div>
              </td>
              <td>
                <div style="font-weight:700;">${copiesNum} / ${copiesNum} Copies</div>
              </td>
              <td>
                <span style="background:#F1F5F9;padding:3px 8px;border-radius:6px;font-weight:600;font-size:0.8rem;">
                  ${escapeTxt(shelfStr)}
                </span>
              </td>
              <td>
                <span class="lp-status-pill available">In Stock</span>
              </td>
              <td>
                <div style="display:flex;gap:6px;">
                  <button class="btn-secondary" style="padding:4px 8px;font-size:0.75rem;" onclick="quickIssueBook('${bookDbId}', '${escapeTxt(assignedId)}')">Issue</button>
                  <button class="btn-secondary" style="padding:4px 8px;font-size:0.75rem;" onclick="openEditBookModal('${bookDbId}', '${safeTitle}', '${safeAuthor}', '${escapeTxt(payload.isbn || assignedId)}', '${copiesNum}', '${escapeTxt(shelfStr)}')">Edit</button>
                </div>
              </td>
            `;
            catalogTbody.insertBefore(tr, catalogTbody.firstChild);
            setTimeout(() => { tr.style.backgroundColor = ''; }, 3500);
          }

          // 3. Update any catalog count badges
          document.querySelectorAll('.lp-tab-badge, #heroCatalogCount').forEach(badge => {
            const current = parseInt(badge.textContent, 10);
            if (!isNaN(current)) badge.textContent = current + 1;
          });

          // Reset save button text
          if (btn) { btn.disabled = false; btn.textContent = '💾 Verify & Save Book to Library'; }

          // Close scanner modal and open print barcode modal
          closeAddBookModal();
          showBarcodePrintModal(currentSavedBook);
        } else {
          alert(data.error || 'Failed to save book.');
          if (btn) { btn.disabled = false; btn.textContent = '💾 Verify & Save Book to Library'; }
        }
      } catch (err) {
        alert('Network or server error while saving book.');
        if (btn) { btn.disabled = false; btn.textContent = '💾 Verify & Save Book to Library'; }
      }
    }

    // ── BARCODE LABEL PRINTING MODAL & ACTION ──
    function showBarcodePrintModal(book) {
      const modal = document.getElementById('barcodePrintModal');
      if (!modal) return;

      const titleEl = document.getElementById('lblBookTitle');
      const authorEl = document.getElementById('lblBookAuthor');
      const idEl = document.getElementById('lblBookId');
      const imgEl = document.getElementById('lblBarcodeImg');

      if (titleEl) titleEl.textContent = book.title || 'Untitled Book';
      if (authorEl) authorEl.textContent = book.author ? ('by ' + book.author) : '';
      if (idEl) idEl.textContent = book.bookId || '';
      if (imgEl && book.bookId) {
        imgEl.src = '/admin/api/barcode/' + encodeURIComponent(book.bookId);
      }

      modal.style.display = 'flex';
      modal.classList.add('active');
      document.body.classList.add('modal-open');
    }

    function printBarcodeSticker() {
      const labelContent = document.getElementById('printableBarcodeLabel');
      if (!labelContent) return;

      const printWin = window.open('', '_blank', 'width=460,height=360');
      if (!printWin) {
        alert('Please allow popups to print the barcode label.');
        return;
      }
      printWin.document.write(`
        <!DOCTYPE html>
        <html>
          <head>
            <title>Print Barcode Label - ${document.getElementById('lblBookId')?.textContent || ''}</title>
            <style>
              @page { size: auto; margin: 4mm; }
              body {
                font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
                margin: 0;
                padding: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: #FFF;
              }
              #printableBarcodeLabel {
                border: 1px dashed #333 !important;
                border-radius: 6px;
                padding: 8px 12px;
                text-align: center;
                width: 100%;
                max-width: 60mm;
                box-sizing: border-box;
              }
              img { max-width: 100%; height: auto; display: block; margin: 4px auto; }
            </style>
          </head>
          <body>
            ${labelContent.outerHTML}
            <` + `script>
              window.onload = function() {
                window.focus();
                window.print();
                setTimeout(function() { window.close(); }, 500);
              };
            <` + `/script>
          </body>
        </html>
      `);
      printWin.document.close();
    }

