                      <div style="font-size:0.78rem;color:#334155;margin-top:4px;display:flex;flex-wrap:wrap;gap:10px;">
                        <span>Barcode: <strong style="color:#0B5ED7;">${escapeHtml(l.barcode || 'N/A')}</strong></span>
                        <span>Shelf: <strong>${escapeHtml(l.shelf_location || 'A-1')}</strong></span>
