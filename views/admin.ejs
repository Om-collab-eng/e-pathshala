    /**
     * Captures high-res video frame with precise 2:3 portrait center-crop
     * and always uses the flipped model so characters and text are read properly for OCR
     */
    function captureVideoFrame() {
      const video = document.getElementById('smartBookVideo');
      const canvas = document.getElementById('smartBookCanvas') || document.createElement('canvas');
      if (!video || !video.videoWidth || !video.videoHeight) return null;

      const vw = video.videoWidth;
      const vh = video.videoHeight;
      const targetAspect = 2 / 3; // Standard 2:3 portrait book aspect ratio

      let cropW, cropH, cropX, cropY;
      const currentAspect = vw / vh;

      if (currentAspect > targetAspect) {
        // Video is wider than 2:3 (e.g. 16:9 webcam). Crop sides to center 2:3
        cropH = vh;
        cropW = Math.round(vh * targetAspect);
        cropX = Math.round((vw - cropW) / 2);
        cropY = 0;
      } else {
        // Video is taller than 2:3 (e.g. 9:16 mobile). Crop top & bottom
        cropW = vw;
        cropH = Math.round(vw / targetAspect);
        cropX = 0;
        cropY = Math.round((vh - cropH) / 2);
      }

      canvas.width = cropW;
      canvas.height = cropH;
      const ctx = canvas.getContext('2d');

      // Always use flipped model to capture the book so characters read properly left-to-right
      if (alwaysFlippedModel) {
        ctx.translate(cropW, 0);
        ctx.scale(-1, 1);
      }

      ctx.drawImage(video, cropX, cropY, cropW, cropH, 0, 0, cropW, cropH);

      // High-quality JPEG for maximum OCR and barcode legibility
      const base64 = canvas.toDataURL('image/jpeg', 0.92);
      const sizeBytes = Math.round((base64.length * 3) / 4);
      const sizeKb = Math.round((sizeBytes / 1024) * 10) / 10;

      return {
        base64,
        width: cropW,
        height: cropH,
        sizeKb,
        format: 'JPEG'
      };
    }

