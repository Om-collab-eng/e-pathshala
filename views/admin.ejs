    // ─────────────────────────────────────────────────────────────────
    // Circulation Desk Scanner Operations
    // ─────────────────────────────────────────────────────────────────
    async function lookupMemberForIssue() {
      const q = document.getElementById('circMemberInput').value.trim();
      if (!q) return;
      try {
        const res = await fetch('/admin/api/circulation/lookup-member', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ query: q })
        });
        const data = await res.json();
        const prev = document.getElementById('circMemberPreview');
        if (data.status === 'success') {
          activeCheckoutMember = data.member;
          prev.style.display = 'flex';
          prev.className = 'lp-preview-card';
          prev.innerHTML = `
            <div class="lp-preview-avatar">${data.member.name[0]}</div>
            <div style="flex:1;">
              <div style="font-weight:800;color:#111827;">${data.member.name} (${data.member.role})</div>
              <div style="font-size:0.8rem;color:#64748B;">Adm No: <strong>${data.member.admission_no || 'N/A'}</strong> &bull; Class: ${data.member.class || 'N/A'}</div>
              <div style="font-size:0.8rem;color:#0B5ED7;font-weight:700;margin-top:2px;">Currently Borrowed: ${data.activeCount} / ${data.borrowingLimit} Books</div>
            </div>
            <span style="color:#198754;font-weight:800;">✓ Verified</span>
          `;
          checkIssueReadiness();
        } else {
          activeCheckoutMember = null;
          prev.style.display = 'block';
          prev.className = 'lp-preview-card';
          prev.innerHTML = `<span style="color:#DC3545;font-weight:700;">⚠️ ${data.message}</span>`;
          checkIssueReadiness();
        }
      } catch (e) {
        console.error(e);
      }
    }

    async function lookupBookForIssue() {
      const barcode = document.getElementById('circBookInput').value.trim();
      if (!barcode) return;
      try {
        const res = await fetch('/admin/api/circulation/lookup-book', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ barcode })
        });
        const data = await res.json();
        const prev = document.getElementById('circBookPreview');
        if (data.status === 'success') {
          activeCheckoutBook = data.book;
          prev.style.display = 'flex';
          prev.className = 'lp-preview-card';
          prev.innerHTML = `
            <div class="lp-preview-avatar" style="background:#E8F5E9;color:#198754;">📖</div>
            <div style="flex:1;">
              <div style="font-weight:800;color:#111827;">${data.book.title}</div>
              <div style="font-size:0.8rem;color:#64748B;">Author: ${data.book.author} &bull; Shelf: <strong>${data.book.shelf_location || 'A-1'}</strong></div>
              <div style="font-size:0.8rem;color:#198754;font-weight:700;">Available Stock: ${data.book.available_copies} Copies</div>
            </div>
            <span style="color:#198754;font-weight:800;">✓ Ready</span>
          `;
          checkIssueReadiness();
        } else {
          activeCheckoutBook = null;
          prev.style.display = 'block';
          prev.className = 'lp-preview-card';
          prev.innerHTML = `<span style="color:#DC3545;font-weight:700;">⚠️ ${data.message}</span>`;
          checkIssueReadiness();
        }
      } catch (e) {
        console.error(e);
      }
    }

    function checkIssueReadiness() {
      const btn = document.getElementById('circConfirmIssueBtn');
      if (activeCheckoutMember && activeCheckoutBook) {
        btn.disabled = false;
      } else {
        btn.disabled = true;
      }
    }

    async function submitCirculationIssue() {
      if (!activeCheckoutMember || !activeCheckoutBook) return;
      const days = document.getElementById('circLoanDays').value;
      try {
        const res = await fetch('/admin/api/circulation/issue', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            member_id: activeCheckoutMember.id,
            book_id: activeCheckoutBook.id,
            barcode: activeCheckoutBook.copy_barcode,
            due_days: days
          })
        });
        const data = await res.json();
        if (data.status === 'success') {
          alert(`✅ ${data.message}`);
          window.location.reload();
        } else {
          alert(`❌ ${data.message}`);
        }
      } catch (e) {
        alert('Circulation issue error: ' + e.message);
      }
    }

    async function submitCirculationReturn() {
      const barcode = document.getElementById('circReturnBarcode').value.trim();
      if (!barcode) return;
      try {
        const res = await fetch('/admin/api/circulation/return', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ barcode })
        });
        const data = await res.json();
        const resDiv = document.getElementById('circReturnResult');
        resDiv.style.display = 'block';
        if (data.status === 'success') {
          resDiv.innerHTML = `
            <div style="color:#146C43;font-weight:800;font-size:1.05rem;">✅ Check-in Successful!</div>
            <div style="font-size:0.9rem;color:#111827;margin-top:4px;">${data.message}</div>
            ${data.fine > 0 ? `<div style="color:#DC3545;font-weight:700;margin-top:4px;">Overdue Fine Calculated: ₹${data.fine}</div>` : ''}
            ${data.reservation_alert ? `<div style="color:#0B5ED7;font-weight:700;margin-top:4px;">${data.reservation_alert}</div>` : ''}
          `;
          document.getElementById('circReturnBarcode').value = '';
        } else {
          resDiv.innerHTML = `<span style="color:#DC3545;font-weight:700;">❌ ${data.message}</span>`;
        }
      } catch (e) {
        alert('Return error: ' + e.message);
      }
    }

    async function rapidReturnPrompt(txId) {
      if (!confirm('Confirm return for this issued book?')) return;
      try {
        const res = await fetch('/admin/api/circulation/return', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ transaction_id: txId })
        });
        const data = await res.json();
        alert(data.message);
        window.location.reload();
      } catch (e) {
        alert(e.message);
      }
    }

    async function renewLoan(txId) {
      try {
        const res = await fetch('/admin/api/circulation/renew', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ transaction_id: txId, extend_days: 14 })
        });
        const data = await res.json();
        alert(data.message);
        window.location.reload();
      } catch (e) {
        alert(e.message);
      }
    }

