<script>
    // Tab switching engine
    function switchTab(tabId, element) {
        // Hide all tab contents
        document.querySelectorAll('.tab-content').forEach(el => el.style.display = 'none');
        
        // Remove active class from all tab buttons
        document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));
        
        // Show target tab content
        const targetTab = document.getElementById('tab-' + tabId);
        if (targetTab) {
            targetTab.style.display = 'block';
        }
        
        // Find corresponding tab buttons && mark active (sync sidebar + bottom nav buttons)
        document.querySelectorAll(`.tab-btn[onclick*="switchTab('${tabId}'"]`).forEach(el => el.classList.add('active'));
        if (element) {
            element.classList.add('active');
        }

        // Update URL state without page reload
        window.history.pushState(null, '', `?section=${tabId}`);
    }

    // Table filter engine
    function filterTable(inputId, tableId, searchColumns) {
        const input = document.getElementById(inputId);
        const filter = input.value.toLowerCase();
        const table = document.getElementById(tableId);
        if (!table) return;
        
        const tr = table.getElementsByTagName("tr");

        for (let i = 1; i < tr.length; i++) {
            const tds = tr[i].getElementsByTagName("td");
            let matchFound = false;
            
            for(let colIndex of searchColumns) {
                if (tds[colIndex]) {
                    const textValue = tds[colIndex].textContent || tds[colIndex].innerText;
                    if (textValue.toLowerCase().indexOf(filter) > -1) {
                        matchFound = true;
                        break;
                    }
                }
            }
            
            tr[i].style.display = matchFound ? "" : "none";
        }
    }

    // ── Book Action Modal ─────────────────────────────────────────────────────
    let _bamBookId = null, _bamBarcodeId = null;

    function openBookMenu(id, title, author, coverUrl, barcodeId, totalCopies, availCopies) {
        _bamBookId    = id;
        _bamBarcodeId = barcodeId;

        document.getElementById('bamTitle').textContent  = title;
        document.getElementById('bamAuthor').textContent = 'by ' + author;
        document.getElementById('bamCopies').textContent = availCopies + ' of ' + totalCopies + ' copies available';

        const img = document.getElementById('bamCover');
        const fb  = document.getElementById('bamCoverFallback');
        if (coverUrl) {
            img.src = coverUrl;
            img.style.display = 'block';
            fb.style.display  = 'none';
        } else {
            img.style.display = 'none';
            fb.style.display  = 'flex';
        }

        document.getElementById('editBookId').value = id;
        document.getElementById('editTitle').value  = title;
        document.getElementById('editAuthor').value = author;

        document.getElementById('bookActionModal').style.display = 'flex';
    }

    function closeBookMenu() {
        document.getElementById('bookActionModal').style.display = 'none';
    }

    function bamEdit() {
        closeBookMenu();
        fetch('/admin/api/book/' + _bamBookId)
            .then(r => r.json())
            .then(d => {
                if (d.book) {
                    const b = d.book;
                    document.getElementById('editBookId').value      = b.id;
                    document.getElementById('editTitle').value       = b.title       || '';
                    document.getElementById('editAuthor').value      = b.author      || '';
                    document.getElementById('editPublisher').value   = b.publisher   || '';
                    document.getElementById('editIsbn').value        = b.isbn        || '';
                    document.getElementById('editGenre').value       = b.genre       || '';
                    document.getElementById('editClass').value       = b['class']    || '';
                    document.getElementById('editSubject').value     = b.subject     || '';
                    document.getElementById('editLanguage').value    = b.language    || '';
                    document.getElementById('editDescription').value = b.description || '';
                }
            })
            .catch(() => {});
        document.getElementById('editBookModal').style.display = 'flex';
    }

    function bamAddCopy() {
        if (!confirm('Add 1 more copy to this book?')) return;
        fetch('/admin/api/add-copy/' + _bamBookId, { method: 'POST' })
            .then(r => r.json())
            .then(d => {
                if (d.status === 'success') {
                    showBamAlert('Copy added! Total copies: ' + d.total_copies, 'success');
                    closeBookMenu();
                    setTimeout(() => location.reload(), 1200);
                } else {
                    showBamAlert(d.message || 'Failed to add copy', 'error');
                }
            });
    }

    function bamIssue() {
        closeBookMenu();
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.tab-content').forEach(c => c.style.display = 'none');
        const txTab = document.querySelector('[data-tab="tab-tx"]');
        if (txTab) txTab.click();
        const bcInput = document.getElementById('txBookBarcode');
        if (bcInput) { bcInput.value = _bamBarcodeId; bcInput.focus(); }
    }

    function bamView() {
        closeBookMenu();
        // Show admin book info modal instead of student page
        const modal = document.getElementById('adminBookInfoModal');
        if (modal) {
            document.getElementById('abiTitle').textContent = _bamTitle;
            document.getElementById('abiAuthor').textContent = _bamAuthor;
            document.getElementById('abiBarcode').textContent = _bamBarcodeId;
            document.getElementById('abiCopies').textContent = _bamTotalCopies + ' total, ' + _bamAvailCopies + ' available';
            const imgEl = document.getElementById('abiCover');
            if (_bamCoverUrl) { imgEl.src = _bamCoverUrl; imgEl.style.display = 'block'; }
            else { imgEl.style.display = 'none'; }
            modal.style.display = 'flex';
        }
    }

    async function submitEditBook(e) {
        e.preventDefault();
        const btn = document.getElementById('editBookSaveBtn');
        btn.textContent = 'Saving...'; btn.disabled = true;

        const payload = {
            title:       document.getElementById('editTitle').value,
            author:      document.getElementById('editAuthor').value,
            publisher:   document.getElementById('editPublisher').value,
            isbn:        document.getElementById('editIsbn').value,
            genre:       document.getElementById('editGenre').value,
            class:       document.getElementById('editClass').value,
            subject:     document.getElementById('editSubject').value,
            language:    document.getElementById('editLanguage').value,
            description: document.getElementById('editDescription').value,
        };

        const res  = await fetch('/admin/api/update-book/' + document.getElementById('editBookId').value, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });
        const data = await res.json();
        btn.textContent = 'Save Changes'; btn.disabled = false;

        if (data.status === 'success') {
            document.getElementById('editBookModal').style.display = 'none';
            showBamAlert('Book updated!', 'success');
            setTimeout(() => location.reload(), 1200);
        } else {
            showBamAlert(data.message || 'Update failed', 'error');
        }
    }

    function showBamAlert(msg, type) {
        const el = document.createElement('div');
        const bg = type === 'success' ? 'var(--lg)' : 'var(--lr)';
        el.style.cssText = `position:fixed;top:1.5rem;right:1.5rem;z-index:99999;background:${bg};color:white;padding:12px 20px;border-radius:12px;font-weight:700;font-size:0.88rem;box-shadow:0 4px 20px rgba(0,0,0,0.2);transition:opacity 0.4s;`;
        el.textContent = msg;
        document.body.appendChild(el);
        setTimeout(() => { el.style.opacity = '0'; setTimeout(() => el.remove(), 400); }, 2500);
    }
    // ─────────────────────────────────────────────────────────────────────────

    // ── Reservation approve / reject ──────────────────────────────────────────
    function approveReservation(resId, bookId, userId) {
        const row = document.getElementById('res-row-' + resId);
        fetch('/admin/api/reservation/' + resId + '/approve', { method: 'POST' })
            .then(r => r.json())
            .then(d => {
                if (d.status === 'success') {
                    showBamAlert('✅ Reservation approved — book issued!', 'success');
                    if (row) { row.style.opacity = '0'; setTimeout(() => row.remove(), 400); }
                    // Update badge count
                    const badge = document.getElementById('resBadge');
                    if (badge) {
                        const cur = parseInt(badge.textContent) - 1;
                        if (cur <= 0) badge.remove(); else badge.textContent = cur;
                    }
                } else {
                    showBamAlert(d.message || 'Failed to approve', 'error');
                }
            })
            .catch(() => showBamAlert('Network error', 'error'));
    }

    function rejectReservation(resId) {
        if (!confirm('Reject this book request? The student will be notified.')) return;
        const row = document.getElementById('res-row-' + resId);
        fetch('/admin/api/reservation/' + resId + '/reject', { method: 'POST' })
            .then(r => r.json())
            .then(d => {
                if (d.status === 'success') {
                    showBamAlert('Request rejected.', 'success');
                    if (row) { row.style.opacity = '0'; setTimeout(() => row.remove(), 400); }
                    const badge = document.getElementById('resBadge');
                    if (badge) {
                        const cur = parseInt(badge.textContent) - 1;
                        if (cur <= 0) badge.remove(); else badge.textContent = cur;
                    }
                } else {
                    showBamAlert(d.message || 'Failed to reject', 'error');
                }
            })
            .catch(() => showBamAlert('Network error', 'error'));
    }
    // ─────────────────────────────────────────────────────────────────────────

    // ── Book Cover Fallback (tries Open Library via ISBN, then emoji) ─────────
    function bookCoverFallback(img) {
        const isbn = img.dataset.isbn;
        if (isbn) {
            img.onerror = function() {
                this.onerror = null;
                this.outerHTML = '<div style="width:40px;height:54px;background:var(--bg);border-radius:6px;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:1.2rem;">📖</div>';
            };
            img.src = 'https://covers.openlibrary.org/b/isbn/' + isbn + '-S.jpg';
        } else {
            img.onerror = null;
            img.outerHTML = '<div style="width:40px;height:54px;background:var(--bg);border-radius:6px;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:1.2rem;">📖</div>';
        }
    }

    // ── Delete single book ────────────────────────────────────────────────────
    let _deleteTargetId   = null;
    let _deleteTargetName = '';

    function bamDelete() {
        _deleteTargetId   = _bamBookId;
        _deleteTargetName = document.getElementById('bamTitle').textContent;
        closeBookMenu();
        document.getElementById('deleteBookModalTitle').textContent = 'Delete "' + _deleteTargetName + '"?';
        document.getElementById('deleteBookModalMsg').textContent   = 'This will permanently remove this book && all its copies. Active loans will be logged as returned. This cannot be undone.';
        document.getElementById('deleteBookModal').style.display    = 'flex';
    }

    function closeDeleteBookModal() {
        document.getElementById('deleteBookModal').style.display = 'none';
    }

    function confirmDeleteBookNow() {
        const btn = document.getElementById('deleteBookConfirmBtn');
        btn.textContent = 'Deleting...'; btn.disabled = true;
        fetch('/admin/api/delete-book/' + _deleteTargetId, { method: 'POST' })
            .then(r => r.json())
            .then(d => {
                btn.textContent = 'Yes, Delete'; btn.disabled = false;
                if (d.status === 'success') {
                    closeDeleteBookModal();
                    showBamAlert('Book deleted successfully!', 'success');
                    // Remove the row from DOM instantly without reload
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showBamAlert(d.message || 'Delete failed', 'error');
                }
            })
            .catch(() => { btn.textContent = 'Yes, Delete'; btn.disabled = false; showBamAlert('Network error', 'error'); });
    }

    // ── Delete ALL books ──────────────────────────────────────────────────────
    function confirmDeleteAll() {
        document.getElementById('deleteAllConfirmInput').value = '';
        document.getElementById('deleteAllBooksModal').style.display = 'flex';
    }

    function closeDeleteAllModal() {
        document.getElementById('deleteAllBooksModal').style.display = 'none';
    }

    function confirmDeleteAllNow() {
        const inputVal = document.getElementById('deleteAllConfirmInput').value.trim();
        if (inputVal !== 'DELETE ALL') {
            showBamAlert('Please type DELETE ALL exactly to confirm', 'error');
            return;
        }
        const btn = document.getElementById('deleteAllConfirmBtn');
        btn.textContent = 'Deleting...'; btn.disabled = true;
        fetch('/admin/api/delete-all-books', { method: 'POST' })
            .then(r => r.json())
            .then(d => {
                btn.textContent = 'Wipe All Books'; btn.disabled = false;
                if (d.status === 'success') {
                    closeDeleteAllModal();
                    showBamAlert('All books deleted — ' + (d.deleted || 0) + ' removed!', 'success');
                    setTimeout(() => location.reload(), 1200);
                } else {
                    showBamAlert(d.message || 'Delete failed', 'error');
                }
            })
            .catch(() => { btn.textContent = 'Wipe All Books'; btn.disabled = false; showBamAlert('Network error', 'error'); });
    }
    // ─────────────────────────────────────────────────────────────────────────

    // Modal Control
    function openModal(modalId) {
        document.getElementById(modalId).style.display = 'flex';
        if (modalId === 'addUserModal') {
            toggleAddUserClassField();
        }
    }

    function closeModal(modalId) {
        document.getElementById(modalId).style.display = 'none';
    }

    // View User details modal injector
    function openViewUserModal(userData) {
        document.getElementById('vUserName').innerText = userData.name || 'Pending Profile';
        document.getElementById('vUserPhone').innerText = userData.phone || 'N/A';
        document.getElementById('vUserEmail').innerText = userData.email || 'N/A';
        document.getElementById('vUserPassword').innerText = userData.password || 'N/A';
        
        const roleSpan = document.getElementById('vUserRole');
        roleSpan.innerText = (userData.role || 'student').toUpperCase();
        if (userData.role === 'admin') {
            roleSpan.className = 'ld-badge ld-badge-warning';
        } else {
            roleSpan.className = 'ld-badge ld-badge-info';
        }
        
        document.getElementById('vUserSchool').innerText = userData.school_code || 'N/A';
        document.getElementById('vUserClass').innerText = userData.class || 'N/A';
        document.getElementById('vUserAdmission').innerText = userData.admission_no || 'N/A';
        
        const statusSpan = document.getElementById('vUserStatus');
        if (userData.is_banned) {
            statusSpan.innerText = 'BANNED';
            statusSpan.className = 'ld-badge ld-badge-danger';
        } else {
            statusSpan.innerText = 'ACTIVE';
            statusSpan.className = 'ld-badge ld-badge-success';
        }
        
        openModal('viewUserModal');
    }

    // Toggle class && admission field inputs dynamically based on selected role
    function toggleAddUserClassField() {
        const role = document.getElementById('addUserRole').value;
        const classGroup = document.getElementById('addUserClassGroup');
        const admissionGroup = document.getElementById('addUserAdmissionGroup');
        const classInput = classGroup.querySelector('input');
        const admissionInput = admissionGroup.querySelector('input');
        
        if (role === 'student') {
            classGroup.style.display = 'block';
            admissionGroup.style.display = 'block';
            classInput.setAttribute('required', 'required');
            admissionInput.setAttribute('required', 'required');
        } else {
            classGroup.style.display = 'none';
            admissionGroup.style.display = 'none';
            classInput.removeAttribute('required');
            admissionInput.removeAttribute('required');
        }
    }

    // Data Hub Handlers
    async function handleImport() {
        const fileInput = document.getElementById('importFile');
        const module = document.getElementById('importModule').value;
        const resultDiv = document.getElementById('importResult');

        if (!fileInput.files[0]) {
            resultDiv.innerHTML = '<span style="color:var(--lr)">Please select a file first.</span>';
            return;
        }

        resultDiv.innerHTML = '<span style="color:var(--lp)">Uploading && processing file...</span>';
        const formData = new FormData();
        formData.append('file', fileInput.files[0]);

        try {
            const res = await fetch(`/data/import/${module}`, { method: 'POST', body: formData });
            const data = await res.json();
            
            if (res.ok) {
                let html = `<span style="color:var(--lg)">Import Complete!</span><br>
                            Total: ${data.total} | Success: ${data.success}<br>
                            Failed: ${data.failed} | Duplicates: ${data.duplicates}`;
                if (data.errors && data.errors.length > 0) {
                    html += `<div style="color:var(--lr); font-size:0.7rem; margin-top:5px; max-height: 80px; overflow-y: auto;">
                                ${data.errors.join('<br>')}
                             </div>`;
                }
                resultDiv.innerHTML = html;
            } else {
                resultDiv.innerHTML = `<span style="color:var(--lr)">Error: ${data.error || 'Upload failed'}</span>`;
            }
        } catch (e) {
            resultDiv.innerHTML = `<span style="color:var(--lr)">Network connection error occurred.</span>`;
        }
    }

    function handleExport() {
        const module = document.getElementById('exportModule').value;
        const format = document.getElementById('exportFormat').value;
        window.location.href = `/data/export/${module}?format=${format}`;
    }

    // Close modal when clicking on overlay background
    window.onclick = function(event) {
        if (event.target.classList.contains('ld-modal-overlay')) {
            event.target.style.display = 'none';
        }
    }

    // Smart greeting
    const hour = new Date().getHours();
    const greet = hour < 12 ? 'Good Morning' : hour < 17 ? 'Good Afternoon' : 'Good Evening';
    const name = '<%= (session.user_name || "Librarian").split(' ')[0] %>';
    document.getElementById('greetingText').textContent = `${greet}, ${name}!`;

    // Today's date
    const opts = { day: 'numeric', month: 'long', year: 'numeric' };
    document.getElementById('todayDate').textContent = new Date().toLocaleDateString('en-IN', opts);

    // Search clear button
    const searchInput = document.getElementById('globalSearch');
    const clearBtn = document.getElementById('searchClear');
    function doSearch(val) {
        clearBtn.style.display = val ? 'block' : 'none';
        // Filter activity cards
        document.querySelectorAll('.ld-activity-card').forEach(card => {
            const text = card.textContent.toLowerCase();
            card.style.display = (!val || text.includes(val.toLowerCase())) ? '' : 'none';
        });
    }

    // Initialize Tab based on URL
    document.addEventListener('DOMContentLoaded', () => {
        const params = new URLSearchParams(window.location.search);
        const section = params.get('section') || 'dashboard';
        switchTab(section);
    });

function toggleAdminSidebar() {
    const sb = document.querySelector('.ld-sidebar');
    const dim = document.getElementById('adminDim');
    if (!sb) return;
    sb.classList.toggle('open');
    if (dim) dim.classList.toggle('active', sb.classList.contains('open'));
}

</script>
