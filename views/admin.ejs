    function handleSingleSlotUpload(e, slot) {
      const file = e.target.files && e.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = (evt) => {
        const base64 = evt.target.result;
        const testImg = new Image();
        testImg.onload = () => {
          const meta = {
            width: testImg.naturalWidth,
            height: testImg.naturalHeight,
            sizeKb: Math.round((file.size / 1024) * 10) / 10,
            format: (file.type ? file.type.replace('image/', '') : 'jpeg').toUpperCase()
          };
          if (slot === 'front') {
            setFrontCoverSnapshot(base64, meta);
          } else {
            setBackCoverSnapshot(base64, meta);
          }
        };
        testImg.src = base64;
      };
      reader.readAsDataURL(file);
    }

    function handleSmartPhotosUpload(e) {
      const files = e.target.files;
      if (!files || files.length === 0) return;

      const reader1 = new FileReader();
      reader1.onload = (evt1) => {
        const base64_1 = evt1.target.result;
        const img1 = new Image();
        img1.onload = () => {
          const meta1 = {
            width: img1.naturalWidth,
            height: img1.naturalHeight,
            sizeKb: Math.round((files[0].size / 1024) * 10) / 10,
            format: (files[0].type ? files[0].type.replace('image/', '') : 'jpeg').toUpperCase()
          };
          setFrontCoverSnapshot(base64_1, meta1);

          if (files.length > 1) {
            const reader2 = new FileReader();
            reader2.onload = (evt2) => {
              const base64_2 = evt2.target.result;
              const img2 = new Image();
              img2.onload = () => {
                const meta2 = {
                  width: img2.naturalWidth,
                  height: img2.naturalHeight,
                  sizeKb: Math.round((files[1].size / 1024) * 10) / 10,
                  format: (files[1].type ? files[1].type.replace('image/', '') : 'jpeg').toUpperCase()
                };
                setBackCoverSnapshot(base64_2, meta2);
              };
              img2.src = base64_2;
            };
            reader2.readAsDataURL(files[1]);
          }
        };
        img1.src = base64_1;
      };
      reader1.readAsDataURL(files[0]);
    }

    async function triggerSmartScanProcessing() {
      if (!frontSnapBase64) {
        logDebugStep('02', 'Front image missing', 'Front cover snapshot is required before running analysis.', true);
        alert('Please snap or upload the front cover first.');
        return;
      }

      // Stop camera while processing in background
      stopSmartCamera();

      const procBanner = document.getElementById('smartScanProcessing');
      const verifSec = document.getElementById('smartBookVerificationSection');
      const statusTitle = document.getElementById('smartProcessStatus');
      const statusSub = document.getElementById('smartProcessSubstatus');

      if (procBanner) procBanner.style.display = 'block';
      if (verifSec) verifSec.style.display = 'none';
      if (statusTitle) statusTitle.textContent = '🧠 AI reading title, author, edition & ISBN from covers...';
      if (statusSub) statusSub.textContent = 'Hybrid Python OCR + Groq AI + fast web crawling in progress...';

      logDebugStep('05', 'Image preprocessing started', 'Dispatching front & back snapshots to backend pipeline...');

      try {
        const res = await fetch('/admin/api/books/smart-scan', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            frontImageBase64: frontSnapBase64,
            backImageBase64: backSnapBase64
          })
        });
        const data = await res.json();

        // Print full server debug trace sequentially into Debug Console
        if (data.debugTrace && Array.isArray(data.debugTrace)) {
          for (const item of data.debugTrace) {
            logDebugStep(item.step, item.title, item.details, !!item.isError);
          }
        }

        if (data.success && data.book) {
          lastSmartScanResult = data;
          populateSmartBookForm(data);
          if (procBanner) procBanner.style.display = 'none';
          if (verifSec) {
            verifSec.style.display = 'block';
            verifSec.scrollIntoView({ behavior: 'smooth' });
          }
        } else {
          // Explicitly report failing step and error details; NEVER hide behind generic messages
          const failMsg = data.error || 'Pipeline execution failed';
          logDebugStep(data.failingStep || '15', 'Pipeline FAILED', failMsg, true);
          alert(`Analysis Warning: ${failMsg}\n\nReview form opened with your photos attached for manual completion.`);
          if (procBanner) procBanner.style.display = 'none';
          if (verifSec) {
            verifSec.style.display = 'block';
            setCommonCover(frontSnapBase64);
            verifSec.scrollIntoView({ behavior: 'smooth' });
          }
        }
      } catch (err) {
        console.error('Smart scan error:', err);
        logDebugStep('15', 'Pipeline FAILED', 'Network or connection error: ' + err.message, true);
        alert('Network/Server connection error. Review form opened with your captured photos attached.');
        if (procBanner) procBanner.style.display = 'none';
        if (verifSec) {
          verifSec.style.display = 'block';
          setCommonCover(frontSnapBase64);
          verifSec.scrollIntoView({ behavior: 'smooth' });
        }
      }
    }

    function populateSmartBookForm(data) {
      const b = data.book || {};
      const bookId = data.bookId || b.book_id || '';

      const idDisp = document.getElementById('cbfBookIdDisplay');
      const idInput = document.getElementById('cbfBookId');
      if (idDisp) idDisp.textContent = bookId;
      if (idInput) idInput.value = bookId;

      // Barcode image
      const barcodeImg = document.getElementById('barcodePreviewImg');
      if (barcodeImg && data.barcodeUrl) {
        barcodeImg.src = data.barcodeUrl;
        barcodeImg.style.display = 'block';
      }

      // Cover switcher buttons
      const btnOnline = document.getElementById('btnToggleOnlineCover');
      const btnSnap = document.getElementById('btnToggleSnapCover');
      const coverLabel = document.getElementById('cbfCoverSourceLabel');
      const coverDesc = document.getElementById('cbfCoverStatusDesc');

      if (data.onlineCoverUrl) {
        if (btnOnline) btnOnline.style.display = 'inline-block';
        if (btnSnap) btnSnap.style.display = 'inline-block';
        if (coverLabel) coverLabel.innerHTML = 'Cover: <strong style="color:#2563EB;">Google Books Store</strong>';
        if (coverDesc) coverDesc.textContent = 'High-resolution official cover fetched';
      } else {
        if (btnOnline) btnOnline.style.display = 'none';
        if (btnSnap) btnSnap.style.display = 'none';
        if (coverLabel) coverLabel.innerHTML = 'Cover: <strong style="color:#15803D;">Camera Snapshot</strong>';
        if (coverDesc) coverDesc.textContent = 'Front cover photo ready';
      }

      setCommonCover(b.cover_url || data.localFrontUrl || frontSnapBase64 || '');
      if (document.getElementById('cbfBackCoverUrl')) {
        document.getElementById('cbfBackCoverUrl').value = b.back_cover_url || data.localBackUrl || backSnapBase64 || '';
      }

      // Fields
      document.getElementById('cbfTitle').value = b.title || '';
      document.getElementById('cbfAuthor').value = b.author || '';
      document.getElementById('cbfPublisher').value = b.publisher || '';
      document.getElementById('cbfEdition').value = b.edition || '';
      document.getElementById('cbfYear').value = b.publication_year || '';
      document.getElementById('cbfLanguage').value = b.language || 'English';
      document.getElementById('cbfIsbn').value = b.isbn || '';
      document.getElementById('cbfPrice').value = b.price || '';
      document.getElementById('cbfSubject').value = b.subject || 'General';
      document.getElementById('cbfClass').value = b.class || '';
      document.getElementById('cbfCopies').value = b.total_copies || 1;
      document.getElementById('cbfRack').value = b.rack || 'A';
      document.getElementById('cbfShelf').value = b.shelf || '1';
      document.getElementById('cbfCondition').value = b.book_condition || 'GOOD';
      document.getElementById('cbfDescription').value = b.description || '';

      // Update Captured Media Showcase & Detected Match Cards
      const scF = document.getElementById('showcaseFrontImg');
      const scFE = document.getElementById('showcaseFrontEmpty');
      const frontSrc = frontSnapBase64 || data.localFrontUrl || b.front_cover_url;
      if (scF && frontSrc) {
        scF.src = frontSrc;
        scF.style.display = 'block';
        if (scFE) scFE.style.display = 'none';
      }

      const scB = document.getElementById('showcaseBackImg');
      const scBE = document.getElementById('showcaseBackEmpty');
      const backSrc = backSnapBase64 || data.localBackUrl || b.back_cover_url;
      if (scB && backSrc) {
        scB.src = backSrc;
        scB.style.display = 'block';
        if (scBE) scBE.style.display = 'none';
      }

      const scOnlineBox = document.getElementById('showcaseOnlineBox');
      const scOnlineImg = document.getElementById('showcaseOnlineImg');
      const onlineCover = data.onlineCoverUrl || (b.cover_url && b.cover_url.startsWith('http') ? b.cover_url : null);
      if (scOnlineBox && scOnlineImg) {
        if (onlineCover) {
          scOnlineImg.src = onlineCover;
          scOnlineImg.style.display = 'block';
          scOnlineBox.style.display = 'block';
        } else {
          scOnlineBox.style.display = 'none';
        }
      }

      const confBadge = document.getElementById('cbfConfidenceBadge');
      if (confBadge) {
        if (onlineCover || b.title) {
          confBadge.innerHTML = '✨ Match Verified (Google Books Store)';
          confBadge.style.background = '#DCFCE7';
          confBadge.style.color = '#15803D';
          confBadge.style.border = '1px solid #86EFAC';
        } else {
          confBadge.innerHTML = '📸 Camera Snapshots Attached';
          confBadge.style.background = '#EFF6FF';
          confBadge.style.color = '#1D4ED8';
          confBadge.style.border = '1px solid #BFDBFE';
        }
      }

      const pTitle = document.getElementById('pillDetectedTitle');
      const pAuthor = document.getElementById('pillDetectedAuthor');
      const pIsbn = document.getElementById('pillDetectedIsbn');
      const pPub = document.getElementById('pillDetectedPublisher');

      if (pTitle) {
        if (b.title) {
          pTitle.textContent = '📖 ' + b.title;
          pTitle.style.display = 'inline-block';
        } else {
          pTitle.style.display = 'none';
        }
      }
      if (pAuthor) {
        if (b.author) {
          pAuthor.textContent = '✍️ ' + b.author;
          pAuthor.style.display = 'inline-block';
        } else {
          pAuthor.style.display = 'none';
        }
      }
      if (pIsbn) {
        if (b.isbn) {
          pIsbn.textContent = '🔢 ISBN: ' + b.isbn;
          pIsbn.style.display = 'inline-block';
        } else {
          pIsbn.style.display = 'none';
        }
      }
      if (pPub) {
        if (b.publisher) {
          pPub.textContent = '🏢 ' + b.publisher + (b.publication_year ? ` (${b.publication_year})` : '');
          pPub.style.display = 'inline-block';
        } else {
          pPub.style.display = 'none';
        }
      }

      // Highlight missing fields and show user prompt
      const missing = data.missingFields || [];
      const fieldIdMap = {
        'title': 'cbfTitle',
        'author': 'cbfAuthor',
        'publisher': 'cbfPublisher',
        'isbn': 'cbfIsbn',
        'price': 'cbfPrice',
        'publication_year': 'cbfYear',
        'synopsis': 'cbfDescription'
      };

      Object.values(fieldIdMap).forEach(id => {
        const el = document.getElementById(id);
        if (el) {
          el.style.border = '';
          el.style.background = '';
        }
      });

      const missingAlert = document.getElementById('smartMissingFieldsAlert');
      const missingText = document.getElementById('smartMissingFieldsText');

      if (missing && missing.length > 0) {
        missing.forEach(f => {
          const id = fieldIdMap[f];
          if (id) {
            const el = document.getElementById(id);
            if (el) {
              el.style.border = '2px solid #D97706';
              el.style.background = '#FFFBEB';
            }
          }
        });
        if (missingAlert) {
          missingAlert.style.display = 'block';
          if (missingText) {
            missingText.textContent = data.userPromptMessage || `AI & Web search completed. Please manually enter the highlighted details (${missing.join(', ')}).`;
          }
        }
      } else {
        if (missingAlert) missingAlert.style.display = 'none';
      }
    }

    function useOnlineCover() {
      if (lastSmartScanResult && lastSmartScanResult.onlineCoverUrl) {
        setCommonCover(lastSmartScanResult.onlineCoverUrl);
        const coverLabel = document.getElementById('cbfCoverSourceLabel');
        if (coverLabel) coverLabel.innerHTML = 'Cover: <strong style="color:#2563EB;">Google Books Store</strong>';
      }
    }

    function useSnapCover() {
      const snapUrl = (lastSmartScanResult && lastSmartScanResult.localFrontUrl) || frontSnapBase64;
      if (snapUrl) {
        setCommonCover(snapUrl);
        const coverLabel = document.getElementById('cbfCoverSourceLabel');
        if (coverLabel) coverLabel.innerHTML = 'Cover: <strong style="color:#15803D;">Camera Snapshot</strong>';
      }
