    async function submitEditBookForm(e) {
      e.preventDefault();
      const id = document.getElementById('ebId').value;
      const payload = {
        title: document.getElementById('ebTitle').value.trim(),
        author: document.getElementById('ebAuthor').value.trim(),
        isbn: document.getElementById('ebIsbn').value.trim(),
        total_copies: parseInt(document.getElementById('ebCopies').value, 10) || 1,
        shelf_location: document.getElementById('ebLocation').value.trim()
      };
