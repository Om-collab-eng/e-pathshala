                    ${s.class ? `<span>Class: <strong>${escapeHtml(s.class)}${s.section ? ' (' + escapeHtml(s.section) + ')' : ''}</strong></span>` : ''}
                    ${s.phone ? `<span>📞 ${escapeHtml(s.phone)}</span>` : ''}
