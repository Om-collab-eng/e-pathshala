    async function returnStudentBookPrompt(txId, bookTitle, fineAmount) {
      let msg = `Confirm return for '${bookTitle}'?`;
      if (fineAmount > 0) {
        msg = `⚠️ OVERDUE FINE CALCULATED: ₹${fineAmount}\n\nBook '${bookTitle}' is overdue. Confirm book check-in and apply fine?`;
      }

      if (!confirm(msg)) return;

      try {
        const res = await fetch('/admin/api/circulation/return', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ transaction_id: txId })
        });
        const data = await res.json();

        if (data.status === 'success') {
          let alertMsg = `✅ ${data.message}`;
          if (data.fine > 0) alertMsg += `\nOverdue Fine Recorded: ₹${data.fine}`;
          if (data.reservation_alert) alertMsg += `\n📢 ${data.reservation_alert}`;
          alert(alertMsg);

          // Refresh the student's loans immediately without page reload
          if (activeReturnMember) {
            loadStudentIssuedBooks(activeReturnMember.id);
          }
        } else {
          alert(`❌ ${data.message}`);
        }
      } catch (e) {
        alert('Return error: ' + e.message);
      }
    }

