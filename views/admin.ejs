    // E-Library Tab Navigation
    // ─────────────────────────────────────────────────────────────────
    function switchElibraryTab(tabId, btn) {
      document.querySelectorAll('.elib-tab-pane').forEach(el => el.style.display = 'none');
      document.querySelectorAll('.lp-tab-btn[id^="btn-tab-elib-"]').forEach(b => b.classList.remove('active'));
