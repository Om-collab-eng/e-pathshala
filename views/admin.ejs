    async function toggleMemberStatus(userId, shouldSuspend) {
      const action = shouldSuspend ? 'suspend' : 'unsuspend';
      if (!confirm(`Are you sure you want to ${action} this account?`)) return;
      try {
        const res = await fetch(`/admin/api/member/${userId}/toggle-status`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ suspend: shouldSuspend })
        });
        const d = await res.json();
        if (d.success) {
          alert(`Account has been ${shouldSuspend ? 'suspended' : 'activated'} successfully.`);
          openMemberDrawer(userId);
          const badge = document.getElementById(`member-status-${userId}`);
          if (badge) {
            badge.className = `lp-status-pill ${shouldSuspend ? 'overdue' : 'available'}`;
            badge.textContent = shouldSuspend ? 'Suspended' : 'Active';
          }
        } else {
          alert(d.error || 'Failed to update member status');
        }
      } catch (e) {
        alert('Network error while updating status');
      }
    }

