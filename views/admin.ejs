    async function startSmartCamera() {
      stopSmartCamera();
      const video = document.getElementById('smartBookVideo');
      const fallback = document.getElementById('cameraFallbackNotice');
      const badge = document.getElementById('cameraDeviceBadge');
      const flipLbl = document.getElementById('cameraFlipLabel');

      const isMobile = isMobileDevice();
      if (badge) {
        badge.textContent = isMobile
          ? (currentFacingMode === 'user' ? '📱 Mobile Front' : '📱 Mobile Back')
          : (currentFacingMode === 'user' ? '💻 Front Webcam' : '💻 External Cam');
      }
      if (flipLbl) {
        flipLbl.textContent = (currentFacingMode === 'user') ? 'Flip' : 'Flip';
      }

      // Always apply flipped model to preview so preview matches flipped capture
      if (video) {
        video.style.transform = alwaysFlippedModel ? 'scaleX(-1)' : 'none';
      }

      try {
        const constraints = {
          video: {
            facingMode: currentFacingMode === 'user' ? 'user' : { ideal: 'environment' },
            width: { ideal: 1920, min: 1280 },
            height: { ideal: 1080, min: 720 }
          },
          audio: false
        };
        smartCameraStream = await navigator.mediaDevices.getUserMedia(constraints);
        if (video) {
          video.srcObject = smartCameraStream;
          await video.play().catch(() => {});
          const vw = video.videoWidth || 1280;
          const vh = video.videoHeight || 720;
          logDebugStep('01', 'Camera initialized', `Resolution: ${vw}x${vh}, Flipped model: ${alwaysFlippedModel ? 'ACTIVE (Characters read properly)' : 'INACTIVE'}, Aspect-ratio: 2:3 portrait`);
        }
        if (fallback) fallback.style.display = 'none';
      } catch (err) {
        console.warn('Camera stream error:', err);
        logDebugStep('01', 'Camera initialization failed', err.message, true);
        if (fallback) fallback.style.display = 'flex';
      }
    }

    function stopSmartCamera() {
      if (smartCameraStream) {
        try {
          smartCameraStream.getTracks().forEach(t => t.stop());
        } catch(e) {}
        smartCameraStream = null;
      }
    }

