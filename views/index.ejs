<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Librika - Online Courses, Free E-Books & Digital Library Platform' %></title>
  
  <!-- Fonts & Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- Coursera-Inspired Librika Stylesheet -->
  <link rel="stylesheet" href="/coursera-librika.css">
  <script src="/js/libra-ai.js" defer></script>
</head>
<body class="coursera-theme">

  <!-- =========================================================================
       1. COURSERA TOP NAVBAR
       ========================================================================= -->
  <header class="cr-header">
    <div class="cr-nav-container">
      <div class="cr-nav-left">
        <!-- Logo -->
        <a href="/" class="cr-brand">
          <img src="/logo.png" alt="Librika Logo" onerror="this.style.display='none'">
          <span>librika</span>
        </a>

        <!-- Explore Mega-Menu Trigger -->
        <div class="cr-explore-wrapper" style="position: relative;">
          <button class="cr-explore-btn" type="button" aria-label="Explore categories">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
            <span>Explore</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
          </button>

          <!-- Mega Menu Dropdown -->
          <div class="cr-mega-menu">
            <div class="cr-menu-col">
              <h4>Top Subject Areas</h4>
              <a href="#catalog" onclick="document.querySelector('[data-filter=courses]').click()">💻 Computer Science & Coding</a>
              <a href="#catalog" onclick="document.querySelector('[data-filter=courses]').click()">📊 Data Science & AI</a>
              <a href="#catalog" onclick="document.querySelector('[data-filter=degrees]').click()">📈 Business & Finance</a>
              <a href="#catalog" onclick="document.querySelector('[data-filter=courses]').click()">🔬 STEM & Modern Physics</a>
              <a href="#catalog" onclick="document.querySelector('[data-filter=exams]').click()">🏆 UPSC & Competitive Exams</a>
            </div>
            <div class="cr-menu-col">
              <h4>Digital Library & Formats</h4>
              <a href="#catalog" onclick="document.querySelector('[data-filter=books]').click()">📚 100% Free Public E-Books</a>
              <a href="#catalog" onclick="document.querySelector('[data-filter=books]').click()">📑 Academic Research Papers</a>
              <a href="#catalog" onclick="document.querySelector('[data-filter=degrees]').click()">🎓 Career Certifications</a>
              <a href="#libra-ai">🤖 Ask Libra AI Tutor</a>
              <a href="/login">🏛️ Institution Portal</a>
            </div>
          </div>
        </div>

        <!-- Universal Search Bar -->
        <div class="cr-search-form">
          <div class="cr-search-wrapper">
            <svg class="cr-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
            <input type="text" id="crUniversalSearch" class="cr-search-input" placeholder="What do you want to learn or read today?">
            <span class="cr-search-shortcut">⌘K</span>
          </div>
        </div>
      </div>

      <!-- Nav Links & Auth -->
      <div class="cr-nav-right">
        <a href="#catalog" class="cr-nav-link cr-nav-links">Courses & Books</a>
        <a href="#pricing" class="cr-nav-link cr-nav-links">Plans</a>
        
        <!-- Libra AI Button in Nav -->
        <a href="#libra-ai" class="cr-btn-ai-nav">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          <span>Ask Libra AI</span>
        </a>

        <% if (typeof session !== 'undefined' && session && session.user_id) { %>
          <% if (session.role === 'student') { %>
            <a href="/student" class="cr-btn-primary">My Student Portal</a>
          <% } else if (session.role === 'personal') { %>
            <a href="/personal" class="cr-btn-primary">My Personal Library</a>
          <% } else if (session.role === 'admin' || session.role === 'super_admin') { %>
            <a href="/admin" class="cr-btn-primary">Admin Console</a>
          <% } else { %>
            <a href="/student" class="cr-btn-primary">Dashboard</a>
          <% } %>
        <% } else { %>
          <a href="/login" class="cr-btn-login">Log In</a>
          <a href="/register" class="cr-btn-primary">Join for Free</a>
        <% } %>
      </div>
    </div>
  </header>

  <!-- =========================================================================
       2. COURSERA HERO SECTION
       ========================================================================= -->
  <section class="cr-hero">
    <div class="cr-hero-grid">
      <!-- Left Column: Copy & CTAs -->
      <div>
        <div class="cr-badge-pill">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
          <span>100% Free Public Access Available</span>
        </div>

        <h1 class="cr-hero-title">
          Learn Without <br><span class="highlight">Limits & Boundaries.</span>
        </h1>

        <p class="cr-hero-subtitle">
          Advance your knowledge with <strong>10,000+ free online courses</strong>, accredited curriculum modules, public e-books, and research papers from top global educators and open digital libraries.
        </p>

        <div class="cr-hero-actions">
          <a href="/register" class="cr-btn-primary" style="padding: 0.85rem 2rem; font-size: 1.05rem;">
            Join for Free
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="#catalog" class="cr-btn-secondary" style="padding: 0.85rem 1.8rem; font-size: 1.05rem;">
            Explore Catalog
          </a>
          <button type="button" onclick="window.openLibraChat('What are the best free courses and books available on Librika?')" class="cr-btn-secondary" style="background:#EBF3FF;border-color:#bad3f7;">
            💬 Ask Libra AI
          </button>
        </div>

        <!-- Trust Stats -->
        <div class="cr-hero-stats">
          <div class="cr-stat-item">
            <strong><%= (typeof stats !== 'undefined' && stats.books) ? (stats.books > 1000 ? (stats.books/1000).toFixed(1) + 'K+' : stats.books) : '12.5K+' %></strong>
            <span>Curated Books</span>
          </div>
          <div class="cr-stat-item">
            <strong><%= (typeof stats !== 'undefined' && stats.digital) ? (stats.digital > 1000 ? (stats.digital/1000).toFixed(1) + 'K+' : stats.digital) : '3.8K+' %></strong>
            <span>Digital E-Books</span>
          </div>
          <div class="cr-stat-item">
            <strong><%= (typeof stats !== 'undefined' && stats.learners) ? (stats.learners > 1000 ? (stats.learners/1000).toFixed(0) + 'K+' : stats.learners) : '45K+' %></strong>
            <span>Active Learners</span>
          </div>
          <div class="cr-stat-item">
            <strong><%= (typeof stats !== 'undefined' && stats.institutions) ? stats.institutions + '+' : '500+' %></strong>
            <span>Partner Libraries</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Hero Card -->
      <div>
        <div class="cr-hero-card">
          <div class="cr-hero-card-header">
            <span style="font-weight: 700; font-size: 0.95rem; color: #00255D;">Featured Today</span>
            <div class="cr-live-pill">
              <span class="cr-live-dot"></span>
              <span>Live Interactive</span>
            </div>
          </div>

          <!-- Preview Course 1 -->
          <div class="cr-preview-course">
            <div class="cr-preview-tag">MIT OpenCourseWare · Computer Science</div>
            <h3 class="cr-preview-title">Foundations of Modern AI & Deep Learning</h3>
            <div class="cr-preview-meta">
              <span>⭐ 4.9 (18.4k reviews)</span>
              <span>•</span>
              <span>Beginner · Free</span>
            </div>
          </div>

          <!-- Preview Course 2 -->
          <div class="cr-preview-course" style="margin-bottom: 1.25rem;">
            <div class="cr-preview-tag" style="color: #6B46C1;">Digital Classic E-Book · Open Access</div>
            <h3 class="cr-preview-title">Atomic Habits & Behavioral Mastery</h3>
            <div class="cr-preview-meta">
              <span>⭐ 4.95 (32.1k reads)</span>
              <span>•</span>
              <span>In-Browser Reader</span>
            </div>
          </div>

          <!-- AI Assistant Banner inside Hero Card -->
          <div class="cr-preview-ai-box">
            <div class="cr-preview-ai-icon">✨</div>
            <div>
              <strong style="display:block;font-size:1rem;margin-bottom:2px;">Meet Libra AI</strong>
              <span style="font-size:0.85rem;opacity:0.9;">Your 24/7 AI tutor for quizzes, book summaries & study plans.</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       3. UNIVERSITY & GLOBAL PARTNERS BANNER
       ========================================================================= -->
  <section class="cr-partners">
    <div class="cr-partners-title">Collaborating with 500+ Leading Universities, Open Archives & Libraries</div>
    <div class="cr-partners-list">
      <div class="cr-partner-logo">🏛️ MIT OpenCourseWare</div>
      <div class="cr-partner-logo">🎓 Stanford Digital Archives</div>
      <div class="cr-partner-logo">📚 Oxford Academic Commons</div>
      <div class="cr-partner-logo">🌐 National Digital Library</div>
      <div class="cr-partner-logo">📖 Project Gutenberg Open</div>
      <div class="cr-partner-logo">🔬 CERN OpenLab Papers</div>
    </div>
  </section>

  <!-- =========================================================================
       4. "LIBRA" AI ENGINE CONSOLE (Accessible to all visitors)
       ========================================================================= -->
  <section id="libra-ai" class="cr-libra-hero-section">
    <div class="cr-libra-container">
      <div class="cr-libra-badge">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        <span>Librika AI Engine</span>
      </div>

      <h2 class="cr-libra-title">Meet "Libra" — Your Intelligent AI Tutor & Library Concierge</h2>
      <p class="cr-libra-subtitle">
        Ask anything about our free online courses, public e-books, study materials, exam vaults, or platform membership plans. Instant, intelligent answers powered by advanced AI.
      </p>

      <!-- Search / Query Form -->
      <form id="libraInlineForm">
        <div class="cr-libra-input-box">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0056D2" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
          <input 
            type="text" 
            id="libraInlineInput" 
            class="cr-libra-input" 
            placeholder="e.g. Find me top free Python courses, or summarize the pricing plans..."
            autocomplete="off"
            required
          >
          <button type="submit" id="libraSubmitBtn" class="cr-libra-submit-btn">
            <span>Ask Libra</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
        </div>
      </form>

      <!-- Suggested Prompt Chips -->
      <div class="cr-libra-chips">
        <button type="button" class="cr-chip-btn" data-query="What free Computer Science and Programming courses can I start right now?">
          💻 Free CS & Coding Courses
        </button>
        <button type="button" class="cr-chip-btn" data-query="Recommend top-rated self-development, productivity and science e-books on Librika">
          📚 Best Free E-Books
        </button>
        <button type="button" class="cr-chip-btn" data-query="Explain Librika membership pricing plans (Free vs. Student Pro vs. School Enterprise)">
          💳 Membership & Pricing Plans
        </button>
        <button type="button" class="cr-chip-btn" data-query="How can I earn verified certificates and test my knowledge with chapter quizzes?">
          🎓 Certificates & Quizzes
        </button>
        <button type="button" class="cr-chip-btn" data-query="What study materials and test series are available for UPSC, GATE and competitive exams?">
          🏆 Competitive Exam Prep
        </button>
        <button type="button" class="cr-chip-btn" data-query="How can educators and authors publish their own digital e-books and study notes on Librika?">
          ✍️ Author Publishing
        </button>
      </div>

      <!-- Real-time Live Result Container -->
      <div id="libraLiveResponse" class="cr-libra-live-response">
        <div class="cr-libra-live-header">
          <div style="display:flex;align-items:center;gap:8px;">
            <span>✨ Libra AI Response</span>
          </div>
          <button type="button" onclick="document.getElementById('libraLiveResponse').classList.remove('visible')" style="background:transparent;border:none;color:white;cursor:pointer;font-size:1.1rem;">✕</button>
        </div>
        <div id="libraLiveBody" class="cr-libra-live-body"></div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       5. COURSERA TABBED CATALOG SHOWCASE
       ========================================================================= -->
  <section id="catalog" class="cr-catalog-section">
    <div class="cr-section-header">
      <h2 class="cr-section-title">Explore Courses, E-Books & Learning Paths</h2>
      <p class="cr-section-subtitle">Start streaming courses or reading curated e-books for free today.</p>
    </div>

    <!-- Filter Tabs -->
    <div class="cr-tabs">
      <button class="cr-tab active" data-filter="all">🌟 All Public Resources</button>
      <button class="cr-tab" data-filter="courses">💻 Most Popular Courses</button>
      <button class="cr-tab" data-filter="books">📚 Free Public E-Books</button>
      <button class="cr-tab" data-filter="degrees">🎓 Specializations & Degrees</button>
      <button class="cr-tab" data-filter="exams">🏆 Competitive Exam Hub</button>
    </div>

    <!-- Catalog Grid -->
    <div class="cr-grid">

      <!-- Course 1 -->
      <div class="cr-card" data-category="courses">
        <div class="cr-card-img-wrapper" style="background: linear-gradient(135deg, #00255D, #0056D2);">
          <div class="cr-card-badge">Course</div>
          <div class="cr-card-free-badge">100% Free</div>
        </div>
        <div class="cr-card-content">
          <div class="cr-card-org">🏛️ MIT OpenCourseWare</div>
          <h3 class="cr-card-title">Full-Stack Modern Web & Cloud Architecture</h3>
          <div class="cr-card-skills"><strong>Skills:</strong> Node.js, React, Docker, Cloud APIs, SQL</div>
          <div class="cr-card-rating">
            <span class="cr-stars">★★★★★</span>
            <span>4.9</span>
            <span class="cr-review-count">(14.2k reviews)</span>
          </div>
          <div class="cr-card-footer-meta">
            <span>Beginner · 6 Weeks</span>
            <span style="color:#12824C;font-weight:700;">Certificate Included</span>
          </div>
          <div class="cr-card-actions">
            <a href="/register" class="cr-btn-card">Enroll for Free</a>
          </div>
        </div>
      </div>

      <!-- Course 2 -->
      <div class="cr-card" data-category="courses">
        <div class="cr-card-img-wrapper" style="background: linear-gradient(135deg, #1e3c72, #2a5298);">
          <div class="cr-card-badge">Specialization</div>
          <div class="cr-card-free-badge">Free Audit</div>
        </div>
        <div class="cr-card-content">
          <div class="cr-card-org">🎓 Stanford Digital Lab</div>
          <h3 class="cr-card-title">Artificial Intelligence & Prompt Engineering Masterclass</h3>
          <div class="cr-card-skills"><strong>Skills:</strong> LLMs, Llama-3, RAG Systems, Python, NLP</div>
          <div class="cr-card-rating">
            <span class="cr-stars">★★★★★</span>
            <span>4.95</span>
            <span class="cr-review-count">(28.4k reviews)</span>
          </div>
          <div class="cr-card-footer-meta">
            <span>Intermediate · 4 Weeks</span>
            <span style="color:#12824C;font-weight:700;">Hands-on Labs</span>
          </div>
          <div class="cr-card-actions">
            <a href="/register" class="cr-btn-card">Start Learning</a>
          </div>
        </div>
      </div>

      <!-- E-Book 1 -->
      <div class="cr-card" data-category="books">
        <div class="cr-card-img-wrapper" style="background: linear-gradient(135deg, #373B44, #4286f4);">
          <div class="cr-card-badge" style="background:#6B46C1;">Digital E-Book</div>
          <div class="cr-card-free-badge">Open Access</div>
        </div>
        <div class="cr-card-content">
          <div class="cr-card-org">📖 Librika Open Library</div>
          <h3 class="cr-card-title">Atomic Habits: An Easy & Proven Way to Build Good Habits</h3>
          <div class="cr-card-skills"><strong>Topics:</strong> Personal Mastery, Psychology, Daily Systems</div>
          <div class="cr-card-rating">
            <span class="cr-stars">★★★★★</span>
            <span>4.98</span>
            <span class="cr-review-count">(45.1k reads)</span>
          </div>
          <div class="cr-card-footer-meta">
            <span>Full EPUB/PDF</span>
            <span style="color:#0056D2;font-weight:700;">AI Summarizer Active</span>
          </div>
          <div class="cr-card-actions">
            <a href="/register" class="cr-btn-card">Read Online Free</a>
          </div>
        </div>
      </div>

      <!-- E-Book 2 -->
      <div class="cr-card" data-category="books">
        <div class="cr-card-img-wrapper" style="background: linear-gradient(135deg, #11998e, #38ef7d);">
          <div class="cr-card-badge" style="background:#6B46C1;">E-Book & Notes</div>
          <div class="cr-card-free-badge">Free PDF</div>
        </div>
        <div class="cr-card-content">
          <div class="cr-card-org">📚 Oxford Academic</div>
          <h3 class="cr-card-title">Data Structures & Algorithms: Visual Handbook</h3>
          <div class="cr-card-skills"><strong>Topics:</strong> Trees, Graphs, Dynamic Programming, Big-O</div>
          <div class="cr-card-rating">
            <span class="cr-stars">★★★★★</span>
            <span>4.88</span>
            <span class="cr-review-count">(19.8k reads)</span>
          </div>
          <div class="cr-card-footer-meta">
            <span>Chapter Quizzes</span>
            <span style="color:#12824C;font-weight:700;">Includes Code Snippets</span>
          </div>
          <div class="cr-card-actions">
            <a href="/register" class="cr-btn-card">Open Reader</a>
          </div>
        </div>
      </div>

      <!-- Degree / Specialization 1 -->
      <div class="cr-card" data-category="degrees">
        <div class="cr-card-img-wrapper" style="background: linear-gradient(135deg, #4b1248, #f0c27b);">
          <div class="cr-card-badge" style="background:#B88E00;">Professional Certificate</div>
          <div class="cr-card-free-badge">Accredited</div>
        </div>
        <div class="cr-card-content">
          <div class="cr-card-org">🏛️ National Knowledge Council</div>
          <h3 class="cr-card-title">Certified Digital Librarian & Knowledge Architect</h3>
          <div class="cr-card-skills"><strong>Skills:</strong> DDC, MARC21, OCR Indexing, SaaS ERP, Metadata</div>
          <div class="cr-card-rating">
            <span class="cr-stars">★★★★★</span>
            <span>4.92</span>
            <span class="cr-review-count">(8.5k enrolled)</span>
          </div>
          <div class="cr-card-footer-meta">
            <span>3 Months · Capstone</span>
            <span style="color:#0056D2;font-weight:700;">Career Certificate</span>
          </div>
          <div class="cr-card-actions">
            <a href="/register" class="cr-btn-card">Explore Curriculum</a>
          </div>
        </div>
      </div>

      <!-- Competitive Exam 1 -->
      <div class="cr-card" data-category="exams">
        <div class="cr-card-img-wrapper" style="background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);">
          <div class="cr-card-badge" style="background:#d9381e;">Exam Vault</div>
          <div class="cr-card-free-badge">Practice Series</div>
        </div>
        <div class="cr-card-content">
          <div class="cr-card-org">🏆 Librika Exam Prep Hub</div>
          <h3 class="cr-card-title">UPSC & State PSC General Studies Comprehensive Vault</h3>
          <div class="cr-card-skills"><strong>Topics:</strong> Polity, Modern History, Economy, Current Affairs</div>
          <div class="cr-card-rating">
            <span class="cr-stars">★★★★★</span>
            <span>4.96</span>
            <span class="cr-review-count">(54.2k aspirants)</span>
          </div>
          <div class="cr-card-footer-meta">
            <span>1,200+ Solved MCQs</span>
            <span style="color:#12824C;font-weight:700;">Daily Tests</span>
          </div>
          <div class="cr-card-actions">
            <a href="/register" class="cr-btn-card">Start Free Mock Test</a>
          </div>
        </div>
      </div>

      <!-- Course 3 -->
      <div class="cr-card" data-category="courses">
        <div class="cr-card-img-wrapper" style="background: linear-gradient(135deg, #134E5E, #71B280);">
          <div class="cr-card-badge">Course</div>
          <div class="cr-card-free-badge">Free Access</div>
        </div>
        <div class="cr-card-content">
          <div class="cr-card-org">🔬 Global Science Initiative</div>
          <h3 class="cr-card-title">Quantum Mechanics & Information Theory for Everyone</h3>
          <div class="cr-card-skills"><strong>Skills:</strong> Quantum Computing, Qubits, Linear Algebra, Physics</div>
          <div class="cr-card-rating">
            <span class="cr-stars">★★★★★</span>
            <span>4.89</span>
            <span class="cr-review-count">(11.7k reviews)</span>
          </div>
          <div class="cr-card-footer-meta">
            <span>All Levels · 5 Weeks</span>
            <span style="color:#0056D2;font-weight:700;">Interactive Visuals</span>
          </div>
          <div class="cr-card-actions">
            <a href="/register" class="cr-btn-card">Enroll Now</a>
          </div>
        </div>
      </div>

      <!-- E-Book 3 -->
      <div class="cr-card" data-category="books">
        <div class="cr-card-img-wrapper" style="background: linear-gradient(135deg, #2C3E50, #FD746C);">
          <div class="cr-card-badge" style="background:#6B46C1;">Literature Classic</div>
          <div class="cr-card-free-badge">Open Book</div>
        </div>
        <div class="cr-card-content">
          <div class="cr-card-org">📖 Global Literary Vault</div>
          <h3 class="cr-card-title">Meditations by Marcus Aurelius (Modern Annotated Translation)</h3>
          <div class="cr-card-skills"><strong>Topics:</strong> Stoic Philosophy, Resilience, Leadership, Ethics</div>
          <div class="cr-card-rating">
            <span class="cr-stars">★★★★★</span>
            <span>4.97</span>
            <span class="cr-review-count">(62.3k reads)</span>
          </div>
          <div class="cr-card-footer-meta">
            <span>Audiobook & Text</span>
            <span style="color:#12824C;font-weight:700;">Free Forever</span>
          </div>
          <div class="cr-card-actions">
            <a href="/register" class="cr-btn-card">Read Free</a>
          </div>
        </div>
