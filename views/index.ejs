        <button onclick="closeLegalModal()" class="cr-btn-primary" style="padding:0.5rem 1.25rem;font-size:0.9rem;">Close</button>
      </div>
    </div>
  </div>

  <script>
    const legalContents = {
      help: {
        icon: '💡',
        title: 'Help Center & Frequently Asked Questions',
        body: '<h4 style="margin:0 0 8px;color:#0F172A;">How do I access free books and courses?</h4><p>Librika offers open access to our public catalog. Students enrolled under participating schools or universities can log in with their student admission number or registered phone to immediately read full texts, take chapter quizzes, and attend live classroom sessions.</p><h4 style="margin:16px 0 8px;color:#0F172A;">Can I access books offline?</h4><p>Yes, all verified students can cache book chapters for offline studying through the progressive mobile web experience.</p><h4 style="margin:16px 0 8px;color:#0F172A;">How does Libra AI assist me?</h4><p>Libra AI generates chapter summaries, interactive practice questions, and helps clarify difficult academic topics 24/7 without extra fees.</p>'
      },
      terms: {
        icon: '⚖️',
        title: 'Terms of Service',
        body: '<p>Welcome to Librika. By accessing or using our platform, you agree to abide by these terms. Librika provides educational material, catalog management, and AI tutoring for academic, non-commercial, and institutional learning purposes.</p><h4 style="margin:12px 0 6px;color:#0F172A;">Fair Use &amp; Academic Integrity</h4><p>Users must not reproduce, distribute, or reverse-engineer copyrighted textbooks or course materials outside the fair-use educational licenses granted by their institution.</p><h4 style="margin:12px 0 6px;color:#0F172A;">Account Responsibilities</h4><p>You are responsible for keeping your login credentials confidential and for all activities occurring under your account.</p>'
      },
      privacy: {
        icon: '🔒',
        title: 'Privacy Policy',
        body: '<p>At Librika, your privacy is our core priority. We only collect the information necessary to provide educational access, track course progress, and ensure library inventory synchronization.</p><h4 style="margin:12px 0 6px;color:#0F172A;">Information We Collect</h4><p>Name, admission/student ID, enrolled classes, reading progress, and attendance records submitted by your school administration.</p><h4 style="margin:12px 0 6px;color:#0F172A;">Data Protection</h4><p>We do not sell personal student data to third parties. All communications are encrypted over SSL/TLS.</p>'
      },
      guidelines: {
        icon: '📖',
        title: 'Publisher & Content Guidelines',
        body: '<p>Educators and librarians publishing materials onto Librika must adhere to standard academic attribution, copyright licensing (e.g. Creative Commons, Open Access), and appropriate content standards for K-12 and university learners.</p>'
      },
      support: {
        icon: '🎧',
        title: 'Contact Customer Support',
        body: '<p>Our support team is available Monday through Saturday to assist students, teachers, and school administrators.</p><div style="background:#F1F5F9;padding:12px 16px;border-radius:10px;margin-top:12px;"><p style="margin:0 0 6px;">📧 <strong>Email Support:</strong> <a href="mailto:support@librika.in" style="color:#0056D2;">support@librika.in</a></p><p style="margin:0 0 6px;">📞 <strong>Toll-Free Helpline:</strong> +91 800-LIBRIKA (Mon-Sat 9AM-6PM IST)</p><p style="margin:0;">💬 <strong>Instant Chat:</strong> Click the "Ask Libra AI" button anytime to get instant troubleshooting answers.</p></div>'
      },
      security: {
        icon: '🛡️',
        title: 'Platform Security & Compliance',
        body: '<p>Librika incorporates end-to-end data encryption, session isolation between school tenants, rate-limiting, and strict role-based access control (RBAC) to ensure student and institutional data remain completely confidential.</p>'
      },
      status: {
        icon: '🟢',
        title: 'Live System Status',
        body: '<div style="display:flex;align-items:center;gap:10px;padding:12px;background:#ECFDF5;border:1px solid #A7F3D0;border-radius:10px;margin-bottom:14px;"><span style="color:#10B981;font-size:1.4rem;">●</span><div><strong style="color:#065F46;">All Systems Operational</strong><div style="font-size:0.85rem;color:#047857;">Cloud Reader, Live Studio WebRTC, and Database APIs running normally.</div></div></div><p style="font-size:0.88rem;color:#64748B;">Uptime over past 90 days: 99.98%.</p>'
      }
    };

    function openLegalModal(key) {
      const data = legalContents[key] || legalContents.help;
      document.getElementById('legalModalIcon').innerText = data.icon;
      document.getElementById('legalModalTitle').innerText = data.title;
      document.getElementById('legalModalBody').innerHTML = data.body;
      const modal = document.getElementById('legalInfoModal');
      modal.style.display = 'flex';
      modal.classList.add('open');
    }

    function closeLegalModal() {
      const modal = document.getElementById('legalInfoModal');
      modal.classList.remove('open');
      modal.style.display = 'none';
    }
  </script>
  
