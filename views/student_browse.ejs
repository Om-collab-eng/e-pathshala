<% contentFor("scripts") %>
<script>
    // Procedural covers: colors array
    const colors = [
        ['#ff9a9e', '#fecfef'],
        ['#a1c4fd', '#c2e9fb'],
        ['#f5f7fa', '#c3cfe2'],
        ['#fbc2eb', '#a6c1ee'],
        ['#fdcbf1', '#e6dee9'],
        ['#a18cd1', '#fbc2eb'],
        ['#ffb199', '#ff0844'],
        ['#4facfe', '#00f2fe'],
        ['#30cfd0', '#330867']
    ];

    // Seeded hash code to pick colors deterministically based on book title
    function getPastelGradient(title) {
        let hash = 0;
        for (let i = 0; i < title.length; i++) {
            hash = title.charCodeAt(i) + ((hash << 5) - hash);
        }
        const index = Math.abs(hash) % colors.length;
        return colors[index];
    }

    // Apply procedural covers on load
    document.addEventListener('DOMContentLoaded', () => {
        const placeholders = document.querySelectorAll('.book-cover-placeholder');
        placeholders.forEach(el => {
            const title = el.getAttribute('data-title') || 'Book';
            const grad = getPastelGradient(title);
            el.style.background = `linear-gradient(135deg, ${grad[0]} 0%, ${grad[1]} 100%)`;
        });

        // Initialize Carousel Scroll Logic
        // Featured Carousel & Ad Manager Controller
        (function() {
            let currentSlide = 0;
            let autoPlayTimer = null;
            const wrapper = document.querySelector('.featured-carousel-wrapper');
            const track = document.querySelector('.featured-carousel');
            const dotsContainer = document.querySelector('.carousel-dots');
            if (!track || !wrapper || !dotsContainer) return;

            // Fetch dynamic ads from server
            fetch('/api/ads?section=digital_library')
                .then(res => res.json())
                .then(data => {
                    if (data.status === 'success' && data.advertisements && data.advertisements.length > 0) {
                        const adSlides = data.advertisements.map(ad => `
                            <div class="featured-banner ad-banner-slide" data-ad-id="${ad.id}" style="background: ${ad.bg_gradient || 'linear-gradient(135deg, #f5f3ff 0%, #edd8ff 100%)'};">
                                <div class="featured-info">
                                    <div class="featured-label" style="color: rgba(255,255,255,0.9);">📢 PROMOTIONAL FEATURE</div>
                                    <h4 class="featured-title" style="color: #ffffff; text-shadow: 0 1px 3px rgba(0,0,0,0.3);">${escapeHtml(ad.title)}</h4>
                                    <p class="featured-subtitle" style="color: rgba(255,255,255,0.9); text-shadow: 0 1px 2px rgba(0,0,0,0.3);">${escapeHtml(ad.subtitle || ad.description || '')}</p>
                                    <a href="${ad.target_url}" onclick="trackAdClick(${ad.id})" class="featured-btn" style="background: rgba(255,255,255,0.25); backdrop-filter: blur(8px); color: white; border: 1px solid rgba(255,255,255,0.4);">${escapeHtml(ad.cta_text || 'Learn More')}</a>
                                </div>
                            </div>
                        `).join('');
                        
                        track.insertAdjacentHTML('afterbegin', adSlides);
                        rebuildDots();
                    }
                    initCarouselController();
                })
                .catch(() => initCarouselController());

            function escapeHtml(str) {
                return String(str || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
            }

            window.trackAdClick = function(adId) {
                fetch('/api/ads/' + adId + '/click', { method: 'POST' }).catch(() => {});
            };

            function rebuildDots() {
                const slides = track.querySelectorAll('.featured-banner');
                dotsContainer.innerHTML = Array.from(slides).map((_, i) => `<div class="carousel-dot ${i===0?'active':''}" data-index="${i}"></div>`).join('');
                bindDotClicks();
            }

            function bindDotClicks() {
                const dots = dotsContainer.querySelectorAll('.carousel-dot');
                dots.forEach((dot, idx) => {
                    dot.onclick = () => {
                        currentSlide = idx;
                        updateSlide();
                        startAutoPlay();
                    };
                });
            }

            function updateSlide() {
                const slides = track.querySelectorAll('.featured-banner');
                if (slides.length === 0) return;
                track.style.transform = `translateX(-${currentSlide * 100}%)`;
                const dots = dotsContainer.querySelectorAll('.carousel-dot');
                dots.forEach((dot, idx) => dot.classList.toggle('active', idx === currentSlide));
            }

            function nextSlide() {
                const slides = track.querySelectorAll('.featured-banner');
                if (slides.length === 0) return;
                currentSlide = (currentSlide + 1) % slides.length;
                updateSlide();
            }

            function startAutoPlay() {
                if (autoPlayTimer) clearInterval(autoPlayTimer);
                autoPlayTimer = setInterval(nextSlide, 6000);
            }

            function initCarouselController() {
                bindDotClicks();
                let touchStartX = 0;
                let touchEndX = 0;

                wrapper.addEventListener('touchstart', (e) => {
                    touchStartX = e.changedTouches[0].screenX;
                    if (autoPlayTimer) clearInterval(autoPlayTimer);
                }, { passive: true });

                wrapper.addEventListener('touchend', (e) => {
                    touchEndX = e.changedTouches[0].screenX;
                    const diff = touchStartX - touchEndX;
                    const slides = track.querySelectorAll('.featured-banner');
                    if (Math.abs(diff) > 40 && slides.length > 0) {
                        if (diff > 0) currentSlide = (currentSlide + 1) % slides.length;
                        else currentSlide = (currentSlide - 1 + slides.length) % slides.length;
                        updateSlide();
                    }
                    startAutoPlay();
                }, { passive: true });

                wrapper.addEventListener('mouseenter', () => {
                    if (autoPlayTimer) clearInterval(autoPlayTimer);
                });

                wrapper.addEventListener('mouseleave', () => {
                    startAutoPlay();
                });

                startAutoPlay();
            }
        })();
    });

    // Mobile Sidebar Drawer Toggle
    function toggleSidebarMenu() {
        const sidebar = document.getElementById('portalSidebar');
        const backdrop = document.getElementById('sidebarBackdrop');
        if (sidebar.style.left === '0px') {
            sidebar.style.left = '-280px';
            backdrop.style.opacity = '0';
            setTimeout(() => backdrop.style.display = 'none', 300);
        } else {
            backdrop.style.display = 'block';
            setTimeout(() => backdrop.style.opacity = '1', 50);
            sidebar.style.left = '0px';
        }
    }

    // Book Actions Drawer Modal
    let activeBookId = null;

    function showBookOptions(bookId) {
        activeBookId = bookId;
        document.getElementById('optionBtnRead').href = '/student/book/' + bookId;
        const modal = document.getElementById('optionModal');
        modal.style.display = 'flex';
        setTimeout(() => {
            modal.firstElementChild.style.transform = 'translateY(0)';
        }, 50);
    }

    function closeOptionModal() {
        const modal = document.getElementById('optionModal');
        modal.firstElementChild.style.transform = 'translateY(100%)';
        setTimeout(() => {
            modal.style.display = 'none';
        }, 300);
    }
</script>

      </main>
    </div>
  </div>
</div>