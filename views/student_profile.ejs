<%- layout("base") %>
<% block('head').append('<link rel="stylesheet" href="/student.css">') %>

<% contentFor("title") %>My Profile - librika.in

<% contentFor("content") %>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
    :root {
        --pp-purple: #5c3cf3;
        --pp-purple-light: #f0eeff;
        --pp-purple-mid: #7c5cf6;
        --pp-green: #22c55e;
        --pp-green-light: #dcfce7;
        --pp-orange: #f97316;
        --pp-orange-light: #fff7ed;
        --pp-teal: #06b6d4;
        --pp-teal-light: #ecfeff;
        --pp-text-dark: #0f172a;
        --pp-text-mid: #475569;
        --pp-text-muted: #94a3b8;
        --pp-bg: #f8fafc;
        --pp-white: #ffffff;
        --pp-border: #e2e8f0;
        --pp-card-shadow: 0 2px 16px rgba(0,0,0,0.06);
    }
    [data-theme="dark"] {
        --pp-text-dark: #f1f5f9;
        --pp-text-mid: #94a3b8;
        --pp-text-muted: #64748b;
        --pp-bg: #0f172a;
        --pp-white: #1e293b;
        --pp-border: #334155;
        --pp-purple-light: rgba(92,60,243,0.15);
        --pp-green-light: rgba(34,197,94,0.12);
        --pp-orange-light: rgba(249,115,22,0.12);
        --pp-teal-light: rgba(6,182,212,0.12);
        --pp-card-shadow: 0 2px 16px rgba(0,0,0,0.3);
    }

    body {
        margin: 0; padding: 0;
        background: var(--pp-bg);
        font-family: 'Plus Jakarta Sans', sans-serif;
        min-height: 100vh;
    }

    /* ─── Portal Shell (matches bookmarks/student pages) ─── */
    .portal-wrapper {
        display: flex;
        min-height: 100vh;
        background: var(--pp-bg);
    }

    /* Desktop Sidebar */
    .desktop-sidebar {
        display: none;
        width: 260px;
        background: var(--pp-white);
        border-right: 1px solid var(--pp-border);
        flex-direction: column;
        padding: 2rem 1.5rem;
        box-sizing: border-box;
        flex-shrink: 0;
        position: sticky;
        top: 0;
        height: 100vh;
        overflow-y: auto;
        z-index: 100;
    }
    .sidebar-brand {
        display: flex; align-items: center; gap: 10px;
        margin-bottom: 2rem;
    }
    .brand-icon { font-size: 1.6rem; }
    .brand-info h4 {
        margin: 0; font-size: 0.9rem; font-weight: 800;
        font-family: 'Outfit', sans-serif; color: var(--pp-text-dark);
    }
    .brand-info p { margin: 0; font-size: 0.7rem; color: var(--pp-text-muted); font-weight: 500; }

    .sidebar-menu { display: flex; flex-direction: column; gap: 4px; flex: 1; }
    .sidebar-link {
        display: flex; align-items: center; gap: 10px;
        padding: 10px 14px; border-radius: 12px;
        text-decoration: none; color: var(--pp-text-mid);
        font-size: 0.85rem; font-weight: 600;
        transition: all 0.2s; background: none; border: none; cursor: pointer;
        width: 100%; text-align: left;
    }
    .sidebar-link:hover { background: var(--pp-purple-light); color: var(--pp-purple); }
    .sidebar-link.active { background: var(--pp-purple-light); color: var(--pp-purple); font-weight: 700; }
    .link-icon { font-size: 1.1rem; width: 20px; text-align: center; flex-shrink: 0; }
    .sidebar-divider { border: none; border-top: 1px solid var(--pp-border); margin: 0.75rem 0; }
    .logout-link:hover { background: rgba(244,63,94,0.08); color: #f43f5e; }

    .sidebar-profile-card {
        margin-top: auto;
        padding: 0.75rem;
        background: var(--pp-purple-light);
        border-radius: 14px;
        display: flex; align-items: center; gap: 10px;
    }
    .profile-card-avatar {
        width: 38px; height: 38px; border-radius: 50%;
        background: var(--pp-purple); color: white;
        display: flex; align-items: center; justify-content: center;
        font-weight: 800; font-size: 1rem; flex-shrink: 0;
    }
    .profile-card-info h5 { margin: 0; font-size: 0.82rem; font-weight: 700; color: var(--pp-text-dark); }
    .profile-card-info p  { margin: 0; font-size: 0.7rem; color: var(--pp-text-muted); font-weight: 500; }

    /* Main content area */
    .portal-main {
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        background: var(--pp-bg);
        overflow-y: auto;
        padding-bottom: 90px;
    }

    /* ─── Mobile Top Bar ─── */
    .pp-topbar {
        background: var(--pp-white);
        padding: 1rem 1.25rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid var(--pp-border);
        position: sticky;
        top: 0;
        z-index: 100;
    }
    .pp-topbar-brand { display: flex; align-items: center; gap: 8px; }
    .pp-topbar-brand-icon {
        width: 34px; height: 34px;
        background: var(--pp-purple-light);
        border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1rem;
    }
    .pp-topbar-brand h4 { margin: 0; font-size: 0.88rem; font-weight: 800; font-family:'Outfit',sans-serif; color:var(--pp-text-dark); }
    .pp-topbar-brand p  { margin: 0; font-size: 0.62rem; color: var(--pp-text-muted); font-weight: 500; }
    .pp-notif-btn {
        position: relative; width: 38px; height: 38px;
        border-radius: 50%; background: var(--pp-white); border: 1px solid var(--pp-border);
        display: flex; align-items: center; justify-content: center; cursor: pointer; color: var(--pp-text-mid);
    }
    .pp-notif-badge {
        position: absolute; top: -3px; right: -3px;
        background: #ef4444; color: white;
        font-size: 0.55rem; font-weight: 800;
        width: 15px; height: 15px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        border: 2px solid var(--pp-white);
    }

    /* ─── Page Header ─── */
    .pp-page-header {
        padding: 1.5rem 1.5rem 1rem;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
    }
    .pp-page-header h1 {
        font-family: 'Outfit', sans-serif;
        font-size: 1.5rem; font-weight: 800;
        color: var(--pp-text-dark); margin: 0 0 4px;
    }
    .pp-page-header p { font-size: 0.78rem; color: var(--pp-text-muted); margin: 0; font-weight: 500; }

    .pp-back-btn {
        display: inline-flex; align-items: center; gap: 6px;
        background: var(--pp-white); border: 1px solid var(--pp-border);
        border-radius: 12px; padding: 8px 14px;
        font-size: 0.78rem; font-weight: 700; color: var(--pp-text-dark);
        text-decoration: none; white-space: nowrap;
        box-shadow: var(--pp-card-shadow); transition: all 0.2s; flex-shrink: 0;
    }
    .pp-back-btn:hover { background: var(--pp-purple-light); color: var(--pp-purple); border-color: var(--pp-purple); }

    /* ─── Content Grid (Desktop 2-col, Mobile 1-col) ─── */
    .pp-content-grid {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        padding: 0 1.5rem 1.5rem;
    }

    /* ─── Hero Card ─── */
    .pp-hero-card {
        background: linear-gradient(135deg, #ede9fe 0%, #f5f3ff 60%, #e0f2fe 100%);
        border-radius: 20px;
        padding: 1.5rem;
        display: flex;
        align-items: center;
        gap: 1.5rem;
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(92,60,243,0.1);
    }
    [data-theme="dark"] .pp-hero-card {
        background: linear-gradient(135deg, rgba(92,60,243,0.2) 0%, rgba(30,41,59,0.9) 100%);
        border-color: rgba(92,60,243,0.2);
    }
    .pp-hero-card::before {
        content: '';
        position: absolute; top: -30px; right: -30px;
        width: 140px; height: 140px;
        background: rgba(92,60,243,0.06); border-radius: 50%;
    }
    .pp-avatar-wrapper { position: relative; flex-shrink: 0; }
    .pp-avatar {
        width: 90px; height: 90px; border-radius: 50%;
        background: var(--pp-purple); color: white;
        font-size: 2.2rem; font-weight: 800; font-family: 'Outfit', sans-serif;
        display: flex; align-items: center; justify-content: center;
        border: 3px solid white;
        box-shadow: 0 4px 16px rgba(92,60,243,0.25); overflow: hidden;
    }
    .pp-avatar img { width: 100%; height: 100%; object-fit: cover; }
    .pp-camera-btn {
        position: absolute; bottom: 2px; right: 2px;
        width: 28px; height: 28px;
        background: var(--pp-purple); border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        border: 2px solid white; cursor: pointer; color: white; font-size: 0.7rem;
    }
    .pp-hero-name { font-family: 'Outfit', sans-serif; font-size: 1.3rem; font-weight: 800; color: var(--pp-text-dark); margin: 0 0 4px; }
    .pp-hero-role {
        display: inline-block; background: var(--pp-purple); color: white;
        font-size: 0.65rem; font-weight: 700; padding: 2px 12px;
        border-radius: 20px; margin-bottom: 10px; letter-spacing: 0.02em;
    }
    .pp-hero-meta { display: flex; flex-direction: column; gap: 4px; }
    .pp-hero-meta-row { display: flex; align-items: center; gap: 7px; font-size: 0.78rem; color: var(--pp-text-mid); font-weight: 600; }

    /* ─── Section Cards ─── */
    .pp-card {
        background: var(--pp-white);
        border-radius: 20px;
        border: 1px solid var(--pp-border);
        box-shadow: var(--pp-card-shadow);
        overflow: hidden;
    }
    .pp-card-header {
        padding: 1rem 1.5rem;
        display: flex; align-items: center; justify-content: space-between;
        border-bottom: 1px solid var(--pp-border);
    }
    .pp-card-title-wrap { display: flex; align-items: center; gap: 10px; }
    .pp-card-icon {
        width: 34px; height: 34px; background: var(--pp-purple-light);
        border-radius: 10px; display: flex; align-items: center; justify-content: center; color: var(--pp-purple);
    }
    .pp-card-title { font-family: 'Outfit', sans-serif; font-size: 0.95rem; font-weight: 800; color: var(--pp-text-dark); margin: 0; }
    .pp-card-subtitle { margin: 0; font-size: 0.7rem; color: var(--pp-text-muted); font-weight: 500; }

    .pp-active-badge { background: var(--pp-green-light); color: var(--pp-green); font-size: 0.7rem; font-weight: 700; padding: 3px 12px; border-radius: 20px; }
    .pp-edit-btn {
        display: flex; align-items: center; gap: 5px;
        background: none; border: none; color: var(--pp-purple);
        font-size: 0.8rem; font-weight: 700; cursor: pointer; padding: 6px 10px;
        border-radius: 10px; font-family: 'Plus Jakarta Sans', sans-serif;
        transition: background 0.2s;
    }
    .pp-edit-btn:hover { background: var(--pp-purple-light); }

    /* Info rows */
    .pp-info-row {
        display: flex; align-items: center; justify-content: space-between;
        padding: 0.9rem 1.5rem; border-bottom: 1px solid var(--pp-border); gap: 1rem;
    }
    .pp-info-row:last-child { border-bottom: none; }
    .pp-info-left { display: flex; align-items: center; gap: 10px; color: var(--pp-text-mid); font-size: 0.82rem; font-weight: 600; }
    .pp-info-right { font-size: 0.82rem; font-weight: 600; color: var(--pp-text-dark); text-align: right; word-break: break-all; }
    .pp-verified-pill {
        display: inline-flex; align-items: center; gap: 4px;
        background: var(--pp-green-light); color: var(--pp-green);
        font-size: 0.72rem; font-weight: 700; padding: 3px 10px; border-radius: 20px;
    }

    /* ─── Stats ─── */
    .pp-stats-row { display: grid; grid-template-columns: repeat(4, 1fr); }
    .pp-stat-item {
        display: flex; flex-direction: column; align-items: center; gap: 6px;
        padding: 1.25rem 0.5rem; border-right: 1px solid var(--pp-border);
    }
    .pp-stat-item:last-child { border-right: none; }
    .pp-stat-icon { width: 38px; height: 38px; border-radius: 11px; display: flex; align-items: center; justify-content: center; }
    .pp-stat-icon.books  { background: var(--pp-purple-light); color: var(--pp-purple); }
    .pp-stat-icon.saved  { background: var(--pp-green-light);  color: var(--pp-green);  }
    .pp-stat-icon.pubs   { background: var(--pp-orange-light); color: var(--pp-orange); }
    .pp-stat-icon.streak { background: var(--pp-teal-light);   color: var(--pp-teal);   }
    .pp-stat-value { font-family: 'Outfit', sans-serif; font-size: 1.4rem; font-weight: 800; color: var(--pp-text-dark); line-height: 1; }
    .pp-stat-label { font-size: 0.62rem; font-weight: 700; color: var(--pp-text-muted); text-align: center; line-height: 1.3; }

    /* ─── Form Fields ─── */
    .pp-field-row {
        display: flex; align-items: center;
        padding: 0.85rem 1.5rem; border-bottom: 1px solid var(--pp-border); gap: 1rem;
        transition: background 0.2s;
    }
    .pp-field-row:last-child { border-bottom: none; }
    body.editing-mode .pp-field-row { background: rgba(92,60,243,0.02); }
    .pp-field-icon { width: 30px; display: flex; align-items: center; justify-content: center; color: var(--pp-text-muted); flex-shrink: 0; }
    .pp-field-label { width: 140px; flex-shrink: 0; font-size: 0.78rem; font-weight: 600; color: var(--pp-text-mid); }
    .pp-field-value { flex: 1; font-size: 0.82rem; font-weight: 600; color: var(--pp-text-dark); text-align: right; }
    .pp-field-input, .pp-field-select {
        flex: 1; border: none; outline: none; background: transparent;
        font-size: 0.82rem; font-weight: 600; color: var(--pp-text-dark);
        text-align: right; font-family: 'Plus Jakarta Sans', sans-serif; width: 100%;
    }
    .pp-field-input::placeholder { color: var(--pp-text-muted); }
    .pp-field-select { direction: rtl; cursor: pointer; appearance: none; -webkit-appearance: none; }

    .view-state  { display: block; }
    .edit-state  { display: none; }
    body.editing-mode .view-state { display: none; }
    body.editing-mode .edit-state { display: block; }

    /* ─── Form Actions ─── */
    .pp-action-section {
        padding: 1.25rem 1.5rem; display: flex; flex-direction: column; gap: 10px;
        border-top: 1px solid var(--pp-border);
    }
    .pp-save-btn {
        width: 100%; padding: 13px; background: var(--pp-purple); color: white;
        border: none; border-radius: 14px; font-size: 0.88rem; font-weight: 800;
        cursor: pointer; font-family: 'Outfit', sans-serif; letter-spacing: 0.02em;
        transition: all 0.2s; box-shadow: 0 4px 16px rgba(92,60,243,0.25);
    }
    .pp-save-btn:hover { background: var(--pp-purple-mid); transform: translateY(-1px); }
    .pp-cancel-btn {
        width: 100%; padding: 12px; background: transparent; color: var(--pp-text-mid);
        border: 1.5px solid var(--pp-border); border-radius: 14px; font-size: 0.82rem;
        font-weight: 700; cursor: pointer; font-family: 'Plus Jakarta Sans', sans-serif;
        transition: all 0.2s;
    }
    .pp-cancel-btn:hover { background: var(--pp-bg); }
    .pp-pass-row { display: flex; gap: 8px; }
    .pp-pass-input {
        flex: 1; padding: 11px 14px; border: 1.5px solid var(--pp-border);
        border-radius: 12px; font-size: 0.82rem; font-weight: 600;
        background: var(--pp-bg); color: var(--pp-text-dark);
        font-family: 'Plus Jakarta Sans', sans-serif; outline: none;
    }
    .pp-pass-input:focus { border-color: var(--pp-purple); box-shadow: 0 0 0 3px rgba(92,60,243,0.08); }
    .pp-pass-btn {
        padding: 11px 14px; border: 1.5px solid var(--pp-purple); border-radius: 12px;
        background: var(--pp-purple-light); color: var(--pp-purple);
        font-size: 0.78rem; font-weight: 700; cursor: pointer; white-space: nowrap;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    /* ─── Danger ─── */
    .pp-logout-btn {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 12px 20px; border: 1.5px solid #f43f5e;
        border-radius: 14px; background: rgba(244,63,94,0.06); color: #f43f5e;
        font-size: 0.82rem; font-weight: 700; cursor: pointer;
        text-decoration: none; font-family: 'Plus Jakarta Sans', sans-serif;
        transition: all 0.2s;
    }
    .pp-logout-btn:hover { background: rgba(244,63,94,0.12); }

    /* ─── Mobile Bottom Nav ─── */
    .pp-bottom-nav {
        position: fixed; bottom: 0; left: 0; right: 0; height: 72px;
        background: var(--pp-white); border-top: 1px solid var(--pp-border);
        box-shadow: 0 -4px 20px rgba(0,0,0,0.06);
        display: flex; justify-content: space-around; align-items: center;
        padding: 0 0.5rem; z-index: 1000;
        /* blur removed */ /* blur removed */
    }
    .pp-nav-item {
        display: flex; flex-direction: column; align-items: center; gap: 3px;
        text-decoration: none; color: var(--pp-text-muted);
        font-size: 0.6rem; font-weight: 700; padding: 8px 12px; border-radius: 12px;
        transition: all 0.2s; font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .pp-nav-item.active { color: var(--pp-purple); background: var(--pp-purple-light); }
    .pp-nav-item.active svg { transform: scale(1.1); }

    /* ─── DESKTOP LAYOUT ─── */
    @media (min-width: 600px) {
        /* Show sidebar, hide mobile topbar & bottom nav */
        .desktop-sidebar { display: flex !important; }
        .pp-topbar       { display: none !important; }
        .pp-bottom-nav   { display: none !important; }

        .portal-main { padding-bottom: 2rem; }

        .pp-page-header {
            padding: 2rem 2rem 1.25rem;
            align-items: center;
        }
        .pp-page-header h1 { font-size: 1.8rem; }

        .pp-content-grid {
            padding: 0 2rem 2rem;
            display: grid;
            grid-template-columns: 1fr 1fr;
            grid-template-rows: auto;
            gap: 1.5rem;
        }

        /* Hero spans full width */
        .pp-hero-card { grid-column: 1 / -1; }
        .pp-hero-card { padding: 2rem; }
        .pp-avatar { width: 100px; height: 100px; font-size: 2.5rem; }
        .pp-hero-name { font-size: 1.6rem; }
        .pp-hero-meta-row { font-size: 0.85rem; }

        /* Stats row also full width */
        .pp-stats-card { grid-column: 1 / -1; }

        /* Account overview on left, form on right */
        .pp-account-card { grid-column: 1 / 2; align-self: start; }
        .pp-form-card     { grid-column: 2 / 3; grid-row: 3 / 5; }

        /* Danger zone spans full width */
        .pp-danger-zone { grid-column: 1 / -1; }

        .pp-card-header { padding: 1.25rem 1.75rem; }
        .pp-info-row    { padding: 0.9rem 1.75rem; }
        .pp-field-row   { padding: 0.85rem 1.75rem; }
        .pp-action-section { padding: 1.5rem 1.75rem; }
    }

    /* Hide global floaters */
    .global-nav-container { display: none !important; }
 </style>
<style>
/* sp- conversion overrides */
.desktop-sidebar, .pp-topbar, .pp-bottom-nav { display: none !important; }
.portal-wrapper { display: block !important; width: 100% !important; max-width: none !important; margin: 0 !important; box-shadow: none !important; background: transparent !important; }
.portal-main { display: block !important; width: 100% !important; max-width: 100% !important; margin: 0 !important; padding: 0 !important; min-height: 0 !important; overflow: visible !important; background: transparent !important; }
</style>

<div class="sp-page">
  <div class="sp-layout">
    <%- include('partials/student_sidebar', { active: 'profile' }) %>
    <div class="sp-main">
      <%- include('partials/student_topbar', { title: 'My Profile' }) %>
      <main class="sp-content">
<div class="portal-wrapper">
    <!-- ══ Desktop Sidebar ══ -->
    <aside class="desktop-sidebar">
        <div class="sidebar-brand">
            <span class="brand-icon">🌐</span>
            <div class="brand-info">
                <h4><%= session.school_name || 'E-Pathshala' %></h4>
                <p>Student Portal</p>
            </div>
        </div>
        <nav class="sidebar-menu">
            <a href="/student" class="sidebar-link">
                <span class="link-icon">📊</span><span>Dashboard</span>
            </a>
            <a href="/leaderboard" class="sidebar-link">
                <span class="link-icon">🏆</span><span>Leaderboard</span>
            </a>
            <a href="/student/browse" class="sidebar-link">
                <span class="link-icon">📚</span><span>Digital Library</span>
            </a>
            <a href="/digital-library" class="sidebar-link">
                <span class="link-icon">🌐</span><span>Community Library</span>
            </a>
            <a href="/student/publish" class="sidebar-link">
                <span class="link-icon">✏️</span><span>Publish Content</span>
            </a>
            <a href="/student/my-publications" class="sidebar-link">
                <span class="link-icon">📄</span><span>Publications</span>
            </a>
            <a href="/student/bookmarks" class="sidebar-link">
                <span class="link-icon">🔖</span><span>Saved Items</span>
            </a>
            <a href="/student/profile" class="sidebar-link active">
                <span class="link-icon">👤</span><span>My Profile</span>
            </a>
            <hr class="sidebar-divider">
            <a href="/logout" class="sidebar-link logout-link">
                <span class="link-icon">🚪</span><span>Log Out</span>
            </a>
        </nav>
        <div class="sidebar-profile-card">
            <div class="profile-card-avatar">
                <%= session.user_name ? session.user_name[0].toUpperCase() : 'S' %>
            </div>
            <div class="profile-card-info">
                <h5><%= session.user_name || 'Student' %></h5>
                <p>Class <%= session.class || '—' %></p>
            </div>
        </div>
    </aside>

    <!-- ══ Main Content ══ -->
    <div class="portal-main">

        <!-- Mobile Top Bar (hidden on desktop) -->
        <div class="pp-topbar">
            <div class="pp-topbar-brand">
                <div class="pp-topbar-brand-icon">📚</div>
                <div>
                    <h4>Librika</h4>
                    <p>Digital Library</p>
                </div>
            </div>
            <button class="pp-notif-btn" title="Notifications">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                <span class="pp-notif-badge">3</span>
            </button>
        </div>

        <!-- Page Header -->
        <div class="pp-page-header">
            <div>
                <h1>My Profile</h1>
                <p>Manage your personal information and account settings</p>
            </div>
            <a href="/student" class="pp-back-btn">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                Back to Dashboard
            </a>
        </div>

        <div class="pp-content-grid">

            <!-- ── Hero Card ── -->
            <div class="pp-hero-card pp-card">
                <div class="pp-avatar-wrapper">
                    <div class="pp-avatar" id="avatarCircle">
                        <%= session.user_name ? session.user_name[0].toUpperCase() : 'S' %>
                    </div>
                    <label for="avatarUpload" class="pp-camera-btn" title="Change Photo">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
                    </label>
                    <input type="file" id="avatarUpload" accept="image/*" style="display:none" onchange="previewAvatar(this)">
                </div>
                <div style="flex:1; min-width:0;">
                    <h2 class="pp-hero-name"><%= user.name || 'Student' %></h2>
                    <span class="pp-hero-role">Student</span>
                    <div class="pp-hero-meta">
                        <div class="pp-hero-meta-row">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
                            Class <%= user.class || '—' %>
                            <% if (user.stream) { %> &bull; <%= user.stream %><% } %>
                        </div>
                        <div class="pp-hero-meta-row">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                            <%= session.school_name || 'librika.in' %> Network
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── Stats Card ── -->
            <div class="pp-card pp-stats-card">
                <div class="pp-stats-row">
                    <div class="pp-stat-item">
                        <div class="pp-stat-icon books">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                        </div>
                        <span class="pp-stat-value"><%= stats.total_read %></span>
                        <span class="pp-stat-label">Books Read</span>
                    </div>
                    <div class="pp-stat-item">
                        <div class="pp-stat-icon saved">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
                        </div>
                        <span class="pp-stat-value"><%= stats.saved_count %></span>
                        <span class="pp-stat-label">Saved Items</span>
                    </div>
                    <div class="pp-stat-item">
                        <div class="pp-stat-icon pubs">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                        </div>
                        <span class="pp-stat-value"><%= stats.publications_count %></span>
                        <span class="pp-stat-label">Publications</span>
                    </div>
                    <div class="pp-stat-item">
                        <div class="pp-stat-icon streak">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2c0 0-5 6-5 11a5 5 0 0 0 10 0c0-5-5-11-5-11z"/><path d="M12 12c0 0-2 2.5-2 4a2 2 0 0 0 4 0c0-1.5-2-4-2-4z" fill="currentColor"/></svg>
                        </div>
                        <span class="pp-stat-value"><%= stats.days_streak %></span>
                        <span class="pp-stat-label">Days Streak</span>
                    </div>
                </div>
            </div>

            <!-- ── Reading Achievements Card ── -->
            <div class="pp-card" style="grid-column: 1 / -1; background: var(--pp-white);">
                <div class="pp-card-header">
                    <div class="pp-card-title-wrap">
                        <div class="pp-card-icon" style="background:var(--pp-purple-light); color:var(--pp-purple);">🏆</div>
                        <div>
                            <h3 class="pp-card-title">Reading Achievements</h3>
                            <p class="pp-card-subtitle">Your score, streaks, and badges earned</p>
                        </div>
                    </div>
                </div>
                <div style="padding: 1.5rem; display: flex; flex-direction: column; gap: 20px;">
                    <!-- Scores Grid -->
                    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; text-align: center;">
                        <div style="background: var(--pp-bg); padding: 15px; border-radius: 16px;">
                            <div style="font-family:'Outfit'; font-size: 1.6rem; font-weight: 800; color: var(--pp-purple);"><%= user.overall_reader_score || 0 %></div>
                            <div style="font-size: 0.7rem; font-weight: 700; color: var(--pp-text-muted); text-transform: uppercase; margin-top: 4px;">Overall Score</div>
                        </div>
                        <div style="background: var(--pp-bg); padding: 15px; border-radius: 16px;">
                            <div style="font-family:'Outfit'; font-size: 1.6rem; font-weight: 800; color: var(--pp-purple);"><%= user.physical_reader_score || 0 %></div>
                            <div style="font-size: 0.7rem; font-weight: 700; color: var(--pp-text-muted); text-transform: uppercase; margin-top: 4px;">Physical Score</div>
                        </div>
                        <div style="background: var(--pp-bg); padding: 15px; border-radius: 16px;">
                            <div style="font-family:'Outfit'; font-size: 1.6rem; font-weight: 800; color: var(--pp-purple);"><%= user.digital_reader_score || 0 %></div>
                            <div style="font-size: 0.7rem; font-weight: 700; color: var(--pp-text-muted); text-transform: uppercase; margin-top: 4px;">Digital Score</div>
                        </div>
                    </div>

                    <!-- Streaks & Stats -->
                    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; text-align: center;">
                        <div style="background: var(--pp-bg); padding: 12px; border-radius: 16px;">
                            <div style="font-size: 1.2rem; font-weight: 800; color: var(--pp-text-dark);"><%= user.longest_streak || 0 %> days</div>
                            <div style="font-size: 0.65rem; font-weight: 600; color: var(--pp-text-muted); margin-top: 2px;">Longest Streak</div>
                        </div>
                        <div style="background: var(--pp-bg); padding: 12px; border-radius: 16px;">
                            <div style="font-size: 1.2rem; font-weight: 800; color: var(--pp-text-dark);"><%= user.quizzes_passed || 0 %></div>
                            <div style="font-size: 0.65rem; font-weight: 600; color: var(--pp-text-muted); margin-top: 2px;">Quizzes Passed</div>
                        </div>
                        <div style="background: var(--pp-bg); padding: 12px; border-radius: 16px;">
                            <div style="font-size: 1.2rem; font-weight: 800; color: var(--pp-text-dark);"><%= user.approved_reviews || 0 %></div>
                            <div style="font-size: 0.65rem; font-weight: 600; color: var(--pp-text-muted); margin-top: 2px;">Reviews Approved</div>
                        </div>
                    </div>

                    <!-- Badges -->
                    <div>
                        <h4 style="font-size: 0.82rem; font-weight: 800; color: var(--pp-text-dark); margin: 0 0 10px 0; text-transform: uppercase; letter-spacing: 0.05em;">🏅 Earned Badges</h4>
                        <% if (badges) { %>
                            <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                                <% badges.forEach(function(b) { %>
                                <span style="font-size: 0.72rem; font-weight: 800; background: var(--pp-purple-light); color: var(--pp-purple); padding: 6px 14px; border-radius: 100px; display: inline-flex; align-items: center; gap: 4px; border: 1px solid rgba(92,60,243,0.15);">
                                    🌟 <%= b %>
                                </span>
                                <% }); %>
                            </div>
                        <% } else { %>
                            <div style="font-size: 0.78rem; color: var(--pp-text-muted); font-style: italic;">No badges earned yet. Complete books and pass quizzes to unlock!</div>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- ── Account Overview Card ── -->
            <div class="pp-card pp-account-card">
                <div class="pp-card-header">
                    <div class="pp-card-title-wrap">
                        <div class="pp-card-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        </div>
                        <h3 class="pp-card-title">Account Overview</h3>
                    </div>
                    <span class="pp-active-badge">Active</span>
                </div>
                <% var email_raw = user.email || ''; %>
                <div class="pp-info-row">
                    <div class="pp-info-left">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                        Email Address
                    </div>
                    <div class="pp-info-right"><%= email_raw || 'Not set' %></div>
                </div>
                <div class="pp-info-row">
                    <div class="pp-info-left">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13 19.79 19.79 0 0 1 1.61 4.37 2 2 0 0 1 3.6 2.18L6.52 2a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.6 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                        Primary Phone
                    </div>
                    <div class="pp-info-right"><%= user.phone ? '+91 ' + user.phone : 'Not set' %></div>
                </div>
                <div class="pp-info-row">
                    <div class="pp-info-left">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        Email Verified
                    </div>
                    <span class="pp-verified-pill">
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="#22c55e" stroke="#22c55e" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                        Verified
                    </span>
                </div>
                <div class="pp-info-row">
                    <div class="pp-info-left">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
                        Phone Verified
                    </div>
                    <span class="pp-verified-pill">
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="#22c55e" stroke="#22c55e" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                        Verified
                    </span>
                </div>
            </div>

            <!-- ── Personal Info Card (Form) ── -->
            <form method="POST" id="profileForm">
                <div class="pp-card pp-form-card">
                    <div class="pp-card-header">
                        <div class="pp-card-title-wrap">
                            <div class="pp-card-icon" style="background:var(--pp-purple-light); color:var(--pp-purple);">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                            </div>
                            <div>
                                <h3 class="pp-card-title" style="color:var(--pp-purple);">Personal Information</h3>
                                <p class="pp-card-subtitle">Update your personal details</p>
                            </div>
                        </div>
                        <button type="button" class="pp-edit-btn" onclick="toggleEditMode()" id="editToggleBtn">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                            Edit
                        </button>
                    </div>

                    <!-- Full Name -->
                    <div class="pp-field-row">
                        <div class="pp-field-icon"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></div>
                        <span class="pp-field-label">Full Name</span>
                        <span class="pp-field-value view-state"><%= user.name || '—' %></span>
                        <input type="text" name="name" class="pp-field-input edit-state" value="<%= user.name || '' %>" placeholder="Enter full name">
                    </div>
                    <!-- Admission No -->
                    <div class="pp-field-row">
                        <div class="pp-field-icon"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg></div>
                        <span class="pp-field-label">Admission No.</span>
                        <span class="pp-field-value view-state"><%= user.admission_no || '—' %></span>
                        <input type="text" name="admission_no" class="pp-field-input edit-state" value="<%= user.admission_no || '' %>" placeholder="e.g. LIB2411007">
                    </div>
                    <!-- Class -->
                    <div class="pp-field-row">
                        <div class="pp-field-icon"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg></div>
                        <span class="pp-field-label">Academic Class</span>
                        <span class="pp-field-value view-state"><%= user.class ? 'Class ' + user.class : '—' %></span>
                        <select name="class" class="pp-field-select edit-state">
                            <% for (var c=1; c<=12; c++) { %>
                            <option value="<%= c %>" <% if (user.class && user.class.toString() === c.toString()) { %>selected<% } %>>Class <%= c %></option>
                            <% } %>
                        </select>
                    </div>
                    <!-- Section -->
                    <div class="pp-field-row">
                        <div class="pp-field-icon"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></div>
                        <span class="pp-field-label">Academic Section</span>
                        <span class="pp-field-value view-state"><%= user.section ? 'Section ' + user.section : '—' %></span>
                        <input type="text" name="section" class="pp-field-input edit-state" value="<%= user.section || '' %>" placeholder="e.g. A, B, C">
                    </div>
                    <!-- Stream -->
                    <div class="pp-field-row">
                        <div class="pp-field-icon"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg></div>
                        <span class="pp-field-label">Stream</span>
                        <% var stream_raw = user.stream || ''; %>
                        <span class="pp-field-value view-state"><%= stream_raw || '—' %></span>
                        <select name="stream" class="pp-field-select edit-state">
                            <option value="">— Select —</option>
                            <option value="Science"  <% if (stream_raw === 'Science')  { %>selected<% } %>>Science</option>
                            <option value="Commerce" <% if (stream_raw === 'Commerce') { %>selected<% } %>>Commerce</option>
                            <option value="Arts"     <% if (stream_raw === 'Arts')     { %>selected<% } %>>Arts</option>
                            <option value="General"  <% if (stream_raw === 'General')  { %>selected<% } %>>General</option>
                        </select>
                    </div>
                    <!-- Date of Birth -->
                    <div class="pp-field-row">
                        <div class="pp-field-icon"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg></div>
                        <span class="pp-field-label">Date of Birth</span>
                        <% var dob_raw = user.dob || ''; %>
                        <span class="pp-field-value view-state"><%= dob_raw || '—' %></span>
                        <input type="date" name="dob" class="pp-field-input edit-state" value="<%= dob_raw || '' %>" style="text-align:right; color-scheme: light dark;">
                    </div>
                    <!-- Email -->
                    <div class="pp-field-row">
                        <div class="pp-field-icon"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg></div>
                        <span class="pp-field-label">Email Address</span>
                        <% var email_raw = user.email || ''; %>
                        <span class="pp-field-value view-state"><%= email_raw || '—' %></span>
                        <input type="email" name="email" class="pp-field-input edit-state" value="<%= email_raw || '' %>" placeholder="you@email.com">
                    </div>
                    <!-- Phone (read-only) -->
                    <div class="pp-field-row">
                        <div class="pp-field-icon"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13 19.79 19.79 0 0 1 1.61 4.37 2 2 0 0 1 3.6 2.18L6.52 2a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.6 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg></div>
                        <span class="pp-field-label">Phone</span>
                        <span class="pp-field-value"><%= user.phone || '—' %></span>
                    </div>

                    <!-- Save actions (edit mode) -->
                    <div class="pp-action-section edit-state">
                        <div class="pp-pass-row">
                            <input type="password" name="password" id="passInput" class="pp-pass-input" placeholder="New password (leave blank to keep)">
                            <button type="button" class="pp-pass-btn" onclick="togglePassVisibility()">Show</button>
                        </div>
                        <button type="submit" class="pp-save-btn">✅ Save Changes</button>
                        <button type="button" class="pp-cancel-btn" onclick="toggleEditMode()">Cancel</button>
                    </div>
                </div>
            </form>

            <!-- ── Danger Zone ── -->
            <div class="pp-danger-zone" style="display:flex; gap:10px; flex-wrap:wrap;">
                <a href="/logout" class="pp-logout-btn">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                    Log Out
                </a>
            </div>

        </div><!-- end grid -->

        <!-- ── Mobile Bottom Nav ── -->
        <nav class="pp-bottom-nav">
            <a href="/student" class="pp-nav-item">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                <span>Home</span>
