<script>
    function selectWorkspace(type) {
        const schoolTab = document.getElementById('schoolTab');
        const personalTab = document.getElementById('personalTab');
        const schoolCodeGroup = document.getElementById('schoolCodeGroup');
        const loginTypeInput = document.getElementById('login_type');
        const lnkRegisterSchool = document.getElementById('lnkRegisterSchool');
        const lnkRegisterPersonal = document.getElementById('lnkRegisterPersonal');

        if (loginTypeInput) loginTypeInput.value = type;

        if (type === 'personal') {
            personalTab.classList.add('active');
            personalTab.classList.remove('text-outline');
            schoolTab.classList.remove('active');
            schoolTab.classList.add('text-outline');
            
            personalTab.querySelector('.material-symbols-outlined').style.fontVariationSettings = "'FILL' 1";
            schoolTab.querySelector('.material-symbols-outlined').style.fontVariationSettings = "'FILL' 0";

            if (schoolCodeGroup) schoolCodeGroup.style.display = 'none';
            if (lnkRegisterSchool) lnkRegisterSchool.style.display = 'none';
            if (lnkRegisterPersonal) lnkRegisterPersonal.style.display = 'flex';
        } else {
            schoolTab.classList.add('active');
            schoolTab.classList.remove('text-outline');
            personalTab.classList.remove('active');
            personalTab.classList.add('text-outline');

            schoolTab.querySelector('.material-symbols-outlined').style.fontVariationSettings = "'FILL' 1";
            personalTab.querySelector('.material-symbols-outlined').style.fontVariationSettings = "'FILL' 0";

            if (schoolCodeGroup) schoolCodeGroup.style.display = 'block';
            if (lnkRegisterSchool) lnkRegisterSchool.style.display = 'flex';
            if (lnkRegisterPersonal) lnkRegisterPersonal.style.display = 'none';
        }
    }

    let currentDemoSchool = 'VBPGZ';
    let currentDemoRole = 'all';

    function switchDemoSchool(schoolCode) {
        currentDemoSchool = schoolCode;
        const btnGZ = document.getElementById('schoolBtnVBPGZ');
        const btnNO = document.getElementById('schoolBtnVBPNO');
        const schoolGZ = document.getElementById('demoSchool_VBPGZ');
        const schoolNO = document.getElementById('demoSchool_VBPNO');
        const lblActive = document.getElementById('lblActiveSchool');
        const schoolInput = document.getElementById('school_code');

        if (schoolCode === 'VBPGZ') {
            if (btnGZ) btnGZ.className = 'flex-1 py-1.5 px-2 rounded-md text-xs font-bold transition-all flex items-center justify-center gap-1.5 bg-blue-600 text-white shadow-sm cursor-pointer';
            if (btnNO) btnNO.className = 'flex-1 py-1.5 px-2 rounded-md text-xs font-bold transition-all flex items-center justify-center gap-1.5 text-gray-600 hover:text-blue-700 hover:bg-blue-50 cursor-pointer';
            if (schoolGZ) schoolGZ.style.display = 'grid';
            if (schoolNO) schoolNO.style.display = 'none';
            if (lblActive) lblActive.textContent = 'VBPS Ghaziabad (VBPGZ)';
            if (schoolInput) schoolInput.value = 'VBPGZ';
        } else {
            if (btnNO) btnNO.className = 'flex-1 py-1.5 px-2 rounded-md text-xs font-bold transition-all flex items-center justify-center gap-1.5 bg-blue-600 text-white shadow-sm cursor-pointer';
            if (btnGZ) btnGZ.className = 'flex-1 py-1.5 px-2 rounded-md text-xs font-bold transition-all flex items-center justify-center gap-1.5 text-gray-600 hover:text-blue-700 hover:bg-blue-50 cursor-pointer';
            if (schoolNO) schoolNO.style.display = 'grid';
            if (schoolGZ) schoolGZ.style.display = 'none';
            if (lblActive) lblActive.textContent = 'VBPS Noida (VBPNO)';
            if (schoolInput) schoolInput.value = 'VBPNO';
        }
        applyDemoRoleFilter();
    }

    function filterDemoRole(role) {
        currentDemoRole = role;
        document.querySelectorAll('.demo-role-pill').forEach(btn => {
            if (btn.getAttribute('data-role') === role) {
                btn.className = 'demo-role-pill active px-2.5 py-0.5 text-[11px] rounded font-bold transition-colors bg-blue-600 text-white shadow-xs cursor-pointer';
            } else {
                btn.className = 'demo-role-pill px-2 py-0.5 text-[11px] rounded font-semibold transition-colors bg-white text-gray-700 hover:bg-blue-50 border border-gray-200 cursor-pointer';
            }
        });
        applyDemoRoleFilter();
    }

    function applyDemoRoleFilter() {
        const activeContainer = document.getElementById(`demoSchool_${currentDemoSchool}`);
        if (!activeContainer) return;
        const cards = activeContainer.querySelectorAll('.demo-card');
        cards.forEach(card => {
            const cardRole = card.getAttribute('data-role');
            if (currentDemoRole === 'all' || cardRole === currentDemoRole) {
                card.style.display = 'flex';
            } else {
                card.style.display = 'none';
            }
        });
    }

    function fillDemoCredentials(schoolCode, username, password, autoSubmit) {
        selectWorkspace('school');
        const schoolInput = document.getElementById('school_code');
        const userInput = document.getElementById('username');
        const passInput = document.getElementById('password');
        const loginBtn = document.getElementById('loginBtn');
        const form = document.getElementById('loginForm');

        if (schoolInput) schoolInput.value = (schoolCode && schoolCode !== 'GLOBAL') ? schoolCode : '';
        if (userInput) userInput.value = username || '';
        if (passInput) passInput.value = password || '';

        if (autoSubmit && form) {
            if (loginBtn) {
                loginBtn.innerHTML = '<span class="font-label-bold text-white">Logging in as ' + (username || 'demo user') + '...</span>';
                loginBtn.style.opacity = '0.85';
            }
            setTimeout(() => {
                form.submit();
            }, 250);
        }
    }

    function togglePasswordVisibility() {
        const passwordInput = document.getElementById('password');
        const eyeIcon = document.getElementById('eyeIcon');
        if (passwordInput.type === 'password') {
            passwordInput.type = 'text';
            eyeIcon.textContent = 'visibility';
        } else {
            passwordInput.type = 'password';
            eyeIcon.textContent = 'visibility_off';
        }
    }

    document.addEventListener('mousemove', (e) => {
        const x = (e.clientX / window.innerWidth) * 20;
        const y = (e.clientY / window.innerHeight) * 20;
        const orbs = document.querySelectorAll('.orb');
        if (orbs[0]) orbs[0].style.transform = `translate(${x}px, ${y}px)`;
        if (orbs[1]) orbs[1].style.transform = `translate(${-x}px, ${-y}px)`;
    });
</script>
