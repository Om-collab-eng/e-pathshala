                    <span class="material-symbols-outlined text-[16px]">apartment</span>
                    <span>VBPS Ghaziabad <span class="font-mono text-[10px] opacity-90">(VBPGZ)</span></span>
                </button>
                <button type="button" id="schoolBtnVBPNO" onclick="switchDemoSchool('VBPNO')" 
                        class="flex-1 py-1.5 px-2 rounded-md text-xs font-bold transition-all flex items-center justify-center gap-1.5 text-gray-600 hover:text-blue-700 hover:bg-blue-50 cursor-pointer">
