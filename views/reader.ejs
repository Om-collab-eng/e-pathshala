<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title><%= title %></title>
  
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="shortcut icon" href="/favicon.ico">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.min.js"></script>

  <style>
    *, *::before, *::after { box-sizing: border-box; }
    html, body {
      margin: 0;
      padding: 0;
      width: 100vw;
      height: 100vh;
      overflow: hidden;
      background: #0B0F19;
      color: #F8FAFC;
      font-family: 'Plus Jakarta Sans', 'Inter', -apple-system, sans-serif;
    }

    .reader-shell {
      display: flex;
      flex-direction: column;
      width: 100vw;
      height: 100vh;
      background: #0B0F19;
    }

    /* Top Navigation Toolbar */
    .reader-topbar {
      height: 60px;
      min-height: 60px;
      background: #111827;
      border-bottom: 1px solid #1F2937;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 1.25rem;
      z-index: 50;
      gap: 12px;
    }

    .reader-left {
      display: flex;
      align-items: center;
      gap: 12px;
      min-width: 0;
    }

    .reader-exit-btn {
      width: 36px;
      height: 36px;
      min-width: 36px;
      border-radius: 10px;
      background: #1F2937;
      color: #94A3B8;
      display: flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      transition: all 0.15s ease;
      border: 1px solid #374151;
    }
    .reader-exit-btn:hover {
      background: #0B5ED7;
      color: #FFFFFF;
      border-color: #0B5ED7;
    }

    .reader-title-wrap {
      display: flex;
      flex-direction: column;
      min-width: 0;
    }

    .reader-title {
      font-size: 1rem;
      font-weight: 800;
      color: #FFFFFF;
      margin: 0;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 340px;
    }

    .reader-sub {
      font-size: 0.75rem;
      color: #94A3B8;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .reader-controls {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .ctrl-btn {
      background: #1F2937;
      border: 1px solid #374151;
      color: #F8FAFC;
      border-radius: 8px;
      padding: 6px 12px;
      font-size: 0.8rem;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      transition: all 0.15s ease;
    }
    .ctrl-btn:hover {
      background: #374151;
      color: #FFFFFF;
    }
    .ctrl-btn:disabled {
      opacity: 0.4;
      cursor: not-allowed;
    }

    .page-indicator {
      background: #1F2937;
      border: 1px solid #374151;
      color: #60A5FA;
      font-family: monospace;
      font-size: 0.82rem;
      font-weight: 700;
      padding: 6px 12px;
      border-radius: 8px;
      white-space: nowrap;
    }

    /* Stage Area */
    #viewer-stage {
      flex: 1;
      overflow-y: auto;
      overflow-x: auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 24px 16px;
      background: #0B0F19;
      position: relative;
    }

    .pdf-canvas-card {
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(255, 255, 255, 0.1);
      border-radius: 6px;
      background: #FFFFFF;
      max-width: 100%;
      height: auto;
      transition: transform 0.2s ease;
    }

    /* Toast */
    .toast-pill {
      position: fixed;
      bottom: 24px;
      right: 24px;
      background: #10B981;
      color: #FFFFFF;
      font-weight: 700;
      font-size: 0.82rem;
      padding: 8px 16px;
      border-radius: 20px;
      box-shadow: 0 10px 15px -3px rgba(0,0,0,0.4);
      opacity: 0;
      transform: translateY(10px);
      transition: all 0.25s ease;
      pointer-events: none;
      z-index: 100;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .toast-pill.show {
      opacity: 1;
      transform: translateY(0);
    }

    /* Fallback Embed View */
    .fallback-card {
      background: #111827;
      border: 1px solid #374151;
      border-radius: 16px;
      padding: 32px;
      max-width: 600px;
      text-align: center;
      margin: 40px auto;
    }

    @media (max-width: 768px) {
      .reader-sub { display: none; }
      .reader-title { max-width: 160px; }
      .hide-mobile { display: none; }
    }
  </style>
</head>
<body>

  <div class="reader-shell">
    
    <!-- Topbar -->
    <header class="reader-topbar">
      <div class="reader-left">
        <a href="/student/e-library" class="reader-exit-btn" title="Back to E-Library">
          <span class="material-symbols-outlined text-[20px]">arrow_back</span>
        </a>

        <div class="reader-title-wrap">
          <h1 class="reader-title"><%= content.title %></h1>
          <div class="reader-sub">
            <%= content.author || 'Librika Curriculum' %> &bull; <%= content.subject || 'E-Book' %>
          </div>
        </div>
      </div>

      <!-- Controls -->
      <div class="reader-controls">
        <button class="ctrl-btn" id="btn-zoom-out" title="Zoom Out">
          <span class="material-symbols-outlined text-[16px]">remove</span>
        </button>
        <span id="zoom-val" class="page-indicator hide-mobile" style="color:#CBD5E1;">120%</span>
        <button class="ctrl-btn" id="btn-zoom-in" title="Zoom In">
          <span class="material-symbols-outlined text-[16px]">add</span>
        </button>

        <div style="width:1px;height:22px;background:#374151;margin:0 4px;"></div>

        <button class="ctrl-btn" id="btn-prev-page">
          <span class="material-symbols-outlined text-[16px]">chevron_left</span>
          <span class="hide-mobile">Prev</span>
        </button>
        
        <span class="page-indicator">
          Page <span id="page-num"><%= start_page || 1 %></span> / <span id="page-count">--</span>
        </span>

        <button class="ctrl-btn" id="btn-next-page">
          <span class="hide-mobile">Next</span>
          <span class="material-symbols-outlined text-[16px]">chevron_right</span>
        </button>

        <a href="/student/e-library" class="ctrl-btn" style="background:#0B5ED7;border-color:#0B5ED7;color:#FFFFFF;margin-left:6px;">
          Close Reader
        </a>
      </div>
    </header>

    <!-- Canvas Viewer Stage -->
    <main id="viewer-stage">
      <div id="loadingIndicator" style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:60vh;color:#94A3B8;">
        <div style="width:40px;height:40px;border:3px solid rgba(255,255,255,0.1);border-top-color:#0B5ED7;border-radius:50%;animation:spin 0.8s linear infinite;margin-bottom:12px;"></div>
        <div style="font-weight:700;">Loading digital book...</div>
      </div>

      <canvas id="pdf-render" class="pdf-canvas-card" style="display:none;"></canvas>

      <div id="fallbackContainer" style="display:none;width:100%;max-width:900px;">
        <div class="fallback-card">
          <div style="font-size:2.8rem;margin-bottom:12px;">📖</div>
          <h3 style="margin:0 0 8px 0;font-size:1.2rem;font-weight:800;color:#FFFFFF;"><%= content.title %></h3>
          <p style="color:#94A3B8;font-size:0.88rem;line-height:1.5;margin-bottom:20px;">
            <%= content.description || 'This curriculum textbook is ready for full-screen study.' %>
          </p>
          <div style="display:flex;justify-content:center;gap:12px;flex-wrap:wrap;">
            <a href="<%= content.file_url %>" target="_blank" class="ctrl-btn" style="background:#0B5ED7;border-color:#0B5ED7;color:#FFFFFF;padding:10px 20px;font-size:0.9rem;">
              🚀 Open PDF Directly
            </a>
            <a href="/student/e-library" class="ctrl-btn" style="padding:10px 20px;font-size:0.9rem;">
              Back to E-Library
            </a>
          </div>
        </div>
      </div>
    </main>

    <!-- Save Progress Toast -->
    <div id="toast" class="toast-pill">
      <span class="material-symbols-outlined" style="font-size:16px;">bookmark</span>
      Reading Progress Saved
    </div>

  </div>

  <style>
    @keyframes spin { to { transform: rotate(360deg); } }
  </style>

  <script>
    const contentId = <%= content.id || 1 %>;
    let rawFileUrl = '<%= content.file_url || "" %>';
    
    // Normalize relative static URLs
    if (rawFileUrl && !rawFileUrl.startsWith('http') && !rawFileUrl.startsWith('/')) {
      rawFileUrl = '/' + rawFileUrl;
    }

    let pdfDoc = null;
    let pageNum = parseInt('<%= start_page || 1 %>', 10) || 1;
    let pageIsRendering = false;
    let pageNumIsPending = null;
    let scale = 1.2;

    const canvas = document.getElementById('pdf-render');
    const ctx = canvas.getContext('2d');
    const loader = document.getElementById('loadingIndicator');
    const fallbackBox = document.getElementById('fallbackContainer');

    if (typeof pdfjsLib !== 'undefined') {
      pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.worker.min.js';
    }

    function renderPage(num) {
      if (!pdfDoc) return;
      pageIsRendering = true;

      pdfDoc.getPage(num).then(page => {
        const viewport = page.getViewport({ scale });
        canvas.height = viewport.height;
        canvas.width = viewport.width;

        const renderCtx = { canvasContext: ctx, viewport };
        page.render(renderCtx).promise.then(() => {
          pageIsRendering = false;
          if (pageNumIsPending !== null) {
            renderPage(pageNumIsPending);
            pageNumIsPending = null;
          }
        });

        document.getElementById('page-num').textContent = num;
        document.getElementById('btn-prev-page').disabled = (num <= 1);
        document.getElementById('btn-next-page').disabled = (num >= pdfDoc.numPages);
        saveProgress(num);
      }).catch(err => {
        console.error('Error rendering page:', err);
      });
    }

    function queueRenderPage(num) {
      if (pageIsRendering) {
        pageNumIsPending = num;
      } else {
        renderPage(num);
      }
    }

    function showPrevPage() {
      if (pageNum <= 1) return;
      pageNum--;
      queueRenderPage(pageNum);
    }

    function showNextPage() {
      if (!pdfDoc || pageNum >= pdfDoc.numPages) return;
      pageNum++;
      queueRenderPage(pageNum);
    }

    // Load PDF Document
    function initPdfReader() {
      if (!rawFileUrl) {
        showFallback();
        return;
      }

      pdfjsLib.getDocument({
        url: rawFileUrl,
        withCredentials: true
      }).promise.then(doc => {
        pdfDoc = doc;
        document.getElementById('page-count').textContent = doc.numPages;
        if (pageNum > doc.numPages) pageNum = doc.numPages;
        if (pageNum < 1) pageNum = 1;

        if (loader) loader.style.display = 'none';
        canvas.style.display = 'block';
        renderPage(pageNum);
      }).catch(err => {
        console.warn('PDF.js could not parse URL directly:', err.message);
        showFallback();
      });
    }

    function showFallback() {
      if (loader) loader.style.display = 'none';
      if (canvas) canvas.style.display = 'none';
      if (fallbackBox) fallbackBox.style.display = 'block';
    }

    // Zoom Controls
    document.getElementById('btn-zoom-in').addEventListener('click', () => {
      scale = Math.min(2.4, scale + 0.2);
      document.getElementById('zoom-val').textContent = Math.round(scale * 100) + '%';
      renderPage(pageNum);
    });

    document.getElementById('btn-zoom-out').addEventListener('click', () => {
      scale = Math.max(0.6, scale - 0.2);
      document.getElementById('zoom-val').textContent = Math.round(scale * 100) + '%';
      renderPage(pageNum);
    });

    document.getElementById('btn-prev-page').addEventListener('click', showPrevPage);
    document.getElementById('btn-next-page').addEventListener('click', showNextPage);

    // Keyboard Arrow navigation
    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') showPrevPage();
      if (e.key === 'ArrowRight') showNextPage();
    });

    // Auto-Save Reading Progress
    let saveTimeout = null;
    function saveProgress(page) {
      clearTimeout(saveTimeout);
      saveTimeout = setTimeout(async () => {
        try {
          await fetch('/digital-library/api/save-progress', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              content_id: contentId,
              page: page,
              total_pages: pdfDoc ? pdfDoc.numPages : 1
            })
          });
          const toast = document.getElementById('toast');
          if (toast) {
            toast.classList.add('show');
            setTimeout(() => toast.classList.remove('show'), 2000);
          }
        } catch (e) {}
      }, 1200);
    }

    document.addEventListener('DOMContentLoaded', initPdfReader);
  </script>
</body>
</html>
