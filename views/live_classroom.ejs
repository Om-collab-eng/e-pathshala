<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="shortcut icon" href="/favicon.ico">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">

  <style>
    *, *::before, *::after { box-sizing: border-box; }
    html, body {
      margin: 0;
      padding: 0;
      width: 100vw;
      height: 100vh;
      overflow: hidden;
      background: #0B0F19;
      color: #F8FAFC;
      font-family: 'Plus Jakarta Sans', 'Inter', -apple-system, sans-serif;
    }

    .ls-app-shell {
      display: flex;
      flex-direction: column;
      width: 100vw;
      height: 100vh;
      background: #0B0F19;
    }

    /* Top App Bar */
    .ls-topbar {
      height: 60px;
      min-height: 60px;
      background: #111827;
      border-bottom: 1px solid #1F2937;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 1.25rem;
      z-index: 50;
    }

    .ls-topbar-left {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .ls-exit-btn {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      background: #1F2937;
      color: #94A3B8;
      display: flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      transition: all 0.15s ease;
      border: 1px solid #374151;
    }
    .ls-exit-btn:hover {
      background: #DC2626;
      color: #FFFFFF;
      border-color: #DC2626;
    }

    .ls-meeting-meta {
      display: flex;
      flex-direction: column;
    }

    .ls-meeting-title-row {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .ls-meeting-title {
      font-size: 1.05rem;
      font-weight: 800;
      color: #FFFFFF;
      margin: 0;
      letter-spacing: -0.02em;
    }

    .ls-live-badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      background: rgba(220, 38, 38, 0.2);
      color: #F87171;
      border: 1px solid rgba(220, 38, 38, 0.4);
      font-size: 0.7rem;
      font-weight: 800;
      padding: 2px 7px;
      border-radius: 6px;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    .ls-live-dot {
      width: 6px;
      height: 6px;
      background: #EF4444;
      border-radius: 50%;
      animation: pulse 1.5s infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(1.3); }
    }

    .ls-meeting-sub {
      font-size: 0.78rem;
      color: #94A3B8;
    }

    .ls-topbar-right {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .ls-code-pill {
      background: #1F2937;
      border: 1px solid #374151;
      color: #60A5FA;
      font-family: monospace;
      font-size: 0.82rem;
      font-weight: 700;
      padding: 5px 10px;
      border-radius: 8px;
      letter-spacing: 1px;
    }

    .ls-action-btn {
      background: #1F2937;
      border: 1px solid #374151;
      color: #F8FAFC;
      border-radius: 8px;
      padding: 6px 12px;
      font-size: 0.8rem;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      text-decoration: none;
      transition: all 0.15s ease;
    }
    .ls-action-btn:hover {
      background: #374151;
      border-color: #4B5563;
    }

    .ls-badge-host {
      background: linear-gradient(135deg, #059669 0%, #10B981 100%);
      color: #FFFFFF;
      font-size: 0.72rem;
      font-weight: 800;
      padding: 4px 8px;
      border-radius: 6px;
      letter-spacing: 0.05em;
    }

    .ls-badge-student {
      background: #374151;
      color: #E2E8F0;
      font-size: 0.72rem;
      font-weight: 700;
      padding: 4px 8px;
      border-radius: 6px;
    }

    /* Main Jitsi Container */
    #jitsiContainer {
      flex: 1;
      width: 100%;
      height: calc(100vh - 60px);
      background: #000000;
      position: relative;
    }

    #jitsiContainer iframe {
      width: 100% !important;
      height: 100% !important;
      border: none !important;
    }

    /* Loading Overlay */
    .ls-loading-overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: #0B0F19;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      z-index: 10;
      transition: opacity 0.3s ease;
    }

    .ls-spinner {
      width: 44px;
      height: 44px;
      border: 3px solid rgba(11, 94, 215, 0.2);
      border-top-color: #0B5ED7;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      margin-bottom: 16px;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }
  </style>

  <!-- Meeting Config Injection -->
  <script>
    window.MEETING_CONFIG = {
      id: <%= session.id || 0 %>,
      meetingCode: '<%= session.meeting_code || session.meeting_id %>',
      title: '<%= (session.title || "Live Studio Class").replace(/'/g, "\\'") %>',
      isHost: <%= isHost ? 'true' : 'false' %>,
      userId: <%= user.id || 0 %>,
      userName: '<%= (user.name || "Participant").replace(/'/g, "\\'") %>',
      userEmail: '<%= user.email || "" %>'
    };
  </script>

  <!-- Official Jitsi External API SDK -->
  <script src="https://meet.jit.si/external_api.js"></script>
</head>
<body>

  <div class="ls-app-shell">
    
    <!-- Top Bar -->
    <header class="ls-topbar">
      <div class="ls-topbar-left">
        <a href="<%= isHost ? '/admin?module=studio' : '/student/live-classes' %>" class="ls-exit-btn" title="Leave & Return" onclick="recordAttendanceLeave()">
          <span class="material-symbols-outlined text-[20px]">arrow_back</span>
        </a>

        <div class="ls-meeting-meta">
          <div class="ls-meeting-title-row">
            <h1 class="ls-meeting-title"><%= session.title %></h1>
            <span class="ls-live-badge">
              <span class="ls-live-dot"></span>
              LIVE STUDIO
            </span>
          </div>
          <div class="ls-meeting-sub">
            <%= session.course_title || session.class_name || 'Classroom' %> &bull; Host: <strong><%= session.host_name || 'Mrs. Sharma' %></strong>
          </div>
        </div>
      </div>

      <div class="ls-topbar-right">
        <span class="ls-code-pill"><%= session.meeting_code || session.meeting_id %></span>

        <button class="ls-action-btn" onclick="copyJoinLink()" title="Copy Meeting Link">
          <span class="material-symbols-outlined text-[16px]">content_copy</span>
          <span id="copyBtnText">Copy Link</span>
        </button>

        <% if (isHost) { %>
          <span class="ls-badge-host">👑 HOST (INSTRUCTOR)</span>
        <% } else { %>
          <span class="ls-badge-student">STUDENT</span>
        <% } %>

        <a href="<%= isHost ? '/admin?module=studio' : '/student/live-classes' %>" class="ls-action-btn" style="background:#DC2626;border-color:#DC2626;color:#FFFFFF;" onclick="recordAttendanceLeave()">
          Leave Room
        </a>
      </div>
    </header>

    <!-- Video Meeting Stage -->
    <main id="jitsiContainer">
      <div id="jitsiLoading" class="ls-loading-overlay">
        <div class="ls-spinner"></div>
        <h3 style="margin:0 0 6px 0;font-weight:700;">Connecting to Librika Studio...</h3>
        <p style="margin:0;color:#94A3B8;font-size:0.85rem;">Securing audio, video & collaborative whiteboard room</p>
      </div>
    </main>

  </div>

  <script>
    let jitsiApi = null;

    function initJitsiMeet() {
      const config = window.MEETING_CONFIG;
      const container = document.getElementById('jitsiContainer');
      const loader = document.getElementById('jitsiLoading');

      const domain = 'meet.jit.si';
      const options = {
        roomName: config.meetingCode,
        width: '100%',
        height: '100%',
        parentNode: container,
        userInfo: {
          displayName: config.userName,
          email: config.userEmail
        },
        configOverwrite: {
          startWithAudioMuted: !config.isHost,
          startWithVideoMuted: !config.isHost,
          prejoinPageEnabled: false,
          disableModeratorIndicator: false,
          enableWelcomePage: false,
          enableClosePage: false,
          disableDeepLinking: true,
          hideConferenceSubject: true,
          subject: config.title,
          toolbarButtons: [
            'camera',
            'chat',
            'desktop',
            'download',
            'etherpad',
            'filmstrip',
            'fullscreen',
            'hangup',
            'help',
            'highlight',
            'microphone',
            'noisesuppression',
            'participants-pane',
            'profile',
            'raisehand',
            'recording',
            'security',
            'select-background',
            'settings',
            'shareaudio',
            'sharedvideo',
            'shortcuts',
            'stats',
            'tileview',
            'toggle-camera',
            'videoquality',
            'whiteboard'
          ]
        },
        interfaceConfigOverwrite: {
          SHOW_JITSI_WATERMARK: false,
          SHOW_WATERMARK_FOR_GUEST: false,
          SHOW_BRAND_WATERMARK: false,
          BRAND_WATERMARK_LINK: '',
          SHOW_POWERED_BY: false,
          SHOW_PROMOTIONAL_CLOSE_PAGE: false,
          DISABLE_JOIN_LEAVE_NOTIFICATIONS: false,
          TILE_VIEW_MAX_COLUMNS: 4,
          MOBILE_APP_PROMO: false
        }
      };

      try {
        jitsiApi = new JitsiMeetExternalAPI(domain, options);

        jitsiApi.addListener('videoConferenceJoined', (data) => {
          console.log('[LIBRIKA STUDIO] Connected to room:', data);
          if (loader) loader.style.display = 'none';
          recordAttendanceJoin();
        });

        jitsiApi.addListener('readyToClose', () => {
          console.log('[LIBRIKA STUDIO] Conference ended or closed by user.');
          recordAttendanceLeave();
          window.location.href = config.isHost ? '/admin?module=studio' : '/student/live-classes';
        });

        jitsiApi.addListener('participantJoined', (participant) => {
          console.log('[LIBRIKA STUDIO] Participant joined:', participant);
        });

        jitsiApi.addListener('participantLeft', (participant) => {
          console.log('[LIBRIKA STUDIO] Participant left:', participant);
        });

        // Safety timeout to hide loader
        setTimeout(() => {
          if (loader) loader.style.display = 'none';
        }, 3500);

      } catch (err) {
        console.error('[LIBRIKA STUDIO] Jitsi init error:', err);
        if (loader) {
          loader.innerHTML = `
            <div style="text-align:center;padding:24px;">
              <h3 style="color:#F87171;">Could not load meeting room</h3>
              <p style="color:#94A3B8;">${err.message}</p>
              <button onclick="window.location.reload()" class="ls-action-btn" style="background:#0B5ED7;border-color:#0B5ED7;margin-top:12px;">Retry</button>
            </div>
          `;
        }
      }
    }

    async function recordAttendanceJoin() {
      if (!window.MEETING_CONFIG.id) return;
      try {
        await fetch(`/api/studio/meetings/${window.MEETING_CONFIG.id}/attendance/join`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            memberId: window.MEETING_CONFIG.userId,
            memberName: window.MEETING_CONFIG.userName,
            role: window.MEETING_CONFIG.isHost ? 'host' : 'student'
          })
        });
      } catch(e) {}
    }

    async function recordAttendanceLeave() {
      if (!window.MEETING_CONFIG.id) return;
      try {
        navigator.sendBeacon(`/api/studio/meetings/${window.MEETING_CONFIG.id}/attendance/leave`, JSON.stringify({
          memberId: window.MEETING_CONFIG.userId
        }));
      } catch(e) {}
    }

    window.addEventListener('beforeunload', recordAttendanceLeave);

    function copyJoinLink() {
      const url = window.location.href;
      navigator.clipboard.writeText(url).then(() => {
        const txt = document.getElementById('copyBtnText');
        txt.textContent = 'Copied!';
        setTimeout(() => { txt.textContent = 'Copy Link'; }, 2000);
      });
    }

    document.addEventListener('DOMContentLoaded', initJitsiMeet);
  </script>
</body>
</html>
